# Resolve at the build boundary, freeze during compilation, retain actual SHAs.
include_guard(GLOBAL)
include(FetchContent)
if(POLICY CMP0135)
  cmake_policy(SET CMP0135 NEW)
endif()

function(neverd_guard_fork_targets Directory)
  get_property(_targets DIRECTORY "${Directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_type ${_target} TYPE)
    if(_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
      add_dependencies(${_target} neverd-check-fork-heads)
    endif()
  endforeach()
  get_property(_directories DIRECTORY "${Directory}" PROPERTY SUBDIRECTORIES)
  foreach(_directory IN LISTS _directories)
    neverd_guard_fork_targets("${_directory}")
  endforeach()
endfunction()

function(neverd_finish_fork_setup)
  if(TARGET neverd-check-fork-heads)
    neverd_guard_fork_targets("${CMAKE_SOURCE_DIR}")
    file(READ "${CMAKE_BINARY_DIR}/.neverd-deps/snapshot.json" _snapshot)
  endif()
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party/forks.json" _repositories)
  set(_receipt "{\"schema\":1,\"purpose\":\"configure_inputs\",\"sources\":{}}")
  get_property(_used GLOBAL PROPERTY NEVERD_MANAGED_FORKS)
  foreach(_name neverd_highway neverd_simdutf neverd_simdjson neverd_tbb neverd_mimalloc)
    get_property(_override GLOBAL PROPERTY NEVERD_FORK_OVERRIDE_${_name})
    if(_name IN_LIST _used)
      string(JSON _source GET "${_snapshot}" sources ${_name})
      string(JSON _source REMOVE "${_source}" archive)
      string(JSON _source SET "${_source}" used true)
      string(JSON _source SET "${_source}" selection "\"managed\"")
    elseif(_override)
      string(REPLACE "\\" "\\\\" _override "${_override}")
      string(REPLACE "\"" "\\\"" _override "${_override}")
      set(_source "{\"used\":true,\"selection\":\"local_override\",\"path\":\"${_override}\"}")
    else()
      set(_source "{\"used\":false,\"selection\":\"disabled\"}")
    endif()
    string(JSON _receipt SET "${_receipt}" sources ${_name} "${_source}")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/neverd-dependency-inputs.json" "${_receipt}\n")
  set(_install_check "${CMAKE_BINARY_DIR}/neverd-check-fork-install.cmake")
  if(_used)
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    file(WRITE "${_install_check}"
      "execute_process(COMMAND \"${Python3_EXECUTABLE}\" \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/fork_dependencies.py\" check-install \"${CMAKE_BINARY_DIR}\" --config \"\${CMAKE_INSTALL_CONFIG_NAME}\" RESULT_VARIABLE _result)\nif(NOT _result EQUAL 0)\n  message(FATAL_ERROR \"Build the current fork inputs successfully before installing\")\nendif()\n")
  else()
    file(WRITE "${_install_check}" "# No managed fork inputs in this configuration.\n")
  endif()
  install(FILES "${CMAKE_BINARY_DIR}/neverd-dependency-inputs.json"
    DESTINATION share/neverd)
  install(FILES "${CMAKE_BINARY_DIR}/neverd-dependency-inputs.json"
    DESTINATION share/neverd COMPONENT WebProduct)
  foreach(_name IN LISTS _used)
    get_property(_notices GLOBAL PROPERTY NEVERD_FORK_NOTICES_${_name})
    get_property(_directory GLOBAL PROPERTY NEVERD_FORK_DIRECTORY_${_name})
    install(DIRECTORY "${_notices}/" DESTINATION "share/neverd/licenses/${_directory}"
      COMPONENT WebProduct)
  endforeach()
endfunction()

if(NOT CMAKE_SCRIPT_MODE_FILE)
  # Register the guard before any dependency or product install rules. Always
  # rewrite the inputs, including configurations with every library disabled.
  install(SCRIPT "${CMAKE_BINARY_DIR}/neverd-check-fork-install.cmake")
  install(SCRIPT "${CMAKE_BINARY_DIR}/neverd-check-fork-install.cmake" COMPONENT WebProduct)
  cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL neverd_finish_fork_setup)
endif()

function(neverd_populate_fork Name)
  string(TOUPPER "${Name}" _upper)
  set(_override "${FETCHCONTENT_SOURCE_DIR_${_upper}}")
  if(_override)
    # Explicit caller-owned fixtures stay local. The mainline build wrapper
    # rejects these overrides; it must not call a local fixture a remote tip.
    FetchContent_Declare(${Name} SOURCE_DIR "${_override}"
      SOURCE_SUBDIR neverd-no-automatic-subdirectory)
    set_property(GLOBAL PROPERTY NEVERD_FORK_OVERRIDE_${Name} "${_override}")
  else()
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    set(_script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/fork_dependencies.py")
    set(_snapshot "${CMAKE_BINARY_DIR}/.neverd-deps/snapshot.json")
    if(NOT EXISTS "${_snapshot}")
      execute_process(COMMAND "${Python3_EXECUTABLE}" "${_script}" refresh "${CMAKE_BINARY_DIR}" --configure
        RESULT_VARIABLE _result)
      if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot resolve NeverSight fork default branches")
      endif()
    endif()
    if(NOT TARGET neverd-check-fork-heads)
      execute_process(COMMAND "${Python3_EXECUTABLE}" "${_script}" begin-configure "${CMAKE_BINARY_DIR}"
        RESULT_VARIABLE _reader_result)
      if(NOT _reader_result EQUAL 0)
        message(FATAL_ERROR "Cannot record the fork sources consumed by this configuration")
      endif()
    endif()
    file(READ "${_snapshot}" _json)
    file(SHA256 "${_snapshot}" _snapshot_digest)
    foreach(_field commit archive sha256 branch)
      string(JSON _${_field} GET "${_json}" sources ${Name} ${_field})
    endforeach()
    message(STATUS "NeverD ${Name}: ${_branch} @ ${_commit}")
    get_filename_component(_archive_directory "${_archive}" DIRECTORY)
    FetchContent_Declare(${Name} URL "${_archive}" URL_HASH "SHA256=${_sha256}"
      SOURCE_DIR "${_archive_directory}/src"
      SOURCE_SUBDIR neverd-no-automatic-subdirectory)
    set_property(GLOBAL APPEND PROPERTY NEVERD_MANAGED_FORKS "${Name}")
    if(NOT TARGET neverd-check-fork-heads)
      add_custom_target(neverd-check-fork-heads
        COMMAND "${Python3_EXECUTABLE}" "${_script}" check "${CMAKE_BINARY_DIR}"
          --expected "${_snapshot_digest}"
        COMMENT "Checking NeverSight fork snapshot" VERBATIM)
    endif()
  endif()
  FetchContent_MakeAvailable(${Name})
  string(REPLACE "neverd_" "" _directory "${Name}")
  if(_directory STREQUAL "tbb")
    set(_directory oneTBB)
  endif()
  set(_notices "${CMAKE_BINARY_DIR}/neverd-fork-notices/${_directory}")
  file(MAKE_DIRECTORY "${_notices}")
  file(GLOB _licenses LIST_DIRECTORIES false
    "${${Name}_SOURCE_DIR}/LICENSE*" "${${Name}_SOURCE_DIR}/NOTICE*"
    "${${Name}_SOURCE_DIR}/COPYING*" "${${Name}_SOURCE_DIR}/third-party-programs*")
  foreach(_license IN LISTS _licenses)
    get_filename_component(_filename "${_license}" NAME)
    configure_file("${_license}" "${_notices}/${_filename}" COPYONLY)
  endforeach()
  if(_override)
    file(WRITE "${_notices}/SOURCE.md"
      "Explicit caller-supplied source override; not a default-branch build.\n")
  else()
    string(JSON _repository GET "${_json}" sources ${Name} repository)
    string(REGEX REPLACE "\\.git$" "" _repository "${_repository}")
    file(WRITE "${_notices}/SOURCE.md"
      "Source: ${_repository}/tree/${_commit}\n\nBranch: ${_branch}\n\nArchive SHA-256: ${_sha256}\n")
  endif()
  set_property(GLOBAL PROPERTY NEVERD_FORK_NOTICES_${Name} "${_notices}")
  set_property(GLOBAL PROPERTY NEVERD_FORK_DIRECTORY_${Name} "${_directory}")
  set(${Name}_NOTICES_DIR "${_notices}" PARENT_SCOPE)
  set(${Name}_SOURCE_DIR "${${Name}_SOURCE_DIR}" PARENT_SCOPE)
  set(${Name}_BINARY_DIR "${${Name}_BINARY_DIR}" PARENT_SCOPE)
endfunction()
