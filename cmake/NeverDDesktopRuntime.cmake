# Runs after Qt's deployment script, in the install tree, never on build inputs.
if(NOT NEVERD_DEPLOY_SYSTEM MATCHES "^(Linux|Windows)$")
  message(FATAL_ERROR "Desktop runtime collector supports Linux and Windows")
endif()
if(NOT IS_DIRECTORY "${QT_DEPLOY_PREFIX}/bin")
  message(FATAL_ERROR "Missing desktop install bin directory")
endif()
file(REAL_PATH "${QT_DEPLOY_PREFIX}" _prefix)

# Validate the physical destination, including symlinked parent directories,
# before removing drivers, replacing libraries or writing the audit.
function(neverd_require_package_path Path)
  # REAL_PATH does not resolve symlinked parents of a nonexistent output.
  # Check its existing ancestors too, before creating any directory or file.
  set(_entry "${Path}")
  while(NOT _entry STREQUAL _prefix)
    if(EXISTS "${_entry}" OR IS_SYMLINK "${_entry}")
      file(REAL_PATH "${_entry}" _real)
      file(RELATIVE_PATH _relative "${_prefix}" "${_real}")
      if(_relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${_relative}")
        message(FATAL_ERROR "Desktop runtime path is outside the package: ${Path}")
      endif()
      if(IS_SYMLINK "${_entry}")
        file(READ_SYMLINK "${_entry}" _link)
        if(IS_ABSOLUTE "${_link}" OR NOT EXISTS "${_entry}")
          message(FATAL_ERROR "Non-relocatable runtime symlink: ${_entry}")
        endif()
      endif()
    endif()
    get_filename_component(_parent "${_entry}" DIRECTORY)
    if(_parent STREQUAL _entry)
      message(FATAL_ERROR "Desktop runtime path is outside the package: ${Path}")
    endif()
    set(_entry "${_parent}")
  endwhile()
endfunction()

# A staging tree may use hard links to its build inputs. Replace directory
# entries atomically instead of modifying the shared inode, even when copying.
function(neverd_copy_desktop_library Source)
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _id)
  set(_temporary "${_lib_dir}/.neverd-copy-${_id}")
  file(MAKE_DIRECTORY "${_temporary}")
  file(COPY "${Source}" DESTINATION "${_temporary}" FOLLOW_SYMLINK_CHAIN)
  file(GLOB _copies "${_temporary}/*")
  foreach(_copy IN LISTS _copies)
    get_filename_component(_name "${_copy}" NAME)
    neverd_require_package_path("${_lib_dir}/${_name}")
    file(RENAME "${_copy}" "${_lib_dir}/${_name}" RESULT _result)
    if(NOT _result STREQUAL "0")
      file(REMOVE_RECURSE "${_temporary}")
      message(FATAL_ERROR "Cannot install ${_name}: ${_result}")
    endif()
  endforeach()
  file(REMOVE_RECURSE "${_temporary}")
endfunction()

neverd_require_package_path("${_prefix}/bin")
set(_executables)
foreach(_name neverd-gui neverd-worker neverd-mcp neverd)
  set(_path "${_prefix}/bin/${_name}${NEVERD_DEPLOY_EXECUTABLE_SUFFIX}")
  if(EXISTS "${_path}")
    neverd_require_package_path("${_path}")
    list(APPEND _executables "${_path}")
  elseif(NOT _name STREQUAL "neverd")
    message(FATAL_ERROR "Desktop package is missing ${_name}")
  endif()
endforeach()

# Only local SQLite is used by NDDB. Avoid shipping external SQL connectors
# that introduce unrelated database clients and unresolved optional libraries.
set(_sql "${_prefix}/${QT_DEPLOY_PLUGINS_DIR}/sqldrivers")
if(NEVERD_DEPLOY_SYSTEM STREQUAL "Windows")
  set(_debug_suffix "")
  if(NEVERD_DEPLOY_CONFIG STREQUAL "Debug")
    set(_debug_suffix "d")
  endif()
  set(_sqlite "qsqlite${_debug_suffix}.dll")
  set(_sql_pattern "^qsql(mimer|mysql|odbc|psql|oci|db2|ibase)${_debug_suffix}\\.dll$")
  set(_lib_dir "${_prefix}/bin")
  set(_pre_exclude "[Aa][Pp][Ii]-[Mm][Ss]-.*" "[Ee][Xx][Tt]-[Mm][Ss]-.*")
  # A vendor/build directory can also be named Windows. Exclude only the
  # actual OS tree, escaping its path and matching Windows' case insensitivity.
  if(NOT IS_DIRECTORY "$ENV{SystemRoot}")
    message(FATAL_ERROR "Windows deployment requires a valid SystemRoot")
  endif()
  file(REAL_PATH "$ENV{SystemRoot}" _system_root)
  # Native CMake also adds these paths through Win32 APIs. Keep them explicit
  # so the same dependency audit works with cross-compiled PE fixtures.
  set(_system_dirs "${_system_root}/System32" "${_system_root}")
  set(_system_regex "^")
  string(LENGTH "${_system_root}" _length)
  math(EXPR _last "${_length} - 1")
  foreach(_index RANGE 0 ${_last})
    string(SUBSTRING "${_system_root}" ${_index} 1 _character)
    if(_character MATCHES "^[A-Za-z]$")
      string(TOLOWER "${_character}" _lower)
      string(TOUPPER "${_character}" _upper)
      string(APPEND _system_regex "[${_lower}${_upper}]")
    elseif(_character MATCHES "^[0-9/ :_-]$")
      string(APPEND _system_regex "${_character}")
    else()
      string(APPEND _system_regex "\\${_character}")
    endif()
  endforeach()
  set(_post_exclude "${_system_regex}/.*")
else()
  set(_sqlite "libqsqlite.so")
  set(_sql_pattern "^libqsql(mimer|mysql|odbc|psql|oci|db2|ibase)\\.so$")
  set(_lib_dir "${_prefix}/${QT_DEPLOY_LIB_DIR}")
  # The OS owns glibc, the loader, and graphics dispatch/driver libraries.
  # Other dependencies, including Qt's own dynamic zlib, are copied privately.
  set(_pre_exclude
    "^ld-(linux|musl).*" "^lib(c|m|dl|pthread|rt|util|resolv|anl)\\.so\\..*"
    "^lib(GL|GLX|EGL|OpenGL|GLdispatch|vulkan)\\.so\\..*")
  set(_post_exclude)
  set(_system_dirs)
endif()
foreach(_path "${_lib_dir}" "${_sql}" "${_prefix}/share/neverd/dependency-audit.txt")
  neverd_require_package_path("${_path}")
endforeach()
file(GLOB_RECURSE _entries LIST_DIRECTORIES true
  "${_lib_dir}/*" "${_prefix}/${QT_DEPLOY_PLUGINS_DIR}/*")
foreach(_path IN LISTS _entries)
  neverd_require_package_path("${_path}")
endforeach()
if(NOT EXISTS "${_sql}/${_sqlite}" OR IS_DIRECTORY "${_sql}/${_sqlite}")
  message(FATAL_ERROR "Desktop package must contain the SQLite Qt driver")
endif()
file(GLOB _sql_entries "${_sql}/*")
set(_remove)
foreach(_path IN LISTS _sql_entries)
  get_filename_component(_name "${_path}" NAME)
  if(IS_SYMLINK "${_path}" OR IS_DIRECTORY "${_path}")
    message(FATAL_ERROR "Unexpected Qt SQL driver entry: ${_path}")
  elseif(_name STREQUAL _sqlite)
    continue()
  elseif(_name MATCHES "${_sql_pattern}")
    list(APPEND _remove "${_path}")
  else()
    message(FATAL_ERROR "Unknown Qt SQL driver: ${_path}")
  endif()
endforeach()
if(_remove)
  file(REMOVE ${_remove})
endif()

# Normalize installed inputs before discovery as well as after copying. This
# also keeps repeated installs from mixing original and already bundled paths.
function(neverd_relocate_desktop_images AllowBuildPaths)
  if(NOT NEVERD_DEPLOY_SYSTEM STREQUAL "Linux")
    return()
  endif()
  find_program(_patchelf patchelf REQUIRED)
  set(_images ${ARGN})
  set(_real_images)
  foreach(_path IN LISTS _images)
    neverd_require_package_path("${_path}")
    file(REAL_PATH "${_path}" _real)
    list(APPEND _real_images "${_real}")
  endforeach()
  list(REMOVE_DUPLICATES _real_images)
  foreach(_path IN LISTS _real_images)
    get_filename_component(_directory "${_path}" DIRECTORY)
    file(RELATIVE_PATH _relative "${_directory}" "${_lib_dir}")
    set(_rpath "$ORIGIN")
    if(NOT _relative STREQUAL "")
      string(APPEND _rpath "/${_relative}")
    endif()
    execute_process(COMMAND "${_patchelf}" --print-rpath "${_path}"
      OUTPUT_VARIABLE _old_rpath OUTPUT_STRIP_TRAILING_WHITESPACE
      RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Cannot read runtime paths of ${_path}: ${_error}")
    endif()
    set(_rpaths "${_rpath}")
    set(_origins "${_directory}")
    if(AllowBuildPaths)
      get_filename_component(_name "${_path}" NAME)
      foreach(_source IN LISTS NEVERD_DEPLOY_SOURCE_FILES)
        get_filename_component(_source_name "${_source}" NAME)
        if(_name STREQUAL _source_name)
          get_filename_component(_origin "${_source}" DIRECTORY)
          list(APPEND _origins "${_origin}")
        endif()
      endforeach()
    endif()
    string(REPLACE ":" ";" _old_paths "${_old_rpath}")
    foreach(_origin IN LISTS _origins)
      foreach(_old IN LISTS _old_paths)
        string(REPLACE "\${ORIGIN}" "${_origin}" _old "${_old}")
        string(REPLACE "$ORIGIN" "${_origin}" _old "${_old}")
        if(NOT IS_ABSOLUTE "${_old}" OR NOT IS_DIRECTORY "${_old}")
          continue()
        endif()
        file(REAL_PATH "${_old}" _old)
        file(RELATIVE_PATH _relative "${_prefix}" "${_old}")
        if(NOT _relative MATCHES "^\\.\\.(/|$)" AND NOT IS_ABSOLUTE "${_relative}")
          file(RELATIVE_PATH _relative "${_directory}" "${_old}")
          set(_old "$ORIGIN")
          if(NOT _relative STREQUAL "")
            string(APPEND _old "/${_relative}")
          endif()
          list(APPEND _rpaths "${_old}")
        elseif(AllowBuildPaths)
          list(APPEND _rpaths "${_old}")
        endif()
      endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _rpaths)
    list(JOIN _rpaths ":" _rpath)
    if(_old_rpath STREQUAL _rpath)
      continue()
    endif()
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _id)
    set(_temporary "${_directory}/.neverd-rpath-${_id}")
    file(MAKE_DIRECTORY "${_temporary}")
    file(COPY "${_path}" DESTINATION "${_temporary}" USE_SOURCE_PERMISSIONS)
    get_filename_component(_name "${_path}" NAME)
    execute_process(COMMAND "${_patchelf}" --set-rpath "${_rpath}" "${_temporary}/${_name}"
      RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0)
      file(REMOVE_RECURSE "${_temporary}")
      message(FATAL_ERROR "Cannot relocate ${_path}: ${_error}")
    endif()
    file(RENAME "${_temporary}/${_name}" "${_path}" RESULT _result)
    file(REMOVE_RECURSE "${_temporary}")
    if(NOT _result STREQUAL "0")
      message(FATAL_ERROR "Cannot replace ${_path}: ${_result}")
    endif()
  endforeach()
endfunction()

file(MAKE_DIRECTORY "${_lib_dir}")
set(_search_dirs ${NEVERD_DEPLOY_SEARCH_DIRS})
foreach(_path IN LISTS NEVERD_DEPLOY_RUNTIME_LIBRARIES)
  get_filename_component(_directory "${_path}" DIRECTORY)
  list(APPEND _search_dirs "${_directory}")
  neverd_copy_desktop_library("${_path}")
endforeach()

file(GLOB_RECURSE _libraries "${_lib_dir}/*.so*" "${_prefix}/bin/*.dll")
file(GLOB_RECURSE _plugins "${_prefix}/${QT_DEPLOY_PLUGINS_DIR}/*.so*"
  "${_prefix}/${QT_DEPLOY_PLUGINS_DIR}/*.dll")
neverd_relocate_desktop_images(TRUE ${_executables} ${_libraries} ${_plugins})
file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES ${_executables} LIBRARIES ${_libraries} MODULES ${_plugins}
  DIRECTORIES "${_lib_dir}" ${_system_dirs} ${_search_dirs}
  PRE_EXCLUDE_REGEXES ${_pre_exclude} POST_EXCLUDE_REGEXES ${_post_exclude}
  RESOLVED_DEPENDENCIES_VAR _resolved UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
if(_unresolved OR _conflicts_FILENAMES)
  message(FATAL_ERROR "Incomplete desktop runtime: ${_unresolved}; conflicts: ${_conflicts_FILENAMES}")
endif()
foreach(_path IN LISTS _resolved)
  file(RELATIVE_PATH _relative "${_prefix}" "${_path}")
  # Different Windows drives have no relative path to one another.
  if(_relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${_relative}")
    neverd_copy_desktop_library("${_path}")
  endif()
endforeach()

file(GLOB_RECURSE _libraries "${_lib_dir}/*.so*" "${_prefix}/bin/*.dll")
neverd_relocate_desktop_images(FALSE ${_executables} ${_libraries} ${_plugins})

# Resolve again from the completed package. A library found only in the build
# machine's directories is a packaging failure, even if it exists locally.
file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES ${_executables} LIBRARIES ${_libraries} MODULES ${_plugins}
  DIRECTORIES "${_lib_dir}" ${_system_dirs}
  PRE_EXCLUDE_REGEXES ${_pre_exclude} POST_EXCLUDE_REGEXES ${_post_exclude}
  RESOLVED_DEPENDENCIES_VAR _resolved UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
if(_unresolved OR _conflicts_FILENAMES)
  message(FATAL_ERROR "Relocated desktop runtime is incomplete: ${_unresolved}; ${_conflicts_FILENAMES}")
endif()
set(_audit "Private desktop runtime; operating-system and graphics-driver libraries remain external.\n")
set(_audited)
foreach(_path IN LISTS _resolved _executables _libraries _plugins)
  file(REAL_PATH "${_path}" _real)
  file(RELATIVE_PATH _relative "${_prefix}" "${_real}")
  if(_relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${_relative}")
    message(FATAL_ERROR "Desktop runtime escapes the package: ${_real}")
  endif()
  if(_real IN_LIST _audited)
    continue()
  endif()
  list(APPEND _audited "${_real}")
  file(SHA256 "${_real}" _sha)
  string(APPEND _audit "${_sha}  ${_relative}\n")
endforeach()
file(MAKE_DIRECTORY "${_prefix}/share/neverd")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _id)
set(_temporary "${_prefix}/share/neverd/.neverd-audit-${_id}")
file(WRITE "${_temporary}" "${_audit}")
file(RENAME "${_temporary}" "${_prefix}/share/neverd/dependency-audit.txt" RESULT _result)
if(NOT _result STREQUAL "0")
  file(REMOVE "${_temporary}")
  message(FATAL_ERROR "Cannot replace desktop runtime audit: ${_result}")
endif()
