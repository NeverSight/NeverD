//===- AArch64SignalCursorOracle.def - Shared cursor oracle ------*- C -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Compare independent SP/PC signing instructions with the public cursor.
/// The native process and Arm model run these same frame walks.
///
//===----------------------------------------------------------------------===//

#include "neverd/runtime/DarwinArm64eSignalCursor.h"

enum { Samples = 64 };
typedef struct {
  uintptr_t LR, CFA, PC;
} Signature;

#ifdef __cplusplus
extern "C" {
#endif
extern void signPACMIA(uintptr_t, Signature *);
extern void signPACMIB(uintptr_t, Signature *);
extern void signExplicitIA(uintptr_t, Signature *);
extern void signExplicitIB(uintptr_t, Signature *);
extern void signZeroPACMIA(uintptr_t, Signature *);
extern void signZeroPACMIB(uintptr_t, Signature *);
extern void signZeroExplicitIA(uintptr_t, Signature *);
extern void signZeroExplicitIB(uintptr_t, Signature *);
#ifdef __cplusplus
}
#endif

// PACIASP/IBSP and their explicit PC forms use the actual SP and instruction
// address. The cursor instead materializes both into x16/x15.
__asm__(".text\n"
        ".p2align 2\n"
        ".macro signer name, word, prefix=0\n"
        ".globl _\\name\n"
        "_\\name:\n"
        "mov x9,x30\n"
        "mov x30,x0\n"
        "adr x3,1f\n"
        "mov x4,sp\n"
        ".if \\prefix\n"
        ".inst 0xd50324ff\n"
        ".endif\n"
        "1: .inst \\word\n"
        "str x30,[x1]\n"
        "stp x4,x3,[x1,#8]\n"
        "mov x30,x9\n"
        "ret\n"
        ".endm\n"
        "signer signPACMIA,0xd503233f,1\n"
        "signer signPACMIB,0xd503237f,1\n"
        "signer signExplicitIA,0xdac1a3fe\n"
        "signer signExplicitIB,0xdac1a7fe\n"
        ".macro zero_signer name, word, prefix=0\n"
        ".globl _\\name\n"
        "_\\name:\n"
        "mov x17,x0\n"
        "mov x16,sp\n"
        "mov x15,xzr\n"
        ".if \\prefix\n"
        ".inst 0xd50324ff\n"
        ".endif\n"
        ".inst \\word\n"
        "str x17,[x1]\n"
        "stp x16,x15,[x1,#8]\n"
        "ret\n"
        ".endm\n"
        "zero_signer signZeroPACMIA,0xd503211f,1\n"
        "zero_signer signZeroPACMIB,0xd503215f,1\n"
        "zero_signer signZeroExplicitIA,0xdac18bfe\n"
        "zero_signer signZeroExplicitIB,0xdac18ffe\n");

typedef struct {
  unsigned Checks, FirstFailure;
  unsigned Signed[2], CFARejected[2], PCRejected[2], KeyRejected[2],
      RecipeRejected[2];
} CursorResults;

static void check(CursorResults *Result, bool Condition) {
  ++Result->Checks;
  if (!Condition && !Result->FirstFailure)
    Result->FirstFailure = Result->Checks;
}

static bool sameCursor(NDDarwinArm64eCursor A, NDDarwinArm64eCursor B) {
  return A.PC == B.PC && A.SP == B.SP && A.FP == B.FP && A.LR == B.LR;
}

static bool step(CursorResults *Result, NDDarwinArm64eCursor *Cursor,
                 NDDarwinArm64eUnwindRow Row, uintptr_t Low, uintptr_t High,
                 bool Explicit) {
  const NDDarwinArm64eCursor Before = *Cursor;
  const bool OK =
      ndDarwinArm64eStepFrameWithPAuthLR(Cursor, Row, Low, High, Explicit);
  if (!OK)
    check(Result, sameCursor(Before, *Cursor));
  return OK;
}

static void checkStackRows(CursorResults *Result) {
  uintptr_t Stack[4] = {0};
  const uintptr_t Low = (uintptr_t)Stack, High = (uintptr_t)(Stack + 4);
  const uintptr_t CFA = (uintptr_t)(Stack + 2);
  const uintptr_t PC = 0x12340, FP = CFA + sizeof(uintptr_t);
  Stack[0] = FP;
  Stack[1] = PC;
  NDDarwinArm64eCursor Cursor = {0x100, Low, CFA, 0};
  NDDarwinArm64eUnwindRow Row = {false,
                                 2 * sizeof(uintptr_t),
                                 true,
                                 true,
                                 -2 * (ptrdiff_t)sizeof(uintptr_t),
                                 -(ptrdiff_t)sizeof(uintptr_t),
                                 NDArm64eUnsigned,
                                 0};
  check(Result, step(Result, &Cursor, Row, Low, High, false));
  check(Result,
        Cursor.PC == PC && Cursor.SP == CFA && Cursor.FP == FP && !Cursor.LR);
  Cursor = (NDDarwinArm64eCursor){0x100, Low, CFA, 0};
  Row.CFAFromFP = true;
  Row.CFAOffset = 0;
  check(Result, step(Result, &Cursor, Row, Low, High, false));
  Cursor = (NDDarwinArm64eCursor){0x100, Low, CFA, 0};
  check(Result, !step(Result, &Cursor, Row, Low + 1, High, false));
  check(Result, !step(Result, &Cursor, Row, Low, CFA - 1, false));
  Row.LROffset = High - CFA;
  check(Result, !step(Result, &Cursor, Row, Low, High, false));
  Row.LROffset = PTRDIFF_MIN;
  check(Result, !step(Result, &Cursor, Row, Low, High, false));
  Row.CFAOffset = PTRDIFF_MIN;
  check(Result, !step(Result, &Cursor, Row, Low, High, false));
  Row.CFAFromFP = false;
  Row.CFAOffset = 1;
  Cursor.SP = UINTPTR_MAX;
  check(Result, !step(Result, &Cursor, Row, Low, High, false));
  Cursor = (NDDarwinArm64eCursor){0x100, CFA, CFA, PC};
  Row = (NDDarwinArm64eUnwindRow){
      false, 0, false, false, 0, 0, NDArm64eUnsigned, 0};
  check(Result, step(Result, &Cursor, Row, Low, High, false));
  Cursor.LR = 0;
  check(Result, !step(Result, &Cursor, Row, Low, High, false));
  Cursor.LR = PC;
  Row.Signing = NDArm64eSigningUnknown;
  check(Result, !step(Result, &Cursor, Row, Low, High, false));
  Row.Signing = (NDDarwinArm64eSigning)-1;
  check(Result, !step(Result, &Cursor, Row, Low, High, false));
  // DWARF slot offsets are in bytes. Exercise an unaligned word ending at
  // High and reject the same row when the last byte is outside the stack.
  uintptr_t Packed[2];
  const uintptr_t PackedLow = (uintptr_t)Packed;
  const uintptr_t PackedEnd = PackedLow + 1 + sizeof(PC);
  __builtin_memcpy_inline((unsigned char *)Packed + 1, &PC, sizeof(PC));
  NDDarwinArm64eCursor PackedInput = {PC, PackedLow, CFA, 0};
  const NDDarwinArm64eUnwindRow PackedRow = {
      false, 0, false, true, 0, 1, NDArm64eUnsigned, 0};
  check(Result, !step(Result, &PackedInput, PackedRow, PackedLow, PackedEnd - 1,
                      false));
  check(Result,
        step(Result, &PackedInput, PackedRow, PackedLow, PackedEnd, false));
  check(Result,
        PackedInput.PC == PC && PackedInput.SP == PackedLow && !PackedInput.LR);
  // An explicit recipe must be refused before any unsupported instruction.
  for (unsigned Key = 0; Key != 2; ++Key) {
    Row.Signing = Key ? NDArm64eSignedIBWithCFAPC : NDArm64eSignedIAWithCFAPC;
    check(Result, !step(Result, &Cursor, Row, Low, High, false));
    check(Result, !ndDarwinArm64eStepFrame(&Cursor, Row, Low, High));
  }
  for (unsigned Key = 0; Key != 2; ++Key) {
    Row.Signing = Key ? NDArm64eSignedIBWithCFA : NDArm64eSignedIAWithCFA;
    Cursor.LR = (uintptr_t)(Key ? ptrauth_sign_unauthenticated(
                                      (void *)PC, ptrauth_key_asib, CFA)
                                : ptrauth_sign_unauthenticated(
                                      (void *)PC, ptrauth_key_asia, CFA));
    check(Result, ndDarwinArm64eStepFrame(&Cursor, Row, Low, High));
    check(Result, Cursor.PC == PC && Cursor.SP == CFA && !Cursor.LR);
  }
}

typedef struct {
  uintptr_t Inner[2], Outer[2];
} SavedFrames;

// Walk a signed spill, then use its recovered FP to reach a second frame.
// The independent signer supplied the real CFA and signing instruction PC.
static void checkSpilled(CursorResults *Result, Signature Value, uintptr_t PC,
                         NDDarwinArm64eUnwindRow Row, uintptr_t Low,
                         uintptr_t High, bool Explicit, SavedFrames *Frames) {
  const uintptr_t OuterPC = PC + sizeof(uint32_t);
  const uintptr_t OuterCFA = (uintptr_t)(Frames->Outer + 2);
  Frames->Outer[0] = Low;
  Frames->Outer[1] = (uintptr_t)ptrauth_sign_unauthenticated(
      (void *)OuterPC, ptrauth_key_asib, OuterCFA);
  Frames->Inner[0] = (uintptr_t)Frames->Outer;
  Frames->Inner[1] = Value.LR;
  const uintptr_t FP = (uintptr_t)Frames->Inner;
  const uintptr_t SP = Value.CFA - sizeof(Frames->Inner);
  const NDDarwinArm64eCursor Input = {Value.PC, SP, FP, 0};
  Row.SavedFP = Row.SavedLR = true;
  Row.FPOffset = (intptr_t)FP - (intptr_t)Value.CFA;
  Row.LROffset = Row.FPOffset + (ptrdiff_t)sizeof(uintptr_t);
  const NDDarwinArm64eUnwindRow OuterRow = {true,
                                            sizeof(Frames->Outer),
                                            true,
                                            true,
                                            -(ptrdiff_t)sizeof(Frames->Outer),
                                            -(ptrdiff_t)sizeof(uintptr_t),
                                            NDArm64eSignedIBWithCFA,
                                            0};
  for (unsigned FromFP = 0; FromFP != 2; ++FromFP) {
    Row.CFAFromFP = FromFP != 0;
    Row.CFAOffset = (intptr_t)Value.CFA - (intptr_t)(FromFP ? FP : SP);
    NDDarwinArm64eCursor Cursor = Input;
    check(Result, step(Result, &Cursor, Row, Low, High, Explicit));
    check(Result, Cursor.PC == PC && Cursor.SP == Value.CFA &&
                      Cursor.FP == (uintptr_t)Frames->Outer && !Cursor.LR);
    check(Result, step(Result, &Cursor, OuterRow, Low, High, Explicit));
    check(Result, Cursor.PC == OuterPC && Cursor.SP == OuterCFA &&
                      Cursor.FP == Low && !Cursor.LR);
  }
  if (Value.LR != PC) {
    NDDarwinArm64eCursor Cursor = Input;
    Cursor.LR = Value.LR;
    Frames->Inner[1] = PC;
    check(Result, !step(Result, &Cursor, Row, Low, High, Explicit));
  }
}

static void checkRecipes(CursorResults *Result, bool Explicit, uintptr_t Low,
                         uintptr_t High) {
  SavedFrames Frames;
  for (unsigned Key = 0; Key != 2; ++Key) {
    for (unsigned I = 0; I != Samples; ++I) {
      const uintptr_t PC = 0x12340 + I * sizeof(uint32_t);
      Signature Value;
      if (Explicit) {
        if (Key)
          signExplicitIB(PC, &Value);
        else
          signExplicitIA(PC, &Value);
      } else if (Key) {
        signPACMIB(PC, &Value);
      } else {
        signPACMIA(PC, &Value);
      }
      const NDDarwinArm64eSigning Kind =
          Explicit
              ? (Key ? NDArm64eSignedIBWithCFAPC : NDArm64eSignedIAWithCFAPC)
              : (Key ? NDArm64eSignedIBWithCFAPACM
                     : NDArm64eSignedIAWithCFAPACM);
      NDDarwinArm64eUnwindRow Row = {false, 0, false, false,
                                     0,     0, Kind,  Value.PC};
      const NDDarwinArm64eCursor Input = {Value.PC, Value.CFA, Low, Value.LR};
      NDDarwinArm64eCursor Cursor = Input;
      check(Result, step(Result, &Cursor, Row, Low, High, Explicit));
      check(Result, Cursor.PC == PC && Cursor.SP == Value.CFA &&
                        Cursor.FP == Low && !Cursor.LR);
      checkSpilled(Result, Value, PC, Row, Low, High, Explicit, &Frames);
      // Toggle a PAC bit while preserving the canonical address.
      const uintptr_t PAC = Value.LR ^ PC;
      if (PAC) {
        ++Result->Signed[Key];
        Cursor = Input;
        Cursor.LR ^= PAC & (0 - PAC);
        check(Result, !step(Result, &Cursor, Row, Low, High, Explicit));
      }
      // PAC collisions are legal. Record sensitivity across independent inputs
      // instead of requiring every pair of signatures to differ.
      Cursor = Input;
      Row.CFAOffset = -(ptrdiff_t)sizeof(Frames.Inner);
      check(Result,
            Value.CFA >= Low && Value.CFA - Low >= sizeof(Frames.Inner));
      Result->CFARejected[Key] +=
          !step(Result, &Cursor, Row, Low, High, Explicit);
      Cursor = Input;
      Row.CFAOffset = 0;
      Row.SigningPC = 0; // A valid modifier, never an "unknown PC" sentinel.
      Result->PCRejected[Key] +=
          !step(Result, &Cursor, Row, Low, High, Explicit);
      Cursor = Input;
      Row.SigningPC = Value.PC;
      Row.Signing = Explicit ? (Key ? NDArm64eSignedIAWithCFAPC
                                    : NDArm64eSignedIBWithCFAPC)
                             : (Key ? NDArm64eSignedIAWithCFAPACM
                                    : NDArm64eSignedIBWithCFAPACM);
      Result->KeyRejected[Key] +=
          !step(Result, &Cursor, Row, Low, High, Explicit);
      Cursor = Input;
      Row.Signing = Key ? NDArm64eSignedIBWithCFA : NDArm64eSignedIAWithCFA;
      Result->RecipeRejected[Key] +=
          !step(Result, &Cursor, Row, Low, High, Explicit);
      // A zero signing address must also succeed when it really signed LR.
      if (Explicit) {
        if (Key)
          signZeroExplicitIB(PC, &Value);
        else
          signZeroExplicitIA(PC, &Value);
      } else if (Key) {
        signZeroPACMIB(PC, &Value);
      } else {
        signZeroPACMIA(PC, &Value);
      }
      check(Result, Value.PC == 0);
      Row.Signing = Kind;
      Row.SigningPC = Value.PC;
      Cursor = (NDDarwinArm64eCursor){Value.PC, Value.CFA, Low, Value.LR};
      check(Result, step(Result, &Cursor, Row, Low, High, Explicit));
      check(Result, Cursor.PC == PC && Cursor.SP == Value.CFA && !Cursor.LR);
      checkSpilled(Result, Value, PC, Row, Low, High, Explicit, &Frames);
    }
    check(Result, Result->Signed[Key] && Result->CFARejected[Key] &&
                      Result->KeyRejected[Key]);
    if (Explicit)
      check(Result, Result->PCRejected[Key] && Result->RecipeRejected[Key]);
  }
}
