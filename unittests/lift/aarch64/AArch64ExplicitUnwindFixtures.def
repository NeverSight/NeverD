ASYNC_FRAME_TEXT(kSigningModelBegin, R"asm(
.text
.globl _main
.p2align 2
_main:
 stp x29, x30, [sp, #-112]!
 stp x19, x20, [sp, #16]
 mov x29, sp
 add x20, sp, #40
.macro run_body
 str xzr, [x20]
 .if $4
  .irp offset, 8, 16, 24, 32, 40, 48
   str xzr, [x20, #\offset]
  .endr
 .endif
 mov x0, x20
 mov x1, #$1
 .ifnb $5
  .if $5
   stp xzr, xzr, [x20, #8]
   .irp n, 10, 11, 12, 13, 14, 15, 16, 17
    mov x\n, #\n
   .endr
   add x2, x20, #56
   str xzr, [x2, #8]
   cmp xzr, xzr
  .endif
 .endif
 bl Lbody$0
 .ifnb $5
  .if $5
   b.ne Lfailed
   cmp sp, x29
   b.ne Lfailed
   .if $6
    ldr x9, [x2, #8]
    cmp x9, #1
    b.ne Lfailed
    .irp offset, 8, 16
     ldr x9, [x20, #\offset]
     cmp x9, x19
     b.ne Lfailed
    .endr
   .endif
   ldr x9, [x2]
   .if $3
    eor x9, x9, x19
    cmp x9, #15
    b.ne Lfailed
   .else
    cbnz x9, Lfailed
   .endif
   .irp n, 10, 11, 12, 13, 14, 16, 17
    cmp x\n, #\n
    b.ne Lfailed
   .endr
   .if $3
    cmp x15, x19
   .else
    cmp x15, #15
   .endif
   b.ne Lfailed
  .endif
 .endif
 .if $2
  cmp x0, x19
 .else
  cmp x0, x20
 .endif
 b.ne Lfailed
 ldr x9, [x20]
 .if $3
  cmp x9, x19
  b.ne Lfailed
 .else
  cbnz x9, Lfailed
 .endif
 .if $4
  .irp offset, 8, 16, 24, 32, 40, 48
   ldr x9, [x20, #\offset]
   cmp x9, x19
   b.ne Lfailed
  .endr
 .endif
.endm
.macro check_body
 adr x19, Lbody$0
 ldr x9, =$1
 add x19, x19, x9
 run_body $0, 0, $4, $5, $6
 .if $7
  mov x19, x20
 .endif
 run_body $0, 1, $2, $3, $6
.endm
)asm")
ASYNC_FRAME_TEXT(kSigningModelEnd, R"asm(
 mov w0, #0
 b Ldone
Lfailed:
 mov w0, #1
Ldone:
 ldp x19, x20, [sp, #16]
 ldp x29, x30, [sp], #112
 ret
 .ltorg
)asm")
