ASYNC_FRAME_TEXT(kJoinModelCall, R"asm(
 adr x19, Lbody{0}
 ldr x9, ={1}
 add x19, x19, x9
 run_body {0}, 0, {3}, {4}, 0, {5}, {6}
 adr x19, Lbody{0}
 ldr x9, ={2}
 add x19, x19, x9
 run_body {0}, 1, {3}, {4}, 0, {5}, {6}
)asm")
ASYNC_FRAME_TEXT(kJoinedSigningBody, R"asm(
 .text
 .globl _signal_tick
 .p2align 2
_signal_tick:
 .cfi_startproc
 nop
#ifdef NEVERD_JOIN_PRESSURE_CONFLICT
#define NEVERD_JOIN_CROSSED
#define NEVERD_JOIN_PRESSURE_STORE
#endif
#ifdef NEVERD_JOIN_PRESSURE_SCOPE
#define NEVERD_JOIN_PRESSURE_PREFIX
#endif
#ifdef NEVERD_JOIN_PRESSURE_PREFIX
#define NEVERD_JOIN_PRESSURE_STORE
#endif
#ifdef NEVERD_JOIN_PRESSURE_RETURN
#define NEVERD_JOIN_RETURN
#endif
#if defined(NEVERD_JOIN_PRESSURE_RETURN) || defined(NEVERD_JOIN_PRESSURE_STORE)
.macro live_inputs
 mov x9, xzr
 .irp reg, x10, x11, x12, x13, x14, x15, x16, x17
  eor x9, x9, \reg
 .endr
 str x9, [x2]
.endm
#else
.macro live_inputs
.endm
#endif
#ifdef NEVERD_SIGN_WITH_B
#define SIGN .inst 0xdac1a7fe
#define OTHER_SIGN .inst 0xdac1a3fe
#else
#define SIGN .inst 0xdac1a3fe
#define OTHER_SIGN .inst 0xdac1a7fe
#endif
#ifdef NEVERD_JOIN_SCRATCH
 .irp r, x10, x11, x12, x13, x14, x15, x16, x17
  mov \r, xzr
 .endr
#endif
#ifdef NEVERD_JOIN_COMMON
Lfirst:
 SIGN
#endif
 cbnz x1, Lright
#ifndef NEVERD_JOIN_COMMON
Lfirst:
 SIGN
#endif
#ifdef NEVERD_JOIN_RETURN
 adr x0, Lfirst
#elif defined(NEVERD_JOIN_SWAPPED)
 adr x15, Lsecond
#else
 adr x15, Lfirst
#endif
 live_inputs
#ifdef NEVERD_JOIN_PRESSURE_PREFIX
 adr x9, Lfirst
 str x9, [x0, #16]
#endif
 b Lauth
Lright:
#ifndef NEVERD_JOIN_COMMON
Lsecond:
#ifdef NEVERD_JOIN_WRONG_KEY
 OTHER_SIGN
#else
 SIGN
#endif
#else
#define Lsecond Lfirst
#endif
#if defined(NEVERD_JOIN_UNKNOWN)
 nop
#elif defined(NEVERD_JOIN_CROSSED) || defined(NEVERD_JOIN_SWAPPED)
 adr x15, Lfirst
#elif defined(NEVERD_JOIN_COPY_PAGE)
 adrp x10, Lsecond@PAGE
 add x10, x10, Lsecond@PAGEOFF
 mov x15, x10
#elif defined(NEVERD_JOIN_RETURN)
 adr x0, Lsecond
#else
 adr x15, Lsecond
#endif
#ifdef NEVERD_JOIN_CLOBBER
 mov w15, w2
#endif
#ifdef NEVERD_JOIN_SCRATCH
 mov x16, xzr
#endif
 live_inputs
#ifdef NEVERD_JOIN_PRESSURE_PREFIX
 adr x9, Lsecond
 str x9, [x0, #16]
#endif
Lauth:
#ifdef NEVERD_JOIN_OVERWRITE
 adr x15, Lfirst
#endif
 .cfi_same_value x19
 .cfi_escape 0x2e, 0
#ifdef NEVERD_JOIN_PRESSURE_PREFIX
 ldr x9, [x2, #8]
#ifdef NEVERD_JOIN_PRESSURE_SCOPE
 .cfi_restore x19
#endif
 add x9, x9, #1
 str x9, [x2, #8]
 str x15, [x0, #8]
#endif
#ifdef NEVERD_JOIN_RETURN
#ifdef NEVERD_SIGN_WITH_B
 .inst 0xd65f0fe0
#else
 .inst 0xd65f0be0
#endif
#else
#ifdef NEVERD_SIGN_WITH_B
 .inst 0xdac195fe
#else
 .inst 0xdac191fe
#endif
 .cfi_restore x19
#ifndef NEVERD_JOIN_LOCAL
 str x15, [x0]
 mov x0, x15
#endif
 ret
#endif
 .cfi_endproc
)asm")
ASYNC_FRAME_TEXT(kSigningAddressBody, R"asm(
 .text
 .globl _signal_tick
 .p2align 2
_signal_tick:
 .cfi_startproc
#ifdef NEVERD_LIVE_SIGNING_FALLTHROUGH
 .cfi_personality 155, ___gxx_personality_v0
 .cfi_lsda 16, Lmodifier_lsda
#endif
#if defined(NEVERD_FORWARD_STORE) || defined(NEVERD_FORWARD_RETURN)
 b Lsign
Lmaterialize:
#ifdef NEVERD_FORWARD_STORE
 mov x16, x0
#ifdef NEVERD_ALL_SIGNING_SCRATCH_LIVE
 add x17, x0, #8
 add x10, x0, #16
 add x11, x0, #24
 add x12, x0, #32
 add x13, x0, #40
 add x14, x0, #48
#elif defined(NEVERD_ORIGINAL_IP_PAIR_LIVE)
 mov x17, x0
#endif
#ifdef NEVERD_LIVE_SIGNING_PAGE
 adrp x15, Lsign@PAGE
 add x15, x15, Lsign@PAGEOFF
#else
 adr x15, Lsign
#endif
#ifdef NEVERD_LIVE_MODIFIER_COPY
 str x15, [x16]
 mov x0, x15
#endif
#if defined(NEVERD_ORIGINAL_IP_PAIR_LIVE) || defined(NEVERD_ALL_SIGNING_SCRATCH_LIVE)
 .cfi_same_value x19
 .cfi_escape 0x2e, 0
#endif
#if defined(NEVERD_LIVE_MODIFIER_COPY) && defined(NEVERD_SIGN_WITH_B)
 .inst 0xdac1941e // autibsppc x0
#elif defined(NEVERD_LIVE_MODIFIER_COPY)
 .inst 0xdac1901e // autiasppc x0
#elif defined(NEVERD_SIGN_WITH_B)
 .inst 0xdac195fe // autibsppc x15
#else
 .inst 0xdac191fe // autiasppc x15
#endif
LcheckedAfter:
#ifdef NEVERD_ALL_SIGNING_SCRATCH_LIVE
 .cfi_restore x19
#endif
#ifdef NEVERD_LIVE_SIGNING_FALLTHROUGH
 cbz x1, Lvalues
 mov x1, #0
 mov x15, x0
 b LcheckedAfter
Lvalues:
#endif
#ifdef NEVERD_LIVE_MODIFIER_COPY
 str x0, [x16]
#else
 str x15, [x16]
#endif
#if defined(NEVERD_ORIGINAL_IP_PAIR_LIVE) || defined(NEVERD_ALL_SIGNING_SCRATCH_LIVE)
 str x15, [x17]
#endif
#ifdef NEVERD_ALL_SIGNING_SCRATCH_LIVE
 .irp reg, x10, x11, x12, x13, x14
 str x15, [\reg]
 .endr
#endif
 mov x0, x15
 ret
#else
 adr x0, Lsign
#ifdef NEVERD_SIGNING_RETURN_ALIASES
 .irp reg, x16, x17, x10, x11, x12, x13, x14, x15
 mov \reg, x0
 .endr
#endif
#ifdef NEVERD_SIGN_WITH_B
 .inst 0xd65f0fe0 // retabsppc x0
#else
 .inst 0xd65f0be0 // retaasppc x0
#endif
#endif
Lsign:
#ifdef NEVERD_SIGN_WITH_B
 .inst 0xdac1a7fe // pacibsppc
#else
 .inst 0xdac1a3fe // paciasppc
#endif
 b Lmaterialize
#else
#ifdef NEVERD_SIGN_WITH_B
 nop
#endif
Lsign:
#ifdef NEVERD_SIGN_WITH_B
 .inst 0xdac1a7fe // pacibsppc
#else
 .inst 0xdac1a3fe // paciasppc
#endif
#ifdef NEVERD_AUTHENTICATED_RETURN
 adr x0, Lsign
#ifdef NEVERD_SIGN_WITH_B
 .inst 0xd65f0fe0 // retabsppc x0
#else
 .inst 0xd65f0be0 // retaasppc x0
#endif
#else
#ifdef NEVERD_OTHER_MODIFIER_ENTRY
 cbnz x2, Lauth
#endif
#ifdef NEVERD_SIGNING_PAGE_PAIR
 adrp x15, Lsign@PAGE
 add x15, x15, Lsign@PAGEOFF
#else
 adr x15, Lsign
#endif
#ifdef NEVERD_STORE_AND_COPY_BEFORE_AUTH
 str x15, [x0]
 mov x0, x15
#endif
Lauth:
#if defined(NEVERD_SIGN_WITH_B) && defined(NEVERD_STORE_AND_COPY_BEFORE_AUTH)
 .inst 0xdac1941e // autibsppc x0
#elif defined(NEVERD_STORE_AND_COPY_BEFORE_AUTH)
 .inst 0xdac1901e // autiasppc x0
#elif defined(NEVERD_SIGN_WITH_B)
 .inst 0xdac195fe // autibsppc x15
#else
 .inst 0xdac191fe // autiasppc x15
#endif
 cbz x1, Lreturn
#if defined(NEVERD_STORE_SIGNING_PAIR)
 stp xzr, x15, [x0, #-8]
#elif defined(NEVERD_STORE_SIGNING_ADDRESS) || defined(NEVERD_RETURN_AND_STORE)
 str x15, [x0]
#endif
#if defined(NEVERD_RETURN_SIGNING_ADDRESS) || defined(NEVERD_RETURN_AND_STORE)
