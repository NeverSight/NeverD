ASYNC_FRAME_TEXT(kSigningModelPage, " .balign {0}\n .space {1}\n")
ASYNC_FRAME_TEXT(kSigningModelExport, "NEVERD_ARM64E_SIGNING_ADDRESS_FIXTURES")
ASYNC_FRAME_TEXT(kSigningModelFile, "signing-address.S")
ASYNC_FRAME_TEXT(kSigningModelPath, "signing_address_model_assembly")
