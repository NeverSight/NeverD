__attribute__((noinline)) unsigned compact_inner(unsigned x) {
  __asm__ volatile("" : "+r"(x));
  return x + 1;
}
__attribute__((noinline)) unsigned compact(unsigned x) {
  unsigned y = compact_inner(x);
  __asm__ volatile("" : "+r"(y));
  return y + 1;
}
)c")
ASYNC_FRAME_TEXT(kCompactDriver, R"c(
#include <dlfcn.h>
#include <limits.h>
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image) return 2;
  typedef unsigned (*call)(unsigned);
  call parent = (call)dlsym(image, "compact");
  const unsigned inputs[] = {0, 11, UINT_MAX};
  if (!parent) return 3;
  for (unsigned i = 0; i < sizeof(inputs) / sizeof(inputs[0]); ++i)
    if (parent(inputs[i]) != inputs[i] + 2) return 4;
  return dlclose(image);
}
)c")
