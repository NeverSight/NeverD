ASYNC_FRAME_TEXT(kCatchBody, R"cpp(
#include <cstdint>
#ifndef RETURN_ADJUSTMENT
#define RETURN_ADJUSTMENT 0
#endif
extern "C" void source_throw(int);
extern "C" int observe_catch(int);
extern "C" __attribute__((noinline)) int catcher(int x) {
#ifdef NEVERD_TEST_STACK_ARGS
  uintptr_t Base;
  asm volatile("mov %0, sp" : "=r"(Base));
#elif defined(NEVERD_TEST_DWARF_CATCH)
  asm volatile(".cfi_escape 0x2e, 0");
#endif
  try {
#ifdef NEVERD_TEST_STACK_ARGS
    asm volatile("sub sp, sp, #16\n.cfi_escape 0x2e, 16" ::: "memory");
#endif
    source_throw(x);
#ifdef NEVERD_TEST_STACK_ARGS
    asm volatile("add sp, sp, #16\n.cfi_escape 0x2e, 0" ::: "memory");
#endif
    return x + RETURN_ADJUSTMENT;
  } catch (int v) {
#ifdef NEVERD_TEST_STACK_ARGS
    uintptr_t Seen;
    asm volatile("mov %0, sp" : "=r"(Seen));
    if (Seen != Base)
      return -1;
#endif
    return observe_catch(v) + RETURN_ADJUSTMENT;
  }
}
)cpp")
ASYNC_FRAME_TEXT(kCatchProvider, R"cpp(
extern "C" void source_throw(int x) {
  switch (x) {
  case 1: throw 7;
  case 2: throw 13L;
  case 3: throw 11;
  }
}
extern "C" int observe_catch(int v) {
  if (v == 11)
    throw 17L;
  return v + 1;
}
)cpp")
ASYNC_FRAME_TEXT(kCatchDriver, R"cpp(
#include <dlfcn.h>
#include <exception>
#include <initializer_list>
int main(int argc, char **argv) {
  if (argc != 2 && argc != 3)
    return 1;
  auto *Image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!Image)
    return 1;
  auto catcher = reinterpret_cast<int (*)(int)>(dlsym(Image, "catcher"));
  const int Adjustment = argc == 3;
  if (!catcher || catcher(0) != Adjustment || catcher(1) != 8 + Adjustment)
    return 1;
  for (int x : {2, 3}) {
    try {
      catcher(x);
      return 2;
    } catch (long v) {
      if (v != (x == 2 ? 13L : 17L))
        return 3;
    }
    if (std::current_exception())
      return 4;
  }
  return dlclose(Image);
}
)cpp")
ASYNC_FRAME_TEXT(kAssembly, R"asm(
.text
.p2align 2
.globl _stages
_stages:
.cfi_startproc
#ifdef NEVERD_TEST_EXPLICIT_RA
.cfi_b_key_frame
#endif
.cfi_escape 0x2e, 0
.macro stage n
  mov w2, #\n
  stlr w2, [x0]
  add x3, x0, #4
1:ldar w4, [x3]
  cmp w4, w2
  b.ne 1b
.endm
  stage 1
  pacibsp
#ifdef NEVERD_TEST_EXPLICIT_RA
.cfi_negate_ra_state
#endif
  stage 2
  sub sp, sp, #16
.cfi_def_cfa_offset 16
  stp x19, x30, [sp]
.cfi_offset 19, -16
.cfi_offset 30, -8
  mov x19, xzr
  stage 3
  ldp x19, x30, [sp]
.cfi_restore 19
.cfi_restore 30
  add sp, sp, #16
.cfi_def_cfa_offset 0
  stage 4
  autibsp
#ifdef NEVERD_TEST_EXPLICIT_RA
.cfi_negate_ra_state
#endif
  stage 5
  ret
.cfi_endproc
.subsections_via_symbols
)asm")
