//===- AArch64SignalCursorNative.def - Native cursor oracle ------*- C -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Compile as C. Independent SP/PC signing instructions exercise the public
/// cursor; unsupported explicit instructions are probed before the test matrix.
///
//===----------------------------------------------------------------------===//

#include "AArch64SignalCursorOracle.def"

#include <pthread.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

enum { Unavailable = 2 };

static void unavailable(int Signal) {
  (void)Signal;
  _Exit(Unavailable);
}

int main(int Argc, char **Argv) {
  if (Argc != 2 || (strcmp(Argv[1], "pacm") && strcmp(Argv[1], "explicit")))
    return EXIT_FAILURE;
  puts("cursor-started");
  fflush(stdout);
  const bool Explicit = !strcmp(Argv[1], "explicit");
  if (Explicit) {
    signal(SIGILL, unavailable);
    Signature Probe;
    signExplicitIA(0x12340, &Probe);
    signExplicitIB(0x12340, &Probe);
    signal(SIGILL, SIG_DFL);
  }
  const uintptr_t High = (uintptr_t)pthread_get_stackaddr_np(pthread_self());
  const uintptr_t Low = High - pthread_get_stacksize_np(pthread_self());
  CursorResults Result = {.Checks = 0};
  checkStackRows(&Result);
  checkRecipes(&Result, Explicit, Low, High);
  if (Result.FirstFailure) {
    fprintf(stderr, "failed cursor check %u\n", Result.FirstFailure);
    return EXIT_FAILURE;
  }
  printf("{\"checks\":%u,\"signed\":[%u,%u],\"pc_rejected\":[%u,%u],"
         "\"key_rejected\":[%u,%u],\"recipe_rejected\":[%u,%u]}\n",
         Result.Checks, Result.Signed[0], Result.Signed[1],
         Result.PCRejected[0], Result.PCRejected[1], Result.KeyRejected[0],
         Result.KeyRejected[1], Result.RecipeRejected[0],
         Result.RecipeRejected[1]);
  return EXIT_SUCCESS;
}
