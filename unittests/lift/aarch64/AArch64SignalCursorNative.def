//===- AArch64SignalCursorNative.def - Native cursor oracle ------*- C -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Compile as C. Independent SP/PC signing instructions exercise the public
/// cursor; unsupported explicit instructions are probed before the test matrix.
///
//===----------------------------------------------------------------------===//

#include "AArch64SignalCursorOracle.def"

#include <pthread.h>
#include <setjmp.h>
#include <signal.h>
#include <stdatomic.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

enum { Unavailable = 2 };

extern const uint32_t signExplicitIASite, signExplicitIBSite;
static sigjmp_buf Recovery;
static _Atomic(uintptr_t) ExpectedPC;

static void illegalInstruction(int Number, siginfo_t *Info, void *Context) {
  (void)Info;
  const mcontext_t MC = ((ucontext_t *)Context)->uc_mcontext;
  if (Number != SIGILL ||
      arm_thread_state64_get_pc(MC->__ss) !=
          atomic_load_explicit(&ExpectedPC, memory_order_relaxed))
    _Exit(EXIT_FAILURE);
  siglongjmp(Recovery, 1);
}

static bool canSign(void (*Sign)(uintptr_t, Signature *),
                    const uint32_t *Site) {
  Signature Probe;
  atomic_store_explicit(&ExpectedPC, (uintptr_t)Site, memory_order_relaxed);
  if (sigsetjmp(Recovery, 1))
    return false;
  Sign(0x12340, &Probe);
  return true;
}

static int probeExplicit(void) {
  struct sigaction Action = {.sa_flags = SA_SIGINFO}, Previous;
  Action.sa_sigaction = illegalInstruction;
  sigemptyset(&Action.sa_mask);
  if (sigaction(SIGILL, &Action, &Previous))
    return EXIT_FAILURE;
  const bool IA = canSign(signExplicitIA, &signExplicitIASite);
  const bool IB = canSign(signExplicitIB, &signExplicitIBSite);
  if (sigaction(SIGILL, &Previous, NULL) || IA != IB)
    return EXIT_FAILURE;
  return IA ? EXIT_SUCCESS : Unavailable;
}

int main(int Argc, char **Argv) {
  if (Argc != 2 || (strcmp(Argv[1], "pacm") && strcmp(Argv[1], "explicit")))
    return EXIT_FAILURE;
  puts("cursor-started");
  fflush(stdout);
  const bool Explicit = !strcmp(Argv[1], "explicit");
  if (Explicit) {
    const int Status = probeExplicit();
    if (Status != EXIT_SUCCESS)
      return Status;
  }
  const uintptr_t High = (uintptr_t)pthread_get_stackaddr_np(pthread_self());
  const uintptr_t Low = High - pthread_get_stacksize_np(pthread_self());
  CursorResults Result = {.Checks = 0};
  checkStackRows(&Result);
  checkRecipes(&Result, Explicit, Low, High);
  if (Result.FirstFailure) {
    fprintf(stderr, "failed cursor check %u\n", Result.FirstFailure);
    return EXIT_FAILURE;
  }
  printf("{\"checks\":%u,\"completed\":[%u,%u],\"signed\":[%u,%u],"
         "\"cfa_rejected\":[%u,%u],"
         "\"pc_rejected\":[%u,%u],\"key_rejected\":[%u,%u],\"recipe_rejected\":"
         "[%u,%u]}\n",
         Result.Checks, Result.Completed[0], Result.Completed[1],
         Result.Signed[0], Result.Signed[1], Result.CFARejected[0],
         Result.CFARejected[1], Result.PCRejected[0], Result.PCRejected[1],
         Result.KeyRejected[0], Result.KeyRejected[1], Result.RecipeRejected[0],
         Result.RecipeRejected[1]);
  return EXIT_SUCCESS;
}
