#ifdef STRUCTURE_MEMORY_TEXT
STRUCTURE_MEMORY_TEXT(kStructureTestBatchName, "Batch{0}")
STRUCTURE_MEMORY_TEXT(kStructureTestName, "structure_memory_{0}")
STRUCTURE_MEMORY_TEXT(kStructureTestNativeName, "native_structure_{0}")
STRUCTURE_MEMORY_TEXT(kStructureTestArtifactEnvironment,
                      "NEVERD_ARM64E_STRUCTURE_MEMORY_ARTIFACT_DIR")
STRUCTURE_MEMORY_TEXT(kStructureTestArtifactProperty,
                      "structure_memory_artifact_dir")
STRUCTURE_MEMORY_TEXT(kStructureTestImageArtifactProperty,
                      "structure_memory_image_artifact_dir")
STRUCTURE_MEMORY_TEXT(kStructureTestBatchDirectory, "/batch-{0}")
STRUCTURE_MEMORY_TEXT(kStructureTestImageDirectory, "/image")
STRUCTURE_MEMORY_TEXT(kStructureTestNativeClobbers, "memory")
STRUCTURE_MEMORY_TEXT(
    kStructureTestPrefix,
    "#include <stdint.h>\n#include <string.h>\n"
    "static int structure_compare(const unsigned char *a, const unsigned char "
    "*b, unsigned count) { for (unsigned i = 0; i < count; ++i) if (a[i] != "
    "b[i]) return 1; return 0; }\n")
STRUCTURE_MEMORY_TEXT(kStructureTestNativeCall,
                      "native_structure_{0}((uint64_t)(b + 80 + (t & 1)), "
                      "(uint64_t)input, (uint64_t)expected, delta)")
STRUCTURE_MEMORY_TEXT(kStructureTestCall, "structure_memory_{0}({1})")
STRUCTURE_MEMORY_TEXT(kStructureTestBaseArgument,
                      "(uint64_t)(a + 80 + (t & 1))")
STRUCTURE_MEMORY_TEXT(kStructureTestIndexArgument, ", delta")
STRUCTURE_MEMORY_TEXT(kStructureTestDataArgument, ", (uint64_t)input")
STRUCTURE_MEMORY_TEXT(kStructureTestOutputArgument, ", (uint64_t)actual")
STRUCTURE_MEMORY_TEXT(kStructureTestDeclaration, "uint64_t {0}(uint64_t{1});\n")
STRUCTURE_MEMORY_TEXT(kStructureTestParameterType, ", uint64_t")
STRUCTURE_MEMORY_TEXT(kStructureTestEntry, "run_{0},\n")
STRUCTURE_MEMORY_TEXT(
    kStructureTestMain,
    "static int (*structure_cases[])(void) = {{{0}}; int main(void) {{ for "
    "(unsigned i = 0; i < sizeof(structure_cases) / "
    "sizeof(structure_cases[0]); ++i) if (structure_cases[i]()) return i + 1; "
    "return 0; }\n")
STRUCTURE_MEMORY_TEXT(
    kStructureTestReplay,
    "static int run_{0}(void) {{ unsigned char input[64]; "
    "for (unsigned i = 0; i < 64; ++i) input[i] = (unsigned char)(i * 37 + "
    "19); "
    "for (unsigned t = 0; t < 3; ++t) {{ "
    "_Alignas(16) unsigned char a[256], b[256], actual[64], expected[64]; "
    "for (unsigned i = 0; i < 256; ++i) a[i] = b[i] = (unsigned char)(i * 19 + "
    "37); "
    "memset(actual, 0xa5, 64); memset(expected, 0xa5, 64); "
    "uint64_t delta = t == 0 ? 17 : t == 1 ? (uint64_t)-17 : 0; "
    "uint64_t wanted = {1}; uint64_t got = {2}; "
    "if (got - (uint64_t)a != wanted - (uint64_t)b || "
    "structure_compare(a, b, 256) || structure_compare(actual, expected, 64)) "
    "return 1; "
    "} return 0; }\n")
STRUCTURE_MEMORY_TEXT(
    kStructureTestNativeFunction,
    "static uint64_t native_structure_{0}(uint64_t base, uint64_t input, "
    "uint64_t output, uint64_t delta) {{ "
    "typedef int64_t Vec __attribute__((vector_size(16))); "
    "Vec values[4]; memcpy(values, (const void *)input, 64); "
    "register Vec a __asm__(\"v29\") = values[0]; "
    "register Vec b __asm__(\"v30\") = values[1]; "
    "register Vec c __asm__(\"v31\") = values[2]; "
    "register Vec d __asm__(\"v0\") = values[3]; "
    "register uint64_t x __asm__(\"x9\") = base; "
    "register uint64_t y __asm__(\"x10\") = delta; "
    "__asm__ volatile(\"{3}.inst %c6{4}\" : \"+w\"(a), \"+w\"(b), \"+w\"(c), "
    "\"+w\"(d), \"+r\"(x) : \"r\"(y), \"i\"({1}) : {5}\"memory\"); "
    "values[0] = a; values[1] = b; values[2] = c; values[3] = d; "
    "{2} return x; }\n")
STRUCTURE_MEMORY_TEXT(kStructureTestCopyOutputs,
                      "memcpy((void *)output, values, {0});")
#undef STRUCTURE_MEMORY_TEXT
#endif
