#ifndef CALL_ABI_VALUE
#define CALL_ABI_VALUE(Type, Name, Value)
#endif
#ifndef CALL_ABI_TEXT
#define CALL_ABI_TEXT(Name, Text)
#endif

CALL_ABI_VALUE(unsigned, kCallABIDoubleBits, 64)
CALL_ABI_VALUE(unsigned, kCallABIFPParameter, 1)
CALL_ABI_VALUE(unsigned, kCallABIParameters, 2)
CALL_ABI_VALUE(unsigned, kCallABICallbackParameters, 1)
CALL_ABI_VALUE(unsigned, kDarwinVaFixedParameters, 2)
CALL_ABI_VALUE(unsigned, kDarwinVaCallArguments, 3)
CALL_ABI_TEXT(kDarwinVaWrapper, "forward_va_list_with_context")
CALL_ABI_TEXT(kDarwinVaCaller, "call_forward_va_list_with_context")
CALL_ABI_TEXT(kDarwinArm64CallAbiImage, "test_call_abi_a64_macho")
CALL_ABI_TEXT(kDarwinArm64eCallAbiImage, "test_call_abi_a64_macho_arm64e")
CALL_ABI_TEXT(kDarwinMachOFixtureUnavailable,
              "AArch64 Mach-O ABI fixture is only built on Apple hosts")
CALL_ABI_TEXT(kCallABIIndirectDouble, "indirect_double_call")
CALL_ABI_TEXT(kCallABIVectorCall, "call <2 x i64> %")
CALL_ABI_TEXT(kCallABIVectorArgument, "(<2 x i64>")
CALL_ABI_TEXT(kCallABIPointerArgument, "i64 %arg0")
CALL_ABI_TEXT(kCallABIScalarReturn, "ret double ")
CALL_ABI_TEXT(kCallABIModuleStart, "; ModuleID")

#undef CALL_ABI_TEXT
#undef CALL_ABI_VALUE
