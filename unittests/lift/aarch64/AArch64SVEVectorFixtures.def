                          "(uint8_t)((uint32_t)(5))")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kImmediateByteStepC,
                          "(uint8_t)((uint32_t)(0))")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kImmediateWideStartC,
                          "(uint64_t)((uint32_t)(7))")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kImmediateWideStepC,
