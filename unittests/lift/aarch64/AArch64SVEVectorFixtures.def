//===- AArch64SVEVectorFixtures.def - Independent Z oracles ---*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Raw INDEX/LASTB words from LLVM llvmorg-22.1.6 test/MC/AArch64/SVE.
/// The cross-width case INDEX.D #7,#3; PTRUE.B VL2; LASTB.B reads byte 1
/// (zero), not the second 64-bit lane (10). Runtime execution is a separate
/// SVE hardware/emulator requirement; these checks compile the real paths.
//===----------------------------------------------------------------------===//
#ifndef NEVERD_SVE_VECTOR_FIXTURE
#define NEVERD_SVE_VECTOR_FIXTURE(Type, Name, Value)
#endif
#ifndef NEVERD_SVE_VECTOR_WIDTH
#define NEVERD_SVE_VECTOR_WIDTH(Bytes)
#endif
#ifndef NEVERD_SVE_VECTOR_RAW
#define NEVERD_SVE_VECTOR_RAW(Word, Id, Element)
#endif

NEVERD_SVE_VECTOR_FIXTURE(const char *, kFunction, "sve_vector_carrier")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kTriple, "aarch64-unknown-linux-gnu")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kNameFormat, "sve_vector_{0}_{1}_{2}")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kValueNameFormat, "value_{0}")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kCanonicalC, "svuint8_t")
