                          "SVE state requires a complete local definition")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kLLVMDefinition, "define ")
// Independent raw PTRUE.B/LASTB.B/RET sequence with no Z0 producer.
NEVERD_SVE_VECTOR_FIXTURE(
    const char *, kUnknownStateAssembly,
    ".text\n.globl unknown_{0}\n.type unknown_{0},%function\nunknown_{0}:\n"
    ".inst 0x2518e3e0\n.inst 0x0521a000\n.inst 0xd65f03c0\n"
    ".size unknown_{0},.-unknown_{0}\n")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kSignedStateSource, "signed-sve.s")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kSignedStateObject, "signed-sve.o")
// PACIASP; PTRUE.B ALL; DUP Z0.B,#1; LASTB W0,P0,Z0.B; RETAA.
NEVERD_SVE_VECTOR_FIXTURE(
    const char *, kSignedStateAssembly,
    ".text\n.globl signed_sve_leaf\n.type signed_sve_leaf,%function\n"
    "signed_sve_leaf:\n.inst 0xd503233f\n.inst 0x2518e3e0\n"
    ".inst 0x2538c020\n.inst 0x0521a000\n.inst 0xd65f0bff\n"
    ".size signed_sve_leaf,.-signed_sve_leaf\n")
// The same leaf returning with RETAB: no proved recipe, explicit operations.
NEVERD_SVE_VECTOR_FIXTURE(
    const char *, kUnprovedSignedStateAssembly,
    ".text\n.globl signed_sve_leaf\n.type signed_sve_leaf,%function\n"
    "signed_sve_leaf:\n.inst 0xd503233f\n.inst 0x2518e3e0\n"
    ".inst 0x2538c020\n.inst 0x0521a000\n.inst 0xd65f0fff\n"
    ".size signed_sve_leaf,.-signed_sve_leaf\n")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kSignedStatePacia, "pacia ")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kSignedStateAuthenticate,
                          "@llvm.ptrauth.auth(")
NEVERD_SVE_VECTOR_FIXTURE(const char *, kSignedStateTargetUse,
                          "neverd authenticated target")
NEVERD_SVE_VECTOR_FIXTURE(unsigned, kPAuthResultId, 13)
NEVERD_SVE_VECTOR_FIXTURE(uint32_t, kAddressMemoryWord, 0xf8626820)
NEVERD_SVE_VECTOR_FIXTURE(unsigned, kAddressMemoryIdFixtureBytes, 2)
NEVERD_SVE_VECTOR_FIXTURE(uint64_t, kPAuthModeEnabled, 1)
