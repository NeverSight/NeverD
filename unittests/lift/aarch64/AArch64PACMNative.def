//===- AArch64PACMNative.def - Independent native prefix oracle -*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Native qualification requires active IA/IB keys and an effective second
/// diversifier. A compatible HINT implementation cannot qualify this test.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_PACM_NATIVE_TEXT
#error "Define NEVERD_PACM_NATIVE_TEXT before including AArch64PACMNative.def"
#endif

NEVERD_PACM_NATIVE_TEXT(kNativeTarget, "arm64e-apple-macos")
NEVERD_PACM_NATIVE_TEXT(kNativeUnavailable,
                        "this host cannot execute PACM with active IA/IB keys "
                        "and a second diversifier")
NEVERD_PACM_NATIVE_TEXT(kHintUnavailable,
                        "this host cannot execute arm64e with active IA/IB "
                        "keys and PACM hint behavior")
NEVERD_PACM_NATIVE_TEXT(kHintMode, "#define RETURN_ORACLE_EXPECTED_MODE 0\n")
NEVERD_PACM_NATIVE_TEXT(kOracle, "pauth_prefix_probe.def")
NEVERD_PACM_NATIVE_TEXT(kProbeMain, R"(
int main(void) { return prefixProbeStatus(RETURN_ORACLE_EXPECTED_MODE); }
)")
NEVERD_PACM_NATIVE_TEXT(kCompareMain, R"(
#define RETURN_ORACLE_PREFIX
#include "pauth_register_oracle.def"

int comparePrefixModes(int Enabled) {
  if (prefixProbeStatus(Enabled))
    return OracleInactive;
  const int Status = compareRegisterAndPC(0, 0);
  return Status ? Status : compareRegisterAndPC(1, Enabled);
}
int main(void) { return comparePrefixModes(RETURN_ORACLE_EXPECTED_MODE); }
)")

#undef NEVERD_PACM_NATIVE_TEXT
