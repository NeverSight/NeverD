A64_RETURN_ABI_VALUE(unsigned, kNativeWordBytes, 4)
A64_RETURN_ABI_VALUE(uint32_t, kReturnSignA, 0xd503233fU)
A64_RETURN_ABI_VALUE(uint32_t, kReturnSignB, 0xd503237fU)
A64_RETURN_ABI_VALUE(uint32_t, kAuthenticatedReturnA, 0xd65f0bffU)
A64_RETURN_ABI_VALUE(uint32_t, kAuthenticatedReturnB, 0xd65f0fffU)
