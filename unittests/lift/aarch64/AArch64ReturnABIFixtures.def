A64_RETURN_ABI_TEXT(kSigningBKey, "b_key")
A64_RETURN_ABI_TEXT(kSourceAKey, "branch-protection=pac-ret+leaf")
A64_RETURN_ABI_TEXT(kSourceBKey, "branch-protection=pac-ret+leaf+b-key")
