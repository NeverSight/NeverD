WRITEBACK_TEXT(
    kWritebackNativeLoad,
    "unsigned __int128 result = {0}(input); if ((uint64_t)result != value || "
    "(uint64_t)(result >> 64) - input != base - origin) return 1;\n")
WRITEBACK_TEXT(kWritebackNativeStore,
               "uint64_t result = {0}(input, 0xfedcba9876543210ULL); if "
