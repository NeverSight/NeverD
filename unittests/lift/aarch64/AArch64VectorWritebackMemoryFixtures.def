#ifdef VECTOR_WRITEBACK_TEXT
VECTOR_WRITEBACK_TEXT(kVectorWritebackNamePrefix, "vector_writeback_")
VECTOR_WRITEBACK_TEXT(kVectorWritebackLoadDeclaration,
                      "uint64_t {0}(uint64_t, uint64_t);\n")
VECTOR_WRITEBACK_TEXT(kVectorWritebackStoreDeclaration,
                      "uint64_t {0}(uint64_t, uint64_t, uint64_t, uint64_t);\n")
VECTOR_WRITEBACK_TEXT(kVectorWritebackLoadCall,
                      "{0}((uintptr_t)(left+512), (uintptr_t)out)")
VECTOR_WRITEBACK_TEXT(kVectorWritebackStoreCall,
                      "{0}((uintptr_t)(left+512), (uint64_t)data, "
                      "(uint64_t)(data>>64), (uintptr_t)out)")
VECTOR_WRITEBACK_TEXT(
    kVectorWritebackHarnessPrelude,
    "#include <stdint.h>\ntypedef unsigned __int128 vwb_bits;\ntypedef int64_t "
    "vwb_vector __attribute__((vector_size(16)));\nunion vwb_representation { "
    "vwb_bits bits; vwb_vector vector; };\nstruct vwb_result { vwb_bits bits; "
    "uint64_t base; };\n")
VECTOR_WRITEBACK_TEXT(
    kVectorWritebackNativeLoad,
    "static struct vwb_result vwb_original_{0}(uint64_t input, vwb_bits data) "
    "{{\n  register vwb_vector value __asm__(\"v21\");\n  register uint64_t "
    "base __asm__(\"x21\") = input;\n  __asm__ volatile(\"{2}.inst {1}{3}\" : "
    "\"=&w\"(value), \"+r\"(base) : : {4}\"memory\");\n  union "
    "vwb_representation "
    "bits = {{ .vector = value };\n  return (struct vwb_result){{ bits.bits, "
    "base };\n}\n")
VECTOR_WRITEBACK_TEXT(
    kVectorWritebackNativeStore,
    "static struct vwb_result vwb_original_{0}(uint64_t input, vwb_bits data) "
    "{{\n  union vwb_representation given = {{ .bits = data };\n  register "
    "vwb_vector value __asm__(\"v21\") = given.vector;\n  register uint64_t "
    "base __asm__(\"x21\") = input;\n  __asm__ volatile(\"{2}.inst {1}{3}\" : "
    "\"+r\"(base) : \"w\"(value) : {4}\"memory\");\n  return (struct "
    "vwb_result){{ data, base };\n}\n")
VECTOR_WRITEBACK_TEXT(
    kVectorWritebackNativeCase,
    "static int vwb_run_{0}(void) {{\n  _Alignas(16) unsigned char left[1024], "
    "right[1024], expected[1024];\n  for (unsigned j=0; j!=1024; ++j) "
    "left[j]=right[j]=expected[j]=(unsigned char)(j*37+19);\n  const vwb_bits "
    "data=((vwb_bits)UINT64_C(0x8172635445362718)<<64)|UINT64_C("
    "0xf1e2d3c4b5a69788);\n  const unsigned at=512+({2} ? {1} : 0);\n  "
    "vwb_bits expected_bits={4} ? 0 : data;\n  if ({4}) {{\n    for (unsigned "
    "j=0; j!={3}; ++j) expected_bits |= (vwb_bits)left[at+j]<<(8*j);\n  } "
    "else {{\n    for (unsigned j=0; j!={3}; ++j) expected[at+j]=(unsigned "
    "char)(data>>(8*j));\n  }\n  const struct vwb_result "
    "native=vwb_original_{0}((uintptr_t)(right+512),data);\n  uint64_t "
    "out[2]={{ UINT64_C(0xbad), UINT64_C(0xbad) };\n  const uint64_t "
    "base={5};\n  const vwb_bits "
    "actual=(vwb_bits)out[0]|((vwb_bits)out[1]<<64);\n  if "
    "(actual!=expected_bits || native.bits!=expected_bits) return 1;\n  if "
    "(base!=(uintptr_t)(left+512+({1})) || "
    "native.base!=(uintptr_t)(right+512+({1}))) return 2;\n  for (unsigned "
    "j=0; j!=1024; ++j) if (left[j]!=expected[j] || right[j]!=expected[j]) "
    "return 3;\n  return 0;\n}\n")
VECTOR_WRITEBACK_TEXT(kVectorWritebackHarnessEntry, "vwb_run_{0},\n")
VECTOR_WRITEBACK_TEXT(
    kVectorWritebackHarnessTail,
    "static int (*const vwb_cases[])(void) = {{ {0} };\nint main(void) {{\n  "
    "for (unsigned i=0; i!=sizeof(vwb_cases)/sizeof(*vwb_cases); ++i)\n    if "
    "(vwb_cases[i]()) return (int)i+1;\n  return 0;\n}\n")
VECTOR_WRITEBACK_TEXT(kVectorWritebackArtifactEnvironment,
                      "NEVERD_ARM64E_VECTOR_WRITEBACK_ARTIFACT_DIR")
VECTOR_WRITEBACK_TEXT(kVectorWritebackArtifactProperty,
                      "arm64e_vector_writeback_memory_artifact_directory")
VECTOR_WRITEBACK_TEXT(kVectorWritebackHiddenFunction, "hidden_vector_writeback")
VECTOR_WRITEBACK_TEXT(kVectorWritebackOwnedHarness,
                      "int main(void) {{ return {0}() != UINT64_C({1}); }\n")
#undef VECTOR_WRITEBACK_TEXT
#endif

