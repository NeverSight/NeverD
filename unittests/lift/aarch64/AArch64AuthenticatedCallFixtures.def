A64_CALL_TEXT(kLegacyPAuthIR, R"IR(
@callback.ptrauth = private constant { ptr, i32, i64, i64 }
  { ptr @callback, i32 0, i64 0, i64 0 }, section "llvm.ptrauth", align 8
declare void @callback()
define ptr @legacy_callback_address() {
  ret ptr @callback.ptrauth
}
)IR")
A64_CALL_TEXT(kUnknownTypedKind, "unknown authenticated call fixture type")
A64_CALL_TEXT(kHVACompilerCase, "hva-clang-darwin")
A64_CALL_VALUE(unsigned, kHVAIndirectParameters, 2)
A64_CALL_TEXT(kHVACompilerSource, R"C(
typedef unsigned char V64 __attribute__((vector_size(8)));
typedef unsigned char V128 __attribute__((vector_size(16)));
struct H64_1 { V64 a; };
struct H64_2 { V64 a, b; };
struct H64_3 { V64 a, b, c; };
struct H64_4 { V64 a, b, c, d; };
struct H128_1 { V128 a; };
struct H128_2 { V128 a, b; };
struct H128_3 { V128 a, b, c; };
struct H128_4 { V128 a, b, c, d; };
struct Nested64 { struct H64_2 a, b; };
struct Nested128 { struct H128_2 a, b; };
struct Array64 { V64 a[2], b[2]; };
struct Array128 { V128 a[3]; };
struct RecordArray { struct H128_2 a[2]; };
struct Five64 { V64 a[5]; };
struct Five128 { V128 a[5]; };
struct Mixed { V64 a; V128 b; };
#define PROBE(Type) \
  extern struct Type take_##Type(struct Type); \
  struct Type call_##Type(struct Type value) { return take_##Type(value); }
PROBE(H64_1)
PROBE(H64_2)
PROBE(H64_3)
PROBE(H64_4)
PROBE(H128_1)
PROBE(H128_2)
PROBE(H128_3)
PROBE(H128_4)
PROBE(Nested64)
PROBE(Nested128)
PROBE(Array64)
PROBE(Array128)
PROBE(RecordArray)
PROBE(Five64)
PROBE(Five128)
PROBE(Mixed)
)C")
A64_CALL_HVA_COMPILER("take_H64_1", 8, 1, false)
A64_CALL_HVA_COMPILER("take_H64_2", 8, 2, false)
A64_CALL_HVA_COMPILER("take_H64_3", 8, 3, false)
