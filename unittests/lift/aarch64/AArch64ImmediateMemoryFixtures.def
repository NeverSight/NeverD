/// \file
/// Independent LLVM MC 22.1.6 encodings and byte-result oracles. CASE owns the
/// original/scratch words, vector class, access/result widths, signedness and
/// signed byte displacement. REJECT owns neighboring writeback/pair words.
/// VALUE and TEXT own fixture constants and native replay syntax.
//===----------------------------------------------------------------------===//

#ifndef IMMEDIATE_MEMORY_CASE
#define IMMEDIATE_MEMORY_CASE(Word, Scratch, Vector, Unsigned, Access, Result, \
                              Signed, Offset)
#endif
#ifndef IMMEDIATE_MEMORY_REJECT
#define IMMEDIATE_MEMORY_REJECT(Word)
#endif
#ifndef IMMEDIATE_MEMORY_VALUE
#define IMMEDIATE_MEMORY_VALUE(Type, Name, Value)
#endif
#ifndef IMMEDIATE_MEMORY_TEXT
#define IMMEDIATE_MEMORY_TEXT(Name, Text)
#endif
#ifndef IMMEDIATE_MEMORY_ID
#define IMMEDIATE_MEMORY_ID(Id, Expected)
#endif

