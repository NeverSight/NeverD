IMMEDIATE_MEMORY_VALUE(unsigned, kImmediateBasePosition, 256)
IMMEDIATE_MEMORY_VALUE(unsigned, kImmediateMemoryBytes, 66064)
IMMEDIATE_MEMORY_VALUE(unsigned, kImmediateSpanBytes, 65536)
IMMEDIATE_MEMORY_VALUE(uint32_t, kImmediateMaximumQLoad, 0x3dfffc20U)
IMMEDIATE_MEMORY_VALUE(uint32_t, kImmediateNegativeQLoad, 0x3cd00020U)
IMMEDIATE_MEMORY_TEXT(kImmediateNamePrefix, "original_immediate_memory_")
IMMEDIATE_MEMORY_TEXT(kImmediateNativeDecl,
                      "uint64_t {0}(uint64_t, uint64_t{1});\n")
IMMEDIATE_MEMORY_TEXT(kImmediateNativeStoreScalarParameter, ", uint{0}_t")
IMMEDIATE_MEMORY_TEXT(kImmediateNativeStoreVectorParameters,
                      ", uint64_t, uint64_t")
IMMEDIATE_MEMORY_TEXT(kImmediateNativeLoadCall, "{0}(base, 0)")
IMMEDIATE_MEMORY_TEXT(kImmediateNativeStoreScalarCall, "{0}(base, 0, low)")
IMMEDIATE_MEMORY_TEXT(kImmediateNativeStoreVectorCall,
                      "{0}(base, 0, low, high)")
IMMEDIATE_MEMORY_TEXT(
    kImmediateNativeWrapper,
    "static uint64_t immediate_case_{0}(uint64_t base, uint64_t low, uint64_t "
    "high, uint64_t *upper) {{ *upper = 0; return {1}; }\n")
IMMEDIATE_MEMORY_TEXT(
    kImmediateNativeVectorLoadWrapper,
    "static uint64_t immediate_case_{0}(uint64_t base, uint64_t low, uint64_t "
    "high, uint64_t *upper) {{ *upper = {1}(base, 1); return {1}(base, 0); }\n")
IMMEDIATE_MEMORY_TEXT(kImmediateNativeCase,
                      "{{ immediate_case_{0}, {1}, {2}, {3}, {4}, {5} },\n")
IMMEDIATE_MEMORY_TEXT(
    kImmediateNativeHarness,
    "struct immediate_case {{ uint64_t (*call)(uint64_t, uint64_t, uint64_t, "
    "uint64_t *);\n"
    "  unsigned width, result, is_signed, vector; int offset; };\n"
    "{0}\n"
    "static const struct immediate_case immediate_cases[] = {{ {1} };\n"
    "int main(void) {{\n"
    "  _Alignas(16) static unsigned char memory[66064];\n"
    "  static const uint64_t low = 0xfedcba987654b381ULL;\n"
    "  static const uint64_t high = 0x91a2b3c4d5e6f708ULL;\n"
    "  for (unsigned c = 0; c != "
    "sizeof(immediate_cases)/sizeof(immediate_cases[0]); ++c) {{\n"
    "    const struct immediate_case *item = &immediate_cases[c];\n"
    "    for (unsigned i = 0; i != sizeof(memory); ++i)\n"
    "      memory[i] = (unsigned char)(i * 13 + (i >> 8) * 7 + 129);\n"
    "    const unsigned position = (unsigned)(256 + item->offset);\n"
    "    uint64_t expected_low = 0, expected_high = 0;\n"
    "    for (unsigned i = 0; i != item->width; ++i) {{\n"
    "      if (i < 8) expected_low |= (uint64_t)memory[position+i] << (i*8);\n"
    "      else expected_high |= (uint64_t)memory[position+i] << ((i-8)*8);\n"
    "    }\n"
    "    if (item->is_signed && item->width < 8 &&\n"
    "        (expected_low & (1ULL << (item->width*8-1))))\n"
    "      expected_low |= ~((1ULL << (item->width*8))-1);\n"
    "    if (!item->vector && item->result == 4) expected_low &= 0xffffffffU;\n"
    "    const uint64_t expected = item->result ? expected_low : 0;\n"
    "    uint64_t upper = ~0ULL;\n"
    "    const uint64_t result = item->call((uint64_t)(uintptr_t)&memory[256], "
    "low, high, &upper);\n"
    "    if (result != expected || upper != (item->vector && item->result ? "
    "expected_high : 0)) return 1;\n"
    "    for (unsigned i = 0; i != sizeof(memory); ++i) {{\n"
    "      unsigned char byte = (unsigned char)(i * 13 + (i >> 8) * 7 + 129);\n"
    "      if (!item->result && i >= position && i-position < item->width) {{\n"
    "        const unsigned j = i-position;\n"
    "        byte = j < 8 ? (unsigned char)(low >> (j*8)) : (unsigned "
    "char)(high >> ((j-8)*8));\n"
    "      }\n"
    "      if (memory[i] != byte) return 2;\n"
    "    }\n"
    "  }\n"
    "  return 0;\n"
    "}\n")
IMMEDIATE_MEMORY_TEXT(kImmediateArtifactEnvironment,
                      "NEVERD_ARM64E_CPTA_ARTIFACT_DIR")
IMMEDIATE_MEMORY_TEXT(kImmediateArtifactPrefix, "immediate-memory")
IMMEDIATE_MEMORY_TEXT(kImmediateArtifactProperty, "cpta_memory_artifacts")
IMMEDIATE_MEMORY_TEXT(kImmediateHighCArtifact, "high.c")
IMMEDIATE_MEMORY_TEXT(kImmediateLLVMCArtifact, "llvm.c")
IMMEDIATE_MEMORY_TEXT(kImmediateELFArtifact, "llvm.o")
IMMEDIATE_MEMORY_TEXT(kImmediateMachOArtifact, "llvm-macho.o")
IMMEDIATE_MEMORY_TEXT(kImmediateHarnessArtifact, "harness.c")

