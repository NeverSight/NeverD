PAIR_MEMORY_TEXT(
    kPairTestPrelude,
    "#include <stdint.h>\ntypedef unsigned __int128 pair_bits;\n"
    "typedef int64_t pair_vector __attribute__((vector_size(16)));\n"
    "union pair_repr { pair_bits bits; pair_vector vector; };\n"
    "struct pair_result { pair_bits first,second; uint64_t base; };\n")
PAIR_MEMORY_TEXT(kPairTestNativeLoad,
                 "static struct pair_result pair_original_{0}(uint64_t input, "
                 "pair_bits data1, pair_bits data2) {{\n"
                 "register {2} first __asm__(\"{3}21\");\n"
                 "register {2} second __asm__(\"{3}22\");\n"
                 "register uint64_t base __asm__(\"x20\") = input;\n"
                 "__asm__ volatile(\"{7}.inst {1}{8}\" : \"{4}\"(first), "
                 "\"{4}\"(second), \"+r\"(base) : : {9}\"memory\");\n"
                 "return (struct pair_result){{ {5}, {6}, base };\n}\n")
PAIR_MEMORY_TEXT(kPairTestNativeStore,
                 "static struct pair_result pair_original_{0}(uint64_t input, "
                 "pair_bits data1, pair_bits data2) {{\n"
                 "register {2} first __asm__(\"{3}21\") = {7};\n"
                 "register {2} second __asm__(\"{3}22\") = {8};\n"
                 "register uint64_t base __asm__(\"x20\") = input;\n"
                 "__asm__ volatile(\"{9}.inst {1}{10}\" : \"+r\"(base) : "
                 "\"{4}\"(first), \"{4}\"(second) : {11}\"memory\");\n"
                 "return (struct pair_result){{ {5}, {6}, base };\n}\n")
PAIR_MEMORY_TEXT(kPairTestScalarBank, "x")
PAIR_MEMORY_TEXT(kPairTestVectorBank, "v")
PAIR_MEMORY_TEXT(
    kPairTestReplay,
    "static int pair_run_{0}(void) {{\n"
    "_Alignas(16) unsigned char left[4096],right[4096],expected[4096];\n"
    "for (unsigned j=0;j!=4096;++j) left[j]=right[j]=expected[j]=(unsigned "
    "char)(j*37+19);\n"
    "const pair_bits "
    "data1=((pair_bits)UINT64_C(0x8172635445362718)<<64)|UINT64_C("
    "0xf1e2d3c4b5a69788);\n"
    "const pair_bits "
    "data2=((pair_bits)UINT64_C(0xa8b7c6d5e4f30219)<<64)|UINT64_C("
    "0x1029384756abcdef);\n"
    "const pair_bits inputs[2]={{data1,data2}; pair_bits values[2]={{0,0};\n"
    "const unsigned at=2048+({2} ? {1} : 0);\n"
    "for (unsigned i=0;i!=2;++i) {{\n"
    " if ({4}) {{\n"
    "  for (unsigned j=0;j!={3};++j) "
    "values[i]|=(pair_bits)left[at+i*{3}+j]<<(8*j);\n"
    "  if ({6}) values[i]=(uint64_t)(int64_t)(int32_t)values[i];\n"
    " } else {{\n"
    "  values[i]={5} ? inputs[i] : (uint64_t)inputs[i];\n"
    "  for (unsigned j=0;j!={3};++j) expected[at+i*{3}+j]=(unsigned "
    "char)(inputs[i]>>(8*j));\n"
    " }\n }\n"
    "const struct pair_result "
    "native=pair_original_{0}((uintptr_t)(right+2048),data1,data2);\n"
    "uint64_t "
    "out[4]={{UINT64_C(0xbad),UINT64_C(0xbad),UINT64_C(0xbad),UINT64_C(0xbad)};"
    "\n"
    "const uint64_t "
    "base={8};\n"
    "const pair_bits first=(pair_bits)out[0]|((pair_bits)out[1]<<64);\n"
    "const pair_bits second=(pair_bits)out[2]|((pair_bits)out[3]<<64);\n"
    "if(first!=values[0]||second!=values[1]||native.first!=values[0]||native."
    "second!=values[1]) return 1;\n"
    "if(base!=(uintptr_t)(left+2048+({7}?{1}:0))||native.base!=(uintptr_t)("
    "right+2048+({7}?{1}:0))) return 2;\n"
    "for(unsigned j=0;j!=4096;++j) "
    "if(left[j]!=expected[j]||right[j]!=expected[j]) return 3;\n"
    "return 0;\n}\n")
PAIR_MEMORY_TEXT(kPairTestEntry, "pair_run_{0},\n")
