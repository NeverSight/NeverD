//===- AArch64ScalarCPATraceFixtures.def - Scalar CPA results ---*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Scalar rows contain the word, X1, X2, X3 and results under the three
/// effective controls. They write X0.
/// Multiply forms use X3 as the pointer. The expected results are literal
/// architectural values, independent of the tracer's overflow calculation.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_A64_CPA_TRACE
#define NEVERD_A64_CPA_TRACE(...)
#endif
#ifndef NEVERD_A64_CPA_REGISTER
#define NEVERD_A64_CPA_REGISTER(...)
#endif

// A shifted register contributes its low 64 bits before the pointer check.
NEVERD_A64_CPA_TRACE(0x9a023c20, 0x1200000000000100, 0x0200000000000000, 0,
                     0x1200000000000100, 0x1200000000000100, 0x1200000000000100)
NEVERD_A64_CPA_TRACE(0x9a022020, 0x00ffffffffffffff, 1, 0,
                     0x0100000000000000, 0x0080000000000000, 0x0080000000000000)
NEVERD_A64_CPA_TRACE(0xda022020, 0x1200000000000000, 1, 0,
                     0x11ffffffffffffff, 0x127fffffffffffff, 0x127fffffffffffff)
// Previously poisoned pointer. One offset preserves its poison already,
// another would repair it through integer arithmetic.
NEVERD_A64_CPA_TRACE(0x9a022020, 0x1240000000000000, 8, 0,
                     0x1240000000000008, 0x1240000000000008, 0x1240000000000008)
NEVERD_A64_CPA_TRACE(0x9a022020, 0x1240000000000000, 0xffc0000000000000, 0,
                     0x1200000000000000, 0x1240000000000000, 0x1240000000000000)

// Signed product wraps to zero. Addition-only sees the original pointer.
// The second base has bits 55 and 54 set, so poisoning clears bit 54.
NEVERD_A64_CPA_TRACE(0x9b620c20, 0x4000000000000000, 4, 0x1200000000000120,
                     0x1200000000000120, 0x1200000000000120, 0x1240000000000120)
NEVERD_A64_CPA_TRACE(0x9b628c20, 0xc000000000000000, 4, 0x12c0000000000120,
                     0x12c0000000000120, 0x12c0000000000120, 0x1280000000000120)
// A negative product that fits, an overflowing positive product, and a
// nonzero truncated product whose tag remains unchanged.
NEVERD_A64_CPA_TRACE(0x9b620c20, 0xfffffffffffffffd, 7, 0x1200000000000100,
                     0x12000000000000eb, 0x12000000000000eb, 0x12000000000000eb)
NEVERD_A64_CPA_TRACE(0x9b628c20, 0xfffffffffffffffd, 7, 0x1200000000000100,
                     0x1200000000000115, 0x1200000000000115, 0x1200000000000115)
NEVERD_A64_CPA_TRACE(0x9b620c20, 0x8000000000000000, 0xffffffffffffffff,
                     0x1200000000000100,
                     0x9200000000000100, 0x1240000000000100, 0x1240000000000100)
NEVERD_A64_CPA_TRACE(0x9b628c20, 0x4000000000000001, 4, 0x1200000000000100,
                     0x12000000000000fc, 0x12000000000000fc, 0x12400000000000fc)
// INT64_MIN times one is representable. Its top-byte change still triggers CPTA.
NEVERD_A64_CPA_TRACE(0x9b628c20, 0x8000000000000000, 1, 0x1200000000000100,
                     0x9200000000000100, 0x1240000000000100, 0x1240000000000100)

// Word, architectural register under test, initial value, X2, unchecked and
// checked results. A discarded result leaves the sentinel register intact.
NEVERD_A64_CPA_REGISTER(0x9a023fff, SP, 0x1200000000000100, 1,
                        0x1200000000000180, 0x1200000000000180)
NEVERD_A64_CPA_REGISTER(0xda012c21, X1, 3, 0,
                        0xffffffffffffffeb, 0x007fffffffffffeb)
NEVERD_A64_CPA_REGISTER(0x9b7f7fff, X0, 8, 0, 8, 8)

#undef NEVERD_A64_CPA_TRACE
#undef NEVERD_A64_CPA_REGISTER
