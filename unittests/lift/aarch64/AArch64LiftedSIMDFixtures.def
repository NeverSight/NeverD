A64_LEAF_TEXT(kSIMDFloatingCaller, R"c(
#pragma STDC FENV_ACCESS ON
#include <dlfcn.h>
#include <fenv.h>
#include <math.h>
#include <string.h>
typedef void *(*Entry)(void *, const void *, const void *, const void *);
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *h = dlopen(argv[1], RTLD_NOW);
  if (!h) return 2;
  Entry entries[] = {(Entry)dlsym(h,"leaf_sum"),
                     (Entry)dlsym(h,"leaf_difference")};
  if (!entries[0] || !entries[1]) return 3;
  const int modes[] = {FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO};
  int original = fegetround();
  for (unsigned mode = 0; mode != 4; ++mode) {
    if (fesetround(modes[mode])) return 4;
    for (unsigned run = 0; run != 3; ++run) {
      float af[4] = {-0.0f, -1.0f, 0x1.fffffep127f, 0x1p-126f};
      float bf[4] = {-0.0f, 0x1.000002p0f, 0x1.fffffep127f, 0x1p-149f};
      float cf[4] = {1, 2, 3, run == 0 ? 0x1.fffffep-1f :
                             run == 1 ? 2.0f : 0x1p-126f};
      double ad[2] = {1.0, 0x1.fffffffffffffp1023};
      double bd[2] = {0x1.0000000000001p0, -0x1.fffffffffffffp1023};
      double cd[2] = {3, run == 0 ? 0x1.fffffffffffffp-1 :
                         run == 1 ? 2.0 : 0x1p-1022};
      for (unsigned op = 0; op != 2; ++op) {
        unsigned char actual[48], expected[48];
        memset(actual, 0xa5, sizeof(actual));
        memset(expected, 0xa5, sizeof(expected));
        if (feclearexcept(FE_ALL_EXCEPT)) return 5;
        if (op == 0) {
          for (unsigned i = 0; i != 4; ++i) {
            float v = fmaf(bf[i], cf[3], af[i]);
            memcpy(expected + 16 + i * 4, &v, 4);
          }
        } else {
          for (unsigned i = 0; i != 2; ++i) {
            double v = fma(-bd[i], cd[1], ad[i]);
            memcpy(expected + 16 + i * 8, &v, 8);
          }
        }
        int exceptions = fetestexcept(FE_ALL_EXCEPT);
        if (feclearexcept(FE_ALL_EXCEPT)) return 6;
        const void *a = op ? (const void *)ad : (const void *)af;
        const void *b = op ? (const void *)bd : (const void *)bf;
        const void *c = op ? (const void *)cd : (const void *)cf;
        if (entries[op](actual + 16, a, b, c) != actual + 16) return 7;
        if (fetestexcept(FE_ALL_EXCEPT) != exceptions) return 8;
        if (fegetround() != modes[mode]) return 9;
        if (memcmp(actual, expected, sizeof(actual))) return 10;
      }
    }
  }
  if (fesetround(original)) return 11;
  dlclose(h);
  return 0;
}
)c")

