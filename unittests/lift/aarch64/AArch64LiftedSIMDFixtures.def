A64_LEAF_TEXT(kSIMDArithmeticLeaves, R"asm(
#ifndef SIMD_LANE_BYTES
#define SIMD_LANE_BYTES 1
#endif
#ifndef SIMD_ACTIVE_BYTES
#define SIMD_ACTIVE_BYTES 16
#endif
#if SIMD_ACTIVE_BYTES == 16
#if SIMD_LANE_BYTES == 1
#define V0 v0.16b
#define V1 v1.16b
#define V2 v2.16b
#elif SIMD_LANE_BYTES == 2
#define V0 v0.8h
#define V1 v1.8h
#define V2 v2.8h
#elif SIMD_LANE_BYTES == 4
#define V0 v0.4s
#define V1 v1.4s
#define V2 v2.4s
#else
#define V0 v0.2d
#define V1 v1.2d
#define V2 v2.2d
#endif
#else
#if SIMD_LANE_BYTES == 1
#define V0 v0.8b
#define V1 v1.8b
#define V2 v2.8b
#elif SIMD_LANE_BYTES == 2
#define V0 v0.4h
#define V1 v1.4h
#define V2 v2.4h
#elif SIMD_LANE_BYTES == 4
#define V0 v0.2s
#define V1 v1.2s
#define V2 v2.2s
#else
#define V0 d0
#define V1 d1
#define V2 d2
#endif
#endif
.text
.p2align 2
.globl _leaf_sum
_leaf_sum:
.cfi_startproc
  ldr q0, [x1]
  ldr q1, [x2]
  add V2, V0, V1
  str q2, [x0]
  ret
.cfi_endproc
.globl _leaf_difference
_leaf_difference:
.cfi_startproc
  ldr q0, [x1]
  ldr q1, [x2]
  sub V2, V0, V1
  str q2, [x0]
  ret
.cfi_endproc
.subsections_via_symbols
)asm")
A64_LEAF_TEXT(kSIMDArithmeticCaller, R"c(
#include <dlfcn.h>
#include <stdint.h>
#include <string.h>
#ifndef SIMD_LANE_BYTES
#define SIMD_LANE_BYTES 1
#endif
#ifndef SIMD_ACTIVE_BYTES
#define SIMD_ACTIVE_BYTES 16
#endif
typedef void *(*Entry)(void *, const void *, const void *);
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *h = dlopen(argv[1], RTLD_NOW);
  if (!h) return 2;
  Entry entries[] = {(Entry)dlsym(h,"leaf_sum"),
                     (Entry)dlsym(h,"leaf_difference")};
  if (!entries[0] || !entries[1]) return 3;
  for (unsigned run = 0; run != 13; ++run) {
    unsigned char a[16], b[16];
    for (unsigned i = 0; i != 16; ++i) {
      a[i] = run == 0 ? 255 : (run * 67 + i * 31);
      b[i] = run == 0 ? 1 : (run * 113 + i * 23);
    }
    for (unsigned op = 0; op != 2; ++op) {
      unsigned char actual[48], expected[48];
      memset(actual, 0xa5, sizeof(actual));
      memset(expected, 0xa5, sizeof(expected));
      memset(expected + 16, 0, 16);
      for (unsigned i = 0; i != SIMD_ACTIVE_BYTES; i += SIMD_LANE_BYTES) {
        uint64_t x = 0, y = 0;
        memcpy(&x, a + i, SIMD_LANE_BYTES);
        memcpy(&y, b + i, SIMD_LANE_BYTES);
        uint64_t value = op ? x - y : x + y;
        memcpy(expected + 16 + i, &value, SIMD_LANE_BYTES);
      }
      if (entries[op](actual + 16, a, b) != actual + 16) return 4;
      if (memcmp(actual, expected, sizeof(actual))) return 5;
    }
  }
  dlclose(h);
  return 0;
}
)c")

