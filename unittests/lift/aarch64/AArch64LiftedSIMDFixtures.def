#include <dlfcn.h>
#include <stdint.h>
#include <string.h>
typedef void *(*Entry)(void *, const void *, const void *);
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *h = dlopen(argv[1], RTLD_NOW);
  if (!h) return 2;
  Entry entries[] = {(Entry)dlsym(h,"leaf_sum"),
                     (Entry)dlsym(h,"leaf_difference")};
  if (!entries[0] || !entries[1]) return 3;
  unsigned long saved;
  __asm__ volatile("mrs %0, fpsr" : "=r"(saved));
  for (unsigned run = 0; run != 13; ++run) {
    unsigned char left[16], right[16];
    for (unsigned i = 0; i != 16; ++i) {
      left[i] = run == 0 ? 0 : run * 67 + i * 31;
      right[i] = run == 0 ? 0 : run * 113 + i * 23;
    }
    for (unsigned op = 0; op != 2; ++op) {
      const unsigned char *a = op ? right : left, *b = op ? left : right;
      uint16_t ah[8], bh[8]; uint32_t aw[4], bw[4]; int32_t as[4], bs[4];
      memcpy(ah,a,16); memcpy(bh,b,16); memcpy(aw,a,16); memcpy(bw,b,16);
      memcpy(as,a,16); memcpy(bs,b,16);
      unsigned char actual[416], expected[416];
      memset(actual, 0xa5, sizeof(actual));
      memset(expected, 0xa5, sizeof(expected));
      memset(expected + 16, 0, 384);
      unsigned char (*out)[16] = (unsigned char (*)[16])(expected + 16);
      unsigned clamped = 0; uint16_t sum = 0;
      for (unsigned i = 0; i != 16; ++i) {
        out[4][i] = a[i] << 2;
        sum += a[i];
        int x = a[i] < 128 ? a[i] : (int)a[i] - 256;
        int y = b[i] < 128 ? b[i] : (int)b[i] - 256;
        int total = x + y;
        if (total > 127) { total = 127; clamped = 1; }
        if (total < -128) { total = -128; clamped = 1; }
        out[13][i] = total;
        out[20][i] = x < 0 ? -x : x;
      }
      out[10][0] = sum; memcpy(out[11], &sum, 2);
      int32_t maximum = as[0];
      for (unsigned i = 0; i != 4; ++i) {
        uint32_t v = bw[i] + aw[i] * bw[i]; memcpy(out[1] + 4*i, &v, 4);
        v = (aw[i] >> 7) | (aw[i] & 0x80000000u ? 0xfe000000u : 0);
        memcpy(out[2] + 4*i, &v, 4);
        v = (uint32_t)ah[i+4] << 3; memcpy(out[7] + 4*i, &v, 4);
        v = (uint32_t)ah[i] * bh[i]; memcpy(out[8] + 4*i, &v, 4);
        if (as[i] > maximum) maximum = as[i];
        v = aw[i] == bw[i] ? UINT32_MAX : 0; memcpy(out[15] + 4*i, &v, 4);
        v = as[i] > bs[i] ? UINT32_MAX : 0; memcpy(out[16] + 4*i, &v, 4);
        v = aw[i] > bw[i] ? UINT32_MAX : 0; memcpy(out[17] + 4*i, &v, 4);
        int32_t narrow = as[i];
        if (narrow > INT16_MAX) { narrow = INT16_MAX; clamped = 1; }
        if (narrow < INT16_MIN) { narrow = INT16_MIN; clamped = 1; }
        int16_t small = narrow; memcpy(out[18] + 2*i, &small, 2);
        int32_t minimum = as[i] < bs[i] ? as[i] : bs[i];
        memcpy(out[22] + 4*i, &minimum, 4);
      }
      memcpy(out[12], &maximum, 4);
      for (unsigned i = 0; i != 2; ++i) {
        int64_t v = (int64_t)as[i+2] * bs[i+2];
        memcpy(out[9] + 8*i, &v, 8);
      }
      for (unsigned i = 0; i != 8; ++i) {
        uint16_t v = (uint32_t)ah[i] * bh[i]; memcpy(out[0] + 2*i, &v, 2);
        v = ah[i] >> 3; memcpy(out[3] + 2*i, &v, 2);
        out[5][i] = ah[i] >> 4; out[5][i+8] = bh[i] >> 4;
        int16_t wide = (a[i] < 128 ? a[i] : (int)a[i] - 256) * 2;
        memcpy(out[6] + 2*i, &wide, 2);
        v = ah[i] < bh[i] ? 0 : ah[i] - bh[i];
        clamped |= ah[i] < bh[i]; memcpy(out[14] + 2*i, &v, 2);
        out[19][i] = ah[i] > UINT8_MAX ? UINT8_MAX : ah[i];
        clamped |= ah[i] > UINT8_MAX;
        v = -ah[i]; memcpy(out[21] + 2*i, &v, 2);
        v = ah[i] > bh[i] ? ah[i] : bh[i]; memcpy(out[23] + 2*i, &v, 2);
      }
      unsigned long clear = saved & ~(1ul << 27), status;
      __asm__ volatile("msr fpsr, %0" : : "r"(clear) : "memory");
      if (entries[op](actual + 16, left, right) != actual + 16) return 4;
      __asm__ volatile("mrs %0, fpsr" : "=r"(status) : : "memory");
      if (((status >> 27) & 1) != clamped) return 5;
      if (memcmp(actual, expected, sizeof(actual))) return 6;
    }
  }
  __asm__ volatile("msr fpsr, %0" : : "r"(saved) : "memory");
  dlclose(h);
  return 0;
}
)c")

#undef A64_LEAF_TEXT
