A64_LEAF_TEXT(kSIMDRegisterCaller, R"c(
#include <dlfcn.h>
#include <stdint.h>
#include <string.h>
typedef uint32_t Words __attribute__((ext_vector_type(4)));
typedef uint64_t Doubles __attribute__((ext_vector_type(2)));
typedef Words (*Add)(Words, Words);
typedef Doubles (*Subtract)(Doubles, Doubles);
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *h = dlopen(argv[1], RTLD_NOW);
  if (!h) return 2;
  Add add = (Add)dlsym(h,"leaf_sum");
  Subtract sub = (Subtract)dlsym(h,"leaf_difference");
  if (!add || !sub) return 3;
  for (unsigned i = 0; i != 13; ++i) {
    Words a = {UINT32_MAX, i, UINT32_MAX / 2 + i, 17 * i};
    Words b = {i, UINT32_MAX, 3 * i, UINT32_MAX - i};
    uint32_t expected[4];
    for (unsigned j = 0; j != 4; ++j) expected[j] = a[j] + b[j];
    Words result = add(a, b);
    if (memcmp(&result, expected, sizeof(result))) return 4;
    Doubles x = {UINT64_MAX - i, UINT64_C(0x8000000000000000) + i};
    Doubles y = {17 * i, UINT64_MAX};
    uint64_t difference[2];
    for (unsigned j = 0; j != 2; ++j) difference[j] = x[j] - y[j];
    Doubles got = sub(x, y);
    if (memcmp(&got, difference, sizeof(got))) return 5;
  }
  dlclose(h);
  return 0;
}
)c")

