A64_LEAF_TEXT(kSIMDPermutationCaller, R"c(
#include <dlfcn.h>
#include <stdint.h>
#include <string.h>
typedef void *(*Entry)(void *, const void *, const void *, const void *);
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *h = dlopen(argv[1], RTLD_NOW);
  if (!h) return 2;
  Entry entries[] = {(Entry)dlsym(h,"leaf_sum"),
                     (Entry)dlsym(h,"leaf_difference")};
  if (!entries[0] || !entries[1]) return 3;
  for (unsigned run = 0; run != 9; ++run) {
    unsigned char left[16], right[16], indices[16];
    for (unsigned i = 0; i != 16; ++i) {
      left[i] = run * 67 + i * 31;
      right[i] = run * 113 + i * 23;
      indices[i] = (run * 13 + i * 7) % 41;
    }
    for (unsigned op = 0; op != 2; ++op) {
      const unsigned char *a = op ? right : left, *b = op ? left : right;
      unsigned char actual[432], expected[432];
      memset(actual, 0xa5, sizeof(actual));
      memset(expected, 0xa5, sizeof(expected));
      unsigned char (*out)[16] = (unsigned char (*)[16])(expected + 16);
      for (unsigned i = 0; i != 16; ++i) {
        out[0][i] = a[i] & b[i];
        out[1][i] = a[i] | b[i];
        out[2][i] = a[i] ^ b[i];
        out[3][i] = a[i] & ~b[i];
        out[4][i] = ~a[i];
        out[5][i] = a[(i / 8) * 8 + 7 - (i % 8)];
        out[6][i] = out[7][i] = 0;
        for (unsigned bit = 0; bit != 8; ++bit) {
          out[6][i] |= ((a[i] >> bit) & 1) << (7 - bit);
          out[7][i] += (a[i] >> bit) & 1;
        }
        unsigned at = i + 7;
        out[8][i] = at < 16 ? a[at] : b[at - 16];
        out[15][i] = indices[i] < 16 ? a[indices[i]] :
                      indices[i] < 32 ? b[indices[i] - 16] : 0;
        out[16][i] = indices[i] < 16 ? b[indices[i]] : a[i];
        out[18][i] = (i & 1) ? 255 : 0;
        out[19][i] = i == 15 ? 0x5a : a[i];
        out[22][i] = b[9];
      }
      for (unsigned i = 0; i != 4; ++i) {
        memcpy(out[9] + i * 4, a + i * 2, 2);
        memcpy(out[9] + i * 4 + 2, b + i * 2, 2);
        memcpy(out[10] + i * 4, a + 8 + i * 2, 2);
        memcpy(out[10] + i * 4 + 2, b + 8 + i * 2, 2);
        uint32_t imm = 0x12ff, value = 0x5a;
        memcpy(out[17] + i * 4, &imm, 4);
        memcpy(out[21] + i * 4, &value, 4);
      }
      for (unsigned i = 0; i != 2; ++i) {
        memcpy(out[11] + i * 4, a + i * 8, 4);
        memcpy(out[11] + 8 + i * 4, b + i * 8, 4);
        memcpy(out[12] + i * 4, a + 4 + i * 8, 4);
        memcpy(out[12] + 8 + i * 4, b + 4 + i * 8, 4);
      }
      memcpy(out[13], a, 8); memcpy(out[13] + 8, b, 8);
      memcpy(out[14], a + 8, 8); memcpy(out[14] + 8, b + 8, 8);
      for (unsigned i = 0; i != 8; ++i) memcpy(out[20] + i * 2, a + 14, 2);
      int32_t low; memcpy(&low, b + 8, 4);
      int64_t wide = low;
      memcpy(out[23], &wide, 8); memcpy(out[23] + 8, &wide, 8);
      memcpy(out[24], a + 8, 8); memcpy(out[24] + 8, b + 8, 8);
      if (entries[op](actual + 16, left, right, indices) != actual + 16) return 4;
      if (memcmp(actual, expected, sizeof(actual))) return 5;
    }
  }
  dlclose(h);
  return 0;
}
)c")

