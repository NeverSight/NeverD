//===- AArch64PAuthNative.def - Active signing-key probe ---------*- C++
//-*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// An executable target name alone cannot prove that pointer signing is active.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_PAUTH_NATIVE_TEXT
#define NEVERD_PAUTH_NATIVE_TEXT(Name, Value)
#endif

// A supervising shell returns the child's Darwin wait status without folding
// distinct signals into LLVM ExecuteAndWait's common crash result.
#define NEVERD_PROBE_MARKER "NEVERD native probe entered"
NEVERD_PAUTH_NATIVE_TEXT(kProbeEntryMarker, NEVERD_PROBE_MARKER "\n")
NEVERD_PAUTH_NATIVE_TEXT(
    kProbeEntrySource,
    "extern long write(int, const void *, __SIZE_TYPE__);\n"
    "__attribute__((constructor)) static void probeEntered(void) {\n"
    "  static const char mark[] = \"" NEVERD_PROBE_MARKER "\\n\";\n"
    "  (void)write(1, mark, sizeof(mark) - 1);\n}\n")
#undef NEVERD_PROBE_MARKER
NEVERD_PAUTH_NATIVE_TEXT(kProbeShell, "/bin/sh")
NEVERD_PAUTH_NATIVE_TEXT(kProbeResultMessage, " probe exit ")
NEVERD_PAUTH_NATIVE_TEXT(kProbeCommandOption, "-c")
NEVERD_PAUTH_NATIVE_TEXT(kProbeCommand, "\"$1\"; exit $?")
NEVERD_PAUTH_NATIVE_TEXT(kProbeProgramName, "neverd-native-probe")
NEVERD_PAUTH_NATIVE_TEXT(kProbeOutputExtension, "out")
#ifdef NEVERD_PAUTH_NATIVE_NUMBER
NEVERD_PAUTH_NATIVE_NUMBER(kProbeSignalBase, 128)
NEVERD_PAUTH_NATIVE_NUMBER(kProbeKilledSignal, 9)
NEVERD_PAUTH_NATIVE_NUMBER(kProbeIllegalSignal, 4)
NEVERD_PAUTH_NATIVE_NUMBER(kProbeSegmentationSignal, 11)
NEVERD_PAUTH_NATIVE_NUMBER(kProbeAbsent, 1)
NEVERD_PAUTH_NATIVE_NUMBER(kProbeFailed, 2)
NEVERD_PAUTH_NATIVE_NUMBER(kProbeTimeoutSeconds, 30)
#undef NEVERD_PAUTH_NATIVE_NUMBER
#endif

NEVERD_PAUTH_NATIVE_TEXT(kPAuthCompiler, "clang")
NEVERD_PAUTH_NATIVE_TEXT(kOracleModule, "native")
NEVERD_PAUTH_NATIVE_TEXT(kOracleArtifactEnvironment,
                         "NEVERD_ARM64E_RETURN_OBJECTS")
NEVERD_PAUTH_NATIVE_TEXT(kOracleArtifactProperty,
                         "arm64e_return_object_directory")
NEVERD_PAUTH_NATIVE_TEXT(kOracleHighRoute, "high")
NEVERD_PAUTH_NATIVE_TEXT(kOracleLLVMRoute, "llvm")
NEVERD_PAUTH_NATIVE_TEXT(kOracleOptimizedLLVMRoute, "llvm-opt")
NEVERD_PAUTH_NATIVE_TEXT(kOracleBackendTarget, "arm64e-apple-macos15")
NEVERD_PAUTH_NATIVE_TEXT(kOracleBackendObject, "backend.o")
NEVERD_PAUTH_NATIVE_TEXT(kOracleOptimizedBackendObject, "backend-opt.o")
NEVERD_PAUTH_NATIVE_TEXT(kOracleCallerDirectory, "caller")
NEVERD_PAUTH_NATIVE_TEXT(kOracleStdint, "#include <stdint.h>\n")
NEVERD_PAUTH_NATIVE_TEXT(kReturnOraclePrototype,
                         "extern uint64_t {0}(uint64_t, uint64_t, uint64_t);\n")
NEVERD_PAUTH_NATIVE_TEXT(kPrefixOraclePrototype,
                         "extern uint64_t {0}(uint64_t, uint64_t, uint64_t, "
                         "uint64_t);\n")
NEVERD_PAUTH_NATIVE_TEXT(kOracleObjectExtension, "o")
NEVERD_PAUTH_NATIVE_TEXT(kOracleCLanguage, "c")
NEVERD_PAUTH_NATIVE_TEXT(
    kPAuthCompilerUnavailable,
    "clang is required for the arm64e source compilation check")
NEVERD_PAUTH_NATIVE_TEXT(kPAuthFixtureEnvironment,
                         "NEVERD_ARM64E_PAUTH_FIXTURES")
NEVERD_PAUTH_NATIVE_TEXT(kGenericOracle, "pacga_oracle.c")
NEVERD_PAUTH_NATIVE_TEXT(kSigningOracle, "pauth_oracle.c")
NEVERD_PAUTH_NATIVE_TEXT(kReturnOracle, "pauth_lr_oracle.c")
NEVERD_PAUTH_NATIVE_TEXT(kSigningKeyTarget, "arm64e-apple-macos")
NEVERD_PAUTH_NATIVE_TEXT(kSigningKeysUnavailable,
                         "this host cannot execute arm64e with all four active "
                         "pointer signing keys and generic signatures")
NEVERD_PAUTH_NATIVE_TEXT(kSigningKeyProbe, "pauth_key_probe.def")
NEVERD_PAUTH_NATIVE_TEXT(kReturnProbeMode, "#define PROBE_RETURN_KEYS 1\n")
NEVERD_PAUTH_NATIVE_TEXT(kReturnHostUnavailable,
                         "native pointer authentication requires Apple Silicon")
NEVERD_PAUTH_NATIVE_TEXT(
    kReturnKeysUnavailable,
    "this host cannot execute arm64e PAuth_LR with active keys")
#ifdef NEVERD_PAUTH_KEY_FUNCTION
NEVERD_PAUTH_KEY_FUNCTION(Pacia, test_pacia)
NEVERD_PAUTH_KEY_FUNCTION(Pacib, test_pacib)
NEVERD_PAUTH_KEY_FUNCTION(Pacda, test_pacda)
NEVERD_PAUTH_KEY_FUNCTION(Pacdb, test_pacdb)
NEVERD_PAUTH_KEY_FUNCTION(Autia, test_autia)
NEVERD_PAUTH_KEY_FUNCTION(Autib, test_autib)
NEVERD_PAUTH_KEY_FUNCTION(Autda, test_autda)
NEVERD_PAUTH_KEY_FUNCTION(Autdb, test_autdb)
NEVERD_PAUTH_KEY_FUNCTION(Xpaci, test_xpaci)
NEVERD_PAUTH_KEY_FUNCTION(Xpacd, test_xpacd)
NEVERD_PAUTH_KEY_FUNCTION(A64_Pacga, test_pacga)
#undef NEVERD_PAUTH_KEY_FUNCTION
#endif

#ifdef NEVERD_PAUTH_ORACLE_PAIR
// Both native oracles compare IA and IB for signing, authentication and return.
NEVERD_PAUTH_ORACLE_PAIR(A64_Pacia2, test_pacia2, A64_PaciaM, test_pacia_m)
NEVERD_PAUTH_ORACLE_PAIR(A64_Pacib2, test_pacib2, A64_PacibM, test_pacib_m)
NEVERD_PAUTH_ORACLE_PAIR(A64_Autia2, test_autia2, A64_AutiaM, test_autia_m)
NEVERD_PAUTH_ORACLE_PAIR(A64_Autib2, test_autib2, A64_AutibM, test_autib_m)
NEVERD_PAUTH_ORACLE_PAIR(A64_AuthReturnIA2, test_returnia2, A64_AuthReturnIAM,
                         test_returnia_m)
NEVERD_PAUTH_ORACLE_PAIR(A64_AuthReturnIB2, test_returnib2, A64_AuthReturnIBM,
                         test_returnib_m)
#undef NEVERD_PAUTH_ORACLE_PAIR
#endif

#undef NEVERD_PAUTH_NATIVE_TEXT
