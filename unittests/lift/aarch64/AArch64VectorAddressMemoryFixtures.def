VECTOR_MEMORY_TEXT(kVectorNativeAliasParameter, ", uint64_t")
VECTOR_MEMORY_TEXT(kVectorNativeAliasArgument, ", (uint64_t)data")
VECTOR_MEMORY_TEXT(kVectorNativeAliasCall, "{0}(base, index{1})")
VECTOR_MEMORY_TEXT(kVectorNativeLoadCall, "{0}(base, index)")
VECTOR_MEMORY_TEXT(kVectorNativeStoreCall,
                   "{0}(base, index, (uint64_t)data, (uint64_t)(data >> 64))")
VECTOR_MEMORY_TEXT(kVectorNativeWrapper,
                   "static uint64_t vector_case_{0}(uint64_t base, uint64_t "
                   "index, unsigned __int128 data) {{ return {1}; }\n")
VECTOR_MEMORY_TEXT(kVectorNativeCase,
                   "{{ vector_case_{0}, {1}, {2}, {3}, {4} },\n")
VECTOR_MEMORY_TEXT(
    kVectorNativeHarness,
    "typedef unsigned __int128 vector_bits;\n"
    "struct vector_case {{ uint64_t (*call)(uint64_t, uint64_t, vector_bits); "
    "unsigned width, step, signed_index, narrow_index; };\n"
    "{0}\n"
    "static const struct vector_case vector_cases[] = {{ {1} };\n"
    "static unsigned char vector_memory[256], vector_expected[256];\n"
    "int main(void) {{\n"
    "  const vector_bits data = ((vector_bits)0x8899aabbccddeeffULL << 64) | "
    "0x1021324354657687ULL;\n"
    "  const int indices[] = {{0, 1, 3, -1, -3};\n"
    "  for (unsigned c = 0; c < sizeof(vector_cases)/sizeof(vector_cases[0]); "
    "++c)\n"
    "    for (unsigned sample = 0; sample < "
    "sizeof(indices)/sizeof(indices[0]); ++sample) {{\n"
    "      const struct vector_case *test = &vector_cases[c];\n"
    "      int n = indices[sample];\n"
    "      if (n < 0 && !test->signed_index) continue;\n"
    "      for (unsigned b = 0; b < sizeof(vector_memory); ++b)\n"
    "        vector_memory[b] = vector_expected[b] = (unsigned char)(b * 37 + "
    "c * 11 + 13);\n"
    "      unsigned pos = (unsigned)(128 + n * (int)test->step);\n"
    "      vector_bits expected = 0;\n"
    "      if ({2}) {{\n"
    "        for (unsigned b = 0; b < test->width; ++b)\n"
    "          expected |= (vector_bits)vector_expected[pos + b] << (b * 8);\n"
    "      } else\n"
    "        for (unsigned b = 0; b < test->width; ++b)\n"
    "          vector_expected[pos + b] = (unsigned char)(data >> (b * 8));\n"
    "      uint64_t index = test->narrow_index\n"
    "                           ? 0xdeadbeef00000000ULL | (uint32_t)n\n"
    "                           : (uint64_t)(int64_t)n;\n"
    "      uint64_t value = test->call((uintptr_t)(vector_memory + 128), "
    "index, data);\n"
    "      uint64_t digest = (uint64_t)expected ^ (uint64_t)(expected >> 64);\n"
    "      if (value != digest) return 1;\n"
    "      for (unsigned b = 0; b < sizeof(vector_memory); ++b)\n"
    "        if (vector_memory[b] != vector_expected[b]) return 2;\n"
    "    }\n"
    "  return 0;\n"
    "}\n")

#undef VECTOR_MEMORY_FAMILY
