    kVectorFPStoreBody,
    "(void){0}(base, index, __builtin_bit_cast({1}, ({2})data)); "
    "return 0;")
VECTOR_MEMORY_TEXT(kVectorFPWrapper,
                   "static uint64_t fp_case_{0}(uint64_t base, uint64_t index, "
                   "uint64_t data) {{ {1} }\n")
VECTOR_MEMORY_TEXT(kVectorFPCase,
                   "{{ fp_case_{0}, {1}, {2}, {3}, {4}, {5} },\n")
VECTOR_MEMORY_TEXT(
    kVectorFPHarness,
    "struct fp_case {{ uint64_t (*call)(uint64_t, uint64_t, uint64_t); "
    "unsigned width, step, signed_index, narrow_index, load; };\n"
    "{0}\n"
    "static const struct fp_case fp_cases[] = {{ {1} };\n"
    "int main(void) {{\n"
    "  static const uint64_t singles[] = {{0x7fc01234U, 0x80000000U, "
    "0x7f800001U, 0xffffffffU, 0x3f800000U};\n"
    "  static const uint64_t doubles[] = {{0x7ff8000000001234ULL, "
    "0x8000000000000000ULL, 0x7ff0000000000001ULL, 0xffffffffffffffffULL, "
    "0x3ff0000000000000ULL};\n"
    "  const int indices[] = {{0, 1, 3, -1, -3};\n"
    "  unsigned char memory[256], expected[256];\n"
    "  for (unsigned c = 0; c < sizeof(fp_cases)/sizeof(fp_cases[0]); ++c)\n"
    "    for (unsigned p = 0; p < sizeof(singles)/sizeof(singles[0]); ++p)\n"
    "      for (unsigned s = 0; s < sizeof(indices)/sizeof(indices[0]); ++s) "
    "{{\n"
    "        const struct fp_case *test = &fp_cases[c];\n"
    "        int n = indices[s];\n"
    "        if (n < 0 && !test->signed_index) continue;\n"
    "        uint64_t data = test->width == 4 ? singles[p] : doubles[p];\n"
    "        for (unsigned b = 0; b < sizeof(memory); ++b)\n"
    "          memory[b] = expected[b] = 0x5a;\n"
    "        unsigned pos = (unsigned)(128 + n * (int)test->step);\n"
    "        for (unsigned b = 0; b < test->width; ++b) {{\n"
    "          expected[pos + b] = (unsigned char)(data >> (b * 8));\n"
    "          if (test->load) memory[pos + b] = expected[pos + b];\n"
    "        }\n"
    "        uint64_t index = test->narrow_index\n"
    "            ? 0xdeadbeef00000000ULL | (uint32_t)n : "
    "(uint64_t)(int64_t)n;\n"
    "        uint64_t result = test->call((uintptr_t)(memory + 128), index, "
    "data);\n"
    "        if (test->load && result != data) return 1;\n"
    "        for (unsigned b = 0; b < sizeof(memory); ++b)\n"
    "          if (memory[b] != expected[b]) return 2;\n"
    "      }\n"
    "  return 0;\n"
    "}\n")
VECTOR_MEMORY_TEXT(kVectorIndexCType, "uint{0}_t")
VECTOR_MEMORY_TEXT(kVectorNativeDecl, "uint64_t {0}(uint64_t, {2}{1});\n")
