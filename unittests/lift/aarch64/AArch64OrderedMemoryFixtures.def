//===----------------------------------------------------------------------===//
/// \file
/// Independent LLVM MC 22.1.6 words for all LRCPC2 GPR and LRCPC3 SIMD/FP
/// ordered unscaled families, with five signed imm9 boundaries. CASE owns the
/// original/scratch words, register class, access/result widths and
/// displacement. REJECT owns unallocated neighboring words. VALUE/TEXT own
/// fixture policy.
//===----------------------------------------------------------------------===//

#ifndef ORDERED_MEMORY_CASE
#define ORDERED_MEMORY_CASE(Word, Scratch, Vector, Access, Result, Signed,     \
                            Offset)
#endif
#ifndef ORDERED_MEMORY_REJECT
