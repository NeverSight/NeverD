#endif
#ifndef ORDERED_MEMORY_VALUE
#define ORDERED_MEMORY_VALUE(Type, Name, Value)
#endif
#ifndef ORDERED_MEMORY_TEXT
#define ORDERED_MEMORY_TEXT(Name, Text)
#endif

