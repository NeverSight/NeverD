A64_LEAF_TEXT(kErrorLeaves, R"c(
#ifdef NEVERD_TEST_FORWARD_ERROR
SWIFT __attribute__((noinline)) void *leaf_difference(void *, void * SELF, void ** ERROR);
#endif
SWIFT void *leaf_sum(void *next, void * SELF context, void ** ERROR error) {
#ifdef NEVERD_TEST_FORWARD_ERROR
  return leaf_difference(next, context, error);
#else
  return *error;
#endif
}
SWIFT void *leaf_difference(void *next, void * SELF context, void ** ERROR error) {
#ifdef NEVERD_TEST_CLEAR_ERROR
  *error = 0;
  return 0;
#else
  void *old = *error;
  *error = next;
  return old;
#endif
}
)c")
A64_LEAF_TEXT(kErrorCaller, R"c(
#include <dlfcn.h>
#include <stdint.h>
typedef SWIFT void *operation(void *next, void * SELF context, void ** ERROR error);
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image) return 2;
  operation *read = (operation *)dlsym(image, "leaf_sum");
  operation *replace = (operation *)dlsym(image, "leaf_difference");
  if (!read || !replace) return 3;
  uintptr_t storage[4];
  void *values[] = {0, &storage[0], &storage[1], &storage[2], &storage[3]};
  for (unsigned i = 0; i != sizeof(values) / sizeof(*values); ++i) {
    for (unsigned j = 0; j != sizeof(values) / sizeof(*values); ++j) {
      void *error = values[i];
#ifdef NEVERD_TEST_FORWARD_ERROR
      if (read(values[j], storage, &error) != values[i] || error != values[j])
        return 4;
      error = values[i];
#else
      if (read(values[j], storage, &error) != values[i] || error != values[i])
        return 4;
#endif
#ifdef NEVERD_TEST_CLEAR_ERROR
      if (replace(values[j], storage, &error) || error)
#else
      if (replace(values[j], storage, &error) != values[i] || error != values[j])
#endif
        return 5;
    }
  }
  return dlclose(image) != 0;
}
)c")
