A64_LEAF_TEXT(kScratchResultSource, R"asm(
.text
.p2align 2
.globl _leaf_sum
_leaf_sum:
.cfi_startproc
#ifdef NEVERD_TEST_SCRATCH_FORWARD
  b _scratch_results
.cfi_endproc
.globl _scratch_results
_scratch_results:
.cfi_startproc
#endif
  mov x8, x0
  mov x9, x1
  add x0, x8, x9
  ret
.cfi_endproc

.globl _leaf_difference
_leaf_difference:
.cfi_startproc
#ifdef NEVERD_TEST_SCRATCH_FRAME
.cfi_b_key_frame
.cfi_escape 0x2e,0
#endif
  pacibsp
  sub sp, sp, #32
  stp x29, x30, [sp, #16]
.cfi_def_cfa_offset 32
.cfi_offset x30, -8
.cfi_offset x29, -16
#ifdef NEVERD_TEST_SCRATCH_FRAME
  mov x29, sp
.cfi_def_cfa_register x29
#endif
  bl _leaf_sum
#ifdef NEVERD_TEST_SCRATCH_FRAME
#ifdef NEVERD_TEST_UNSUPPORTED_STACK_BODY
  rbit x12, x0
#endif
  mov x10,#1
  str x8,[sp,x10,lsl #3]
  ldr x8,[sp,w10,uxtw #3]
  sub x11,x10,#1
  str x9,[sp,w11,sxtw #3]
  ldr x9,[sp,x11,sxtx #3]
#endif
  sub x0, x8, x9
#ifdef NEVERD_TEST_SCRATCH_FRAME
.cfi_remember_state
  cbz x0, Lzero
  tbz x0, #40, Lpositive
  tbnz w0, #0, Lzero
Lpositive:
#endif
  ldp x29, x30, [sp, #16]
#ifdef NEVERD_TEST_SCRATCH_FRAME
.cfi_def_cfa sp,32
.cfi_restore x29
.cfi_restore x30
#endif
  add sp, sp, #32
#ifdef NEVERD_TEST_SCRATCH_FRAME
.cfi_def_cfa_offset 0
  autibsp
  ret
.cfi_restore_state
Lzero:
  ldp x29,x30,[sp,#16]
.cfi_def_cfa sp,32
.cfi_same_value x29
.cfi_same_value x30
  add sp,sp,#32
.cfi_def_cfa_offset 0
#endif
  retab
.cfi_endproc
.subsections_via_symbols
)asm")
A64_LEAF_TEXT(kRegisterCallerAssembly, R"asm(
.text
.p2align 2
.globl _observe
_observe:
#if __arm64e__
  pacibsp
#endif
  stp x29, x30, [sp, #-16]!
  mov x29, sp
  stp x19, x20, [sp, #-16]!
  sub sp, sp, #64
  mov x19, x3
  mov x16, x0
  mov x17, x1
  ldp x10, x11, [x2]
  stp x10, x11, [sp]
  ldp x10, x11, [x2, #16]
  stp x10, x11, [sp, #16]
  ldp x10, x11, [x2, #32]
  stp x10, x11, [sp, #32]
  ldp x10, x11, [x2, #48]
  stp x10, x11, [sp, #48]
  ldp x0, x1, [x17]
  ldp x2, x3, [x17, #16]
  ldp x4, x5, [x17, #32]
  ldp x6, x7, [x17, #48]
  mov x8, #68
  mov x9, #85
  fmov d0, xzr
#if __arm64e__
  blraaz x16
#else
  blr x16
#endif
  stp x0, x8, [x19]
  str x9, [x19, #16]
  str d0, [x19, #24]
  mov x10, sp
  str x10, [x19, #32]
  add sp, sp, #64
  ldp x19, x20, [sp], #16
  ldp x29, x30, [sp], #16
#if __arm64e__
  retab
#else
  ret
#endif
)asm")
A64_LEAF_TEXT(kRegisterCallerSource, R"c(
#include <dlfcn.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
typedef void (*entry)(void);
struct result { uint64_t x0, x8, x9, d0, sp; };
extern void observe(entry, const uint64_t *, const uint64_t *, struct result *);
int main(int argc, char **argv) {
  if (argc != 3) return 1;
  void *original = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  void *installed = dlopen(argv[2], RTLD_NOW | RTLD_LOCAL);
  if (!original || !installed) return 2;
  const char *names[] = {"leaf_sum", "leaf_difference", "va_walk", "va_named",
                         "va_sentinel", "va_direct", "va_copied", "va_wide", "va_fp"};
  for (unsigned i = 0; i != sizeof(names) / sizeof(*names); ++i) {
    entry a = (entry)dlsym(original, names[i]), b = (entry)dlsym(installed, names[i]);
    if (!a || !b || a == b) return 3;
    for (unsigned round = 0; round != 3; ++round) {
      uint64_t regs[8] = {round, 1, 2, 3, 4, 5, 6, 7};
      uint64_t args[8] = {9, 23, 7, 0, 1, 2, 3, 4};
      if (i < 2) regs[0] = 100;
      if (round == 1) args[0] = 0;
      struct result x, y;
      observe(a, regs, args, &x);
      observe(b, regs, args, &y);
      if (memcmp(&x, &y, sizeof(x))) {
        fprintf(stderr, "%s[%u] x0 %llx/%llx x8 %llx/%llx x9 %llx/%llx d0 %llx/%llx sp %llx/%llx\n",
                names[i], round, x.x0, y.x0, x.x8, y.x8, x.x9, y.x9,
                x.d0, y.d0, x.sp, y.sp);
        return 4;
      }
      if (i == 0 && x.x0 != 100 + args[0]) return 5;
      if (i == 1 && x.x0 != 77) return 6;
    }
  }
  return 0;
}
)c")
A64_LEAF_TEXT(kVariadicLeaves, R"c(
#include <stdarg.h>
typedef unsigned long word;
word leaf_sum(word seed, ...) {
  va_list args;
  va_start(args, seed);
  word first = va_arg(args, word);
  va_end(args);
  return seed + first;
}
word leaf_difference(word seed, ...) {
  va_list args;
  va_start(args, seed);
  (void)va_arg(args, word);
  word second = va_arg(args, word);
  va_end(args);
  return seed - second;
}
word va_walk(word count, ...) {
  va_list args;
  va_start(args, count);
  word sum = 0;
  while (count--)
    sum = sum * 5 + va_arg(args, word);
  va_end(args);
  return sum;
}
word va_named(word a, word b, word c, word d, word e, word f, word g,
              word h, word i, ...) {
  va_list args;
  va_start(args, i);
  word tail = va_arg(args, word);
  va_end(args);
  return a + i - tail;
}
__attribute__((noinline)) word va_sentinel(word unused, ...) {
  va_list args;
  va_start(args, unused);
  word total = 0;
  for (word n; (n = va_arg(args, word));)
    total = total * 7 + n;
  va_end(args);
  return total;
}
word va_direct(void) {
  return va_sentinel(123, 2UL, 4UL, 0UL);
}
word va_copied(word seed, ...) {
  va_list args, copy;
  va_start(args, seed);
  va_copy(copy, args);
  word first = va_arg(args, word), second = va_arg(args, word);
  word copied = va_arg(copy, word);
  va_end(copy);
  va_end(args);
  return ((seed + second) ^ first) - copied;
}
word va_wide(word seed, ...) {
  va_list args;
  va_start(args, seed);
  word first = va_arg(args, word);
  unsigned __int128 wide = va_arg(args, unsigned __int128);
  va_end(args);
  return seed - first + (word)(wide >> 64);
}
double va_fp(word seed, ...) {
  va_list args;
  va_start(args, seed);
  word first = va_arg(args, word);
  double second = va_arg(args, double);
  va_end(args);
  return (double)(seed + first) + second;
}
)c")
A64_LEAF_TEXT(kVariadicCaller, R"c(
#include <dlfcn.h>
#include <stdint.h>
typedef unsigned long word;
typedef word operation(word, ...);
#ifdef TEST_VARIADIC_EXTENDED
static int check_extended(void *image) {
  operation *walk = (operation *)dlsym(image, "va_walk");
  operation *copy = (operation *)dlsym(image, "va_copied");
  operation *wide = (operation *)dlsym(image, "va_wide");
  word (*named)(word, word, word, word, word, word, word, word, word, ...) =
      dlsym(image, "va_named");
  double (*fp)(word, ...) = dlsym(image, "va_fp");
  if (!walk || !copy || !wide || !named || !fp) return 5;
  const word high = UINT64_C(0x13579bdf2468ace0);
  const unsigned __int128 value = ((unsigned __int128)high << 64) | ~high;
  if (walk(0) || walk(3, 3UL, 9UL, 7UL) != 127) return 6;
  if (named(8, 2, 3, 4, 5, 6, 7, 8, 30, 11UL) != 27) return 7;
  if (copy(6, 3UL, 4UL) != 6) return 8;
  if (wide(10, 3UL, value) != high + 7) return 9;
  if (fp(10, 3UL, -2.5) != 10.5) return 10;
  operation *sentinel = (operation *)dlsym(image, "va_sentinel");
  word (*direct)(void) = dlsym(image, "va_direct");
  if (!sentinel || !direct) return 11;
  if (direct() != 18) return 12;
  if (sentinel(9, 0UL) || sentinel(1, 3UL, 1UL, 2UL, 0UL) != 156) return 13;
  return 0;
}
#endif
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image) return 2;
  operation *sum = (operation *)dlsym(image, "leaf_sum");
  operation *difference = (operation *)dlsym(image, "leaf_difference");
  if (!sum || !difference) return 3;
  const word values[] = {0, 1, UINT64_C(0x123456789abcdef), UINT64_MAX};
  for (unsigned i = 0; i < sizeof(values)/sizeof(*values); ++i)
    for (unsigned j = 0; j < sizeof(values)/sizeof(*values); ++j) {
      word seed = values[i], a = values[j], b = ~a;
#ifdef TEST_RESERVED_STACK
      if (sum(seed, a, b) != seed + b ||
#else
      if (sum(seed, a, b) != seed + a ||
#endif
          difference(seed, a, b) != seed - b)
        return 4;
    }
#ifdef TEST_VARIADIC_EXTENDED
  int result = check_extended(image);
  if (result) return result;
#endif
  return dlclose(image) != 0;
}
)c")
