  const int pre = 1;
#else
  const int pre = 0;
#endif
  struct load { unsigned bytes, count; int sign, word_result; };
  const struct load loads[] = {{1,1,0,0}, {1,1,1,0}, {1,1,1,1},
                              {2,1,0,0}, {2,1,1,0}, {2,1,1,1},
                              {4,1,0,0}, {4,1,1,0}, {8,1,0,0},
                              {4,2,0,0}, {4,2,1,0}, {8,2,0,0}};
  const struct load stores[] = {{1,1,0,0}, {2,1,0,0}, {4,1,0,0},
                               {8,1,0,0}, {4,2,0,0}, {8,2,0,0}};
  uint8_t source[96], output[96], expected[96];
  for (unsigned round = 0; round < 4; ++round) {
    for (unsigned i = 0; i < sizeof(source); ++i)
      source[i] = i * 37 + 129 + round * 53;
    unsigned offset = 0;
    uint64_t sum = 0;
    for (unsigned i = 0; i < sizeof(loads) / sizeof(*loads); ++i) {
      struct load l = loads[i];
      if (pre) offset += l.bytes * l.count;
      for (unsigned j = 0; j < l.count; ++j) {
        const void *at = source + offset + j * l.bytes;
        uint64_t value = 0;
        memcpy(&value, at, l.bytes);
        if (l.sign) {
          int64_t signed_value;
          if (l.bytes == 1) { int8_t x; memcpy(&x, at, 1); signed_value = x; }
          else if (l.bytes == 2) { int16_t x; memcpy(&x, at, 2); signed_value = x; }
          else { int32_t x; memcpy(&x, at, 4); signed_value = x; }
          value = l.word_result ? (uint32_t)signed_value : (uint64_t)signed_value;
