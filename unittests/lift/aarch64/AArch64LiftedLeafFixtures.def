  if (argc != 2) return 1;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image) return 2;
  uint64_t (*read)(const void *) = dlsym(image, "leaf_sum");
  void *(*write)(void *, uint64_t) = dlsym(image, "leaf_difference");
  if (!read || !write) return 3;
