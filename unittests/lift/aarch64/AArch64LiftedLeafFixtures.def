A64_LEAF_TEXT(kProcessImport, "getpid")
A64_LEAF_TEXT(kGlobalLeaves, R"c(
#include <stdint.h>
#include <unistd.h>
/* The selected word is past a 4-KiB ADRP boundary and has a nonzero PAGEOFF. */
uint64_t leaf_state[] = {[0] = UINT64_C(0x7369676e6564), [513] = 42};
uint64_t leaf_sum(void) { return leaf_state[513]; }
#ifdef NEVERD_TEST_FRAMED_IMPORT
uint64_t leaf_difference(void) { return (uint32_t)getpid() + leaf_state[513]; }
#else
int leaf_difference(void) { return getpid(); }
#endif
)c")
A64_LEAF_TEXT(kGlobalCaller, R"c(
#include <dlfcn.h>
#include <stdint.h>
#include <unistd.h>
int main(int argc, char **argv) {
  if (argc != 2) return 1;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image) return 2;
  uint64_t (*read_state)(void) = dlsym(image, "leaf_sum");
#ifdef NEVERD_TEST_FRAMED_IMPORT
  uint64_t (*process)(void) = dlsym(image, "leaf_difference");
#else
  int (*process)(void) = dlsym(image, "leaf_difference");
#endif
  uint64_t *words = dlsym(image, "leaf_state");
  if (!words || !read_state || !process || read_state() != 42) return 3;
  uint64_t *state = &words[513];
  const uint64_t values[] = {0, 1, UINT64_MAX, UINT64_C(1) << 63};
  for (unsigned i = 0; i < sizeof(values) / sizeof(*values); ++i) {
    *state = values[i];
    if (read_state() != *state || words[0] != UINT64_C(0x7369676e6564)) return 4;
#ifdef NEVERD_TEST_FRAMED_IMPORT
    if (process() != (uint32_t)getpid() + *state) return 5;
#else
    if (process() != getpid()) return 5;
#endif
  }
  return dlclose(image) != 0;
}
)c")
A64_LEAF_TEXT(kMemoryCaller, R"c(
#include <dlfcn.h>
#include <stdint.h>
int main(int argc, char **argv) {
  if (argc != 2)
    return 1;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image)
    return 2;
  typedef uint64_t (*load_fn)(const uint64_t *);
  typedef void (*store_fn)(uint64_t *, uint64_t);
  load_fn load = (load_fn)dlsym(image, "leaf_sum");
  store_fn store = (store_fn)dlsym(image, "leaf_difference");
  if (!load || !store)
    return 3;
  const uint64_t values[] = {0, 1, 17, UINT64_MAX, UINT64_C(1) << 63};
  for (unsigned i = 0; i != sizeof(values) / sizeof(*values); ++i)
    for (unsigned j = 0; j != sizeof(values) / sizeof(*values); ++j) {
      uint64_t words[] = {UINT64_C(0x3210), values[i], UINT64_C(0xabcd)};
      if (load(words) != values[i])
        return 4;
      store(words, values[j]);
      if (load(words) != values[j] || words[0] != UINT64_C(0x3210) ||
          words[1] != values[j] || words[2] != UINT64_C(0xabcd))
        return 5;
    }
  return dlclose(image) != 0;
}
)c")

