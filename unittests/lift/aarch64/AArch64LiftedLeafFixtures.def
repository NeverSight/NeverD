A64_LEAF_TEXT(kReservedStackLeaves, R"c(
#include <stdarg.h>
typedef unsigned long word;
word leaf_sum(word seed, ...) {
  va_list args;
  va_start(args, seed);
#ifdef TEST_RESTORE_ON_LOAD
  word value = va_arg(args, word);
#else
  word value = ((const word *)args)[1];
#endif
  va_end(args);
  return seed + value;
}
word leaf_difference(word seed, ...) {
  va_list args;
  va_start(args, seed);
  word value = ((const word *)args)[1];
  va_end(args);
  return seed - value;
}
)c")
A64_LEAF_TEXT(kStackLoadLeaves, R"asm(
.text
.p2align 2
.globl _leaf_sum
_leaf_sum:
.cfi_startproc
