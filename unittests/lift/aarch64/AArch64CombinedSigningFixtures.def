 .cfi_def_cfa_offset 32
 stur x15, [sp, #5]
)asm")
ASYNC_FRAME_TEXT(kCombinedLoadUnaligned, R"asm(
 ldur x15, [sp, #5]
 add sp, sp, #32
)asm")
