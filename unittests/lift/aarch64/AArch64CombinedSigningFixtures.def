)asm")
ASYNC_FRAME_TEXT(kCombinedDefault, "-DNEVERD_COMBINED_DEFAULT")
ASYNC_FRAME_TEXT(kCombinedArmSpill, "-DNEVERD_COMBINED_ARMSPILL")
ASYNC_FRAME_TEXT(kCombinedExitReload, "-DNEVERD_COMBINED_EXITRELOAD")
ASYNC_FRAME_TEXT(kCombinedBrokenCFI, "-DNEVERD_COMBINED_BROKENCFI")
ASYNC_FRAME_TEXT(kCombinedAdjacent, "-DNEVERD_COMBINED_ADJACENT")
ASYNC_FRAME_TEXT(kCombinedPartial, "-DNEVERD_COMBINED_PARTIAL")
ASYNC_FRAME_TEXT(kCombinedAlias, "-DNEVERD_COMBINED_ALIAS")
ASYNC_FRAME_TEXT(kCombinedReused, "-DNEVERD_COMBINED_REUSED")
ASYNC_FRAME_TEXT(kCombinedBadSP, "-DNEVERD_COMBINED_BADSP")
ASYNC_FRAME_TEXT(kCombinedBadCopy, "-DNEVERD_COMBINED_BADCOPY")
ASYNC_FRAME_TEXT(kCombinedConditional, "-DNEVERD_COMBINED_CONDITIONAL")
ASYNC_FRAME_TEXT(kCombinedOrderedByte, "-DNEVERD_COMBINED_ORDEREDBYTE")
ASYNC_FRAME_TEXT(kCombinedTornIndex, "-DNEVERD_COMBINED_TORNINDEX")
ASYNC_FRAME_TEXT(kCombinedLostLR, "-DNEVERD_COMBINED_LOSTLR")
ASYNC_FRAME_TEXT(kCombinedCall, "-DNEVERD_COMBINED_CALL")
ASYNC_FRAME_TEXT(kCombinedResign, "-DNEVERD_COMBINED_RESIGN")
ASYNC_FRAME_TEXT(kCombinedWrongKey, "-DNEVERD_COMBINED_WRONGKEY")
ASYNC_FRAME_TEXT(kCombinedBothLost, "-DNEVERD_COMBINED_BOTHLOST")
ASYNC_FRAME_TEXT(kCombinedBadFirst, "-DNEVERD_COMBINED_BADFIRST")
ASYNC_FRAME_TEXT(kCombinedBody, R"asm(
 .text
 .globl _signal_tick
 .p2align 2
_signal_tick:
 .cfi_startproc
#ifdef NEVERD_SIGN_WITH_B
#define SIGN .inst 0xdac1a7fe
#define AUTH .inst 0xdac195fe
#define OTHER_AUTH .inst 0xdac191fe
#else
#define SIGN .inst 0xdac1a3fe
#define AUTH .inst 0xdac191fe
#define OTHER_AUTH .inst 0xdac195fe
#endif
 .macro save_carrier
 {1}
 mov x10, xzr
 mov x15, xzr
 .endm
 .macro reload_carrier
 {2}
#ifdef NEVERD_COMBINED_BROKENCFI
 .cfi_adjust_cfa_offset -32
#else
 .cfi_def_cfa_offset 0
#endif
 .endm
 nop
 cbnz x1, Lright
Lfirst:
 SIGN
 adr x10, Lfirst
 {0}
#ifdef NEVERD_COMBINED_ARMSPILL
 .cfi_remember_state
 save_carrier
#endif
 b Ljoin
Lright:
#ifdef NEVERD_COMBINED_ARMSPILL
 .cfi_restore_state
#endif
Lsecond:
 SIGN
 adr x10, Lsecond
 {0}
#ifdef NEVERD_COMBINED_ARMSPILL
 save_carrier
#endif
Ljoin:
 .cfi_same_value x19
 .cfi_escape 0x2e, 0
#ifndef NEVERD_COMBINED_ARMSPILL
 save_carrier
#endif
#ifdef NEVERD_COMBINED_ADJACENT
 strb w1, [sp, #16]
#elif defined(NEVERD_COMBINED_PARTIAL)
 strb w1, [sp, #15]
#elif defined(NEVERD_COMBINED_ALIAS)
 str x1, [x2]
#elif defined(NEVERD_COMBINED_REUSED)
 add sp, sp, #32
 .cfi_def_cfa_offset 0
 sub sp, sp, #32
 .cfi_def_cfa_offset 32
#elif defined(NEVERD_COMBINED_CONDITIONAL)
 add x14, sp, #8
 stxr w12, x1, [x14]
#elif defined(NEVERD_COMBINED_ORDEREDBYTE)
 add x14, sp, #15
 stlrb w1, [x14]
#elif defined(NEVERD_COMBINED_TORNINDEX)
 mov w14, #1
 strh w1, [sp, w14, uxtw #1]
 mov w14, #7
 strh w1, [sp, w14, uxtw #1]
#endif
#if defined(NEVERD_COMBINED_EXITRELOAD) || defined(NEVERD_COMBINED_BROKENCFI)
 .cfi_remember_state
 cbnz x3, Lalternate
 reload_carrier
#else
 reload_carrier
 cbnz x3, Lalternate
#endif
#if defined(NEVERD_COMBINED_BADFIRST) || defined(NEVERD_COMBINED_BOTHLOST)
 mov w15, w15
#endif
 AUTH
 str x15, [x0]
 mov x0, x15
 ret
Lalternate:
#if defined(NEVERD_COMBINED_EXITRELOAD) || defined(NEVERD_COMBINED_BROKENCFI)
 .cfi_restore_state
 reload_carrier
#endif
#ifdef NEVERD_COMBINED_BADSP
 sub sp, sp, #32
 .cfi_def_cfa_offset 32
#elif defined(NEVERD_COMBINED_BADCOPY)
 mov w15, w15
#elif defined(NEVERD_COMBINED_LOSTLR) || defined(NEVERD_COMBINED_BOTHLOST)
 mov x30, x9
#elif defined(NEVERD_COMBINED_CALL)
 blr x4
#elif defined(NEVERD_COMBINED_RESIGN)
 pacibsp
#endif
#ifdef NEVERD_COMBINED_WRONGKEY
 OTHER_AUTH
#else
 AUTH
#endif
#ifdef NEVERD_COMBINED_BADSP
 add sp, sp, #32
 .cfi_def_cfa_offset 0
#endif
 str x15, [x0, #8]
 str x15, [x0]
 mov x0, x15
 ret
 .cfi_endproc
)asm")
#endif

