ASYNC_FRAME_TEXT(kCombinedMove, "mov x15, x10")
ASYNC_FRAME_TEXT(kCombinedAdd, "add x15, x10, #0")
ASYNC_FRAME_TEXT(kCombinedSub, "sub x15, x10, #0, lsl #12")
ASYNC_FRAME_TEXT(kCombinedOr, "orr x15, x10, xzr")
ASYNC_FRAME_TEXT(kCombinedXor, "eor x15, x10, xzr")
ASYNC_FRAME_TEXT(kCombinedAddReg, "add x15, x10, xzr")
ASYNC_FRAME_TEXT(kCombinedSubReg, "sub x15, x10, xzr")
ASYNC_FRAME_TEXT(kCombinedLsr, "lsr x15, x10, #0")
ASYNC_FRAME_TEXT(kCombinedAsr, "asr x15, x10, #0")
ASYNC_FRAME_TEXT(kCombinedRor, "ror x15, x10, #0")
ASYNC_FRAME_TEXT(kCombinedOrSelf, "orr x15, x10, x10")
ASYNC_FRAME_TEXT(kCombinedAndSelf, "and x15, x10, x10")
ASYNC_FRAME_TEXT(kCombinedXorLeft, "eor x15, xzr, x10")
ASYNC_FRAME_TEXT(kCombinedNarrow, "mov w15, w10")
ASYNC_FRAME_TEXT(kCombinedChanged, "add x15, x10, #1")
ASYNC_FRAME_TEXT(kCombinedShift, "orr x15, xzr, x10, lsl #1")
ASYNC_FRAME_TEXT(kCombinedShiftedSelf, "and x15, x10, x10, lsr #1")
ASYNC_FRAME_TEXT(kCombinedExtract, "extr x15, x11, x10, #0")
ASYNC_FRAME_TEXT(kCombinedSelect, "csel x15, x10, x10, eq")
ASYNC_FRAME_TEXT(kCombinedShiftReg, "lslv x15, x10, xzr")
ASYNC_FRAME_TEXT(kCombinedRotateReg, "rorv x15, x10, xzr")
ASYNC_FRAME_TEXT(kCombinedExtendedZero, "sub x15, x10, wzr, sxtw")
ASYNC_FRAME_TEXT(kCombinedOtherSelect, "csel x15, x10, x11, eq")
ASYNC_FRAME_TEXT(kCombinedLostExtract, "extr x15, x11, x10, #1")
ASYNC_FRAME_TEXT(kCombinedOtherShift, "lsrv x15, x10, x11")
ASYNC_FRAME_TEXT(kCombinedSaveOffset, R"asm(
 sub sp, sp, #32
 .cfi_def_cfa_offset 32
 str x15, [sp, #8]
)asm")
ASYNC_FRAME_TEXT(kCombinedLoadOffset, R"asm(
 ldr x15, [sp, #8]
 add sp, sp, #32
)asm")
ASYNC_FRAME_TEXT(kCombinedSavePairFirst, R"asm(
 sub sp, sp, #32
 .cfi_def_cfa_offset 32
 stp x15, xzr, [sp, #8]
)asm")
ASYNC_FRAME_TEXT(kCombinedLoadPairFirst, R"asm(
 ldp x15, x13, [sp, #8]
 add sp, sp, #32
)asm")
ASYNC_FRAME_TEXT(kCombinedSavePairSecond, R"asm(
 sub sp, sp, #32
 .cfi_def_cfa_offset 32
 stp xzr, x15, [sp]
)asm")
ASYNC_FRAME_TEXT(kCombinedLoadPairSecond, R"asm(
 ldp x13, x15, [sp]
 add sp, sp, #32
)asm")
ASYNC_FRAME_TEXT(kCombinedSavePairWriteback, R"asm(
 stp x13, x15, [sp, #-32]!
 .cfi_def_cfa_offset 32
)asm")
ASYNC_FRAME_TEXT(kCombinedLoadPairWriteback, R"asm(
 ldp x13, x15, [sp], #32
)asm")
ASYNC_FRAME_TEXT(kCombinedSaveScalarWriteback, R"asm(
 str x15, [sp, #-32]!
 .cfi_def_cfa_offset 32
)asm")
ASYNC_FRAME_TEXT(kCombinedLoadScalarWriteback, R"asm(
 ldr x15, [sp], #32
)asm")
ASYNC_FRAME_TEXT(kCombinedSaveUnaligned, R"asm(
