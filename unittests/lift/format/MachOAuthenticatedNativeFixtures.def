MACHO_AUTH_NATIVE_TEXT(kLegacyBindingSource, R"c(
extern const int retained;
typedef int (*Fn)(int);
static const int *volatile plain = &retained;
static const int *__ptrauth(2, 1, 0x3197) volatile checked = &retained;
static int plus(int x) {
  const int *value = plain;
  return value == &retained && checked == value ? x + *value : x;
}
static Fn __ptrauth(1, 1, 0x5371) volatile slot = plus;
extern int neverd_provider(void);
static __thread volatile int per_thread = 1;
static volatile int ready;
__attribute__((constructor)) static void initialize(void) { ready = 1; }
int entry(int x) { return slot(x) + neverd_provider() + per_thread - ready; }
)c")
MACHO_AUTH_NATIVE_TEXT(kGOTOnlySource, R"c(
