MACHO_AUTH_NATIVE_TEXT(kAnonymousFrameAssembly, R"asm(
.text
.p2align 2
.globl _replacement
_replacement:
.cfi_startproc
 b Lframe
.cfi_endproc
Lframe:
.cfi_startproc
#ifdef NEVERD_INDEXED_FRAME
.cfi_b_key_frame
#endif
#ifdef NEVERD_DATA_FRAME
 .data_region
 .long 0
 .end_data_region
#endif
#ifdef NEVERD_WRONG_KEY
 paciasp
#else
 pacibsp
#endif
#ifdef NEVERD_INDEXED_FRAME
.cfi_negate_ra_state
#endif
 stp x29, x30, [sp, #-16]!
#ifdef NEVERD_INDEXED_FRAME
.cfi_def_cfa_offset 16
.cfi_offset x29, -16
.cfi_offset x30, -8
#endif
 mov x29, sp
#ifndef NEVERD_INDEXED_FRAME
.cfi_def_cfa w29, 16
.cfi_offset w30, -8
.cfi_offset w29, -16
#else
.cfi_def_cfa_register x29
.cfi_escape 0x2e, 0
#endif
 bl _frame_callback
 add w0, w0, #17
 ldp x29, x30, [sp], #16
#ifdef NEVERD_INDEXED_FRAME
.cfi_def_cfa sp, 0
.cfi_restore x29
.cfi_restore x30
 autibsp
.cfi_negate_ra_state
 ret
#else
 retab
#endif
.cfi_endproc
Linitializer:
.cfi_startproc
 nop
 b _frame_init
.cfi_endproc
// More private functions than symbols exercise compact-unwind sizing.
.rept 24
1:
.cfi_startproc
 ret
.cfi_endproc
.endr
#ifdef NEVERD_INIT
.section __DATA,__mod_init_func,mod_init_funcs
.p2align 3
#ifdef NEVERD_INTERIOR_INIT
.set Linit_target,Linitializer+4
#else
.set Linit_target,Linitializer
#endif
#ifdef NEVERD_WRONG_INIT_KEY
 .quad Linit_target@AUTH(db,0)
#elif defined(NEVERD_SIGNED_INIT)
 .quad Linit_target@AUTH(ia,0)
#else
 .quad Linit_target
#endif
#endif
.subsections_via_symbols
)asm")
MACHO_AUTH_NATIVE_TEXT(kStandaloneFDEAssembly, R"asm(
.text
.p2align 2
.globl _replacement
_replacement:
 pacibsp
 stp x29, x30, [sp, #-16]!
 mov x29, sp
 bl _frame_callback
 add w0, w0, #17
 ldp x29, x30, [sp], #16
 autibsp
 ret
Lend:
#ifdef NEVERD_COMPACT_NEIGHBOR
Lcompact_leaf:
.cfi_startproc
 ret
.cfi_endproc
#endif
.section __TEXT,__eh_frame,coalesced,no_toc+strip_static_syms+live_support
.p2align 3
Lcie:
.long Lcie_end-Lcie_body
Lcie_body:
.long 0
.byte 1
.asciz "zR"
.uleb128 1
.sleb128 -8
// Return register LR and one byte of augmentation (PC-relative pointer).
.byte 30, 1, 0x10
// DW_CFA_def_cfa sp, 0.
.byte 0x0c, 31, 0
.p2align 3
Lcie_end:
.long Lfde_end-Lfde_body
Lfde_body:
.long .-Lcie
.quad _replacement-.
.quad Lend-_replacement
.byte 0
// After PACIBSP and STP, CFA = SP + 16, FP and LR are saved.
.byte 0x44
.byte 0x44, 0x0e, 16, 0x9d, 2, 0x9e, 1
// MOV establishes FP. The call site uses Darwin implicit signed LR.
.byte 0x44, 0x0d, 29, 0x2e, 0
// Restore SP, FP and LR after LDP.
.byte 0x4c, 0x0c, 31, 0, 0xdd, 0xde
.byte 0x44
.p2align 3
Lfde_end:
#if defined(NEVERD_CONFLICTING_EXTENT) || defined(NEVERD_MISSING_WRITER)
.section __LD,__compact_unwind,regular,debug
.p2align 3
#ifdef NEVERD_MISSING_WRITER
 .quad 0
#else
 .quad _replacement
#endif
 .long Lend-_replacement-4
 .long 0x04000000
 .quad 0, 0
#endif
.subsections_via_symbols
)asm")
MACHO_AUTH_NATIVE_TEXT(kAnonymousFrameSource, R"cpp(
extern "C" __attribute__((noinline)) int frame_callback(int value) {
  if (value < 0)
    throw value;
  return value + 1;
}
extern "C" __attribute__((noinline)) int original_entry(int value) {
  return frame_callback(value) + 3;
}
static int initialized;
extern "C" void frame_init() { ++initialized; }
extern "C" int frame_init_count() { return initialized; }
)cpp")
MACHO_AUTH_NATIVE_TEXT(kAnonymousFrameDriver, R"cpp(
#include <cstdlib>
#include <dlfcn.h>
int main(int argc, char **argv) {
  if (argc != 5)
    return 2;
  auto *image = dlopen(argv[1], RTLD_NOW);
  if (!image)
    return 3;
  auto entry = reinterpret_cast<int (*)(int)>(dlsym(image, argv[2]));
  auto count = reinterpret_cast<int (*)()>(dlsym(image, "frame_init_count"));
  if (!entry || !count || count() != std::atoi(argv[4]) ||
      entry(2) != std::atoi(argv[3]))
    return 4;
  try {
    entry(-23);
  } catch (int value) {
    if (value == -23)
      return 0;
  }
  return 5;
}
)cpp")
MACHO_AUTH_NATIVE_TEXT(kBindingAssembly, R"asm(
.text
.globl _entry
.p2align 2
_entry:
.cfi_startproc
  cbnz x0, Lfields
  adrp x16, _getpid@GOTPAGE
  ldr x16, [x16, _getpid@GOTPAGEOFF]
  cbz x16, Labsent
  b _getpid
Labsent:
  mov x0, #0
  ret
Lfields:
  cmp x0, #2
  b.ne LreturnFields
  adrp x16, getpid@GOTPAGE
  ldr x16, [x16, getpid@GOTPAGEOFF]
  cbz x16, Labsent
  b getpid
LreturnFields:
  cmp x0, #3
  b.eq LoriginalC
  cmp x0, #4
  b.eq LoriginalBare
  adrp x0, _binding_fields@PAGE
  add x0, x0, _binding_fields@PAGEOFF
  ret
LoriginalC:
#ifdef BIND_OBJECT
.globl binding_interior
.alt_entry binding_interior
binding_interior:
#endif
  adrp x0, _binding_code@PAGE
  add x0, x0, _binding_code@PAGEOFF
  ret
LoriginalBare:
  adrp x0, binding_code@PAGE
  add x0, x0, binding_code@PAGEOFF
  ret
.cfi_endproc
#ifdef BIND_OBJECT
#ifndef BIND_REFERENCE_ONLY
.globl binding_marker
#endif
binding_marker:
.cfi_startproc
#ifdef BIND_REFERENCE_ONLY
.cfi_escape 0x2e, 0
#endif
  b binding_helper
.cfi_endproc
binding_helper:
.cfi_startproc
  mov w0, #27
  ret
.cfi_endproc
#else
.globl _binding_marker
_binding_marker:
.cfi_startproc
  mov w0, #16
  ret
.cfi_endproc
#endif
#ifndef BIND_OBJECT
.private_extern _binding_code
.private_extern binding_code
_binding_code:
  ret
binding_code:
  ret
#endif
#ifndef BIND_WEAK
.weak_reference getpid
#endif
#ifdef BIND_WEAK
.weak_reference _getpid
#elif defined(BIND_OBJECT)
// N_REF_TO_WEAK on an undefined symbol still requires a definition.
.desc _getpid, 0x80
#endif
#ifdef BIND_REFERENCE_ONLY
#ifdef BIND_WEAK
.weak_reference _binding_fallback
#endif
#else
.data
.p2align 3
.globl _binding_fallback
.weak_definition _binding_fallback
_binding_fallback:
#ifdef BIND_OBJECT
  .quad 99
#else
  .quad 42
#endif
#endif
.section __DATA_CONST,__const
.p2align 3
.globl _binding_fields
_binding_fields:
  .quad (_getpid-4)@AUTH(da,0x1234,addr)
