MACHO_AUTH_NATIVE_TEXT(kRelroRuntimeSource, R"cpp(
#include <dlfcn.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <mach/mach.h>
#include <mach/mach_vm.h>
int main(int argc, char **argv) {
  if (argc != 4) return 1;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image) { fprintf(stderr, "%s\n", dlerror()); return 2; }
  uintptr_t anchor = (uintptr_t)dlsym(image, "new_slots");
  if (!anchor) return 3;
  auto *constant = (volatile uint64_t *)(anchor + strtoull(argv[2], nullptr, 0));
  auto *mutableData = (volatile uint64_t *)(anchor + strtoull(argv[3], nullptr, 0));
  if (*constant != 73 || *mutableData != 0) return 4;
  *mutableData = 19;
  if (*mutableData != 19) return 5;
  mach_vm_address_t address = (uintptr_t)constant;
  mach_vm_size_t size = 0;
  vm_region_basic_info_data_64_t info{};
  mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
  mach_port_t owner = MACH_PORT_NULL;
  auto status = mach_vm_region(mach_task_self(), &address, &size,
      VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &count, &owner);
  if (owner) mach_port_deallocate(mach_task_self(), owner);
  if (status || address > (uintptr_t)constant ||
      (uintptr_t)constant - address >= size ||
      !(info.protection & VM_PROT_READ) || (info.protection & VM_PROT_WRITE)) return 6;
  puts("native-relro-permissions-ok");
  return 0;
}
)cpp")
