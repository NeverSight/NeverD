MACHO_AUTH_NATIVE_TEXT(kRuntimeCapabilitySource, R"cpp(
#include <ptrauth.h>
#include <stdint.h>
#include <signal.h>
#include <stdio.h>
#include <sys/resource.h>
#include <sys/wait.h>
#include <unistd.h>
template <int Key> int checkKey() {
  volatile int Value = 42;
  void *Raw = (void *)&Value;
  uintptr_t Signed = 0, Difference = 0;
  unsigned Discriminator = 0;
  for (unsigned Salt = 1; Salt != 17; ++Salt) {
    void *Pointer = __builtin_ptrauth_sign_unauthenticated(Raw, Key, Salt);
    if (__builtin_ptrauth_auth(Pointer, Key, Salt) != Raw) return 1;
    Difference = (uintptr_t)Pointer ^ (uintptr_t)Raw;
    if (Difference) { Signed = (uintptr_t)Pointer; Discriminator = Salt; break; }
  }
  if (!Difference) return 77;
  // Flip a bit that signing changed; do not guess the host's PAC bit layout.
  const uintptr_t Corrupt = Signed ^ (Difference & -Difference);
  if (__builtin_ptrauth_strip((void *)Corrupt, Key) != Raw) return 2;
  for (unsigned Attempt = 0; Attempt != 2; ++Attempt) {
    const bool Invalid = Attempt != 0;
    const uintptr_t Candidate = Invalid ? Corrupt : Signed;
    const pid_t Child = fork();
    if (Child < 0)
      return 3;
    if (!Child) {
      auto *Pointer = (volatile int *)__builtin_ptrauth_auth(
          (void *)Candidate, Key, Discriminator);
      _exit(*Pointer == 42 ? 0 : 5);
    }
    int Status = 0;
    if (waitpid(Child, &Status, 0) != Child)
      return 6;
    const int Signal = WIFSIGNALED(Status) ? WTERMSIG(Status) : 0;
    printf("native-pac-key=%d invalid=%d child-status=%d child-signal=%d\n",
           Key, Invalid, Status, Signal);
    fflush(stdout);
    if (!Invalid) {
      if (!WIFEXITED(Status) || WEXITSTATUS(Status))
        return 9;
      continue;
    }
    // Clang's checked AUT/XPAC comparison traps with BRK 0xc470 + Key.
    if (Signal != SIGSEGV && Signal != SIGBUS && Signal != SIGILL &&
        Signal != SIGTRAP)
      return 7;
  }
  return 0;
}
int main() {
  puts("native-pac-enforcement-started");
  fflush(stdout);
  rlimit Limit{};
  if (setrlimit(RLIMIT_CORE, &Limit)) return 8;
  const int Results[] = {checkKey<0>(), checkKey<1>(), checkKey<2>(), checkKey<3>()};
  for (int Result : Results)
    if (Result && Result != 77) return Result;
  for (int Result : Results)
    if (Result) return Result;
  puts("native-pac-enforcement-ok");
  return 0;
}
)cpp")
