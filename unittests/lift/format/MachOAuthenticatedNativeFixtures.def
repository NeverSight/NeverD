MACHO_AUTH_NATIVE_TEXT(kRuntimeHarness, R"cpp(
#include <ptrauth.h>
#include <dlfcn.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <mach/mach.h>
#include <mach/mach_vm.h>
using Function = int (*)();
using OriginalFunction = int (*)(int);
using DataA = int * __ptrauth(2, 1, 4660);
using DataB = int * __ptrauth(3, 1, 4660);
#ifdef NEVERD_AUTH_CONTROL
extern "C" {
int native_dispatch();
int native_catch();
int native_cleanup();
extern int native_cleanups;
extern int neverd_should_throw;
int original_catch(int);
int cleanup_frame(int);
extern int cleanups;
extern DataA const native_local_data;
extern DataB const native_external_data;
}
#endif
int main(int argc, char **argv) {
#ifdef NEVERD_AUTH_CONTROL
  Function call = &native_dispatch;
  Function catching = &native_catch;
  Function cleanup = &native_cleanup;
  int *cleanups = &native_cleanups;
  int *throwFlag = &neverd_should_throw;
  OriginalFunction OriginalCatch = &original_catch;
  OriginalFunction OriginalCleanup = &cleanup_frame;
  int *OriginalCleanups = &::cleanups;
  if (*native_local_data != 9 || *native_external_data != 13) return 2;
  volatile int *mutableData = native_local_data;
  *mutableData = 19;
  if (*mutableData != 19) return 7;
  *mutableData = 9;
#else
  if (argc != 9) return 10;
  void *image = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
  if (!image) { fprintf(stderr, "%s\n", dlerror()); return 11; }
  const uintptr_t anchor = (uintptr_t)dlsym(image, "new_slots");
  int *throwFlag = (int *)dlsym(image, "neverd_should_throw");
  if (!anchor || !throwFlag) return 12;
  void *CatchAddress = dlsym(image, "original_catch");
  void *CleanupAddress = dlsym(image, "cleanup_frame");
  int *OriginalCleanups = (int *)dlsym(image, "cleanups");
  if (!CatchAddress || !CleanupAddress || !OriginalCleanups) return 19;
  OriginalFunction OriginalCatch = (OriginalFunction)ptrauth_sign_unauthenticated(
      ptrauth_strip(CatchAddress, ptrauth_key_function_pointer),
      ptrauth_key_function_pointer, 0);
  OriginalFunction OriginalCleanup = (OriginalFunction)ptrauth_sign_unauthenticated(
      ptrauth_strip(CleanupAddress, ptrauth_key_function_pointer),
      ptrauth_key_function_pointer, 0);
  Function call = (Function)ptrauth_sign_unauthenticated(
      (void *)(anchor + strtoull(argv[2], nullptr, 0)), ptrauth_key_function_pointer, 0);
  Function catching = (Function)ptrauth_sign_unauthenticated(
      (void *)(anchor + strtoull(argv[6], nullptr, 0)), ptrauth_key_function_pointer, 0);
  Function cleanup = (Function)ptrauth_sign_unauthenticated(
      (void *)(anchor + strtoull(argv[7], nullptr, 0)), ptrauth_key_function_pointer, 0);
  int *cleanups = (int *)(anchor + strtoull(argv[8], nullptr, 0));
  auto *local = (DataA const *)(anchor + strtoull(argv[3], nullptr, 0));
  auto *external = (DataB const *)(anchor + strtoull(argv[4], nullptr, 0));
  if (**local != 9 || **external != 13) return 13;
  volatile int *mutableData = *local;
  *mutableData = 19;
  if (*mutableData != 19) return 15;
  *mutableData = 9;
  const auto slot = anchor + strtoull(argv[5], nullptr, 0);
  mach_vm_address_t address = slot;
  mach_vm_size_t size = 0;
  vm_region_basic_info_data_64_t info{};
  mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
  mach_port_t owner = MACH_PORT_NULL;
  auto status = mach_vm_region(mach_task_self(), &address, &size,
      VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &count, &owner);
  if (owner) mach_port_deallocate(mach_task_self(), owner);
  if (status || address > slot || slot - address >= size ||
      (info.protection & VM_PROT_WRITE)) return 14;
#endif
  *OriginalCleanups = 0;
  if (OriginalCatch(71) != 71 || *OriginalCleanups != 1) return 20;
  try { (void)OriginalCleanup(71); return 21; }
  catch (int Value) { if (Value != 71 || *OriginalCleanups != 2) return 22; }
  if (call() != 49) return 3;
  *throwFlag = 1;
  try { (void)call(); return 4; }
  catch (int value) { if (value != 71) return 5; }
  *cleanups = 0;
  if (catching() != 93 || *cleanups != 1) return 16;
  try { (void)cleanup(); return 17; }
  catch (int value) { if (value != 71 || *cleanups != 2) return 18; }
  *throwFlag = 0;
  if (call() != 49 || catching() != 49 || *cleanups != 3) return 6;
  puts("native-auth-call-unwind-ok");
  return 0;
}
)cpp")

MACHO_AUTH_NATIVE_TEXT(kObjectSource, R"cpp(
#include <ptrauth.h>
extern "C" {
int neverd_provider();
extern int neverd_provider_data[2];
__attribute__((noinline)) int native_target() { return 42; }
int native_values[2] = {7, 9};
using Function = int (*)();
extern Function __ptrauth(0, 1, 4660) const volatile native_local_code
  __attribute__((section("__AUTH_CONST,__const"))) = &native_target;
extern Function __ptrauth(1, 1, 4660) const volatile native_external_code
  __attribute__((section("__AUTH_CONST,__const"))) = &neverd_provider;
extern int * __ptrauth(2, 1, 4660) const native_local_data
  __attribute__((section("__DATA_CONST,__const"))) = &native_values[1];
extern int * __ptrauth(3, 1, 4660) const native_external_data
  = &neverd_provider_data[1];
__attribute__((noinline)) int native_dispatch() {
  return native_local_code() + native_external_code();
}
extern int *const volatile native_plain_local = &native_values[1];
extern int *const volatile native_plain_external = &neverd_provider_data[1];
int native_cleanups = 0;
}
struct NativeGuard { ~NativeGuard(); };
NativeGuard::~NativeGuard() {
  (void)native_local_code();
  ++native_cleanups;
}
extern "C" __attribute__((noinline)) int native_catch() {
#ifdef NEVERD_DWARF_LANGUAGE
  asm volatile(".cfi_escape 0x2e, 0");
#endif
  NativeGuard guard;
  try { return native_dispatch(); }
  catch (int value) {
    return value + *native_plain_local + *native_plain_external;
  }
}
extern "C" __attribute__((noinline)) int native_cleanup() {
#ifdef NEVERD_DWARF_LANGUAGE
  asm volatile(".cfi_escape 0x2e, 0");
#endif
  NativeGuard guard;
  return native_dispatch();
}
)cpp")

