MACHO_AUTH_NATIVE_TEXT(kDarwinDestructorIR, R"ir(
target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64e-apple-macosx14.0.0"

@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [
  { i32, ptr, ptr } { i32 65535, ptr @start, ptr null }
]
@llvm.global_dtors = appending global [2 x { i32, ptr, ptr }] [
  { i32, ptr, ptr } { i32 100, ptr @late, ptr null },
  { i32, ptr, ptr } { i32 300, ptr @early, ptr @entry }
]

declare void @record_event(i32)

define internal void @start() #0 {
  call void @record_event(i32 1)
  ret void
}
define internal void @early() #0 {
  call void @record_event(i32 3)
  ret void
}
define internal void @late() #0 {
  call void @record_event(i32 2)
  ret void
}
define i32 @entry(i32 %x) #0 {
  ret i32 %x
}

attributes #0 = { nounwind uwtable(sync) "ptrauth-returns" }
!llvm.module.flags = !{!0, !3}
!0 = !{i32 6, !"ptrauth.abi-version", !1}
!1 = !{!2}
!2 = !{i32 0, i1 false}
!3 = !{i32 7, !"uwtable", i32 1}
)ir")
MACHO_AUTH_NATIVE_TEXT(kInvalidDestructorIR, R"ir(
target triple = "arm64e-apple-macosx14.0.0"
@llvm.global_dtors = appending global [1 x { i32, ptr, ptr }] [
  { i32, ptr, ptr } { i32 100, ptr @entry, ptr null }
]
define i32 @entry(i32 %x) {
  ret i32 %x
}
)ir")
