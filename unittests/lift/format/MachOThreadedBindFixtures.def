//===----------------------------------------------------------------------===//
/// \file
/// Independent on-disk bytes and expected values; no production encoding
/// helper participates in the oracle. VALUE, TEXT and BYTES name test data.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_THREADED_VALUE
#define NEVERD_THREADED_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_THREADED_TEXT
#define NEVERD_THREADED_TEXT(Name, Value)
#endif
#ifndef NEVERD_THREADED_BYTES
#define NEVERD_THREADED_BYTES(Name, ...)
#endif
#ifndef NEVERD_THREADED_MUTATION
#define NEVERD_THREADED_MUTATION(Name, Index, Byte)
#endif

