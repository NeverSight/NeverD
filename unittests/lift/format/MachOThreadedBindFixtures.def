                     "classic Objective-C producer requires Apple tools")
NEVERD_THREADED_TEXT(kClassicUnavailable,
                     "the selected Apple SDK has no ld-classic")
NEVERD_THREADED_TEXT(kClass, "ThreadedMetadata")
NEVERD_THREADED_TEXT(kSelector, "increment:")
NEVERD_THREADED_TEXT(kMethod, "-[ThreadedMetadata increment:]")
NEVERD_THREADED_TEXT(kSupported, "supported")
NEVERD_THREADED_TEXT(kWeakValue, "_threaded_weak_value")
NEVERD_THREADED_TEXT(kWeakFunction, "_threaded_weak_function")
NEVERD_THREADED_VALUE(int64_t, kWeakLookupOrdinal, -3)
NEVERD_THREADED_TEXT(kObjCSource, R"(
__attribute__((weak)) int threaded_weak_value = 7;
__attribute__((weak,noinline)) int threaded_weak_function(int value) {
  return value + threaded_weak_value;
}
int *threaded_weak_address = &threaded_weak_value;
int (*threaded_weak_function_pointer)(int) = threaded_weak_function;
__attribute__((objc_root_class))
@interface ThreadedMetadata
- (int)increment:(int)value;
@end
@implementation ThreadedMetadata
- (int)increment:(int)value { return value + 1; }
@end
)")

// One import with weak flag, library ordinal one and signed addend -4.
// Segment zero at offset zero is the chain root in the utility fixture.
NEVERD_THREADED_BYTES(kOneImport, 0xd0, 0x01, 0x11, 0x41, '_', 'i', 'm', 'p',
                      'o', 'r', 't', 0, 0x51, 0x60, 0x7c, 0x90, 0x70, 0, 0xd1,
                      0)
NEVERD_THREADED_BYTES(kRebasesOnly, 0xd0, 0, 0x70, 0, 0xd1, 0)
NEVERD_THREADED_BYTES(kTwoRoots, 0xd0, 0, 0x70, 0, 0xd1, 0x70, 0x10, 0xd1, 0)
NEVERD_THREADED_BYTES(kDuplicateRoots, 0xd0, 0, 0x70, 0, 0xd1, 0xd1, 0)
NEVERD_THREADED_BYTES(kMissingSize, 0xd0)
NEVERD_THREADED_BYTES(kBadSize, 0xd0, 0x80, 0x80, 0x04, 0)
NEVERD_THREADED_BYTES(kIncompleteTable, 0xd0, 1, 0x70, 0, 0xd1, 0)
NEVERD_THREADED_BYTES(kMissingTable, 0x70, 0, 0xd1, 0)
NEVERD_THREADED_BYTES(kRepeatedTable, 0xd0, 0, 0xd0, 0, 0)
NEVERD_THREADED_BYTES(kMissingSegment, 0xd0, 0, 0xd1, 0)
NEVERD_THREADED_BYTES(kBadSegment, 0xd0, 0, 0x7f, 0, 0xd1, 0)
NEVERD_THREADED_BYTES(kMisalignedRoot, 0xd0, 0, 0x70, 4, 0xd1, 0)
NEVERD_THREADED_BYTES(kUnknownSubopcode, 0xd2, 0)
NEVERD_THREADED_BYTES(kUnknownOpcode, 0xd0, 0, 0xe0, 0)
NEVERD_THREADED_BYTES(kTruncatedSymbol, 0xd0, 1, 0x40, '_')
NEVERD_THREADED_BYTES(kTruncatedSLEB, 0xd0, 0, 0x60, 0x80)
NEVERD_THREADED_BYTES(kOverflowULEB, 0xd0, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
                      0x80, 0x80, 0x80, 0x02)
// This ordinary stream's symbol payload contains the threaded opcode.
NEVERD_THREADED_BYTES(kOrdinaryPayload, 0x11, 0x40, '_', 0xd0, 'x', 0, 0x51,
                      0x70, 0, 0x90, 0)
NEVERD_THREADED_VALUE(va_t, kPayloadOffset, 0x50)
NEVERD_THREADED_VALUE(int64_t, kPayloadAddend, 80)
// 0xd0 is an operand byte in both LEB encodings, never a threaded opcode.
NEVERD_THREADED_BYTES(kOrdinaryULEBPayload, 0x11, 0x40, '_', 'p', 0, 0x51, 0x70,
                      0xd0, 0, 0x90, 0)
NEVERD_THREADED_BYTES(kOrdinarySLEBPayload, 0x11, 0x40, '_', 'p', 0, 0x51, 0x60,
                      0xd0, 0, 0x70, 0, 0x90, 0)
NEVERD_THREADED_BYTES(kOrdinaryPrefix, 0x11, 0x40, '_', 'p', 0, 0x51, 0x70, 0,
                      0x90)
NEVERD_THREADED_VALUE(size_t, kAddendByteOffset, 14)
NEVERD_THREADED_BYTES(kMinimumAddend, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
                      0x80, 0x80, 0x7f)

NEVERD_THREADED_MUTATION("missing library ordinal", 2, 0x51)
NEVERD_THREADED_MUTATION("out-of-range library ordinal", 2, 0x12)
NEVERD_THREADED_MUTATION("unknown special library ordinal", 2, 0x3c)
NEVERD_THREADED_MUTATION("reserved symbol flag", 3, 0x42)
NEVERD_THREADED_MUTATION("non-pointer bind type", 12, 0x52)
NEVERD_THREADED_MUTATION("missing pointer bind type", 12, 0x11)
NEVERD_THREADED_MUTATION("reserved DO_BIND immediate", 15, 0x91)
NEVERD_THREADED_MUTATION("too many ordinal records", 1, 0)
NEVERD_THREADED_MUTATION("incomplete ordinal table", 1, 2)
NEVERD_THREADED_MUTATION("reserved DONE immediate", 19, 1)

NEVERD_THREADED_BYTES(kTwoImports, 0xd0, 2, 0x12, 0x40, '_', 'i', 'm', 'p', 'o',
                      'r', 't', 0, 0x51, 0x60, 7, 0x90, 0x60, 0x7c, 0x90, 0x70,
                      0, 0xd1, 0)
NEVERD_THREADED_BYTES(kTwoLibraries, 0xd0, 2, 0x11, 0x40, '_', 'i', 'm', 'p',
                      'o', 'r', 't', 0, 0x51, 0x60, 7, 0x90, 0x12, 0x90, 0x70,
