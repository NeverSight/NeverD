ARM64E_DEPENDENCY_TEXT(kProducerAssembly, R"asm(
.text
.p2align 2
.globl _installed
_installed:
ret
.data
.p2align 3
.globl _slots
_slots:
.quad _installed@AUTH(ia,4660,addr)
.quad (_target-4)@AUTH(db,4660)
.subsections_via_symbols
)asm")

ARM64E_DEPENDENCY_TEXT(kProducerIR, R"ir(
@target = external global i8
@rebased = global ptr ptrauth (ptr @installed, i32 0, i64 4660, ptr @rebased), align 8
@bound = global [1 x ptr] [ptr ptrauth (ptr getelementptr(i8, ptr @target, i64 -4), i32 3, i64 4660)], align 8
define void @installed() {
  ret void
}
)ir")

ARM64E_DEPENDENCY_TEXT(kNestedProducerIR, R"ir(
@target = external global i8
@bound = global [1 x ptr] [ptr ptrauth (ptr getelementptr(i8, ptr @target, i64 -4), i32 3, i64 4660)], align 8
define void @installed() {
  ret void
}
)ir")

