NEVERD_COMPACT_PAGE_FIXTURE_INVALID_COMPRESSED(
    Overflow, 0xfffffff0, 0xffffffff, 0, 0x20,
    "compressed function delta overflows")
NEVERD_COMPACT_PAGE_FIXTURE_INVALID_COMPRESSED(
    OutsidePage, 0x100, 0x200, 0, 0x100,
    "compressed entry lies outside its page range")
NEVERD_COMPACT_PAGE_FIXTURE_INVALID_COMPRESSED(
    FirstEntryMismatch, 0x100, 0x300, 4, 0x100,
    "compressed page does not begin at its index key")
