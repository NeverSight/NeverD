//===- CompactUnwindPageFixtures.def - Page boundary oracles -*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Independent section layouts, mutation inputs and expected page bounds.
/// WORD/HALF rows describe literal little-endian fields; malformed cases use
/// the same layout across signed ARM64, ordinary ARM64 and x86-64 recipes.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_COMPACT_PAGE_FIXTURE_VALUE
#define NEVERD_COMPACT_PAGE_FIXTURE_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_COMPACT_PAGE_FIXTURE_MODE
#define NEVERD_COMPACT_PAGE_FIXTURE_MODE(TargetArch, Encoding)
#endif
#ifndef NEVERD_COMPACT_PAGE_FIXTURE_SINGLE_WORD
#define NEVERD_COMPACT_PAGE_FIXTURE_SINGLE_WORD(Offset, Value)
#endif
#ifndef NEVERD_COMPACT_PAGE_FIXTURE_SINGLE_HALF
