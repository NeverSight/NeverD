//===- CompactUnwindARM64Fixtures.def - ARM64 unwind oracles ---*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Independent compact-unwind fixture words and expected byte addresses from
/// the published LLVM libunwind format. VALUE(Type, Name, Value) declares
/// named inputs; REGISTER, INVALID_ENCODING, RANGE_CASE, PAYLOAD_CASE and
/// BAD_SECTION_RANGE provide the corresponding test tables. These rows never
/// derive their expected results from production encoding constants.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_COMPACT_ARM64_FIXTURE_VALUE
#define NEVERD_COMPACT_ARM64_FIXTURE_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_COMPACT_ARM64_FIXTURE_REGISTER
#define NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(Number)
#endif
#ifndef NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING
#define NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING(Encoding)
#endif
#ifndef NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE
#define NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(Name, Encoding, Begin, End,    \
                                                Valid)
#endif
#ifndef NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE
#define NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE(Encoding, Mask)
#endif
#ifndef NEVERD_COMPACT_ARM64_FIXTURE_BAD_SECTION_RANGE
#define NEVERD_COMPACT_ARM64_FIXTURE_BAD_SECTION_RANGE(Begin, End, Encoding)
#endif

NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kPAuthLRAllPairs, 0x05007f1f)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kPAuthLRFirst, 0x05000000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kPAuthLRFirstPair, 0x05000001)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kPAuthLRNextPair, 0x05001001)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kPAuthLRMaxOffset, 0x05fff000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kPAuthLRCompressedLocal,
                                   0x55003001)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kFrameWithoutSigning, 0x04000000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kUnknownMode, 0x06000000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kAllPairsSigningOffset, 28)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kFirstSigningOffset, 0)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kNextSigningOffset, 4)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kLocalSigningOffset, 12)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kMaxSigningOffset, 16380)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kAllPairsGPRMask, 0x1ff80000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kAllPairsFPRMask, 0x0000ff00)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kNoSavedRegisters, 0)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kRangeBegin, 0x1000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kRangeEnd, 0x2000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kMaximumOffsetRangeEnd, 0x5000)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kTruncatedMaximumOffsetRangeEnd,
                                   0x4fff)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kFirstRecipeRVA, 0x100)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kSecondRecipeRVA, 0x200)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(uint32_t, kTerminalRVA, 0x300)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kFirstRecipeSigningRVA, 0x104)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kSecondRecipeSigningRVA, 0x204)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kCompressedLocalSigningRVA, 0x20c)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(va_t, kOverflowImageHeadroom, 0x7f)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(size_t, kOneEntryCount, 1)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(size_t, kTwoEntryCount, 2)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(size_t, kCompressedCommonEncodingOffset, 28)
NEVERD_COMPACT_ARM64_FIXTURE_VALUE(size_t, kCompressedLocalEncodingOffset, 88)

NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(19)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(20)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(21)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(22)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(23)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(24)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(25)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(26)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(27)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(28)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(8)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(9)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(10)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(11)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(12)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(13)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(14)
NEVERD_COMPACT_ARM64_FIXTURE_REGISTER(15)

NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING(0x05000020u)
NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING(0x05000040u)
NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING(0x05000080u)
NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING(0x04001000u)
NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING(0x06000000u)

NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(FirstInstruction, 0x05000000, 0x1000,
                                        0x1004, true)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(TruncatedFirstInstruction, 0x05000000,
                                        0x1000, 0x1003, false)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(InstructionAtEnd, 0x05001000, 0x1000,
                                        0x1004, false)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(LastCompleteInstruction, 0x05001000,
                                        0x1000, 0x1008, true)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(UnalignedInstruction, 0x05000000,
                                        0x1001, 0x1009, false)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(EmptyRange, 0x05000000, 0x1000, 0x1000,
                                        false)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(CompleteNearAddressLimit, 0x05000000,
                                        0xfffffffffffffff8ULL,
                                        0xffffffffffffffffULL, true)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(TruncatedNearAddressLimit, 0x05001000,
                                        0xfffffffffffffff8ULL,
                                        0xffffffffffffffffULL, false)
NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE(WrappedRange, 0x05000000,
                                        0xfffffffffffffffcULL, 0, false)

NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE(0x05000000, 0x00ffff1f)
NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE(0x04000000, 0x00000f1f)
NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE(0x02000000, 0x00ffff1f)
NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE(0x03000000, 0x00ffffff)
NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE(0, 0)

NEVERD_COMPACT_ARM64_FIXTURE_BAD_SECTION_RANGE(0x100u, 0x104u, 0x05001000u)
NEVERD_COMPACT_ARM64_FIXTURE_BAD_SECTION_RANGE(0x100u, 0x103u, 0x05000000u)
NEVERD_COMPACT_ARM64_FIXTURE_BAD_SECTION_RANGE(0x101u, 0x109u, 0x05000000u)

#undef NEVERD_COMPACT_ARM64_FIXTURE_VALUE
#undef NEVERD_COMPACT_ARM64_FIXTURE_REGISTER
#undef NEVERD_COMPACT_ARM64_FIXTURE_INVALID_ENCODING
#undef NEVERD_COMPACT_ARM64_FIXTURE_RANGE_CASE
#undef NEVERD_COMPACT_ARM64_FIXTURE_PAYLOAD_CASE
#undef NEVERD_COMPACT_ARM64_FIXTURE_BAD_SECTION_RANGE
