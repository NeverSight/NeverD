//===- MIPSBitfieldKernels.def - Source roundtrip field examples ----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Name, assembly mnemonic, operation bits, insertion, position, field size.
MIPS_FIELD_KERNEL(mips_ext, ext, 32, 0, 5, 17)
MIPS_FIELD_KERNEL(mips_ext_full, ext, 32, 0, 0, 32)
MIPS_FIELD_KERNEL(mips_ins, ins, 32, 1, 7, 19)
// Name, assembly mnemonic, operation bits, source lane bytes, permutation.
MIPS_SHUFFLE_KERNEL(mips_seb, seb, 32, 1, 0)
MIPS_SHUFFLE_KERNEL(mips_seh, seh, 32, 2, 0)
MIPS_SHUFFLE_KERNEL(mips_wsbh, wsbh, 32, 1, 1)
#ifdef WIDE
MIPS_FIELD_KERNEL(mips_dext, dext, 64, 0, 31, 32)
MIPS_FIELD_KERNEL(mips_dextm, dextm, 64, 0, 7, 39)
MIPS_FIELD_KERNEL(mips_dextu, dextu, 64, 0, 40, 16)
MIPS_FIELD_KERNEL(mips_dext_full, dextm, 64, 0, 0, 64)
MIPS_FIELD_KERNEL(mips_dins, dins, 64, 1, 3, 17)
MIPS_FIELD_KERNEL(mips_dinsm, dinsm, 64, 1, 8, 48)
MIPS_FIELD_KERNEL(mips_dinsu, dinsu, 64, 1, 45, 19)
MIPS_FIELD_KERNEL(mips_dins_full, dinsm, 64, 1, 0, 64)
MIPS_SHUFFLE_KERNEL(mips_dsbh, dsbh, 64, 1, 1)
MIPS_SHUFFLE_KERNEL(mips_dshd, dshd, 64, 2, 2)
#endif

#undef MIPS_FIELD_KERNEL
#undef MIPS_SHUFFLE_KERNEL
