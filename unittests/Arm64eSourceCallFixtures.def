      "callback": "Pair callback(int tag, ...) { va_list ap; va_start(ap, tag); Pair value = va_arg(ap, Pair); va_end(ap); if (tag != 7 || value.low != 0x1122 || value.high != 0x3344) __builtin_trap(); return (Pair){0x5566,0x7788}; }",
