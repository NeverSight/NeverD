  "assembly_variadic_entry": ".globl _{name}\n_{name}:\n  sub sp,sp,#96\n  str x30,[sp,#88]\n  mov x16,x0\n  mov x17,x1\n",
  "assembly_variadic_exit": "  ldr x30,[sp,#88]\n  add sp,sp,#96\n  ret\n.p2align 2\n",
  "raw_call": "  blr x16\n",
  "native_triple": "arm64-apple-macos13",
  "native_flags": [
    "-std=c11",
    "-fblocks",
    "-fno-strict-aliasing"
  ],
  "native_header": "#include <stdint.h>\n#include <stdarg.h>\n",
  "native_main": "\nint main(void) {{ return (uint64_t){name}({arguments}) == {expected} ? 0 : 1; }}\n",
  "native_prototype": "extern long long {name}(long long, long long, {parameters});\n",
  "native_parameter": "long long",
  "native_header_arguments": [
    "(uintptr_t)&callback",
    "0"
  ],
  "native_argument": "({type})({value})",
  "native_callback_file": "{name}-callback.c",
  "native_host": [
    "Darwin",
    "arm64"
  ],
  "native_signature": "(?m)^([^\\n;{{}}]*\\b{name}\\(([^;{{}}]*)\\))\\s*\\{{",
  "native_parameter_name": "\\s*\\barg\\d+$",
  "native_entry_types": [
