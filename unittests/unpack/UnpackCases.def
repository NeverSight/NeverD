NEVERD_UNPACK_TEST_TEXT(FirstOutput, "first.exe")
NEVERD_UNPACK_TEST_TEXT(SecondOutput, "second.exe")
NEVERD_UNPACK_TEST_TEXT(StandardOutput, "report.json")
NEVERD_UNPACK_TEST_TEXT(Missing, "missing.exe")
NEVERD_UNPACK_TEST_TEXT(Unavailable, "unavailable")
NEVERD_UNPACK_TEST_TEXT(OrdinalPrefix, "#")
NEVERD_UNPACK_TEST_TEXT(FixtureBufferName, "fixture")
NEVERD_UNPACK_TEST_TEXT(NotPE32Plus, "not a PE32+ image")
NEVERD_UNPACK_TEST_TEXT(SupportedFormat, "pe64")
NEVERD_UNPACK_TEST_TEXT(ProcessProfile, "windows-pe64-v1")
NEVERD_UNPACK_TEST_TEXT(X64Architecture, "x86_64")
NEVERD_UNPACK_TEST_TEXT(ReportOutput, "out.exe")
NEVERD_UNPACK_TEST_TEXT(ScratchPrefix, "neverd-unpack")
