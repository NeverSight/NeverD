//===- SBFOfficialExecutionConstants.def - Execution oracle ABI -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_OFFICIAL_EXECUTION_CONSTANT(ID, RUST_ID, RUST_TYPE, CXX_TYPE, VALUE)
//
// Values shared by the C++ differential driver and detached Rust oracle live
// here so protocol limits, probe semantics, and pinned cardinalities cannot
// drift between the two implementations.
//
//===----------------------------------------------------------------------===//

