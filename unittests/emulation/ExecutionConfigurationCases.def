#ifdef NEVERD_CONFIGURATION_VALUE
NEVERD_CONFIGURATION_VALUE(PageSize, 4096)
NEVERD_CONFIGURATION_VALUE(MemoryLimit, 8 * PageSize)
NEVERD_CONFIGURATION_VALUE(Code, 0x10000)
NEVERD_CONFIGURATION_VALUE(Device, 0x20000)
NEVERD_CONFIGURATION_VALUE(DeviceValue, 42)
NEVERD_CONFIGURATION_VALUE(Timeout, 1000000)
NEVERD_CONFIGURATION_VALUE(ShortTimeout, 1000)
NEVERD_CONFIGURATION_VALUE(NativeAddressBits, 48)
NEVERD_CONFIGURATION_VALUE(PortableAddressBits, 64)
#endif
#ifdef NEVERD_CONFIGURATION_INVALID_TIMEOUT
NEVERD_CONFIGURATION_INVALID_TIMEOUT(Zero, 0)
NEVERD_CONFIGURATION_INVALID_TIMEOUT(UnsignedLimit, UINT64_MAX)
NEVERD_CONFIGURATION_INVALID_TIMEOUT(SignedLimit, INT64_MAX)
#endif
