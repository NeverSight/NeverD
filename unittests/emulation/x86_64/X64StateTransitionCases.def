#ifdef NEVERD_X64_TRANSITION_VALUE
NEVERD_X64_TRANSITION_VALUE(Code, 0x100000)
NEVERD_X64_TRANSITION_VALUE(Data, 0x200000)
NEVERD_X64_TRANSITION_VALUE(PageSize, 4096)
NEVERD_X64_TRANSITION_VALUE(Limit, 8 * 1024 * 1024)
NEVERD_X64_TRANSITION_VALUE(Timeout, 1'000'000)
NEVERD_X64_TRANSITION_VALUE(InitialFlags, 0x202)
NEVERD_X64_TRANSITION_VALUE(First, 0x123456789abcdef0ULL)
NEVERD_X64_TRANSITION_VALUE(Second, 0xfedcba9876543210ULL)
NEVERD_X64_TRANSITION_VALUE(WordBytes, 8)
NEVERD_X64_TRANSITION_VALUE(LoadGSOffset, 4)
NEVERD_X64_TRANSITION_VALUE(FaultOffset, 0x100)
NEVERD_X64_TRANSITION_VALUE(Rounds, 20)
NEVERD_X64_TRANSITION_VALUE(ResultOffset, 0x200)
NEVERD_X64_TRANSITION_VALUE(OtherResultOffset, 0x240)
NEVERD_X64_TRANSITION_VALUE(VectorOffset, 8)
NEVERD_X64_TRANSITION_VALUE(HighVectorOffset, 24)
NEVERD_X64_TRANSITION_VALUE(MXCSROffset, 40)
NEVERD_X64_TRANSITION_VALUE(ControlOffset, 44)
NEVERD_X64_TRANSITION_VALUE(FXOffset, 64)
NEVERD_X64_TRANSITION_VALUE(RoundingModes, 4)
NEVERD_X64_TRANSITION_VALUE(MXCSRRoundUnit, 0x2000)
NEVERD_X64_TRANSITION_VALUE(ControlRoundUnit, 0x400)
NEVERD_X64_TRANSITION_VALUE(FP80Base, 0x8000000000000000ULL)
NEVERD_X64_TRANSITION_VALUE(FP80High, 0x3fff)
// A pending unmasked invalid operation keeps saved metadata valid on AMD.
NEVERD_X64_TRANSITION_VALUE(FPInvalidException, 1)
NEVERD_X64_TRANSITION_VALUE(FPPendingStatus, 0x8081)
#endif
#ifdef NEVERD_X64_TRANSITION_CODE
// MOV RAX,FS:[RCX]; MOV RDX,GS:[RCX]. The host checks independent RAM values.
NEVERD_X64_TRANSITION_CODE(LoadTLS, 0x64, 0x48, 0x8b, 0x01, 0x65, 0x48, 0x8b,
                           0x11)
NEVERD_X64_TRANSITION_CODE(ReadCR8, 0x44, 0x0f, 0x20, 0xc0)
NEVERD_X64_TRANSITION_CODE(Divide, 0x48, 0xf7, 0xf3)
// ADD RAX,RBX; MOV [RCX],RAX; MOVDQU [RCX+8],XMM0;
// MOVDQU [RCX+24],XMM15; STMXCSR [RCX+40]; FNSTCW [RCX+44];
// FXSAVE64 [RCX+64]. Host changes occur between these real CPU instructions.
NEVERD_X64_TRANSITION_CODE(StoreState, 0x48, 0x01, 0xd8, 0x48, 0x89, 0x01, 0xf3,
                           0x0f, 0x7f, 0x41, 0x08, 0xf3, 0x44, 0x0f, 0x7f, 0x79,
                           0x18, 0x0f, 0xae, 0x59, 0x28, 0xd9, 0x79, 0x2c, 0x48,
                           0x0f, 0xae, 0x41, 0x40)
#endif
#ifdef NEVERD_X64_TRANSITION_LEVEL
NEVERD_X64_TRANSITION_LEVEL(0)
NEVERD_X64_TRANSITION_LEVEL(2)
NEVERD_X64_TRANSITION_LEVEL(15)
#endif
