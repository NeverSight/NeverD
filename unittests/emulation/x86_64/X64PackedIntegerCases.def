NEVERD_PACKED_OPERATION(PSUBB, _mm_sub_epi8, 0x66, 0x0f, 0xf8, 0xc1)
NEVERD_PACKED_OPERATION(PSUBW, _mm_sub_epi16, 0x66, 0x0f, 0xf9, 0xc1)
