#ifdef NEVERD_PACKED_VALUE
NEVERD_PACKED_VALUE(InputCount, 4)
NEVERD_PACKED_VALUE(InvalidFormCount, 3)
NEVERD_PACKED_VALUE(MMXForm, 0)
NEVERD_PACKED_VALUE(LockedForm, 1)
NEVERD_PACKED_VALUE(MisalignedForm, 2)
#endif
#ifdef NEVERD_PACKED_TEXT
NEVERD_PACKED_TEXT(ObserverFailure, "packed source observer failed")
#endif
#ifdef NEVERD_PACKED_OPERATION
// Name, independent compiler intrinsic and original XMM0,XMM1 encoding.
NEVERD_PACKED_OPERATION(PADDB, _mm_add_epi8, 0x66, 0x0f, 0xfc, 0xc1)
NEVERD_PACKED_OPERATION(PADDW, _mm_add_epi16, 0x66, 0x0f, 0xfd, 0xc1)
