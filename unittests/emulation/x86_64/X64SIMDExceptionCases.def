#ifdef NEVERD_SIMD_VALUE
NEVERD_SIMD_VALUE(Page, 4096)
NEVERD_SIMD_VALUE(Code, 0x100000)
NEVERD_SIMD_VALUE(Data, 0x200000)
NEVERD_SIMD_VALUE(Limit, 8 * 1024 * 1024)
NEVERD_SIMD_VALUE(Flags, 0x602)
NEVERD_SIMD_VALUE(DefaultMXCSR, 0x1f80)
NEVERD_SIMD_VALUE(Sticky, 0x3f)
NEVERD_SIMD_VALUE(MaskShift, 7)
NEVERD_SIMD_VALUE(Sentinel, 0x1234567887654321ULL)
NEVERD_SIMD_VALUE(One, 0x3f800000)
NEVERD_SIMD_VALUE(Two, 0x40000000)
NEVERD_SIMD_VALUE(Fill, 0xa5)
NEVERD_SIMD_VALUE(Vector, 19)
NEVERD_SIMD_VALUE(FourBytes, 4)
NEVERD_SIMD_VALUE(HalfPage, 0x800)
NEVERD_SIMD_VALUE(MemoryOperand, 0x01)
NEVERD_SIMD_VALUE(Timeout, 1'000'000)
NEVERD_SIMD_VALUE(FPTag, 0xff)
NEVERD_SIMD_VALUE(FPStatus, 0x1800)
NEVERD_SIMD_VALUE(FPSignificand, 0x8000000000000000ULL)
NEVERD_SIMD_VALUE(FPExponent, 0x3fff)
NEVERD_SIMD_VALUE(Nop, 0x90)
#endif
#ifdef NEVERD_SIMD_CASE
// Scalar SSE cases verified against original x64 host instructions. Fields:
// exception mask bit, source operands, new fault status, new masked status,
// masked result, repaired result and original register encoding. Clearing UM
// reports an exact tiny result; clearing OM changes when inexact status is
// calculated.
NEVERD_SIMD_CASE(Invalid, 1, 0, 0, 1, 1, 0xffc00000, One, 0xf3, 0x0f, 0x5e,
                 0xc1)
NEVERD_SIMD_CASE(Denormal, 2, 1, 0, 2, 2, 1, Two, 0xf3, 0x0f, 0x58, 0xc1)
NEVERD_SIMD_CASE(DivideByZero, 4, 0x3f800000, 0, 4, 4, 0x7f800000, One, 0xf3,
                 0x0f, 0x5e, 0xc1)
NEVERD_SIMD_CASE(Overflow, 8, 0x7f7fffff, 0x7f7fffff, 0x28, 0x28, 0x7f800000,
                 One, 0xf3, 0x0f, 0x59, 0xc1)
NEVERD_SIMD_CASE(Underflow, 16, 0x00800000, 0x00800000, 0x10, 0x30, 0, One,
                 0xf3, 0x0f, 0x59, 0xc1)
NEVERD_SIMD_CASE(ExactTiny, 16, 0x00800000, 0x3f000000, 0x10, 0, 0x00400000,
                 One, 0xf3, 0x0f, 0x59, 0xc1)
NEVERD_SIMD_CASE(ExactOverflow, 8, 0x7f7fffff, 0x40000000, 0x08, 0x28,
                 0x7f800000, One, 0xf3, 0x0f, 0x59, 0xc1)
NEVERD_SIMD_CASE(Precision, 32, 0x3f800000, 0x40400000, 32, 32, 0x3eaaaaab, One,
                 0xf3, 0x0f, 0x5e, 0xc1)
#endif

#ifdef NEVERD_SIMD_BACKEND
NEVERD_SIMD_BACKEND(kvmSupervisor, KVM, false)
NEVERD_SIMD_BACKEND(kvmUser, KVM, true)
NEVERD_SIMD_BACKEND(whpSupervisor, WHP, false)
NEVERD_SIMD_BACKEND(whpUser, WHP, true)
#endif
#ifdef NEVERD_SIMD_TEXT
NEVERD_SIMD_TEXT(Separator, "_")
#endif
