#ifdef NEVERD_FRAME_ENTRY_VALUE
NEVERD_FRAME_ENTRY_VALUE(DataPages, 8)
NEVERD_FRAME_ENTRY_VALUE(OracleDataPages, 32)
NEVERD_FRAME_ENTRY_VALUE(OracleStackPage, 24)
NEVERD_FRAME_ENTRY_VALUE(FaultResumeFlag, 0x10000)
NEVERD_FRAME_ENTRY_VALUE(Mirror, 0x400080000ULL)
NEVERD_FRAME_ENTRY_VALUE(PatternMultiplier, 37)
NEVERD_FRAME_ENTRY_VALUE(StackPage, 5)
NEVERD_FRAME_ENTRY_VALUE(FramePage, 3)
NEVERD_FRAME_ENTRY_VALUE(ProbePage, 1)
NEVERD_FRAME_ENTRY_VALUE(NestingMask, 31)
NEVERD_FRAME_ENTRY_VALUE(DefaultNesting, 3)
NEVERD_FRAME_ENTRY_VALUE(Allocation, 17)
NEVERD_FRAME_ENTRY_VALUE(ImmediateBytes, 3)
NEVERD_FRAME_ENTRY_VALUE(Limit, 1024 * 1024)
NEVERD_FRAME_ENTRY_VALUE(Page, 4096)
NEVERD_FRAME_ENTRY_VALUE(Code, 0x10000)
NEVERD_FRAME_ENTRY_VALUE(LowData, 0x20000)
NEVERD_FRAME_ENTRY_VALUE(Data, 0x100020000ULL)
NEVERD_FRAME_ENTRY_VALUE(Alias, 0x200040000ULL)
NEVERD_FRAME_ENTRY_VALUE(DeviceAddress, 0x300060000ULL)
NEVERD_FRAME_ENTRY_VALUE(SegmentBase, 0x50000)
NEVERD_FRAME_ENTRY_VALUE(Noncanonical, 0x800000000000ULL)
NEVERD_FRAME_ENTRY_VALUE(Offset, 1024)
NEVERD_FRAME_ENTRY_VALUE(WordBytes, 8)
NEVERD_FRAME_ENTRY_VALUE(ByteBits, 8)
NEVERD_FRAME_ENTRY_VALUE(Seed, 0x1122334455667788ULL)
NEVERD_FRAME_ENTRY_VALUE(Fill, 0xa5)
NEVERD_FRAME_ENTRY_VALUE(LowFill, 0x5a)
NEVERD_FRAME_ENTRY_VALUE(Nop, 0x90)
NEVERD_FRAME_ENTRY_VALUE(Flags, 0xed7)
NEVERD_FRAME_ENTRY_VALUE(Timeout, 1'000'000)
NEVERD_FRAME_ENTRY_VALUE(MXCSR, 0x5fa5)
NEVERD_FRAME_ENTRY_VALUE(FPCW, 0xb7f)
NEVERD_FRAME_ENTRY_VALUE(FPSW, 0x1800)
NEVERD_FRAME_ENTRY_VALUE(FPHigh, 0x3fff)
NEVERD_FRAME_ENTRY_VALUE(VectorCount, 16)
NEVERD_FRAME_ENTRY_VALUE(FPCount, 8)
NEVERD_FRAME_ENTRY_VALUE(OracleFields, 3)
NEVERD_FRAME_ENTRY_VALUE(OracleWords, 6)
#endif
#ifdef NEVERD_FRAME_ENTRY_TEXT
NEVERD_FRAME_ENTRY_TEXT(FaultOracleExecuted,
                        "original host frame entry faults: ")
NEVERD_FRAME_ENTRY_TEXT(FaultOracleUnavailable,
                        "the frame entry fault oracle requires Linux x64")
NEVERD_FRAME_ENTRY_TEXT(ObserverFailure, "frame entry read observer failed")
NEVERD_FRAME_ENTRY_TEXT(OracleUnavailable,
                        "the frame entry oracle requires x64")
NEVERD_FRAME_ENTRY_TEXT(OracleExecuted, "original host frame entries: ")
#endif
#ifdef NEVERD_FRAME_ENTRY_BACKEND
NEVERD_FRAME_ENTRY_BACKEND(kvmSupervisor, KVM, CheckedX64)
NEVERD_FRAME_ENTRY_BACKEND(kvmUser, KVM, CheckedUserX64)
NEVERD_FRAME_ENTRY_BACKEND(kvmDriver, KVM, Legacy)
NEVERD_FRAME_ENTRY_BACKEND(whpSupervisor, WHP, CheckedX64)
NEVERD_FRAME_ENTRY_BACKEND(whpUser, WHP, CheckedUserX64)
NEVERD_FRAME_ENTRY_BACKEND(whpDriver, WHP, Legacy)
NEVERD_FRAME_ENTRY_BACKEND(unicornSupervisor, Unicorn, CheckedX64)
NEVERD_FRAME_ENTRY_BACKEND(unicornUser, Unicorn, CheckedUserX64)
#endif
#ifdef NEVERD_FRAME_ENTRY_CASE
// Name, pushed width, original instruction bytes.
NEVERD_FRAME_ENTRY_CASE(Qword, 8, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(Word, 2, 0x66, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(AddressQword, 8, 0x67, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(AddressWord, 2, 0x66, 0x67, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(RexW, 8, 0x66, 0x48, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(OperandAfterRex, 2, 0x48, 0x66, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(RexAfterOperand, 2, 0x66, 0x40, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(LastRexWins, 2, 0x66, 0x48, 0x40, 0xc8, 0x00, 0x00,
                        0x03)
NEVERD_FRAME_ENTRY_CASE(RexAfterAddress, 8, 0x66, 0x67, 0x48, 0xc8, 0x00, 0x00,
                        0x03)
NEVERD_FRAME_ENTRY_CASE(AddressAfterRex, 2, 0x66, 0x48, 0x67, 0xc8, 0x00, 0x00,
                        0x03)
NEVERD_FRAME_ENTRY_CASE(FS, 8, 0x64, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(GSWord, 2, 0x65, 0x66, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(ExtendedRex, 8, 0x49, 0xc8, 0x00, 0x00, 0x03)
NEVERD_FRAME_ENTRY_CASE(ExtendedRexWord, 2, 0x66, 0x41, 0xc8, 0x00, 0x00, 0x03)
#endif
#ifdef NEVERD_FRAME_ENTRY_REJECTED_PREFIX
NEVERD_FRAME_ENTRY_REJECTED_PREFIX(0xf0)
NEVERD_FRAME_ENTRY_REJECTED_PREFIX(0xf2)
NEVERD_FRAME_ENTRY_REJECTED_PREFIX(0xf3)
#endif
#ifdef NEVERD_FRAME_ENTRY_ORACLE_REGISTER
NEVERD_FRAME_ENTRY_ORACLE_REGISTER(BP, 0)
NEVERD_FRAME_ENTRY_ORACLE_REGISTER(SP, 1)
NEVERD_FRAME_ENTRY_ORACLE_REGISTER(FLAGS, 2)
#endif
#ifdef NEVERD_FRAME_ENTRY_ORACLE_BYTES
// Preserve the host's frame and flags. R10 owns the packet and R11 keeps the
// caller's stack, so ENTER may consume a completely independent frame.
NEVERD_FRAME_ENTRY_ORACLE_BYTES(OraclePrefix, 0x55, 0x9c, 0x49, 0x89, 0xe3)
NEVERD_FRAME_ENTRY_ORACLE_BYTES(SysVArgument, 0x49, 0x89, 0xfa)
NEVERD_FRAME_ENTRY_ORACLE_BYTES(Win64Argument, 0x49, 0x89, 0xca)
NEVERD_FRAME_ENTRY_ORACLE_BYTES(OracleLoad, 0x41, 0xff, 0x72, 0x10, 0x9d, 0x49,
                                0x8b, 0x2a, 0x49, 0x8b, 0x62, 0x08)
NEVERD_FRAME_ENTRY_ORACLE_BYTES(OracleSave, 0x49, 0x89, 0x6a, 0x18, 0x49, 0x89,
                                0x62, 0x20, 0x4c, 0x89, 0xdc, 0x9c, 0x41, 0x8f,
                                0x42, 0x28, 0x9d, 0x5d, 0xc3)
#endif

#ifdef NEVERD_FRAME_ENTRY_LEVEL
NEVERD_FRAME_ENTRY_LEVEL(0)
NEVERD_FRAME_ENTRY_LEVEL(1)
NEVERD_FRAME_ENTRY_LEVEL(2)
NEVERD_FRAME_ENTRY_LEVEL(31)
NEVERD_FRAME_ENTRY_LEVEL(32)
NEVERD_FRAME_ENTRY_LEVEL(33)
NEVERD_FRAME_ENTRY_LEVEL(255)
#endif
#ifdef NEVERD_FRAME_ENTRY_FAULT
// Name, stack offset, frame offset, guard page, allocation, nesting, completed
// stores, failed access, fault offset, fault bytes. Width is the operand width.
NEVERD_FRAME_ENTRY_FAULT(FinalProbe, 5 * Page + Offset, 3 * Page + Offset, 1,
                         4 * Page - 4 * Width, 3, 4, Write, Page + Offset,
                         Width)
NEVERD_FRAME_ENTRY_FAULT(FirstAncestor, 5 * Page + Offset, 2 * Page + Width, 2,
                         0, 3, 1, Read, 2 * Page, Width)
NEVERD_FRAME_ENTRY_FAULT(SecondPush, 5 * Page + Width, 3 * Page + Offset, 4, 0,
                         1, 1, Write, 5 * Page - Width, Width)
NEVERD_FRAME_ENTRY_FAULT(SecondAncestor, 5 * Page + Offset, 3 * Page + Width, 2,
                         0, 3, 2, Read, 3 * Page - Width, Width)
NEVERD_FRAME_ENTRY_FAULT(SplitFirstPush, 5 * Page + Width / 2,
                         3 * Page + Offset, 5, 0, 0, 0, Write, 5 * Page,
                         Width / 2)
NEVERD_FRAME_ENTRY_FAULT(SplitFinalProbe, 5 * Page + Offset, 3 * Page + Offset,
                         2, 3 * Page + Offset + 1 - 4 * Width, 3, 4, Write,
                         2 * Page, Width - 1)
#endif

#ifdef NEVERD_FRAME_ENTRY_UNSUPPORTED_PREFIX
NEVERD_FRAME_ENTRY_UNSUPPORTED_PREFIX(Rex2, 0xd5, 0x00)
#endif
