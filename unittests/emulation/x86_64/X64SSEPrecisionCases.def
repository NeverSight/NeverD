#ifdef NEVERD_SSE_PRECISION_OPERATION
// Name, prefix, source bits, active lanes, memory alignment.
NEVERD_SSE_PRECISION_OPERATION(CVTSS2SD, 0xf3, 32, 1, 1)
NEVERD_SSE_PRECISION_OPERATION(CVTSD2SS, 0xf2, 64, 1, 1)
NEVERD_SSE_PRECISION_OPERATION(CVTPS2PD, 0, 32, 2, 1)
NEVERD_SSE_PRECISION_OPERATION(CVTPD2PS, 0x66, 64, 2, 16)
#endif
#ifdef NEVERD_SSE_PRECISION_VALUE
NEVERD_SSE_PRECISION_VALUE(Opcode, 0x5a)
NEVERD_SSE_PRECISION_VALUE(OpcodeMap, 0x0f)
NEVERD_SSE_PRECISION_VALUE(Rex, 0x40)
NEVERD_SSE_PRECISION_VALUE(RexDestination, 0x04)
NEVERD_SSE_PRECISION_VALUE(RexSource, 0x01)
NEVERD_SSE_PRECISION_VALUE(RegisterMask, 0x07)
NEVERD_SSE_PRECISION_VALUE(RegisterShift, 3)
NEVERD_SSE_PRECISION_VALUE(RegisterModRM, 0xc0)
NEVERD_SSE_PRECISION_VALUE(InitialMXCSR, 0x1f80)
NEVERD_SSE_PRECISION_VALUE(InvalidStatus, 0x01)
NEVERD_SSE_PRECISION_VALUE(DenormalStatus, 0x02)
NEVERD_SSE_PRECISION_VALUE(OverflowStatus, 0x08)
NEVERD_SSE_PRECISION_VALUE(UnderflowStatus, 0x10)
NEVERD_SSE_PRECISION_VALUE(PrecisionStatus, 0x20)
NEVERD_SSE_PRECISION_VALUE(ExistingStatus, 0x3f)
NEVERD_SSE_PRECISION_VALUE(FlushToZero, 0x8000)
NEVERD_SSE_PRECISION_VALUE(RoundingMask, 0x6000)
NEVERD_SSE_PRECISION_VALUE(RoundingShift, 13)
NEVERD_SSE_PRECISION_VALUE(PhysicalExponent, 0x3fff)
NEVERD_SSE_PRECISION_VALUE(SingleBits, 32)
NEVERD_SSE_PRECISION_VALUE(DoubleBits, 64)
NEVERD_SSE_PRECISION_VALUE(PatternStride, 37)
NEVERD_SSE_PRECISION_VALUE(ClearFlags, 0x202)
NEVERD_SSE_PRECISION_VALUE(DirectionFlag, 0x400)
#endif
#ifdef NEVERD_SSE_PRECISION_INPUT
// Additional narrowing boundaries. Common finite/NaN inputs are independent
// fixtures shared with X64SSEComparisonCases.def. Both signs are exercised.
NEVERD_SSE_PRECISION_INPUT(BelowHalfway, 0x3f800000, 0x3ff000000fffffffULL)
NEVERD_SSE_PRECISION_INPUT(Halfway, 0x3f800001, 0x3ff0000010000000ULL)
NEVERD_SSE_PRECISION_INPUT(AboveHalfway, 0x3f800002, 0x3ff0000010000001ULL)
NEVERD_SSE_PRECISION_INPUT(HalfwayOdd, 0x3f800003, 0x3ff0000030000000ULL)
NEVERD_SSE_PRECISION_INPUT(ExactFloatMax, 0x7f7fffff, 0x47efffffe0000000ULL)
NEVERD_SSE_PRECISION_INPUT(BelowOverflow, 0x7f7ffffe, 0x47efffffefffffffULL)
NEVERD_SSE_PRECISION_INPUT(OverflowHalfway, 0x7f7fffff, 0x47effffff0000000ULL)
NEVERD_SSE_PRECISION_INPUT(AboveOverflow, 0x7f7fffff, 0x47effffff0000001ULL)
NEVERD_SSE_PRECISION_INPUT(OverflowPower, 0x7f7fffff, 0x47f0000000000000ULL)
NEVERD_SSE_PRECISION_INPUT(ExactFloatMin, 0x00800000, 0x3810000000000000ULL)
NEVERD_SSE_PRECISION_INPUT(BelowFloatMin, 0x007fffff, 0x380fffffffffffffULL)
NEVERD_SSE_PRECISION_INPUT(BelowUnboundedHalfway, 0x007fffff, 0x380fffffefffffffULL)
NEVERD_SSE_PRECISION_INPUT(UnboundedHalfway, 0x00800000, 0x380ffffff0000000ULL)
NEVERD_SSE_PRECISION_INPUT(AboveUnboundedHalfway, 0x00800001, 0x380ffffff0000001ULL)
NEVERD_SSE_PRECISION_INPUT(BelowNormalHalfway, 0x007ffffe, 0x380fffffdfffffffULL)
NEVERD_SSE_PRECISION_INPUT(NormalHalfway, 0x007fffff, 0x380fffffe0000000ULL)
NEVERD_SSE_PRECISION_INPUT(AboveNormalHalfway, 0x00800001, 0x380fffffe0000001ULL)
NEVERD_SSE_PRECISION_INPUT(ExactFloatSubnormal, 0x007fffff, 0x380fffffc0000000ULL)
NEVERD_SSE_PRECISION_INPUT(ExactFloatTiny, 0x00000001, 0x36a0000000000000ULL)
NEVERD_SSE_PRECISION_INPUT(BelowTinyHalfway, 0x00000002, 0x368fffffffffffffULL)
NEVERD_SSE_PRECISION_INPUT(TinyHalfway, 0x00000003, 0x3690000000000000ULL)
NEVERD_SSE_PRECISION_INPUT(AboveTinyHalfway, 0x00000004, 0x3690000000000001ULL)
NEVERD_SSE_PRECISION_INPUT(LowPayloadQuietNaN, 0x7fc00001, 0x7ff8000000000001ULL)
NEVERD_SSE_PRECISION_INPUT(LowPayloadSignalingNaN, 0x7f800001, 0x7ff0000000000001ULL)
#endif
#ifdef NEVERD_SSE_PRECISION_BYTES
// Fourth oracle argument is {128-bit memory source, FLAGS}; preserve host DF.
NEVERD_SSE_PRECISION_BYTES(BeforeConversion, 0x9c, 0xff, 0x71, 0x10, 0x9d)
NEVERD_SSE_PRECISION_BYTES(AfterConversion, 0x9c, 0x58, 0x9d)
#endif
#ifdef NEVERD_SSE_PRECISION_INVALID
NEVERD_SSE_PRECISION_INVALID(VexSS, 0xc5, 0xfa, 0x5a, 0xc1)
NEVERD_SSE_PRECISION_INVALID(VexSD, 0xc5, 0xfb, 0x5a, 0x01)
NEVERD_SSE_PRECISION_INVALID(VexPS, 0xc5, 0xf8, 0x5a, 0xc1)
NEVERD_SSE_PRECISION_INVALID(VexPD, 0xc5, 0xf9, 0x5a, 0x01)
NEVERD_SSE_PRECISION_INVALID(EvexSS, 0x62, 0xf1, 0x7e, 0x08, 0x5a, 0xc1)
NEVERD_SSE_PRECISION_INVALID(EvexSD, 0x62, 0xf1, 0xff, 0x08, 0x5a, 0x01)
NEVERD_SSE_PRECISION_INVALID(EvexPS, 0x62, 0xf1, 0x7c, 0x08, 0x5a, 0xc1)
NEVERD_SSE_PRECISION_INVALID(EvexPD, 0x62, 0xf1, 0xfd, 0x08, 0x5a, 0x01)
#endif
#ifdef NEVERD_SSE_PRECISION_TEXT
NEVERD_SSE_PRECISION_TEXT(ObserverError, "SSE precision conversion observer failure")
#endif
