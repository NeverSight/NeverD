//===- X64MemoryUpdateCases.def - Scalar INC/DEC memory encodings ---------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_MEMORY_UPDATE
NEVERD_MEMORY_UPDATE(Inc8, 1, true, 0xfe, 0x01)
NEVERD_MEMORY_UPDATE(Inc16, 2, true, 0x66, 0xff, 0x01)
NEVERD_MEMORY_UPDATE(Inc32, 4, true, 0xff, 0x01)
NEVERD_MEMORY_UPDATE(Inc64, 8, true, 0x48, 0xff, 0x01)
NEVERD_MEMORY_UPDATE(Dec8, 1, false, 0xfe, 0x09)
NEVERD_MEMORY_UPDATE(Dec16, 2, false, 0x66, 0xff, 0x09)
NEVERD_MEMORY_UPDATE(Dec32, 4, false, 0xff, 0x09)
NEVERD_MEMORY_UPDATE(Dec64, 8, false, 0x48, 0xff, 0x09)
#endif
#ifdef NEVERD_MEMORY_UPDATE_VALUE
NEVERD_MEMORY_UPDATE_VALUE(InitialFlags, 0x202)
NEVERD_MEMORY_UPDATE_VALUE(Carry, 0x1)
NEVERD_MEMORY_UPDATE_VALUE(Zero, 0x40)
NEVERD_MEMORY_UPDATE_VALUE(Sign, 0x80)
NEVERD_MEMORY_UPDATE_VALUE(Canary, 0x123456789abcdef0ULL)
NEVERD_MEMORY_UPDATE_VALUE(LockPrefix, 0xf0)
#endif
