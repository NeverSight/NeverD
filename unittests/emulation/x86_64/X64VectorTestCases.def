NEVERD_VECTOR_VALUE(Lock, 0xf0)
NEVERD_VECTOR_VALUE(Flags, 0xad7)
NEVERD_VECTOR_VALUE(MXCSR, 0x5fa1)
NEVERD_VECTOR_VALUE(SentinelLow, 0x76543210abcdef01ULL)
NEVERD_VECTOR_VALUE(SentinelHigh, 0x123456789abcdef0ULL)
