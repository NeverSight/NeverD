//===- X64DoubleShiftCases.def - Independent SHLD/SHRD inputs -------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_DOUBLE_SHIFT_VALUE
NEVERD_DOUBLE_SHIFT_VALUE(Limit, 1024 * 1024)
NEVERD_DOUBLE_SHIFT_VALUE(Page, 4096)
NEVERD_DOUBLE_SHIFT_VALUE(Code, 0x10000)
NEVERD_DOUBLE_SHIFT_VALUE(Data, 0x20000)
NEVERD_DOUBLE_SHIFT_VALUE(Alias, 0x40000)
NEVERD_DOUBLE_SHIFT_VALUE(Device, 0x60000)
NEVERD_DOUBLE_SHIFT_VALUE(Timeout, 1'000'000)
NEVERD_DOUBLE_SHIFT_VALUE(Flags, 0xed7)
NEVERD_DOUBLE_SHIFT_VALUE(Reserved, 2)
NEVERD_DOUBLE_SHIFT_VALUE(Carry, 1)
NEVERD_DOUBLE_SHIFT_VALUE(Parity, 4)
NEVERD_DOUBLE_SHIFT_VALUE(Auxiliary, 0x10)
NEVERD_DOUBLE_SHIFT_VALUE(Zero, 0x40)
NEVERD_DOUBLE_SHIFT_VALUE(Sign, 0x80)
NEVERD_DOUBLE_SHIFT_VALUE(Overflow, 0x800)
NEVERD_DOUBLE_SHIFT_VALUE(Seed, 0x1234567887654321ULL)
NEVERD_DOUBLE_SHIFT_VALUE(Source, 0xfedcba9876543210ULL)
NEVERD_DOUBLE_SHIFT_VALUE(Fill, 0xa5)
NEVERD_DOUBLE_SHIFT_VALUE(Nop, 0x90)
NEVERD_DOUBLE_SHIFT_VALUE(Lock, 0xf0)
NEVERD_DOUBLE_SHIFT_VALUE(Escape, 0x0f)
NEVERD_DOUBLE_SHIFT_VALUE(Operand16, 0x66)
NEVERD_DOUBLE_SHIFT_VALUE(Operand64, 0x48)
NEVERD_DOUBLE_SHIFT_VALUE(RegisterDestination, 0xd0)
NEVERD_DOUBLE_SHIFT_VALUE(MemoryDestination, 0x16)
NEVERD_DOUBLE_SHIFT_VALUE(CLFormOffset, 1)
NEVERD_DOUBLE_SHIFT_VALUE(WordBytes, 8)
NEVERD_DOUBLE_SHIFT_VALUE(DWordBytes, 4)
NEVERD_DOUBLE_SHIFT_VALUE(HalfWordBytes, 2)
NEVERD_DOUBLE_SHIFT_VALUE(MXCSR, 0x5fa5)
NEVERD_DOUBLE_SHIFT_VALUE(FPCW, 0xb7f)
NEVERD_DOUBLE_SHIFT_VALUE(FPSW, 0x1800)
NEVERD_DOUBLE_SHIFT_VALUE(VectorCount, 16)
NEVERD_DOUBLE_SHIFT_VALUE(FPCount, 8)
NEVERD_DOUBLE_SHIFT_VALUE(FPHigh, 0x3fff)
NEVERD_DOUBLE_SHIFT_VALUE(ProbeCount, 5)
NEVERD_DOUBLE_SHIFT_VALUE(UndefinedCount, 17)
NEVERD_DOUBLE_SHIFT_VALUE(ADCBytes, 4)
NEVERD_DOUBLE_SHIFT_VALUE(StoreBytes, 3)
#endif
#ifdef NEVERD_DOUBLE_SHIFT_TEXT
NEVERD_DOUBLE_SHIFT_TEXT(ObserverFailure, "double-shift write observer failed")
NEVERD_DOUBLE_SHIFT_TEXT(OracleUnavailable,
                         "the independent double-shift oracle requires x64")
#endif
#ifdef NEVERD_DOUBLE_SHIFT_CASE
NEVERD_DOUBLE_SHIFT_CASE(Left16, 2, true, 0xa4)
NEVERD_DOUBLE_SHIFT_CASE(Left32, 4, true, 0xa4)
NEVERD_DOUBLE_SHIFT_CASE(Left64, 8, true, 0xa4)
NEVERD_DOUBLE_SHIFT_CASE(Right16, 2, false, 0xac)
NEVERD_DOUBLE_SHIFT_CASE(Right32, 4, false, 0xac)
NEVERD_DOUBLE_SHIFT_CASE(Right64, 8, false, 0xac)
#endif
#ifdef NEVERD_DOUBLE_SHIFT_ALIAS
NEVERD_DOUBLE_SHIFT_ALIAS(DestinationCX, CX, DX, 0xd1, 0)
NEVERD_DOUBLE_SHIFT_ALIAS(SourceCX, AX, CX, 0xc8, 0)
NEVERD_DOUBLE_SHIFT_ALIAS(SameRegister, AX, AX, 0xc0, 0)
NEVERD_DOUBLE_SHIFT_ALIAS(ExtendedRegisters, R8, R9, 0xc8, 0x45)
#endif
#ifdef NEVERD_DOUBLE_SHIFT_COUNT
NEVERD_DOUBLE_SHIFT_COUNT(0)
NEVERD_DOUBLE_SHIFT_COUNT(1)
NEVERD_DOUBLE_SHIFT_COUNT(2)
NEVERD_DOUBLE_SHIFT_COUNT(15)
NEVERD_DOUBLE_SHIFT_COUNT(16)
NEVERD_DOUBLE_SHIFT_COUNT(31)
NEVERD_DOUBLE_SHIFT_COUNT(32)
NEVERD_DOUBLE_SHIFT_COUNT(63)
NEVERD_DOUBLE_SHIFT_COUNT(64)
NEVERD_DOUBLE_SHIFT_COUNT(127)
NEVERD_DOUBLE_SHIFT_COUNT(255)
#endif
#ifdef NEVERD_DOUBLE_SHIFT_BYTES
NEVERD_DOUBLE_SHIFT_BYTES(OraclePrefix, 0x53, 0x9c)
NEVERD_DOUBLE_SHIFT_BYTES(SysVArgument, 0x48, 0x89, 0xfb)
NEVERD_DOUBLE_SHIFT_BYTES(Win64Argument, 0x48, 0x89, 0xcb)
// Packet: AX, DX, CX, effective input FLAGS, result AX, result FLAGS.
// Record the flags actually installed at host CPL3 before the tested opcode.
NEVERD_DOUBLE_SHIFT_BYTES(OracleLoad, 0x48, 0x8b, 0x03, 0x48, 0x8b, 0x53, 0x08,
                          0x48, 0x8b, 0x4b, 0x10, 0xff, 0x73, 0x18, 0x9d, 0x9c,
                          0x8f, 0x43, 0x18)
NEVERD_DOUBLE_SHIFT_BYTES(OracleSave, 0x48, 0x89, 0x43, 0x20, 0x9c, 0x8f, 0x43,
                          0x28, 0x9d, 0x5b, 0xc3)
NEVERD_DOUBLE_SHIFT_BYTES(Continuation, 0x48, 0x83, 0xd0, 0x00, 0x48, 0x89,
                          0x07, 0x90)
#endif
#ifdef NEVERD_DOUBLE_SHIFT_BACKEND
NEVERD_DOUBLE_SHIFT_BACKEND(kvmSupervisor, KVM, CheckedX64)
NEVERD_DOUBLE_SHIFT_BACKEND(kvmUser, KVM, CheckedUserX64)
NEVERD_DOUBLE_SHIFT_BACKEND(kvmDriver, KVM, Legacy)
NEVERD_DOUBLE_SHIFT_BACKEND(whpSupervisor, WHP, CheckedX64)
NEVERD_DOUBLE_SHIFT_BACKEND(whpUser, WHP, CheckedUserX64)
NEVERD_DOUBLE_SHIFT_BACKEND(whpDriver, WHP, Legacy)
NEVERD_DOUBLE_SHIFT_BACKEND(unicornSupervisor, Unicorn, CheckedX64)
NEVERD_DOUBLE_SHIFT_BACKEND(unicornUser, Unicorn, CheckedUserX64)
#endif
