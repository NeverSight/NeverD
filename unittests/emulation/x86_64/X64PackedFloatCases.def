//===- X64PackedFloatCases.def - Packed signed integer to SSE float -----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_PACKED_FLOAT_OPERATION
// Name, prefix, opcode, active signed32 inputs, result width, alignment.
NEVERD_PACKED_FLOAT_OPERATION(CVTDQ2PS, 0, 0x5b, 4, 32, 16)
NEVERD_PACKED_FLOAT_OPERATION(CVTDQ2PD, 0xf3, 0xe6, 2, 64, 1)
#endif
#ifdef NEVERD_PACKED_FLOAT_VALUE
NEVERD_PACKED_FLOAT_VALUE(OpcodeMap, 0x0f)
NEVERD_PACKED_FLOAT_VALUE(Rex, 0x40)
NEVERD_PACKED_FLOAT_VALUE(RexDestination, 0x04)
NEVERD_PACKED_FLOAT_VALUE(RexSource, 0x01)
NEVERD_PACKED_FLOAT_VALUE(RegisterMask, 0x07)
NEVERD_PACKED_FLOAT_VALUE(RegisterShift, 3)
NEVERD_PACKED_FLOAT_VALUE(RegisterModRM, 0xc0)
NEVERD_PACKED_FLOAT_VALUE(InitialMXCSR, 0x1f80)
NEVERD_PACKED_FLOAT_VALUE(PrecisionStatus, 0x20)
NEVERD_PACKED_FLOAT_VALUE(ExistingStatus, 0x3f)
NEVERD_PACKED_FLOAT_VALUE(FlushToZero, 0x8000)
NEVERD_PACKED_FLOAT_VALUE(RoundingMask, 0x6000)
NEVERD_PACKED_FLOAT_VALUE(RoundingShift, 13)
NEVERD_PACKED_FLOAT_VALUE(PhysicalExponent, 0x3fff)
NEVERD_PACKED_FLOAT_VALUE(SingleBits, 32)
NEVERD_PACKED_FLOAT_VALUE(DoubleBits, 64)
NEVERD_PACKED_FLOAT_VALUE(PatternStride, 37)
NEVERD_PACKED_FLOAT_VALUE(ClearFlags, 0x202)
NEVERD_PACKED_FLOAT_VALUE(DirectionFlag, 0x400)
#endif
#ifdef NEVERD_PACKED_FLOAT_INPUT
NEVERD_PACKED_FLOAT_INPUT(Zero, 0x00000000)
NEVERD_PACKED_FLOAT_INPUT(One, 0x00000001)
NEVERD_PACKED_FLOAT_INPUT(Two, 0x00000002)
NEVERD_PACKED_FLOAT_INPUT(Three, 0x00000003)
NEVERD_PACKED_FLOAT_INPUT(NegativeOne, 0xffffffff)
NEVERD_PACKED_FLOAT_INPUT(NegativeTwo, 0xfffffffe)
NEVERD_PACKED_FLOAT_INPUT(Minimum, 0x80000000)
NEVERD_PACKED_FLOAT_INPUT(AboveMinimum, 0x80000001)
NEVERD_PACKED_FLOAT_INPUT(Maximum, 0x7fffffff)
NEVERD_PACKED_FLOAT_INPUT(BelowMaximum, 0x7ffffffe)
NEVERD_PACKED_FLOAT_INPUT(Below24, 0x00ffffff)
NEVERD_PACKED_FLOAT_INPUT(Exact24, 0x01000000)
NEVERD_PACKED_FLOAT_INPUT(Halfway24, 0x01000001)
NEVERD_PACKED_FLOAT_INPUT(Even24, 0x01000002)
NEVERD_PACKED_FLOAT_INPUT(Odd24, 0x01000003)
NEVERD_PACKED_FLOAT_INPUT(NegativeHalfway24, 0xfeffffff)
NEVERD_PACKED_FLOAT_INPUT(NegativeEven24, 0xfefffffe)
NEVERD_PACKED_FLOAT_INPUT(NegativeOdd24, 0xfefffffd)
NEVERD_PACKED_FLOAT_INPUT(Below25, 0x01ffffff)
NEVERD_PACKED_FLOAT_INPUT(Halfway25, 0x02000002)
NEVERD_PACKED_FLOAT_INPUT(Odd25, 0x02000006)
NEVERD_PACKED_FLOAT_INPUT(Below31, 0x7fffff80)
NEVERD_PACKED_FLOAT_INPUT(Halfway31, 0x7fffffc0)
NEVERD_PACKED_FLOAT_INPUT(AboveHalfway31, 0x7fffffc1)
#endif
#ifdef NEVERD_PACKED_FLOAT_BYTES
// Fourth oracle argument is {128-bit memory source, FLAGS}; preserve host DF.
NEVERD_PACKED_FLOAT_BYTES(BeforeConversion, 0x9c, 0xff, 0x71, 0x10, 0x9d)
NEVERD_PACKED_FLOAT_BYTES(AfterConversion, 0x9c, 0x58, 0x9d)
#endif
#ifdef NEVERD_PACKED_FLOAT_INVALID
NEVERD_PACKED_FLOAT_INVALID(VexPS, 0xc5, 0xf8, 0x5b, 0xc1)
NEVERD_PACKED_FLOAT_INVALID(VexPD, 0xc5, 0xfa, 0xe6, 0x01)
NEVERD_PACKED_FLOAT_INVALID(EvexPS, 0x62, 0xf1, 0x7c, 0x08, 0x5b, 0xc1)
NEVERD_PACKED_FLOAT_INVALID(EvexPD, 0x62, 0xf1, 0x7e, 0x08, 0xe6, 0x01)
NEVERD_PACKED_FLOAT_INVALID(MMXToPS, 0x0f, 0x2a, 0xc0)
NEVERD_PACKED_FLOAT_INVALID(MMXToPD, 0x66, 0x0f, 0x2a, 0xc0)
#endif
#ifdef NEVERD_PACKED_FLOAT_TEXT
NEVERD_PACKED_FLOAT_TEXT(ObserverError, "packed integer to float observer failure")
#endif
