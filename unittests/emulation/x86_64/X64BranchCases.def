//===- X64BranchCases.def - Original relative-branch encodings ---------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_BRANCH_VALUE
NEVERD_BRANCH_VALUE(Limit, 1024 * 1024)
NEVERD_BRANCH_VALUE(Page, 4096)
NEVERD_BRANCH_VALUE(Code, 0x10000)
NEVERD_BRANCH_VALUE(LowCode, 0)
NEVERD_BRANCH_VALUE(HighCode, 0x100010000ULL)
NEVERD_BRANCH_VALUE(Data, 0x20000)
NEVERD_BRANCH_VALUE(EntryOffset, 1024)
NEVERD_BRANCH_VALUE(Timeout, 1'000'000)
NEVERD_BRANCH_VALUE(ZeroFlag, 0x40)
NEVERD_BRANCH_VALUE(SetFlags, 0xed7)
NEVERD_BRANCH_VALUE(ClearFlags, 2)
NEVERD_BRANCH_VALUE(Seed, 0x1234567887654321ULL)
NEVERD_BRANCH_VALUE(Source, 0xfedcba9876543210ULL)
NEVERD_BRANCH_VALUE(Fill, 0xa5)
NEVERD_BRANCH_VALUE(Nop, 0x90)
NEVERD_BRANCH_VALUE(Lock, 0xf0)
NEVERD_BRANCH_VALUE(Rep, 0xf3)
NEVERD_BRANCH_VALUE(Repne, 0xf2)
NEVERD_BRANCH_VALUE(AMDVendorEBX, 0x68747541)
NEVERD_BRANCH_VALUE(AMDVendorEDX, 0x69746e65)
NEVERD_BRANCH_VALUE(AMDVendorECX, 0x444d4163)
NEVERD_BRANCH_VALUE(Displacement, 16)
NEVERD_BRANCH_VALUE(MXCSR, 0x5fa5)
NEVERD_BRANCH_VALUE(FPCW, 0xb7f)
NEVERD_BRANCH_VALUE(FPSW, 0x1800)
NEVERD_BRANCH_VALUE(VectorCount, 16)
NEVERD_BRANCH_VALUE(FPCount, 8)
NEVERD_BRANCH_VALUE(FPHigh, 0x3fff)
NEVERD_BRANCH_VALUE(CarryFlag, 1)
NEVERD_BRANCH_VALUE(ParityFlag, 4)
NEVERD_BRANCH_VALUE(SignFlag, 0x80)
NEVERD_BRANCH_VALUE(OverflowFlag, 0x800)
NEVERD_BRANCH_VALUE(FlagCombinations, 32)
NEVERD_BRANCH_VALUE(OpcodeEscape, 0x0f)
NEVERD_BRANCH_VALUE(ByteBits, 8)
NEVERD_BRANCH_VALUE(ShortBytes, 1)
NEVERD_BRANCH_VALUE(HalfBytes, 2)
NEVERD_BRANCH_VALUE(WordBytes, 4)
#endif
#ifdef NEVERD_BRANCH_TEXT
NEVERD_BRANCH_TEXT(ObserverFailure, "relative-branch observer failed")
NEVERD_BRANCH_TEXT(OracleUnavailable,
                   "the relative-branch native oracle requires x64")
NEVERD_BRANCH_TEXT(OracleExecuted, "original host branch executions: ")
NEVERD_BRANCH_TEXT(OracleGuestOnly,
                   "; low-target forms checked in guest memory: ")
#endif
#ifdef NEVERD_BRANCH_OPERATION
NEVERD_BRANCH_OPERATION(JO, 0x70, 0x80, O)
NEVERD_BRANCH_OPERATION(JNO, 0x71, 0x81, !O)
NEVERD_BRANCH_OPERATION(JB, 0x72, 0x82, C)
NEVERD_BRANCH_OPERATION(JAE, 0x73, 0x83, !C)
NEVERD_BRANCH_OPERATION(JE, 0x74, 0x84, Z)
NEVERD_BRANCH_OPERATION(JNE, 0x75, 0x85, !Z)
NEVERD_BRANCH_OPERATION(JBE, 0x76, 0x86, C || Z)
NEVERD_BRANCH_OPERATION(JA, 0x77, 0x87, !C && !Z)
NEVERD_BRANCH_OPERATION(JS, 0x78, 0x88, S)
NEVERD_BRANCH_OPERATION(JNS, 0x79, 0x89, !S)
NEVERD_BRANCH_OPERATION(JP, 0x7a, 0x8a, P)
NEVERD_BRANCH_OPERATION(JNP, 0x7b, 0x8b, !P)
NEVERD_BRANCH_OPERATION(JL, 0x7c, 0x8c, S != O)
NEVERD_BRANCH_OPERATION(JGE, 0x7d, 0x8d, S == O)
NEVERD_BRANCH_OPERATION(JLE, 0x7e, 0x8e, Z || S != O)
NEVERD_BRANCH_OPERATION(JG, 0x7f, 0x8f, !Z && S == O)
NEVERD_BRANCH_OPERATION(JMP, 0xeb, 0xe9, true)
#endif
#ifdef NEVERD_BRANCH_PREFIX
NEVERD_BRANCH_PREFIX(Native, false)
NEVERD_BRANCH_PREFIX(Operand16, true, 0x66)
NEVERD_BRANCH_PREFIX(Address32, false, 0x67)
NEVERD_BRANCH_PREFIX(Operand16Address32, true, 0x66, 0x67)
NEVERD_BRANCH_PREFIX(RexW, false, 0x48)
NEVERD_BRANCH_PREFIX(RexB, false, 0x41)
NEVERD_BRANCH_PREFIX(Address32RexW, false, 0x67, 0x48)
NEVERD_BRANCH_PREFIX(Operand16RexW, false, 0x66, 0x48)
NEVERD_BRANCH_PREFIX(Operand16Address32RexW, false, 0x66, 0x67, 0x48)
#endif
#ifdef NEVERD_BRANCH_DISPLACEMENT
NEVERD_BRANCH_DISPLACEMENT(-128)
NEVERD_BRANCH_DISPLACEMENT(-16)
NEVERD_BRANCH_DISPLACEMENT(-14)
NEVERD_BRANCH_DISPLACEMENT(-13)
NEVERD_BRANCH_DISPLACEMENT(0)
NEVERD_BRANCH_DISPLACEMENT(16)
NEVERD_BRANCH_DISPLACEMENT(127)
#endif
#ifdef NEVERD_BRANCH_BYTES
NEVERD_BRANCH_BYTES(OraclePrefix, 0x53, 0x9c)
NEVERD_BRANCH_BYTES(SysVArgument, 0x48, 0x89, 0xfb)
NEVERD_BRANCH_BYTES(Win64Argument, 0x48, 0x89, 0xcb)
// Packet: input count, installed FLAGS, output count, output FLAGS, taken.
NEVERD_BRANCH_BYTES(OracleLoad, 0x48, 0x8b, 0x0b, 0xff, 0x73, 0x08, 0x9d, 0x9c,
                    0x8f, 0x43, 0x08)
// Both paths use MOV/JMP so they preserve every input flag.
NEVERD_BRANCH_BYTES(OracleFalse, 0x48, 0xc7, 0x43, 0x20, 0, 0, 0, 0)
NEVERD_BRANCH_BYTES(OracleSkipTrue, 0xeb, 0x08)
NEVERD_BRANCH_BYTES(OracleTrue, 0x48, 0xc7, 0x43, 0x20, 1, 0, 0, 0)
NEVERD_BRANCH_BYTES(OracleSave, 0x48, 0x89, 0x4b, 0x10, 0x9c, 0x8f, 0x43, 0x18,
                    0x9d, 0x5b, 0xc3)
#endif
#ifdef NEVERD_BRANCH_BACKEND
NEVERD_BRANCH_BACKEND(kvmSupervisor, KVM, CheckedX64)
NEVERD_BRANCH_BACKEND(kvmUser, KVM, CheckedUserX64)
NEVERD_BRANCH_BACKEND(kvmDriver, KVM, Legacy)
NEVERD_BRANCH_BACKEND(whpSupervisor, WHP, CheckedX64)
NEVERD_BRANCH_BACKEND(whpUser, WHP, CheckedUserX64)
NEVERD_BRANCH_BACKEND(whpDriver, WHP, Legacy)
NEVERD_BRANCH_BACKEND(unicornSupervisor, Unicorn, CheckedX64)
NEVERD_BRANCH_BACKEND(unicornUser, Unicorn, CheckedUserX64)
#endif
#ifdef NEVERD_BRANCH_BOUNDARY
NEVERD_BRANCH_BOUNDARY(JO)
NEVERD_BRANCH_BOUNDARY(JNO)
NEVERD_BRANCH_BOUNDARY(JMP)
#endif

#ifdef NEVERD_BRANCH_FORM
NEVERD_BRANCH_FORM(NativeShort, Native, false)
NEVERD_BRANCH_FORM(NativeNear, Native, true)
NEVERD_BRANCH_FORM(Operand16Short, Operand16, false)
NEVERD_BRANCH_FORM(Operand16Near, Operand16, true)
NEVERD_BRANCH_FORM(Address32Short, Address32, false)
NEVERD_BRANCH_FORM(Address32Near, Address32, true)
NEVERD_BRANCH_FORM(Operand16Address32Short, Operand16Address32, false)
NEVERD_BRANCH_FORM(Operand16Address32Near, Operand16Address32, true)
NEVERD_BRANCH_FORM(RexWShort, RexW, false)
NEVERD_BRANCH_FORM(RexWNear, RexW, true)
NEVERD_BRANCH_FORM(RexBShort, RexB, false)
NEVERD_BRANCH_FORM(RexBNear, RexB, true)
NEVERD_BRANCH_FORM(Address32RexWShort, Address32RexW, false)
NEVERD_BRANCH_FORM(Address32RexWNear, Address32RexW, true)
NEVERD_BRANCH_FORM(Operand16RexWShort, Operand16RexW, false)
NEVERD_BRANCH_FORM(Operand16RexWNear, Operand16RexW, true)
NEVERD_BRANCH_FORM(Operand16Address32RexWShort, Operand16Address32RexW, false)
NEVERD_BRANCH_FORM(Operand16Address32RexWNear, Operand16Address32RexW, true)
#endif
#ifdef NEVERD_BRANCH_POLICY
NEVERD_BRANCH_POLICY(Intel, 0x123450000ULL, 0x66, 0x0f, 0x80, 0, 0, 0, 0)
NEVERD_BRANCH_POLICY(AMD, 0x123450000ULL, 0x66, 0x0f, 0x80, 0, 0)
NEVERD_BRANCH_POLICY(AMD, 0x123450000ULL, 0x66, 0x48, 0x0f, 0x80, 0, 0, 0, 0)
NEVERD_BRANCH_POLICY(Intel, 0x123450000ULL, 0x66, 0xe9, 0, 0, 0, 0)
NEVERD_BRANCH_POLICY(AMD, 0x123450000ULL, 0x66, 0xe9, 0, 0)
NEVERD_BRANCH_POLICY(AMD, 0x123450000ULL, 0x66, 0x48, 0xe9, 0, 0, 0, 0)
#endif
