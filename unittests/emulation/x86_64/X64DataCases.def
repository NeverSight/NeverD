#ifdef NEVERD_DATA_LOAD
// Loads from memory clear the unused upper bits for legacy scalar moves.
NEVERD_DATA_LOAD(LoadD, 4, Low & 0xffffffff, 0, 0x66, 0x0f, 0x6e, 0x01)
NEVERD_DATA_LOAD(LoadQ, 8, Low, 0, 0xf3, 0x0f, 0x7e, 0x01)
NEVERD_DATA_LOAD(LoadSS, 4, Low & 0xffffffff, 0, 0xf3, 0x0f, 0x10, 0x01)
NEVERD_DATA_LOAD(LoadSD, 8, Low, 0, 0xf2, 0x0f, 0x10, 0x01)
NEVERD_DATA_LOAD(LoadUPS, 16, Low, High, 0x0f, 0x10, 0x01)
NEVERD_DATA_LOAD(LoadUPD, 16, Low, High, 0x66, 0x0f, 0x10, 0x01)
NEVERD_DATA_LOAD(LoadDQU, 16, Low, High, 0xf3, 0x0f, 0x6f, 0x01)
NEVERD_DATA_LOAD(LoadAPS, 16, Low, High, 0x0f, 0x28, 0x01)
NEVERD_DATA_LOAD(LoadAPD, 16, Low, High, 0x66, 0x0f, 0x28, 0x01)
NEVERD_DATA_LOAD(LoadDQA, 16, Low, High, 0x66, 0x0f, 0x6f, 0x01)
#endif
#ifdef NEVERD_DATA_REGISTER
// XMM0 initially {Low,High}, XMM1 and RDX {High,Low}. Expected XMM0.
NEVERD_DATA_REGISTER(MoveSS,
                     (Low & 0xffffffff00000000ULL) | (High & 0xffffffff), High,
                     0xf3, 0x0f, 0x10, 0xc1)
NEVERD_DATA_REGISTER(MoveSD, High, High, 0xf2, 0x0f, 0x10, 0xc1)
NEVERD_DATA_REGISTER(MoveQ, High, 0, 0xf3, 0x0f, 0x7e, 0xc1)
NEVERD_DATA_REGISTER(MoveGPRD, High & 0xffffffff, 0, 0x66, 0x0f, 0x6e, 0xc2)
NEVERD_DATA_REGISTER(MoveGPRQ, High, 0, 0x66, 0x48, 0x0f, 0x6e, 0xc2)
NEVERD_DATA_REGISTER(MoveLH, Low, Low, 0x0f, 0x16, 0xc0)
NEVERD_DATA_REGISTER(MoveHL, High, High, 0x0f, 0x12, 0xc0)
NEVERD_DATA_REGISTER(XorPS, UINT64_MAX, UINT64_MAX, 0x0f, 0x57, 0xc1)
NEVERD_DATA_REGISTER(XorPD, UINT64_MAX, UINT64_MAX, 0x66, 0x0f, 0x57, 0xc1)
NEVERD_DATA_REGISTER(Pxor, UINT64_MAX, UINT64_MAX, 0x66, 0x0f, 0xef, 0xc1)
NEVERD_DATA_REGISTER(AndPS, 0, 0, 0x0f, 0x54, 0xc1)
NEVERD_DATA_REGISTER(AndPD, 0, 0, 0x66, 0x0f, 0x54, 0xc1)
NEVERD_DATA_REGISTER(Pand, 0, 0, 0x66, 0x0f, 0xdb, 0xc1)
NEVERD_DATA_REGISTER(OrPS, UINT64_MAX, UINT64_MAX, 0x0f, 0x56, 0xc1)
NEVERD_DATA_REGISTER(OrPD, UINT64_MAX, UINT64_MAX, 0x66, 0x0f, 0x56, 0xc1)
NEVERD_DATA_REGISTER(Por, UINT64_MAX, UINT64_MAX, 0x66, 0x0f, 0xeb, 0xc1)
NEVERD_DATA_REGISTER(AndnPS, High, Low, 0x0f, 0x55, 0xc1)
NEVERD_DATA_REGISTER(AndnPD, High, Low, 0x66, 0x0f, 0x55, 0xc1)
NEVERD_DATA_REGISTER(Pandn, High, Low, 0x66, 0x0f, 0xdf, 0xc1)
#endif

#ifdef NEVERD_SSE_INPUT
// Repeat each lane to exercise packed forms without host floating-point math.
NEVERD_SSE_INPUT(Finite, 0x3ff0000000000000ULL, 0x4008000000000000ULL,
                 0x3f800000, 0x40400000)
NEVERD_SSE_INPUT(Inexact, 0x3ff0000000000000ULL, 0x3ca0000000000000ULL,
                 0x3f800000, 0x33800000)
NEVERD_SSE_INPUT(SignedZero, 0, 0x8000000000000000ULL, 0, 0x80000000)
NEVERD_SSE_INPUT(Denormal, 1, 0x3ff0000000000000ULL, 1, 0x3f800000)
NEVERD_SSE_INPUT(DenormalSource, 0x3ff0000000000000ULL, 1, 0x3f800000, 1)
NEVERD_SSE_INPUT(DenormalQuietNaN, 1, 0x7ff8000000000011ULL, 1, 0x7fc00011)
NEVERD_SSE_INPUT(DenormalSignalingNaN, 1, 0x7ff0000000000011ULL, 1, 0x7f800011)
NEVERD_SSE_INPUT(DenormalZero, 1, 0, 1, 0)
NEVERD_SSE_INPUT(NegativeDenormal, 0x3ff0000000000000ULL, 0x8000000000000001ULL,
                 0x3f800000, 0x80000001)
NEVERD_SSE_INPUT(Infinity, 0x7ff0000000000000ULL, 0xfff0000000000000ULL,
                 0x7f800000, 0xff800000)
NEVERD_SSE_INPUT(QuietNaN, 0x7ff8000000000011ULL, 0x3ff0000000000000ULL,
                 0x7fc00011, 0x3f800000)
NEVERD_SSE_INPUT(SignalingNaN, 0x3ff0000000000000ULL, 0x7ff0000000000011ULL,
                 0x3f800000, 0x7f800011)
#endif
