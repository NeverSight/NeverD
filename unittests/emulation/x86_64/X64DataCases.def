#ifdef NEVERD_DATA_CONDITION
// Truth-table bit N uses N's bits in CF, PF, ZF, SF, OF order.
NEVERD_DATA_CONDITION(O, 0xffff0000, 0x0f, 0x90, 0x01)
NEVERD_DATA_CONDITION(NO, 0x0000ffff, 0x0f, 0x91, 0x01)
NEVERD_DATA_CONDITION(B, 0xaaaaaaaa, 0x0f, 0x92, 0x01)
NEVERD_DATA_CONDITION(AE, 0x55555555, 0x0f, 0x93, 0x01)
NEVERD_DATA_CONDITION(E, 0xf0f0f0f0, 0x0f, 0x94, 0x01)
NEVERD_DATA_CONDITION(NE, 0x0f0f0f0f, 0x0f, 0x95, 0x01)
NEVERD_DATA_CONDITION(BE, 0xfafafafa, 0x0f, 0x96, 0x01)
NEVERD_DATA_CONDITION(A, 0x05050505, 0x0f, 0x97, 0x01)
NEVERD_DATA_CONDITION(S, 0xff00ff00, 0x0f, 0x98, 0x01)
NEVERD_DATA_CONDITION(NS, 0x00ff00ff, 0x0f, 0x99, 0x01)
NEVERD_DATA_CONDITION(P, 0xcccccccc, 0x0f, 0x9a, 0x01)
NEVERD_DATA_CONDITION(NP, 0x33333333, 0x0f, 0x9b, 0x01)
NEVERD_DATA_CONDITION(L, 0x00ffff00, 0x0f, 0x9c, 0x01)
NEVERD_DATA_CONDITION(GE, 0xff0000ff, 0x0f, 0x9d, 0x01)
NEVERD_DATA_CONDITION(LE, 0xf0fffff0, 0x0f, 0x9e, 0x01)
NEVERD_DATA_CONDITION(G, 0x0f00000f, 0x0f, 0x9f, 0x01)
#endif
