#ifdef NEVERD_DATA_CONVERSION
NEVERD_DATA_CONVERSION(Exact, 0x4026000000000000ULL, 11, 0)
NEVERD_DATA_CONVERSION(Truncate, 0x4027000000000000ULL, 11, PrecisionStatus)
NEVERD_DATA_CONVERSION(Negative, 0xc027000000000000ULL, uint64_t(-11),
                       PrecisionStatus)
NEVERD_DATA_CONVERSION(NaN, 0x7ff8000000000000ULL, 0x8000000000000000ULL,
                       InvalidStatus)
NEVERD_DATA_CONVERSION(Infinity, 0x7ff0000000000000ULL, 0x8000000000000000ULL,
                       InvalidStatus)
NEVERD_DATA_CONVERSION(Overflow, 0x43e0000000000000ULL, 0x8000000000000000ULL,
                       InvalidStatus)
#endif
