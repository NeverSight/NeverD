#ifdef NEVERD_MASK_OPERATION
// Name, element width, mandatory prefix, opcode.
NEVERD_MASK_OPERATION(MOVMSKPS, 32, 0, 0x50)
NEVERD_MASK_OPERATION(MOVMSKPD, 64, 0x66, 0x50)
NEVERD_MASK_OPERATION(PMOVMSKB, 8, 0x66, 0xd7)
#endif
#ifdef NEVERD_MASK_VALUE
NEVERD_MASK_VALUE(OpcodeMap, 0x0f)
