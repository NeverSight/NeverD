NEVERD_MASK_VALUE(RegisterFieldMask, 7)
NEVERD_MASK_VALUE(Rex, 0x40)
NEVERD_MASK_VALUE(RexWide, 0x08)
NEVERD_MASK_VALUE(RexDestination, 0x04)
NEVERD_MASK_VALUE(RexSource, 0x01)
NEVERD_MASK_VALUE(PhysicalExponent, 0x3fff)
#endif
