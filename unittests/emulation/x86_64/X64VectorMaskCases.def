#ifdef NEVERD_MASK_INPUT
// Raw NaNs, signed zero, alternating signs and non-sign payloads.
NEVERD_MASK_INPUT(0x7ff0000000000001ULL, 0xfff0000000000001ULL)
NEVERD_MASK_INPUT(0xff8000017f800001ULL, 0x800000007fc00001ULL)
NEVERD_MASK_INPUT(0x8000000000000000ULL, 0)
NEVERD_MASK_INPUT(0x80ff007f01818000ULL, 0xff7f807f00fe0100ULL)
NEVERD_MASK_INPUT(0, 0)
NEVERD_MASK_INPUT(UINT64_MAX, UINT64_MAX)
#endif
#ifdef NEVERD_MASK_INVALID
NEVERD_MASK_INVALID(MMX, 0x0f, 0xd7, 0xc1)
NEVERD_MASK_INVALID(MemoryPS, 0x0f, 0x50, 0x01)
NEVERD_MASK_INVALID(MemoryPD, 0x66, 0x0f, 0x50, 0x01)
NEVERD_MASK_INVALID(MemoryBytes, 0x66, 0x0f, 0xd7, 0x01)
