NEVERD_STACK_CASE(PushOperandAfterRex, true, 2, Register, X64AX, Base, 0, 0x48,
                  0x66, 0x50)
NEVERD_STACK_CASE(PushImm8, true, 8, Immediate, X64AX, Base, -128, 0x6a, 0x80)
NEVERD_STACK_CASE(PushImm8Word, true, 2, Immediate, X64AX, Base, -128, 0x66,
                  0x6a, 0x80)
