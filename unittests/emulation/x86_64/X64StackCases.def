NEVERD_STACK_CASE(PushMemory64, true, 8, Memory, X64AX, Base, 0, 0xff, 0x33)
NEVERD_STACK_CASE(PushMemory16, true, 2, Memory, X64AX, Base, 0, 0x66, 0xff,
