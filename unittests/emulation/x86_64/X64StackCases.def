NEVERD_STACK_CASE(PopAX64, false, 8, Register, X64AX, Base, 0, 0x58)
NEVERD_STACK_CASE(PopAX16, false, 2, Register, X64AX, Base, 0, 0x66, 0x58)
NEVERD_STACK_CASE(PopSP64, false, 8, Register, X64SP, Base, 0, 0x5c)
NEVERD_STACK_CASE(PopSP16, false, 2, Register, X64SP, Base, 0, 0x66, 0x5c)
NEVERD_STACK_CASE(PopR1264, false, 8, Register, X64R12, Base, 0, 0x41, 0x5c)
NEVERD_STACK_CASE(PopR1216, false, 2, Register, X64R12, Base, 0, 0x66, 0x41,
                  0x5c)
