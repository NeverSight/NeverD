//===- X64IntegerFloatCases.def - Independent signed SSE conversions ----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_INT_FLOAT_OPERATION
// Name, mandatory prefix, result width. REX.W selects integer source width.
NEVERD_INT_FLOAT_OPERATION(CVTSI2SS, 0xf3, 32)
NEVERD_INT_FLOAT_OPERATION(CVTSI2SD, 0xf2, 64)
#endif
#ifdef NEVERD_INT_FLOAT_VALUE
NEVERD_INT_FLOAT_VALUE(OpcodeMap, 0x0f)
NEVERD_INT_FLOAT_VALUE(Opcode, 0x2a)
NEVERD_INT_FLOAT_VALUE(Rex, 0x40)
NEVERD_INT_FLOAT_VALUE(RexWide, 0x08)
NEVERD_INT_FLOAT_VALUE(RexDestination, 0x04)
NEVERD_INT_FLOAT_VALUE(RexSource, 0x01)
NEVERD_INT_FLOAT_VALUE(RegisterMask, 0x07)
NEVERD_INT_FLOAT_VALUE(RegisterShift, 3)
NEVERD_INT_FLOAT_VALUE(RegisterModRM, 0xc0)
NEVERD_INT_FLOAT_VALUE(InitialMXCSR, 0x1f80)
NEVERD_INT_FLOAT_VALUE(PrecisionStatus, 0x20)
// Keep the other five exception flags, then also test a preexisting precision
// flag. Exact conversion must preserve every sticky bit.
NEVERD_INT_FLOAT_VALUE(ExistingStatus, 0x1f)
NEVERD_INT_FLOAT_VALUE(FlushToZero, 0x8000)
NEVERD_INT_FLOAT_VALUE(PhysicalExponent, 0x3fff)
NEVERD_INT_FLOAT_VALUE(SingleBits, 32)
NEVERD_INT_FLOAT_VALUE(PatternStride, 37)
NEVERD_INT_FLOAT_VALUE(InexactInput, 0x0020000001000001ULL)
#endif
#ifdef NEVERD_INT_FLOAT_ROUND
NEVERD_INT_FLOAT_ROUND(Nearest, 0x0000, rmNearestTiesToEven)
NEVERD_INT_FLOAT_ROUND(Down, 0x2000, rmTowardNegative)
NEVERD_INT_FLOAT_ROUND(Up, 0x4000, rmTowardPositive)
NEVERD_INT_FLOAT_ROUND(Truncate, 0x6000, rmTowardZero)
#endif
#ifdef NEVERD_INT_FLOAT_INPUT
NEVERD_INT_FLOAT_INPUT(0)
NEVERD_INT_FLOAT_INPUT(1)
NEVERD_INT_FLOAT_INPUT(UINT64_MAX)
NEVERD_INT_FLOAT_INPUT(0x0000000001000001ULL)
NEVERD_INT_FLOAT_INPUT(0xfffffffffeffffffULL)
NEVERD_INT_FLOAT_INPUT(0x0020000000000001ULL)
NEVERD_INT_FLOAT_INPUT(0xffdfffffffffffffULL)
NEVERD_INT_FLOAT_INPUT(0x000000007fffffffULL)
NEVERD_INT_FLOAT_INPUT(0x0000000080000000ULL)
NEVERD_INT_FLOAT_INPUT(0x7fffffffffffffffULL)
NEVERD_INT_FLOAT_INPUT(0x8000000000000000ULL)
NEVERD_INT_FLOAT_INPUT(0xa5a5a5a580000001ULL)
#endif
#ifdef NEVERD_INT_FLOAT_INVALID
NEVERD_INT_FLOAT_INVALID(VexSS, 0xc5, 0xfa, 0x2a, 0xc0)
NEVERD_INT_FLOAT_INVALID(VexSD, 0xc5, 0xfb, 0x2a, 0xc0)
NEVERD_INT_FLOAT_INVALID(VexWideSS, 0xc4, 0xe1, 0xfa, 0x2a, 0x01)
NEVERD_INT_FLOAT_INVALID(VexWideSD, 0xc4, 0xe1, 0xfb, 0x2a, 0x01)
NEVERD_INT_FLOAT_INVALID(EvexSS, 0x62, 0xf1, 0x7e, 0x08, 0x2a, 0xc0)
NEVERD_INT_FLOAT_INVALID(EvexSD, 0x62, 0xf1, 0xff, 0x08, 0x2a, 0x01)
// Unprefixed packed conversions select MMX, a different unsupported family.
NEVERD_INT_FLOAT_INVALID(MMXToPS, 0x0f, 0x2a, 0xc0)
NEVERD_INT_FLOAT_INVALID(MMXToPD, 0x66, 0x0f, 0x2a, 0xc0)
#endif
#ifdef NEVERD_INT_FLOAT_TEXT
NEVERD_INT_FLOAT_TEXT(ObserverError, "integer to float observer failure")
#endif
