#ifdef NEVERD_PUSH_FLAGS_VALUE
NEVERD_PUSH_FLAGS_VALUE(Limit, 1024 * 1024)
NEVERD_PUSH_FLAGS_VALUE(Page, 4096)
NEVERD_PUSH_FLAGS_VALUE(Code, 0x10000)
NEVERD_PUSH_FLAGS_VALUE(Data, 0x100020000ULL)
NEVERD_PUSH_FLAGS_VALUE(Alias, 0x200040000ULL)
NEVERD_PUSH_FLAGS_VALUE(Timeout, 1'000'000)
NEVERD_PUSH_FLAGS_VALUE(Flags, 0xed7)
NEVERD_PUSH_FLAGS_VALUE(Reserved, 2)
NEVERD_PUSH_FLAGS_VALUE(Trap, 0x100)
NEVERD_PUSH_FLAGS_VALUE(Seed, 0x1234567887654321ULL)
NEVERD_PUSH_FLAGS_VALUE(Fill, 0xa5)
NEVERD_PUSH_FLAGS_VALUE(Nop, 0x90)
NEVERD_PUSH_FLAGS_VALUE(MXCSR, 0x5fa5)
NEVERD_PUSH_FLAGS_VALUE(FPCW, 0xb7f)
NEVERD_PUSH_FLAGS_VALUE(FPSW, 0x1800)
NEVERD_PUSH_FLAGS_VALUE(VectorCount, 16)
NEVERD_PUSH_FLAGS_VALUE(Noncanonical, 0x800000000008ULL)
NEVERD_PUSH_FLAGS_VALUE(Wrapped, 4)
#endif
