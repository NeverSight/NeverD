#ifdef NEVERD_PUSH_FLAGS_INSTRUCTION
NEVERD_PUSH_FLAGS_INSTRUCTION(Qword, 8, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(Word, 2, 0x66, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(AddressQword, 8, 0x67, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(AddressWord, 2, 0x67, 0x66, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(SegmentQword, 8, 0x64, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(SegmentWord, 2, 0x65, 0x66, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(RexQword, 8, 0x48, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(RexAfterSize, 8, 0x66, 0x48, 0x9c)
NEVERD_PUSH_FLAGS_INSTRUCTION(SizeAfterRex, 2, 0x48, 0x66, 0x9c)
#endif
#ifdef NEVERD_PUSH_FLAGS_REJECTED
NEVERD_PUSH_FLAGS_REJECTED(LockedQword, 0xf0, 0x9c)
NEVERD_PUSH_FLAGS_REJECTED(LockedWord, 0xf0, 0x66, 0x9c)
#endif
