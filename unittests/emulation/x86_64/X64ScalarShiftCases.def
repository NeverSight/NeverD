#ifdef NEVERD_SCALAR_SHIFT_BYTES
NEVERD_SCALAR_SHIFT_BYTES(OraclePrefix, 0x53, 0x9c)
NEVERD_SCALAR_SHIFT_BYTES(SysVArgument, 0x48, 0x89, 0xfb)
NEVERD_SCALAR_SHIFT_BYTES(Win64Argument, 0x48, 0x89, 0xcb)
// Packet: AX, CX, effective input FLAGS, result AX, result FLAGS.
// Record the flags actually installed at host CPL3 before the original opcode.
NEVERD_SCALAR_SHIFT_BYTES(OracleLoad, 0x48, 0x8b, 0x03, 0x48, 0x8b, 0x4b, 0x08,
                          0xff, 0x73, 0x10, 0x9d, 0x9c, 0x8f, 0x43, 0x10)
NEVERD_SCALAR_SHIFT_BYTES(OracleSave, 0x48, 0x89, 0x43, 0x18, 0x9c, 0x8f, 0x43,
                          0x20, 0x9d, 0x5b, 0xc3)
NEVERD_SCALAR_SHIFT_BYTES(Continuation, 0x48, 0x83, 0xd0, 0x00, 0x48, 0x89,
                          0x07, 0x90)
#endif
