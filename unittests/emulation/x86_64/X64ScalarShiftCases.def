#ifdef NEVERD_SCALAR_SHIFT_ALIAS
// Name, destination register, r/m field, REX, bit offset, byte-only.
NEVERD_SCALAR_SHIFT_ALIAS(CountRegister, CX, 0x01, 0, 0, false)
NEVERD_SCALAR_SHIFT_ALIAS(ExtendedRegister, R8, 0x00, 0x41, 0, false)
NEVERD_SCALAR_SHIFT_ALIAS(HighByte, AX, 0x04, 0, 8, true)
NEVERD_SCALAR_SHIFT_ALIAS(RexLowByte, SP, 0x04, 0x40, 0, true)
#endif
