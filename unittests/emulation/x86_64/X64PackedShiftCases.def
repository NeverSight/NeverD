//===- X64PackedShiftCases.def - Original SSE2 shift fixtures -----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_SHIFT_VALUE
NEVERD_SHIFT_VALUE(VectorBits, 128)
NEVERD_SHIFT_VALUE(SelfModRM, 0xc0)
NEVERD_SHIFT_VALUE(LargeCount, 0xffffffffffffffffULL)
#endif
#ifdef NEVERD_SHIFT_TEXT
NEVERD_SHIFT_TEXT(ObserverFailure, "packed count observer failed")
#endif
#ifdef NEVERD_SHIFT_LANES
// Name, lane width, direction and independent native compiler intrinsic.
NEVERD_SHIFT_LANES(PSLLW, 16, Left, _mm_sll_epi16)
NEVERD_SHIFT_LANES(PSLLD, 32, Left, _mm_sll_epi32)
NEVERD_SHIFT_LANES(PSLLQ, 64, Left, _mm_sll_epi64)
NEVERD_SHIFT_LANES(PSRLW, 16, Right, _mm_srl_epi16)
NEVERD_SHIFT_LANES(PSRLD, 32, Right, _mm_srl_epi32)
NEVERD_SHIFT_LANES(PSRLQ, 64, Right, _mm_srl_epi64)
NEVERD_SHIFT_LANES(PSRAW, 16, Arithmetic, _mm_sra_epi16)
NEVERD_SHIFT_LANES(PSRAD, 32, Arithmetic, _mm_sra_epi32)
#endif
#ifdef NEVERD_SHIFT_BYTES_OPERATION
NEVERD_SHIFT_BYTES_OPERATION(PSLLDQ, Left, _mm_slli_si128)
NEVERD_SHIFT_BYTES_OPERATION(PSRLDQ, Right, _mm_srli_si128)
#endif
#ifdef NEVERD_SHIFT_BYTES
// Variable forms use XMM0,XMM1; immediate prefixes use XMM0,imm8.
NEVERD_SHIFT_BYTES(PSLLWVariable, 0x66, 0x0f, 0xf1, 0xc1)
NEVERD_SHIFT_BYTES(PSLLDVariable, 0x66, 0x0f, 0xf2, 0xc1)
NEVERD_SHIFT_BYTES(PSLLQVariable, 0x66, 0x0f, 0xf3, 0xc1)
NEVERD_SHIFT_BYTES(PSRLWVariable, 0x66, 0x0f, 0xd1, 0xc1)
NEVERD_SHIFT_BYTES(PSRLDVariable, 0x66, 0x0f, 0xd2, 0xc1)
NEVERD_SHIFT_BYTES(PSRLQVariable, 0x66, 0x0f, 0xd3, 0xc1)
NEVERD_SHIFT_BYTES(PSRAWVariable, 0x66, 0x0f, 0xe1, 0xc1)
NEVERD_SHIFT_BYTES(PSRADVariable, 0x66, 0x0f, 0xe2, 0xc1)
NEVERD_SHIFT_BYTES(PSLLWImmediate, 0x66, 0x0f, 0x71, 0xf0)
NEVERD_SHIFT_BYTES(PSLLDImmediate, 0x66, 0x0f, 0x72, 0xf0)
NEVERD_SHIFT_BYTES(PSLLQImmediate, 0x66, 0x0f, 0x73, 0xf0)
NEVERD_SHIFT_BYTES(PSRLWImmediate, 0x66, 0x0f, 0x71, 0xd0)
NEVERD_SHIFT_BYTES(PSRLDImmediate, 0x66, 0x0f, 0x72, 0xd0)
NEVERD_SHIFT_BYTES(PSRLQImmediate, 0x66, 0x0f, 0x73, 0xd0)
NEVERD_SHIFT_BYTES(PSRAWImmediate, 0x66, 0x0f, 0x71, 0xe0)
NEVERD_SHIFT_BYTES(PSRADImmediate, 0x66, 0x0f, 0x72, 0xe0)
NEVERD_SHIFT_BYTES(PSLLDQImmediate, 0x66, 0x0f, 0x73, 0xf8)
NEVERD_SHIFT_BYTES(PSRLDQImmediate, 0x66, 0x0f, 0x73, 0xd8)
NEVERD_SHIFT_BYTES(VexPSLLW, 0xc5, 0xf9, 0xf1, 0xc1)
NEVERD_SHIFT_BYTES(EvexPSLLW, 0x62, 0xf1, 0x7d, 0x08, 0xf1, 0xc1)
#endif
#ifdef NEVERD_SHIFT_INPUT
NEVERD_SHIFT_INPUT(0x80017f00fffe0100ULL, 0x7fff8000ffff00ffULL)
NEVERD_SHIFT_INPUT(0, 0xffffffffffffffffULL)
NEVERD_SHIFT_INPUT(1, 0x123456789abcdef0ULL)
#endif
#ifdef NEVERD_SHIFT_IMMEDIATE
NEVERD_SHIFT_IMMEDIATE(0)
NEVERD_SHIFT_IMMEDIATE(1)
NEVERD_SHIFT_IMMEDIATE(7)
NEVERD_SHIFT_IMMEDIATE(8)
NEVERD_SHIFT_IMMEDIATE(15)
NEVERD_SHIFT_IMMEDIATE(16)
NEVERD_SHIFT_IMMEDIATE(17)
NEVERD_SHIFT_IMMEDIATE(31)
NEVERD_SHIFT_IMMEDIATE(32)
NEVERD_SHIFT_IMMEDIATE(33)
NEVERD_SHIFT_IMMEDIATE(63)
NEVERD_SHIFT_IMMEDIATE(64)
NEVERD_SHIFT_IMMEDIATE(65)
NEVERD_SHIFT_IMMEDIATE(127)
NEVERD_SHIFT_IMMEDIATE(128)
NEVERD_SHIFT_IMMEDIATE(255)
#endif
#ifdef NEVERD_SHIFT_WIDE_COUNT
NEVERD_SHIFT_WIDE_COUNT(0x100ULL)
NEVERD_SHIFT_WIDE_COUNT(0x100000000ULL)
NEVERD_SHIFT_WIDE_COUNT(0x100000001ULL)
NEVERD_SHIFT_WIDE_COUNT(0x8000000000000000ULL)
NEVERD_SHIFT_WIDE_COUNT(0xffffffffffffffffULL)
#endif
