//===- X64CrossPageCases.def - Cross-page RAM instruction fixtures --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_CROSS_PAGE_VALUE
NEVERD_CROSS_PAGE_VALUE(Low, 0xfedcba9876543210ULL)
NEVERD_CROSS_PAGE_VALUE(High, 0x0123456789abcdefULL)
NEVERD_CROSS_PAGE_VALUE(InitialFlags, 0x202)
NEVERD_CROSS_PAGE_VALUE(ArithmeticFlags, 0x8c5)
NEVERD_CROSS_PAGE_VALUE(OverflowFlags, 0x884)
NEVERD_CROSS_PAGE_VALUE(WordBytes, 8)
NEVERD_CROSS_PAGE_VALUE(VectorBytes, 16)
NEVERD_CROSS_PAGE_VALUE(NopOpcode, 0x90)
NEVERD_CROSS_PAGE_VALUE(ReturnOpcode, 0xc3)
NEVERD_CROSS_PAGE_VALUE(DirectionFlag, 0x400)
NEVERD_CROSS_PAGE_VALUE(CopyCount, 2)
NEVERD_CROSS_PAGE_VALUE(OracleSetupFailure, 100)
NEVERD_CROSS_PAGE_VALUE(OracleUnexpectedReturn, 101)
NEVERD_CROSS_PAGE_VALUE(OracleFaultExit, 102)
NEVERD_CROSS_PAGE_VALUE(OracleDataPages, 2)
NEVERD_CROSS_PAGE_VALUE(OraclePages, OracleDataPages + 1)
#endif
#ifdef NEVERD_CROSS_PAGE_TEXT
NEVERD_CROSS_PAGE_TEXT(NativeOracleUnavailable,
                        "the independent native x64 fault oracle requires Linux x64")
#endif
#ifdef NEVERD_CROSS_PAGE_BYTES
// SysV RDI points to vector input, RSI seeds RAX, RCX points to target RAM.
NEVERD_CROSS_PAGE_BYTES(NativePrefix, 0x48, 0x89, 0xf0, 0xf3, 0x0f, 0x6f, 0x07)
NEVERD_CROSS_PAGE_BYTES(RepeatQword, 0xf3, 0x48, 0xa5)
// SysV arguments source, destination, count become RSI, RDI, RCX.
NEVERD_CROSS_PAGE_BYTES(NativeRepeat, 0x48, 0x89, 0xf8, 0x48, 0x89, 0xf7,
                        0x48, 0x89, 0xc6, 0x48, 0x89, 0xd1, 0xf3, 0x48,
                        0xa5, 0xc3)
#endif
#ifdef NEVERD_CROSS_PAGE_INSTRUCTION
// Name, operation, width, original memory low word, expected result.
NEVERD_CROSS_PAGE_INSTRUCTION(Read16, Load, 2, Low,
                              (High & ~0xffffULL) | 0x3210, 0x66, 0x8b, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Read32, Load, 4, Low, 0x76543210, 0x8b, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Read64, Load, 8, Low, Low, 0x48, 0x8b, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Read128, VectorLoad, 16, Low, Low,
                              0xf3, 0x0f, 0x6f, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Write16, Store, 2, High, Low, 0x66, 0x89, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Write32, Store, 4, High, Low, 0x89, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Write64, Store, 8, High, Low, 0x48, 0x89, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Write128, VectorStore, 16, High, Low,
                              0xf3, 0x0f, 0x7f, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Add16, Update, 2, 0x7fff, 0x8000,
                              0x66, 0x83, 0x01, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Add32, Update, 4, 0x7fffffff, 0x80000000,
                              0x83, 0x01, 0x01)
NEVERD_CROSS_PAGE_INSTRUCTION(Add64, Update, 8, 0x7fffffffffffffffULL,
                              0x8000000000000000ULL, 0x48, 0x83, 0x01, 0x01)
#endif
