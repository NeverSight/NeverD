NEVERD_STATUS_FLAGS_TEXT(ObserverFailure,
                         "status flag instruction observer failed")
NEVERD_STATUS_FLAGS_TEXT(
    OracleUnavailable,
    "the independent status flag oracle requires an x64 host")
NEVERD_STATUS_FLAGS_TEXT(
    OracleFeatureUnavailable,
    "the native CPU does not advertise long-mode LAHF/SAHF")
#endif
