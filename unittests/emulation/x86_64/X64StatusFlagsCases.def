#ifdef NEVERD_STATUS_FLAGS_BYTES
NEVERD_STATUS_FLAGS_BYTES(SysVArgument, 0x49, 0x89, 0xfb)
NEVERD_STATUS_FLAGS_BYTES(Win64Argument, 0x49, 0x89, 0xcb)
// Save host flags; install requested flags; capture the actual CPL3 flags;
// load RAX. R10/R11 and RAX are volatile under both native ABIs.
NEVERD_STATUS_FLAGS_BYTES(OracleBefore, 0x9c, 0x41, 0x5a, 0x41, 0xff, 0x73,
                          0x08, 0x9d, 0x9c, 0x41, 0x8f, 0x43, 0x20, 0x49, 0x8b,
                          0x03)
// Store RAX and flags, restore the caller's flags/stack, return.
NEVERD_STATUS_FLAGS_BYTES(OracleAfter, 0x49, 0x89, 0x43, 0x10, 0x9c, 0x41, 0x8f,
                          0x43, 0x18, 0x41, 0x52, 0x9d, 0xc3)
// ADC RCX,0; MOV [RDX],RCX; NOP. Observe native continuation and carry use.
NEVERD_STATUS_FLAGS_BYTES(Continuation, 0x48, 0x83, 0xd1, 0x00, 0x48, 0x89,
                          0x0a, 0x90)
#endif
