//===- InstructionFetchCases.def - Fresh checked instruction fixtures -----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_FETCH_VALUE
NEVERD_FETCH_VALUE(PageSize, 4096)
NEVERD_FETCH_VALUE(Limit, 32 * PageSize)
NEVERD_FETCH_VALUE(Code, 0x10000)
NEVERD_FETCH_VALUE(Data, 0x20000)
NEVERD_FETCH_VALUE(Alias, 0x30000)
NEVERD_FETCH_VALUE(Timeout, 2000000)
NEVERD_FETCH_VALUE(FirstValue, 11)
NEVERD_FETCH_VALUE(SecondValue, 22)
NEVERD_FETCH_VALUE(MixedMemory, 0x5678)
NEVERD_FETCH_VALUE(MixedResult, 7)
NEVERD_FETCH_VALUE(MixedByte, 0x78)
NEVERD_FETCH_VALUE(MixedObservations, 9)
NEVERD_FETCH_VALUE(X64PatchOffset, 3)
NEVERD_FETCH_VALUE(ARMPatchOffset, 4)
NEVERD_FETCH_VALUE(ARMReplacement, 0xd28002c0)
NEVERD_FETCH_VALUE(CrossingPrefix, 4)
NEVERD_FETCH_VALUE(LoopIterations, 4096)
NEVERD_FETCH_VALUE(X64ChangedOperand, 0x1000b)
NEVERD_FETCH_VALUE(ARMChangedOperand, 0x10b)
#endif
#ifdef NEVERD_FETCH_X64
// movabs rax, 11; nop
NEVERD_FETCH_X64(First, 0x48, 0xb8, 0x0b, 0, 0, 0, 0, 0, 0, 0, 0x90)
// mov eax, 22; nop
NEVERD_FETCH_X64(Second, 0xb8, 0x16, 0, 0, 0, 0x90)
// mov [rcx], edx; mov eax, 11; nop
NEVERD_FETCH_X64(Rewrite, 0x89, 0x11, 0xb8, 0x0b, 0, 0, 0, 0x90)
// mov eax, 0x5678; mov [rcx], eax; movzx edx, byte [rcx]; xor eax, eax;
// test edx, edx; jz bad; add eax, 7; jmp end; bad: mov eax, 99; end: nop
NEVERD_FETCH_X64(Mixed, 0xb8, 0x78, 0x56, 0, 0, 0x89, 0x01, 0x0f, 0xb6, 0x11,
                 0x31, 0xc0, 0x85, 0xd2, 0x74, 0x05, 0x83, 0xc0, 0x07, 0xeb,
                 0x05, 0xb8, 0x63, 0, 0, 0, 0x90)
NEVERD_FETCH_X64(Nop, 0x90)
// inc rax; jmp back to inc
NEVERD_FETCH_X64(Loop, 0x48, 0xff, 0xc0, 0xeb, 0xfb)
// A truncated movabs has no immediate bytes on the following unmapped page.
NEVERD_FETCH_X64(InvalidTail, 0x48, 0xb8)
#endif
#ifdef NEVERD_FETCH_ARM
// mov x0, 11; nop
NEVERD_FETCH_ARM(First, 0xd2800160, 0xd503201f)
// mov x0, 22; nop
NEVERD_FETCH_ARM(Second, 0xd28002c0, 0xd503201f)
// str w2, [x1]; mov x0, 11; nop
NEVERD_FETCH_ARM(Rewrite, 0xb9000022, 0xd2800160, 0xd503201f)
// mov w0, 0x5678; str w0, [x1]; ldrb w2, [x1]; eor w0, w0, w0;
// cmp w2, 0; b.eq bad; add w0, w0, 7; b end; bad: mov w0, 99; end: nop
NEVERD_FETCH_ARM(Mixed, 0x528acf00, 0xb9000020, 0x39400022, 0x4a000000,
                 0x7100005f, 0x54000060, 0x11001c00, 0x14000002, 0x52800c60,
                 0xd503201f)
NEVERD_FETCH_ARM(Nop, 0xd503201f)
// add x0, x0, 1; b back to add
NEVERD_FETCH_ARM(Loop, 0x91000400, 0x17ffffff)
// Reserved encoding; unlike x64, aligned ARM64 fetches cannot straddle a page.
NEVERD_FETCH_ARM(InvalidTail, 0xffffffff)
#endif
#ifdef NEVERD_FETCH_PROFILE
NEVERD_FETCH_PROFILE(UnicornX64Supervisor, Unicorn, X64, CheckedX64)
NEVERD_FETCH_PROFILE(UnicornX64User, Unicorn, X64, CheckedUserX64)
NEVERD_FETCH_PROFILE(UnicornARM64Supervisor, Unicorn, AArch64, CheckedAArch64)
NEVERD_FETCH_PROFILE(UnicornARM64User, Unicorn, AArch64, CheckedUserAArch64)
NEVERD_FETCH_PROFILE(KvmX64Supervisor, KVM, X64, CheckedX64)
NEVERD_FETCH_PROFILE(KvmX64User, KVM, X64, CheckedUserX64)
NEVERD_FETCH_PROFILE(KvmARM64Supervisor, KVM, AArch64, CheckedAArch64)
NEVERD_FETCH_PROFILE(KvmARM64User, KVM, AArch64, CheckedUserAArch64)
NEVERD_FETCH_PROFILE(WhpX64Supervisor, WHP, X64, CheckedX64)
NEVERD_FETCH_PROFILE(WhpX64User, WHP, X64, CheckedUserX64)
NEVERD_FETCH_PROFILE(WhpARM64Supervisor, WHP, AArch64, CheckedAArch64)
NEVERD_FETCH_PROFILE(WhpARM64User, WHP, AArch64, CheckedUserAArch64)
NEVERD_FETCH_PROFILE(HvfX64Supervisor, HVF, X64, CheckedX64)
NEVERD_FETCH_PROFILE(HvfX64User, HVF, X64, CheckedUserX64)
NEVERD_FETCH_PROFILE(HvfARM64Supervisor, HVF, AArch64, CheckedAArch64)
NEVERD_FETCH_PROFILE(HvfARM64User, HVF, AArch64, CheckedUserAArch64)
#endif
