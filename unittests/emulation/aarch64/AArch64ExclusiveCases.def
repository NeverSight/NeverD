//===- AArch64ExclusiveCases.def - Original exclusive instruction pairs ---===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Independently assembled load x0/w0[, x3/w3], [x1]; store w2, x0/w0[, x3/w3],
// [x1].
#ifdef NEVERD_EXCLUSIVE_CASE
NEVERD_EXCLUSIVE_CASE(Byte, 0x085f7c20, 0x08027c20, 1, 1)
NEVERD_EXCLUSIVE_CASE(Half, 0x485f7c20, 0x48027c20, 2, 1)
NEVERD_EXCLUSIVE_CASE(Word, 0x885f7c20, 0x88027c20, 4, 1)
NEVERD_EXCLUSIVE_CASE(Double, 0xc85f7c20, 0xc8027c20, 8, 1)
NEVERD_EXCLUSIVE_CASE(AcquireByte, 0x085ffc20, 0x0802fc20, 1, 1)
NEVERD_EXCLUSIVE_CASE(AcquireHalf, 0x485ffc20, 0x4802fc20, 2, 1)
NEVERD_EXCLUSIVE_CASE(AcquireWord, 0x885ffc20, 0x8802fc20, 4, 1)
NEVERD_EXCLUSIVE_CASE(AcquireDouble, 0xc85ffc20, 0xc802fc20, 8, 1)
NEVERD_EXCLUSIVE_CASE(PairWord, 0x887f0c20, 0x88220c20, 4, 2)
NEVERD_EXCLUSIVE_CASE(PairDouble, 0xc87f0c20, 0xc8220c20, 8, 2)
NEVERD_EXCLUSIVE_CASE(AcquirePairWord, 0x887f8c20, 0x88228c20, 4, 2)
NEVERD_EXCLUSIVE_CASE(AcquirePairDouble, 0xc87f8c20, 0xc8228c20, 8, 2)
#endif
#ifdef NEVERD_EXCLUSIVE_VALUE
NEVERD_EXCLUSIVE_VALUE(Code, 0x400000)
NEVERD_EXCLUSIVE_VALUE(Data, 0x800000)
NEVERD_EXCLUSIVE_VALUE(Alias, 0x900000)
NEVERD_EXCLUSIVE_VALUE(Limit, 1024 * 1024)
NEVERD_EXCLUSIVE_VALUE(PageSize, 4096)
NEVERD_EXCLUSIVE_VALUE(Timeout, 1000000)
NEVERD_EXCLUSIVE_VALUE(WordBytes, 8)
NEVERD_EXCLUSIVE_VALUE(InstructionBytes, 4)
NEVERD_EXCLUSIVE_VALUE(Granule, 16)
NEVERD_EXCLUSIVE_VALUE(Nop, 0xd503201f)
NEVERD_EXCLUSIVE_VALUE(Clear, 0xd5033f5f)
NEVERD_EXCLUSIVE_VALUE(Service, 0xd4000001)
NEVERD_EXCLUSIVE_VALUE(StoreByte, 0x39000020)
NEVERD_EXCLUSIVE_VALUE(ReadWord, 0xf9400020)
NEVERD_EXCLUSIVE_VALUE(ZeroCacheBlock, 0xd50b7421)
NEVERD_EXCLUSIVE_VALUE(Initial, 0xfedcba9876543210ULL)
NEVERD_EXCLUSIVE_VALUE(Updated, 0x0123456789abcdefULL)
NEVERD_EXCLUSIVE_VALUE(InitialStatus, 0xfedcba98abcdef42ULL)
NEVERD_EXCLUSIVE_VALUE(SecondRegister, 3)
NEVERD_EXCLUSIVE_VALUE(StatusRegister, 2)
NEVERD_EXCLUSIVE_VALUE(RegisterMask, 31)
NEVERD_EXCLUSIVE_VALUE(BaseShift, 5)
NEVERD_EXCLUSIVE_VALUE(SecondShift, 10)
NEVERD_EXCLUSIVE_VALUE(StatusShift, 16)
NEVERD_EXCLUSIVE_VALUE(InitialFlags, 0xb0000000)
NEVERD_EXCLUSIVE_VALUE(OptionMask, 0xf00)
NEVERD_EXCLUSIVE_VALUE(OptionShift, 8)
NEVERD_EXCLUSIVE_VALUE(CodeTargetOffset, 32)
NEVERD_EXCLUSIVE_VALUE(CodeEndOffset, 40)
NEVERD_EXCLUSIVE_VALUE(UpdatedCode, 0x34ffff0752800045ULL)
NEVERD_EXCLUSIVE_VALUE(CodeResult, 2)
#endif
#ifdef NEVERD_EXCLUSIVE_CODE_WORD
// Warm a translated target, replace its MOV through a writable physical alias,
// then branch back to that target without leaving the public execution call.
NEVERD_EXCLUSIVE_CODE_WORD(0x14000008) // b target
NEVERD_EXCLUSIVE_CODE_WORD(Load)
NEVERD_EXCLUSIVE_CODE_WORD(0xaa0603e0) // mov x0, x6
NEVERD_EXCLUSIVE_CODE_WORD(Store)
NEVERD_EXCLUSIVE_CODE_WORD(0x52800027) // mov w7, #1
NEVERD_EXCLUSIVE_CODE_WORD(0x14000003) // b target
NEVERD_EXCLUSIVE_CODE_WORD(0xd503201f)
NEVERD_EXCLUSIVE_CODE_WORD(0xd503201f)
NEVERD_EXCLUSIVE_CODE_WORD(0x52800025) // target: mov w5, #1
NEVERD_EXCLUSIVE_CODE_WORD(0x34ffff07) // cbz w7, load
NEVERD_EXCLUSIVE_CODE_WORD(0xd503201f)
NEVERD_EXCLUSIVE_CODE_WORD(0xd503201f)
#endif
#ifdef NEVERD_EXCLUSIVE_TEXT
NEVERD_EXCLUSIVE_TEXT(UserProfile, "User_")
NEVERD_EXCLUSIVE_TEXT(SoftwareProfile, "Software_")
NEVERD_EXCLUSIVE_TEXT(SupervisorProfile, "Supervisor_")
NEVERD_EXCLUSIVE_TEXT(ObserverFailure, "exclusive observer failure")
#endif
