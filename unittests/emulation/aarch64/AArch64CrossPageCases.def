//===- AArch64CrossPageCases.def - ARM64 cross-page RAM fixtures
//-----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_ARM_CROSS_VALUE
NEVERD_ARM_CROSS_VALUE(WordBytes, 8)
NEVERD_ARM_CROSS_VALUE(RegisterCount, 2)
NEVERD_ARM_CROSS_VALUE(CodeWords, 2)
NEVERD_ARM_CROSS_VALUE(MaxBytes, RegisterCount *WordBytes)
NEVERD_ARM_CROSS_VALUE(InitialFirst, 0x0123456789abcdefULL)
NEVERD_ARM_CROSS_VALUE(InitialSecond, 0x8877665544332211ULL)
NEVERD_ARM_CROSS_VALUE(MemoryFirst, 0xfedcba988654a210ULL)
NEVERD_ARM_CROSS_VALUE(MemorySecond, 0x1029384756abcdefULL)
NEVERD_ARM_CROSS_VALUE(InitialNZCV, 0xa0000000)
NEVERD_ARM_CROSS_VALUE(Nop, 0xd503201f)
#endif
#ifdef NEVERD_ARM_CROSS_TEXT
NEVERD_ARM_CROSS_TEXT(NameDelimiter, "_")
#endif
#ifdef NEVERD_ARM_CROSS_PROFILE
NEVERD_ARM_CROSS_PROFILE(UnicornEL0, Unicorn, CheckedUserAArch64)
NEVERD_ARM_CROSS_PROFILE(UnicornEL1, Unicorn, CheckedAArch64)
NEVERD_ARM_CROSS_PROFILE(KvmEL0, KVM, CheckedUserAArch64)
NEVERD_ARM_CROSS_PROFILE(KvmEL1, KVM, CheckedAArch64)
NEVERD_ARM_CROSS_PROFILE(WhpEL0, WHP, CheckedUserAArch64)
NEVERD_ARM_CROSS_PROFILE(HvfEL0, HVF, CheckedUserAArch64)
NEVERD_ARM_CROSS_PROFILE(WhpEL1, WHP, CheckedAArch64)
NEVERD_ARM_CROSS_PROFILE(HvfEL1, HVF, CheckedAArch64)
#endif
#ifdef NEVERD_ARM_CROSS_INSTRUCTION
// Name, load, operand bytes/count, effective-address bias, writeback,
// independently expected X0/X2 and original assembled instruction.
// ldrh w0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(Read16, true, 2, 1, 0, 0, 0xa210, InitialSecond,
                             0x79400020)
// ldr w0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(Read32, true, 4, 1, 0, 0, 0x8654a210,
                             InitialSecond, 0xb9400020)
// ldr x0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(Read64, true, 8, 1, 0, 0, MemoryFirst,
                             InitialSecond, 0xf9400020)
// ldrsh x0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(SignedRead16, true, 2, 1, 0, 0,
                             0xffffffffffffa210ULL, InitialSecond, 0x79800020)
// ldrsw x0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(SignedRead32, true, 4, 1, 0, 0,
                             0xffffffff8654a210ULL, InitialSecond, 0xb9800020)
// strh w0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(Write16, false, 2, 1, 0, 0, InitialFirst,
                             InitialSecond, 0x79000020)
// str w0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(Write32, false, 4, 1, 0, 0, InitialFirst,
                             InitialSecond, 0xb9000020)
// str x0, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(Write64, false, 8, 1, 0, 0, InitialFirst,
                             InitialSecond, 0xf9000020)
// ldp w0, w2, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(PairRead32, true, 4, 2, 0, 0, 0x8654a210,
                             0xfedcba98, 0x29400820)
// ldp x0, x2, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(PairRead64, true, 8, 2, 0, 0, MemoryFirst,
                             MemorySecond, 0xa9400820)
// ldpsw x0, x2, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(SignedPairRead32, true, 4, 2, 0, 0,
                             0xffffffff8654a210ULL, 0xfffffffffedcba98ULL,
                             0x69400820)
// stp w0, w2, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(PairWrite32, false, 4, 2, 0, 0, InitialFirst,
                             InitialSecond, 0x29000820)
// stp x0, x2, [x1]
NEVERD_ARM_CROSS_INSTRUCTION(PairWrite64, false, 8, 2, 0, 0, InitialFirst,
                             InitialSecond, 0xa9000820)
// str x0, [x1, #8]!
NEVERD_ARM_CROSS_INSTRUCTION(PreWrite64, false, 8, 1, 8, 8, InitialFirst,
                             InitialSecond, 0xf8008c20)
// str x0, [x1], #8
NEVERD_ARM_CROSS_INSTRUCTION(PostWrite64, false, 8, 1, 0, 8, InitialFirst,
                             InitialSecond, 0xf8008420)
// ldr x0, [x1, #-8]!
NEVERD_ARM_CROSS_INSTRUCTION(NegativePreRead64, true, 8, 1, -8, -8, MemoryFirst,
                             InitialSecond, 0xf85f8c20)
// stp x0, x2, [x1, #16]!
NEVERD_ARM_CROSS_INSTRUCTION(PrePairWrite64, false, 8, 2, 16, 16, InitialFirst,
                             InitialSecond, 0xa9810820)
// ldp x0, x2, [x1], #16
NEVERD_ARM_CROSS_INSTRUCTION(PostPairRead64, true, 8, 2, 0, 16, MemoryFirst,
                             MemorySecond, 0xa8c10820)
#endif
