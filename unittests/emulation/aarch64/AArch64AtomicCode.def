//===- AArch64AtomicCode.def - Original self-modifying atomic programs ----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_ATOMIC_CODE_WORD
NEVERD_ATOMIC_CODE_WORD(0x10000110) // adr x16, target
NEVERD_ATOMIC_CODE_WORD(0xd63f0200) // blr x16
NEVERD_ATOMIC_CODE_WORD(AtomicWord)
NEVERD_ATOMIC_CODE_WORD(0xd63f0200) // blr x16
NEVERD_ATOMIC_CODE_WORD(0xd503201f) // stop
NEVERD_ATOMIC_CODE_WORD(0xd503201f)
NEVERD_ATOMIC_CODE_WORD(0xd503201f)
NEVERD_ATOMIC_CODE_WORD(0xd503201f)
NEVERD_ATOMIC_CODE_WORD(0x52800025) // target: mov w5, #1
NEVERD_ATOMIC_CODE_WORD(0xd65f03c0) // ret
NEVERD_ATOMIC_CODE_WORD(0xd503201f)
NEVERD_ATOMIC_CODE_WORD(0xd503201f)
#endif
// Source value, expected function result. All widths edit the immediate field
// in MOV while preserving the destination register and the following RET.
#ifdef NEVERD_ATOMIC_CODE_SOURCE
NEVERD_ATOMIC_CODE_SOURCE(Add, 0x20, 2)
NEVERD_ATOMIC_CODE_SOURCE(Clear, 0x20, 0)
NEVERD_ATOMIC_CODE_SOURCE(Xor, 0x60, 2)
NEVERD_ATOMIC_CODE_SOURCE(Set, 0x40, 3)
NEVERD_ATOMIC_CODE_SOURCE(SignedMax, 0xd65f03c052800045ULL, 2)
NEVERD_ATOMIC_CODE_SOURCE(SignedMin, 0xd65f03c052800005ULL, 0)
NEVERD_ATOMIC_CODE_SOURCE(UnsignedMax, 0xd65f03c052800045ULL, 2)
NEVERD_ATOMIC_CODE_SOURCE(UnsignedMin, 0xd65f03c052800005ULL, 0)
NEVERD_ATOMIC_CODE_SOURCE(Swap, 0xd65f03c052800045ULL, 2)
NEVERD_ATOMIC_CODE_SOURCE(Compare, 0xd65f03c052800045ULL, 2)
NEVERD_ATOMIC_CODE_SOURCE(ComparePair, 0xd65f03c052800045ULL, 2)
#endif
#ifdef NEVERD_ATOMIC_CODE_VALUE
NEVERD_ATOMIC_CODE_VALUE(CodeTargetOffset, 32)
NEVERD_ATOMIC_CODE_VALUE(CodeEndOffset, 16)
#endif
