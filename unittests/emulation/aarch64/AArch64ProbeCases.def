#ifdef NEVERD_AARCH64_PROBE_TEST_VALUE
NEVERD_AARCH64_PROBE_TEST_VALUE(Limit, 4 * 1024 * 1024)
NEVERD_AARCH64_PROBE_TEST_VALUE(CorruptBit, 1)
NEVERD_AARCH64_PROBE_TEST_VALUE(Code, 0x400000)
NEVERD_AARCH64_PROBE_TEST_VALUE(ProbeInstructions, 18)
