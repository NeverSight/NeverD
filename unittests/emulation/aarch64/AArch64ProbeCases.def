#ifdef NEVERD_AARCH64_PROBE_TEST_CODE
// Assembled independently by Clang; verify the private program's original
// bytes.
NEVERD_AARCH64_PROBE_TEST_CODE(Program, 0xd503201f, 0x1e3d2bfe, 0x4efd87ff,
                               0xd503233f, 0xd50323bf, 0xd503237f, 0xd50323ff,
                               0xd503241f, 0xd503245f, 0xd503249f, 0xd50324df,
                               0xd53b003a, 0xd53b003b, 0xd50b7b3c, 0xd5033b9f,
                               0xd50b753c, 0xd5033b9f, 0xd5033fdf)
#endif
