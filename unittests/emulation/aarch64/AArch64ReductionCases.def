//===- AArch64ReductionCases.def - Independently assembled lane results ---===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Each word is assembled with Clang from the adjacent ARMv8-A instruction.
#ifdef NEVERD_AARCH64_REDUCTION_CASE
// cmeq v31.8b, v1.8b, v2.8b
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x2e228c3f, 8, 8)
// cmeq v31.8b, v1.8b, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x0e20983f, 8, 8)
// cmeq v31.16b, v1.16b, v2.16b
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x6e228c3f, 8, 16)
// cmeq v31.16b, v1.16b, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x4e20983f, 8, 16)
// cmeq v31.4h, v1.4h, v2.4h
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x2e628c3f, 16, 4)
// cmeq v31.4h, v1.4h, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x0e60983f, 16, 4)
// cmeq v31.8h, v1.8h, v2.8h
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x6e628c3f, 16, 8)
// cmeq v31.8h, v1.8h, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x4e60983f, 16, 8)
// cmeq v31.2s, v1.2s, v2.2s
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x2ea28c3f, 32, 2)
// cmeq v31.2s, v1.2s, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x0ea0983f, 32, 2)
// cmeq v31.4s, v1.4s, v2.4s
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x6ea28c3f, 32, 4)
// cmeq v31.4s, v1.4s, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x4ea0983f, 32, 4)
// cmeq v31.2d, v1.2d, v2.2d
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x6ee28c3f, 64, 2)
// cmeq v31.2d, v1.2d, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x4ee0983f, 64, 2)
// cmeq d31, d1, d2
NEVERD_AARCH64_REDUCTION_CASE(Equal, 0x7ee28c3f, 64, 1)
// cmeq d31, d1, #0
NEVERD_AARCH64_REDUCTION_CASE(Zero, 0x5ee0983f, 64, 1)
// uzp1 v31.8b, v1.8b, v2.8b
NEVERD_AARCH64_REDUCTION_CASE(Unzip, 0x0e02183f, 8, 8)
// uzp1 v31.16b, v1.16b, v2.16b
NEVERD_AARCH64_REDUCTION_CASE(Unzip, 0x4e02183f, 8, 16)
// uzp1 v31.4h, v1.4h, v2.4h
NEVERD_AARCH64_REDUCTION_CASE(Unzip, 0x0e42183f, 16, 4)
// uzp1 v31.8h, v1.8h, v2.8h
NEVERD_AARCH64_REDUCTION_CASE(Unzip, 0x4e42183f, 16, 8)
// uzp1 v31.2s, v1.2s, v2.2s
NEVERD_AARCH64_REDUCTION_CASE(Unzip, 0x0e82183f, 32, 2)
// uzp1 v31.4s, v1.4s, v2.4s
NEVERD_AARCH64_REDUCTION_CASE(Unzip, 0x4e82183f, 32, 4)
// uzp1 v31.2d, v1.2d, v2.2d
NEVERD_AARCH64_REDUCTION_CASE(Unzip, 0x4ec2183f, 64, 2)
// xtn v31.8b, v1.8h
NEVERD_AARCH64_REDUCTION_CASE(Narrow, 0x0e21283f, 8, 8)
// xtn2 v31.16b, v1.8h
NEVERD_AARCH64_REDUCTION_CASE(NarrowHigh, 0x4e21283f, 8, 8)
// xtn v31.4h, v1.4s
NEVERD_AARCH64_REDUCTION_CASE(Narrow, 0x0e61283f, 16, 4)
// xtn2 v31.8h, v1.4s
NEVERD_AARCH64_REDUCTION_CASE(NarrowHigh, 0x4e61283f, 16, 4)
// xtn v31.2s, v1.2d
NEVERD_AARCH64_REDUCTION_CASE(Narrow, 0x0ea1283f, 32, 2)
// xtn2 v31.4s, v1.2d
NEVERD_AARCH64_REDUCTION_CASE(NarrowHigh, 0x4ea1283f, 32, 2)
// umaxv b31, v1.8b
NEVERD_AARCH64_REDUCTION_CASE(Maximum, 0x2e30a83f, 8, 8)
// umaxv b31, v1.16b
NEVERD_AARCH64_REDUCTION_CASE(Maximum, 0x6e30a83f, 8, 16)
// umaxv h31, v1.4h
NEVERD_AARCH64_REDUCTION_CASE(Maximum, 0x2e70a83f, 16, 4)
// umaxv h31, v1.8h
NEVERD_AARCH64_REDUCTION_CASE(Maximum, 0x6e70a83f, 16, 8)
// umaxv s31, v1.4s
NEVERD_AARCH64_REDUCTION_CASE(Maximum, 0x6eb0a83f, 32, 4)
// uminv b31, v1.8b
NEVERD_AARCH64_REDUCTION_CASE(Minimum, 0x2e31a83f, 8, 8)
// uminv b31, v1.16b
NEVERD_AARCH64_REDUCTION_CASE(Minimum, 0x6e31a83f, 8, 16)
// uminv h31, v1.4h
NEVERD_AARCH64_REDUCTION_CASE(Minimum, 0x2e71a83f, 16, 4)
// uminv h31, v1.8h
NEVERD_AARCH64_REDUCTION_CASE(Minimum, 0x6e71a83f, 16, 8)
// uminv s31, v1.4s
NEVERD_AARCH64_REDUCTION_CASE(Minimum, 0x6eb1a83f, 32, 4)
#endif
