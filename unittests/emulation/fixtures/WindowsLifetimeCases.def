#ifdef NEVERD_LIFETIME_CASE
NEVERD_LIFETIME_CASE(Normal, "/n", ExitStatus)
#endif
#ifdef NEVERD_LIFETIME_RETURN_CASE
NEVERD_LIFETIME_RETURN_CASE(EntryReturn, "/r", ExitStatus)
#endif
#ifdef NEVERD_LIFETIME_CASE
NEVERD_LIFETIME_CASE(FailLeaf, "/a", InitFailureStatus)
NEVERD_LIFETIME_CASE(FailMiddle, "/b", InitFailureStatus)
NEVERD_LIFETIME_CASE(ExitLeafTLS, "/c", ExitStatus)
NEVERD_LIFETIME_CASE(ExitLeafEntry, "/d", ExitStatus)
NEVERD_LIFETIME_CASE(ExitMiddleEntry, "/e", ExitStatus)
NEVERD_LIFETIME_CASE(ExitMainTLS, "/f", ExitStatus)
#endif
#ifdef NEVERD_LIFETIME_NOENTRY_CASE
NEVERD_LIFETIME_NOENTRY_CASE(NoEntry, "/n", ExitStatus)
#endif
#ifdef NEVERD_LIFETIME_ASM
#if defined(_M_X64) || defined(__x86_64__)
NEVERD_LIFETIME_ASM(ReadTEB, "movq %%gs:0x30, %0")
#else
NEVERD_LIFETIME_ASM(ReadTEB, "mov %0, x18")
#endif
#endif
