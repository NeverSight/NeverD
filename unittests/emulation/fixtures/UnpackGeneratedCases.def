NEVERD_GENERATED_TEXT(OpaqueModule, "user32.dll")
NEVERD_GENERATED_TEXT(LateExport, "GetDoubleClickTime")
NEVERD_GENERATED_TEXT(PackSection, ".pay")
NEVERD_GENERATED_TEXT(ProgramSection, ".prog")
NEVERD_GENERATED_TEXT(RelaySection, ".relay")
NEVERD_GENERATED_TEXT(LoaderExport, "loader")
NEVERD_GENERATED_TEXT(Message, "generated code ran\n")
NEVERD_GENERATED_TEXT(ScratchPrefix, "neverd-unpack-generated")
NEVERD_GENERATED_TEXT(MissingRecord, "the fixture has no pack record or loader")
NEVERD_GENERATED_TEXT(RecordOverflow, " does not fit the pack record")
NEVERD_GENERATED_TEXT(X64CallShape,
                      "the mutated import call is an x86-64 shape")
NEVERD_GENERATED_TEXT(MissingTail, "an import call has no tail stub")
NEVERD_GENERATED_TEXT(TailOutOfRange,
                      "a tail stub is out of relative-call range")
NEVERD_GENERATED_TEXT(NoImportCall, "the program has no import call to mutate")
