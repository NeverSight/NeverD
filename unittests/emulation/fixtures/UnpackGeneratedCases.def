//===- UnpackGeneratedCases.def - A program whose loader writes its code --===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// The fixture links as an ordinary program and carries a loader that is not
// its entry. A test packs it: the bytes of the program's code section move,
// transformed, into the pack record, the section is cleared and the loader
// becomes the entry. The linked file is therefore an exact oracle for what
// unpacking must recover, on every instruction set the fixture is built for.
// It imitates no product.
#ifdef NEVERD_GENERATED_VALUE
NEVERD_GENERATED_VALUE(ExitStatus, 43)
NEVERD_GENERATED_VALUE(FailureStatus, 91)
NEVERD_GENERATED_VALUE(StdoutSelector, 0xfffffff5)
NEVERD_GENERATED_VALUE(InitializeResult, 7)
NEVERD_GENERATED_VALUE(Key, 0xa5)
// The pack record: four words, then the program's bytes and the second
// loader's bytes, each in a fixed capacity.
NEVERD_GENERATED_VALUE(Capacity, 4096)
NEVERD_GENERATED_VALUE(ModeOffset, 0)
NEVERD_GENERATED_VALUE(KeyOffset, 4)
NEVERD_GENERATED_VALUE(ProgramBytesOffset, 8)
NEVERD_GENERATED_VALUE(RelayBytesOffset, 12)
NEVERD_GENERATED_VALUE(ProgramOffset, 16)
NEVERD_GENERATED_VALUE(RelayOffset, 16 + 4096)
NEVERD_GENERATED_VALUE(InstructionLimit, 2000000)
NEVERD_GENERATED_VALUE(TimeoutMicroseconds, 60000000)
NEVERD_GENERATED_VALUE(SecondTransfer, 2)
NEVERD_GENERATED_VALUE(FLSRearmCount, 80)
NEVERD_GENERATED_VALUE(ExtendedLoadOffset, 4)
NEVERD_GENERATED_VALUE(ExtendedLoadStride, 16)
NEVERD_GENERATED_VALUE(OpaqueCallOffset, 6)
NEVERD_GENERATED_VALUE(LateCallOffset, 4)
#endif

// What the loader does once the code it wrote exists.
#ifdef NEVERD_GENERATED_MODE
// Leaves for the program.
NEVERD_GENERATED_MODE(Jump, 1)
// Calls into the program on its own stack, then leaves for it.
NEVERD_GENERATED_MODE(Call, 2)
// Writes a second loader and leaves for it; that one writes the program.
NEVERD_GENERATED_MODE(Staged, 3)
// The program's import calls are six-byte tail calls. x86-64 only.
NEVERD_GENERATED_MODE(Mutated, 4)
// The program loads an export address through a balanced helper.
NEVERD_GENERATED_MODE(Address, 5)
// The helper changes persistent memory, so it must not be replaced.
NEVERD_GENERATED_MODE(ImpureAddress, 6)
// The same helper is pure once, then writes persistent memory.
NEVERD_GENERATED_MODE(ChangingAddress, 7)
// A helper invokes an OS service while preserving visible RAM/registers.
NEVERD_GENERATED_MODE(ServiceAddress, 8)
// The same helper returns an export once, then an unknown address.
NEVERD_GENERATED_MODE(UnresolvedAddress, 9)
// Each extended GPR carries an export through an eight-byte helper site.
NEVERD_GENERATED_MODE(ExtendedAddress, 10)
// The preceding instruction ends in a byte that resembles a REX.B prefix.
NEVERD_GENERATED_MODE(PreviousPrefixAddress, 11)
// Extended POP plus CALL fits seven bytes; its helper returns directly.
NEVERD_GENERATED_MODE(CompactAddress, 12)
// A five-byte CALL skips one arbitrary byte before entering the export.
NEVERD_GENERATED_MODE(PaddedCall, 13)
// A CALL returns an address while skipping two non-instruction bytes.
NEVERD_GENERATED_MODE(CallOnlyAddress, 14)
// One call proxy changes persistent memory before entering the export.
NEVERD_GENERATED_MODE(ImpureCall, 15)
// A pure helper reaches a real export whose behavior is not modeled.
NEVERD_GENERATED_MODE(OpaqueCall, 16)
// A dynamically resolved export moves when the rebuilt imports bind first.
NEVERD_GENERATED_MODE(ReboundOpaqueCall, 17)
// The export does not exist until the recovered entry resolves it.
NEVERD_GENERATED_MODE(LateOpaqueCall, 18)
// Startup leaves an image pointer to live process-local heap data.
NEVERD_GENERATED_MODE(HeapState, 19)
// Startup frees that data and clears its image pointer before transfer.
NEVERD_GENERATED_MODE(ReleasedHeapState, 20)
// Both loader and program use a provider-derived direct syscall number.
NEVERD_GENERATED_MODE(DirectService, 21)
// The loader stores the number; only the recovered program uses it.
NEVERD_GENERATED_MODE(LateDirectService, 22)
// Startup retains an OS-encoded null pointer in image or TLS bytes.
NEVERD_GENERATED_MODE(EncodedPointer, 23)
// Startup clears that value before transferring control.
NEVERD_GENERATED_MODE(ClearedEncodedPointer, 24)
// Encoding first occurs in the recovered program, after capture.
NEVERD_GENERATED_MODE(LateEncodedPointer, 25)
// The same retained state through the native provider aliases.
NEVERD_GENERATED_MODE(NativeEncodedPointer, 26)
// A decoder input is observed even when no encoder produced it in this run.
NEVERD_GENERATED_MODE(DecodedPointer, 27)
NEVERD_GENERATED_MODE(NativeDecodedPointer, 28)
// Dynamic thread/fiber-local slots are separate from PE static TLS bytes.
NEVERD_GENERATED_MODE(DynamicTLS, 29)
NEVERD_GENERATED_MODE(DynamicFLS, 30)
NEVERD_GENERATED_MODE(ReleasedDynamicTLS, 31)
NEVERD_GENERATED_MODE(ReleasedDynamicFLS, 32)
NEVERD_GENERATED_MODE(LateDynamicTLS, 33)
NEVERD_GENERATED_MODE(LateDynamicFLS, 34)
// An allocated zero-valued slot still has process-local ownership.
NEVERD_GENERATED_MODE(ZeroDynamicTLS, 35)
NEVERD_GENERATED_MODE(ZeroDynamicFLS, 36)
// The modeled API permits storing in an unallocated in-range TLS cell.
NEVERD_GENERATED_MODE(UnallocatedTLSValue, 37)
NEVERD_GENERATED_MODE(ClearedUnallocatedTLSValue, 38)
// Releasing a nonempty FLS slot must not discard its cleanup callback.
NEVERD_GENERATED_MODE(FreedFLSCallback, 39)
NEVERD_GENERATED_MODE(EmptyFLSCallback, 40)
NEVERD_GENERATED_MODE(ReusedFLSCallback, 41)
NEVERD_GENERATED_MODE(NestedFLSCallback, 42)
NEVERD_GENERATED_MODE(RecursiveFLSCallback, 43)
NEVERD_GENERATED_MODE(RearmedFLSCallback, 44)
NEVERD_GENERATED_MODE(EndlessFLSCallback, 45)
#endif

#ifdef NEVERD_GENERATED_ADDRESS_REGISTER
NEVERD_GENERATED_ADDRESS_REGISTER(8)
NEVERD_GENERATED_ADDRESS_REGISTER(9)
NEVERD_GENERATED_ADDRESS_REGISTER(10)
NEVERD_GENERATED_ADDRESS_REGISTER(11)
NEVERD_GENERATED_ADDRESS_REGISTER(12)
NEVERD_GENERATED_ADDRESS_REGISTER(13)
NEVERD_GENERATED_ADDRESS_REGISTER(14)
NEVERD_GENERATED_ADDRESS_REGISTER(15)
#endif

#ifdef NEVERD_GENERATED_BUILD
NEVERD_GENERATED_BUILD(OutputDirectory, "unpack-generated-fixtures")
NEVERD_GENERATED_BUILD(ProgramEntry, "program")
NEVERD_GENERATED_BUILD(ProgramBase, "0x140000000")
NEVERD_GENERATED_BUILD(X64Target, "x86_64-pc-windows-msvc")
NEVERD_GENERATED_BUILD(X64Machine, "x64")
NEVERD_GENERATED_BUILD(AArch64Target, "aarch64-pc-windows-msvc")
NEVERD_GENERATED_BUILD(AArch64Machine, "arm64")
// A loader writes into both code sections, so both are writable.
NEVERD_GENERATED_BUILD(ProgramAccess, ".prog,ERW")
NEVERD_GENERATED_BUILD(RelayAccess, ".relay,ERW")
// The early export cache lives before the static IAT and is loader writable.
NEVERD_GENERATED_BUILD(CacheAccess, ".text,ERW")
NEVERD_GENERATED_BUILD(CacheMerge, ".cache=.text")
#endif

