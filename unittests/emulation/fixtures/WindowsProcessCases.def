#ifdef NEVERD_WINDOWS_FIXTURE_BYTES
NEVERD_WINDOWS_FIXTURE_BYTES(X64Syscall, 0x0f, 0x05, 0xc3)
NEVERD_WINDOWS_FIXTURE_BYTES(X64Privileged, 0x0f, 0x20, 0xc0, 0xc3)
NEVERD_WINDOWS_FIXTURE_BYTES(ARMSyscall, 0x01, 0x00, 0x00, 0xd4, 0xc0, 0x03,
                             0x5f, 0xd6)
NEVERD_WINDOWS_FIXTURE_BYTES(ARMPrivileged, 0x00, 0x10, 0x38, 0xd5, 0xc0, 0x03,
                             0x5f, 0xd6)
#endif
#ifdef NEVERD_WINDOWS_FIXTURE_TEXT
NEVERD_WINDOWS_FIXTURE_TEXT(BadOutput, "b")
NEVERD_WINDOWS_FIXTURE_TEXT(AliasedOutput, "a")
NEVERD_WINDOWS_FIXTURE_TEXT(TLSMutation, "m")
NEVERD_WINDOWS_FIXTURE_TEXT(TailExit, "t")
NEVERD_WINDOWS_FIXTURE_TEXT(ForgedGate, "g")
NEVERD_WINDOWS_FIXTURE_TEXT(ReentrantExit, "d")
NEVERD_WINDOWS_FIXTURE_TEXT(ReturnSlot, "v")
#endif
#ifdef NEVERD_WINDOWS_FIXTURE_ASM
#if defined(_M_X64) || defined(__x86_64__)
NEVERD_WINDOWS_FIXTURE_ASM(ReadTEB, "movq %%gs:0x30, %0")
NEVERD_WINDOWS_FIXTURE_ASM(
    TailExitCode,
    "movq $0, (%rsp)\nmovl $37, %ecx\njmpq *__imp_ExitProcess(%rip)")
NEVERD_WINDOWS_FIXTURE_ASM(ReturnSlotCode,
                           "movq %rsp, %r9\njmpq *__imp_WriteFile(%rip)")
#else
NEVERD_WINDOWS_FIXTURE_ASM(ReadTEB, "mov %0, x18")
NEVERD_WINDOWS_FIXTURE_ASM(
    TailExitCode, "mov x30, xzr\nmov w0, #37\nadrp x16, __imp_ExitProcess\nldr "
                  "x16, [x16, :lo12:__imp_ExitProcess]\nbr x16")
NEVERD_WINDOWS_FIXTURE_ASM(ReturnSlotCode, "ret")
#endif
#endif
#ifdef NEVERD_WINDOWS_FIXTURE_TEXT
NEVERD_WINDOWS_FIXTURE_TEXT(NativeExit, "q")
#endif
