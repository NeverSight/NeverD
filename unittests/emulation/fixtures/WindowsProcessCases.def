#ifdef NEVERD_WINDOWS_FIXTURE_TEXT
NEVERD_WINDOWS_FIXTURE_TEXT(Executable, "fixture.exe")
NEVERD_WINDOWS_FIXTURE_TEXT(Message, "Windows user process\n")
NEVERD_WINDOWS_FIXTURE_TEXT(Detached, "TLS detached\n")
NEVERD_WINDOWS_FIXTURE_TEXT(Binary, "A\0\xffZ")
NEVERD_WINDOWS_FIXTURE_TEXT(Normal, "n")
NEVERD_WINDOWS_FIXTURE_TEXT(Returned, "r")
NEVERD_WINDOWS_FIXTURE_TEXT(Loop, "l")
NEVERD_WINDOWS_FIXTURE_TEXT(InitLoop, "i")
NEVERD_WINDOWS_FIXTURE_TEXT(Fault, "f")
NEVERD_WINDOWS_FIXTURE_TEXT(Privileged, "p")
NEVERD_WINDOWS_FIXTURE_TEXT(Unknown, "u")
NEVERD_WINDOWS_FIXTURE_TEXT(Errors, "e")
NEVERD_WINDOWS_FIXTURE_TEXT(Unsupported, "s")
NEVERD_WINDOWS_FIXTURE_TEXT(Environment, "MODE=hello")
NEVERD_WINDOWS_FIXTURE_TEXT(ProbeOptions,
                            "{\"backend\":\"unicorn\",\"architecture\":\"x64\","
                            "\"contract\":\"checked-user-x64\"}")
NEVERD_WINDOWS_FIXTURE_TEXT(MissingTools,
                            "PE process fixtures require Clang and lld-link")
