NEVERD_WINDOWS_FIXTURE_VALUE(ExitStatus, 37)
NEVERD_WINDOWS_FIXTURE_VALUE(HeapBytes, 33)
NEVERD_WINDOWS_FIXTURE_VALUE(HeapZero, 8)
NEVERD_WINDOWS_FIXTURE_VALUE(StdoutSelector, 0xfffffff5)
NEVERD_WINDOWS_FIXTURE_VALUE(StderrSelector, 0xfffffff4)
NEVERD_WINDOWS_FIXTURE_VALUE(InvalidParameter, 87)
NEVERD_WINDOWS_FIXTURE_VALUE(InvalidUserBuffer, 1784)
NEVERD_WINDOWS_FIXTURE_VALUE(TebPEB, 0x60)
NEVERD_WINDOWS_FIXTURE_VALUE(TebProcessID, 0x40)
NEVERD_WINDOWS_FIXTURE_VALUE(TebThreadID, 0x48)
NEVERD_WINDOWS_FIXTURE_VALUE(TebLastError, 0x68)
NEVERD_WINDOWS_FIXTURE_VALUE(TebTLSSlots, 0x1480)
NEVERD_WINDOWS_FIXTURE_VALUE(PebImage, 0x10)
NEVERD_WINDOWS_FIXTURE_VALUE(PebParameters, 0x20)
NEVERD_WINDOWS_FIXTURE_VALUE(ParamsCommandLineBuffer, 0x78)
NEVERD_WINDOWS_FIXTURE_VALUE(ParamsEnvironment, 0x80)
NEVERD_WINDOWS_FIXTURE_VALUE(Quantum, 3)
NEVERD_WINDOWS_FIXTURE_VALUE(InstructionLimit, 50000)
NEVERD_WINDOWS_FIXTURE_VALUE(LoopLimit, 500)
