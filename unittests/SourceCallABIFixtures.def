#ifndef SOURCE_CALL_ABI_VALUE
#define SOURCE_CALL_ABI_VALUE(Type, Name, Value)
#endif
#ifndef SOURCE_CALL_ABI_SPILL
#define SOURCE_CALL_ABI_SPILL(Floating, Bytes, Offset)
#endif

#ifndef SOURCE_CALL_ABI_NARROW
#define SOURCE_CALL_ABI_NARROW(Bytes)
#endif
#ifndef SOURCE_CALL_ABI_VARIADIC_PART
#define SOURCE_CALL_ABI_VARIADIC_PART(Parameter, Offset, Bytes)
#endif

SOURCE_CALL_ABI_NARROW(1)
SOURCE_CALL_ABI_NARROW(2)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinExtraArguments, 2)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinRegisterArguments, 8)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinRegisterBytes, 8)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinWideBytes, 16)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinPairWords, 2)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinFloatBytes, 4)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinHFAMembers, 4)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinVariadicPrefix, 9)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinThreeMembers, 3)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinNarrowBytes, 1)
SOURCE_CALL_ABI_VALUE(unsigned, kDarwinPartialFPPrefix, 7)
// Independent layout after nine fixed signed bytes. The ninth byte is at SP;
// a promoted int, i128, word pair, HFA3, double, nested HFA4, HFA1 and HFA4d
// follow the ellipsis. Offsets are relative to the callee's entry SP.
SOURCE_CALL_ABI_VARIADIC_PART(9, 8, 4)
SOURCE_CALL_ABI_VARIADIC_PART(10, 16, 8)
SOURCE_CALL_ABI_VARIADIC_PART(10, 24, 8)
SOURCE_CALL_ABI_VARIADIC_PART(11, 32, 8)
SOURCE_CALL_ABI_VARIADIC_PART(11, 40, 8)
SOURCE_CALL_ABI_VARIADIC_PART(12, 48, 4)
SOURCE_CALL_ABI_VARIADIC_PART(12, 52, 4)
SOURCE_CALL_ABI_VARIADIC_PART(12, 56, 4)
SOURCE_CALL_ABI_VARIADIC_PART(13, 64, 8)
SOURCE_CALL_ABI_VARIADIC_PART(14, 72, 4)
SOURCE_CALL_ABI_VARIADIC_PART(14, 76, 4)
SOURCE_CALL_ABI_VARIADIC_PART(14, 80, 4)
SOURCE_CALL_ABI_VARIADIC_PART(14, 84, 4)
SOURCE_CALL_ABI_VARIADIC_PART(15, 88, 4)
SOURCE_CALL_ABI_VARIADIC_PART(16, 96, 8)
SOURCE_CALL_ABI_VARIADIC_PART(16, 104, 8)
SOURCE_CALL_ABI_VARIADIC_PART(16, 112, 8)
SOURCE_CALL_ABI_VARIADIC_PART(16, 120, 8)
SOURCE_CALL_ABI_SPILL(true, 4, 0)
SOURCE_CALL_ABI_SPILL(true, 4, 4)
SOURCE_CALL_ABI_SPILL(false, 8, 8)
SOURCE_CALL_ABI_SPILL(true, 4, 16)
SOURCE_CALL_ABI_SPILL(true, 8, 24)

#undef SOURCE_CALL_ABI_VALUE
#undef SOURCE_CALL_ABI_SPILL

#undef SOURCE_CALL_ABI_NARROW
#undef SOURCE_CALL_ABI_VARIADIC_PART
