// One regular compact page, first-level entry plus sentinel, no LSDA or
// personalities. The final word is varied by the individual source contract.
NEVERD_RA_CAPI_WORDS(kCompactWords, 1, 28, 0, 28, 0, 28, 2, 0x400, 52, 52,
                     0x440, 0, 52, 2, 0x00010008, 0x400, 0x05001000)

