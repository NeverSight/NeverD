NEVERD_RA_CAPI_TEXT(kUnwindSection, "__unwind_info")
NEVERD_RA_CAPI_TEXT(kJSONNull, "null")
NEVERD_RA_CAPI_TEXT(kJSONEmpty, "")
NEVERD_RA_CAPI_TEXT(kBegin, "begin")
NEVERD_RA_CAPI_TEXT(kEnd, "end")
NEVERD_RA_CAPI_TEXT(kEncoding, "encoding")
NEVERD_RA_CAPI_TEXT(kLanguageData, "language_data")
NEVERD_RA_CAPI_TEXT(kPersonality, "personality")
NEVERD_RA_CAPI_TEXT(kReturnAddress, "return_address")
NEVERD_RA_CAPI_TEXT(kQueryPC, "query_pc")
NEVERD_RA_CAPI_TEXT(kDwarfState, "dwarf_state_at_pc")
NEVERD_RA_CAPI_TEXT(kCompactRecipe, "compact_recipe")
