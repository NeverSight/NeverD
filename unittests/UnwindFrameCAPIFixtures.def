NEVERD_RA_CAPI_VALUE(uint32_t, kRangeFieldOffset, 16)
NEVERD_RA_CAPI_VALUE(uint32_t, kSignedCompact, 0x05001000)
NEVERD_RA_CAPI_VALUE(uint32_t, kOrdinaryCompact, 0x04000000)
NEVERD_RA_CAPI_VALUE(uint32_t, kAArch64DwarfMode, 0x03000000)
NEVERD_RA_CAPI_VALUE(uint32_t, kX64DwarfMode, 0x04000000)
NEVERD_RA_CAPI_VALUE(uint64_t, kShortDwarfRange, 0x20)
NEVERD_RA_CAPI_VALUE(size_t, kRememberDepthOverflow, 65)
NEVERD_RA_CAPI_VALUE(uint8_t, kRememberState, 0x0a)
NEVERD_RA_CAPI_VALUE(unsigned, kPathCapacity, 128)
NEVERD_RA_CAPI_TEXT(kDirectoryPrefix, "neverd-unwind-frame-capi")
