NEVERD_RA_CAPI_TEXT(kOutOfRange, "out_of_range")
NEVERD_RA_CAPI_TEXT(kResourceLimit, "resource_limit")
NEVERD_RA_CAPI_TEXT(kSP, "sp")
NEVERD_RA_CAPI_TEXT(kUnsigned, "unsigned")
NEVERD_RA_CAPI_TEXT(kSPPC, "sp_and_pc")
