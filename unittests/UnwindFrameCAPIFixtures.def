#ifndef NEVERD_RA_CAPI_VALUE
#define NEVERD_RA_CAPI_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_RA_CAPI_TEXT
#define NEVERD_RA_CAPI_TEXT(Name, Text)
#endif
#ifndef NEVERD_RA_CAPI_WORDS
#define NEVERD_RA_CAPI_WORDS(Name, ...)
#endif

NEVERD_RA_CAPI_VALUE(uint64_t, kImageBase, 0x100000000)
NEVERD_RA_CAPI_VALUE(size_t, kFileBytes, 0x2000)
NEVERD_RA_CAPI_VALUE(uint32_t, kLoadCommandCount, 2)
NEVERD_RA_CAPI_VALUE(uint32_t, kCodeOffset, 0x400)
NEVERD_RA_CAPI_VALUE(uint32_t, kFrameOffset, 0x800)
