{
  "schema": "neverd.gui-plugin.v1",
  "id": "workbench-explorer",
  "name": "Workbench Explorer",
  "version": "1.2.0",
  "program": "python",
  "arguments": [
    "explorer.py"
  ],
  "queries": [
    "metadata",
    "functions",
    "disasm",
    "bytes",
    "cfg",
    "xrefs",
    "imports",
    "resolve"
  ],
  "actions": [
    {
      "id": "report",
      "title": "Analyze current function",
      "context": "function",
      "context_menu": true,
      "icon": "icons/function-report.svg"
    },
    {
      "id": "overview",
      "title": "Browse largest functions",
      "context": "project",
      "icon": "builtin:functions"
    },
    {
      "id": "instructions",
      "title": "Inspect selected instructions",
      "context": "address",
      "context_menu": true,
      "icon": "builtin:bytes"
    },
    {
      "id": "graph",
      "title": "Function report with CFG",
      "context": "function",
      "context_menu": true,
      "icon": "builtin:graph"
    }
  ],
  "icon": "builtin:extensions"
}
