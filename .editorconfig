root = true

# Global defaults: unified line endings, charset and final newline across platforms
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: keep trailing whitespace (two trailing spaces mean a hard line break)
[*.md]
trim_trailing_whitespace = false

# Binary / build artifacts: no normalization
[*.{bc,o,obj,a,lib,so,dylib,dll,exe,elf,vm,vmp,bin,png,jpg,jpeg,gif,ico,pdf,zip,gz,tar}]
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
