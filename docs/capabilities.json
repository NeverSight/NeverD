{
  "schema": 1,
  "capabilities": [
    {
      "id": "symbolic.execution.path-exploration",
      "kind": "analysis",
      "status": "experimental",
      "owner": "symbolic",
      "targets": [
        "x86",
        "x86_64",
        "arm",
        "aarch64"
      ],
      "docs": [
        "docs/architecture.md"
      ],
      "limitations": [
        "mixed decode-mode boundaries fail closed when block identity cannot prove the execution mode",
        "unresolved indirect control flow is reported as a typed path termination"
      ],
      "tests": [
        "SymExplore.InterworkingDoesNotEnterABlockDecodedInTheWrongMode",
        "SymExplore.ContradictoryPathConditionsAreNotExecuted"
      ],
      "public_surfaces": {
        "c": [],
        "python": [],
        "cli": [
          "neverd sym-explore"
        ],
        "json": []
      }
    },
    {
      "id": "translation.runtime-contract",
      "kind": "translation",
      "status": "experimental",
      "owner": "translate",
      "targets": [
        "x86_64"
      ],
      "docs": [
        "docs/architecture.md"
      ],
      "limitations": [
        "the fixed runtime state covers the x86-64 integer core and preserves unmodeled logical state outside generated code",
        "deterministic target resolution, verification, exact runtime-symbol binding, and one-way W^X publication do not by themselves provide an executable translation engine",
        "the native publication smoke test proves only the generated-code memory boundary, not guest lowering, object linking, dispatch, or cross-architecture execution"
      ],
      "tests": [
        "RuntimeGuestState.X86_64LogicalStateRoundTripsWithoutLosingRFlags",
        "RuntimeHelpers.AcceptsCheckedLoadAndStoreControlFlow",
        "ResolvedHostTarget.FeatureOrderDoesNotChangeCacheIdentity",
        "ResolvedHostTarget.ResolvesTheNativeProcessIdentity",
        "RuntimeCodeMemory.PublishesExactlyOnceFromWritableToExecutable",
        "RuntimeCodeMemory.ExecutesOnlyAfterHostInstructionsArePublished",
        "RuntimeSymbolRegistry.ResolvesOnlyExactRegisteredNames",
        "RuntimeSymbolRegistry.IdentityIsVersionedAddressFreeAndOrderStable",
        "TranslationArtifactVerifier.AcceptsCanonicalMachOObject"
      ],
      "public_surfaces": {
        "c": [],
        "python": [],
        "cli": [],
        "json": []
      }
    },
