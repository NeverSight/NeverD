        "x86_64",
        "arm",
        "aarch64"
      ],
      "docs": [
        "docs/python-plugins.md"
      ],
      "limitations": [
        "candidate discovery never authorizes a rewrite without an equivalent proof",
        "grammar coverage is explicit; exhaustive mode removes work and solver ceilings but cannot remove physical resource limits"
      ],
      "proof_test": {
        "target": "NeverDSymbolicTests",
        "source": "unittests/symbolic/SymSynthTests.cpp",
        "filter": "SymSynth.ProductionRewriteAcceptsOnlyAProvedEquivalent"
      },
