    {
      "id": "llvm.semantic.synthesis-rewrite",
      "kind": "rewrite",
      "status": "supported",
      "owner": "pass-ir",
      "targets": [
        "x86",
        "x86_64",
        "arm",
        "aarch64"
      ],
      "docs": [
        "docs/python-plugins.md"
      ],
      "limitations": [
        "eligible integer SSA expressions only; poison, undef, and unmodelled operations remain opaque",
        "synthesis is opt-in and conservative mode deliberately performs no semantic rewrite"
      ],
      "proof_test": {
        "target": "NeverDSymSimplifyGuardTests",
        "source": "unittests/lift/pipeline/SymSimplifyGuardTests.cpp",
        "filter": "SymSimplifyGuard.SynthesisEquivalent"
      },
      "unknown_test": {
        "target": "NeverDSymSimplifyGuardTests",
        "source": "unittests/lift/pipeline/SymSimplifyGuardTests.cpp",
        "filter": "SymSimplifyGuard.SynthesisUnknownLeavesIRUnchanged"
      },
      "poison_test": {
        "target": "NeverDSymSimplifyGuardTests",
        "source": "unittests/lift/pipeline/SymSimplifyGuardTests.cpp",
        "filter": "SymSimplifyGuard.LeavesPoisonGeneratingOperationsOpaque"
      },
      "tests": [
        "NeverDSemanticCAPI.SynthesisRewriteRequiresAnEquivalentProof",
        "NeverDSemanticCAPI.LLVMOptimizationUsesTheTransactionalDeepPipeline"
      ],
      "public_surfaces": {
        "c": [
          "neverd_synthesize_expr",
          "neverd_optimize_llvm_ir"
        ],
        "python": [
          "synthesize_expression",
          "optimize_llvm_ir"
        ],
        "cli": [
          "neverd simplify --synthesize",
          "neverd optimize-ir"
        ],
        "json": [
          "neverd_synthesize_expr_json_v1",
          "neverd_optimize_llvm_ir_json_v1"
        ]
      }
    },
