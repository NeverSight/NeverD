    "mode": "Explicit ordinary-RAM protected legacy execution, code16/code32; legacy paging and PAE",
    "undefined_flag_masks": {
      "AAA/AAS": "0x8c4 (OF/SF/ZF/PF)",
      "DAA/DAS": "0x800 (OF)",
      "AAM/AAD": "0x811 (OF/AF/CF)"
    },
    "zero_base": "AAM delivers restartable #DE; AAD keeps AL and clears AH. Ordinary function-ABI lifting refuses AAM zero.",
    "native_oracle": "Original KVM execution precedes the software model; only the instruction-specific undefined flag slice is imported as an explicit input. Defined outputs, GPRs, frames and RAM are independently calculated. Unit cases independently vary undefined choices.",
    "refused_forms": [
      "LOCK",
      "REP",
      "duplicate prefixes",
      "malformed instruction extent"
    ],
    "compiler_boundary": "This change adds no NeverC i386 frontend or native i386 decimal intrinsic API."
  },
