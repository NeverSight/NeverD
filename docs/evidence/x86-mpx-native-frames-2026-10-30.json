  "neverd_documentation_base": "9b76b90e84b9d3c394614a11f009b77a5837bb78",
  "implementation": {
    "cause": "Fixed BX/SI operand copies overwrote reserved frame bases; volatile local accesses then used the native operand address.",
    "fix": "Reuse allocated legacy-encodable native address carriers for base, MIB index and register checks. Frame/PIC registers remain owned by register allocation and frame lowering.",
    "stack_memory": "BNDMOV load/store/LOCK-store use unmodified RBP plus a computed index. Both long-mode encoding widths retain the complete 64-bit address because MPX ignores 67H.",
    "controls": "Shared LLVM MPX address validator admits the three memory forms; rejects stack controls in i386, MIB, BNDMK and address checks, FS/GS combinations and malformed controls.",
    "capabilities": [
      "LLVM_X86_MPX_STACK_MEMORY=1",
      "__NEVERC_X86_MPX_STACK_MEMORY__=1"
    ],
    "intrinsic_and_opcode_ids_changed": false
  },
