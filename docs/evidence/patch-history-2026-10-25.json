  "memory_driver": "import importlib.util,json,os,sys\nfrom pathlib import Path\nroot=Path.cwd()\na=Path('/mnt/data/neverd-patch-history')\nos.environ['TMPDIR']=str(a/'tmp')\nspec=importlib.util.spec_from_file_location('bench',root/'tools/neverd-bench/patch-scaling.py')\nm=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nbase=m.Client\nobservations=[]\nclass Client(base):\n def close(self):\n  status=Path(f'/proc/{self.process.pid}/status').read_text()\n  rss={k:int(v.strip().split()[0]) for line in status.splitlines() if ':' in line for k,v in [line.split(':',1)] if k in ['VmHWM','VmRSS']}\n  observations.append(rss)\n  super().close()\nm.Client=Client\nvariant=sys.argv[1]\nlib=a/variant/'bin/libneverd.so'\nos.environ['LD_LIBRARY_PATH']=str(lib.parent)\nhost=m.HostAPI(m.ctypes.CDLL(str(lib)))\nfor count in [64,8192]:\n for attempt in range(3):\n  m.worker_edit_case(host,str(lib.parent/'neverd-worker'),lib,count,3)\n  observations[-1].update(adjacent_rows=count,attempt=attempt)\nprint(json.dumps({'variant':variant,'library_sha256':m.digest(lib),'worker_sha256':m.digest(lib.parent/'neverd-worker'),'scope':'Linux /proc VmHWM after three checked commits and undos; includes worker startup, input load and whole durable state, not isolated allocations or a timing comparison.','observations':observations},indent=2))\n",
