  "contract": {
    "profiles": [
      "InputBeforeWrite",
      "InputAfterWriteChecks",
      "InputBeforeWriteFragments"
    ],
    "oracle": "Original protected instructions using independent identical device tapes through KVM_EXIT_IO. This is KVM-intercepted device emulation, not bare CPU port execution.",
    "environments": [
      "legacy paging",
      "PAE",
      "16/32-bit protected code",
      "16/32-bit addressing",
      "CPL0..3"
    ],
    "state": [
      "GPR bank",
      "EIP and original restart frames",
      "defined EFLAGS",
      "CR2",
      "usable segment caches",
      "selector/unusable for unusable caches",
      "operand/frame RAM",
      "ordered device transcript",
      "NMI inhibition"
    ],
    "ownership": "One shared device/bitmap owner; mode adapters own decoding, TSS admission, segment/canonical checks, alignment order and staged register progress.",
    "event_resume": "Retains the current accepted event, fault EIP, saved flags and recursive exception across missing backing. Resume retries that entry against retained ordinary RAM, without refetch, device replay, repeated event acceptance or NMI inhibition. Caller repairs backing without changing architectural state or running guest code.",
    "native_repair": "All OUTS widths and byte INS. Multi-element word/dword INS repair uses the separate discrepancy regression.",
    "native_async_boundary": "Output IRQ/NMI only; select the observed completed element count but independently compute model effects and frames.",
    "software_checks": [
      "Input profiles and partial stores",
      "Backing, device wait and callback-error effects",
      "Permission before zero count",
      "16-bit TSS denial and 32-bit wrapped implicit bitmap reads",
      "AC/PF order",
      "Consumed input across IDT backing stop and recursive DF",
      "Accepted NMI resume despite its own inhibition",
      "Both input/output IRQ/NMI delivery, IRET and continued progress"
    ],
    "exclusions": [
      "Physical bus/device read-ahead and interrupt timing",
      "Native input batch-completion interrupt timing",
      "KVM port AC omission as architectural evidence",
      "MMIO, concurrent CPUs, external writers and mutable original instruction bytes",
      "Self-modifying page-table fragment behavior",
      "Hardware debug-stop RF and opaque unusable cache payload",
      "Processor-dependent A/D on faulting walks",
      "Task/VM86/real mode, CET/FRED and debug producers",
      "General i386 source dispatcher"
    ]
  },
