  "reference": {
    "url": "https://cdrdv2.intel.com/v1/dl/getContent/671241",
    "document": "Intel SDM 253667-093US, SYSENTER, SYSEXIT and SYSRET, September 2026",
    "accessed": "2026-10-30"
  },
  "implementation": {
    "entry": "Canonical 0F34/0F35 share semantics in 64-bit and compatibility mode. V7 and inherited V8 accept both compatibility CS.D values with CS.base=0 and the complete instruction within CS.limit. Invalid privilege/cache/mode combinations refuse before effects. Other bytes retain their prior mode guard.",
    "transition": "The existing owner installs the full IA-32e SYSENTER RIP/RSP and CPL0 long-mode caches. SYSEXIT retains ECX/EDX low-word semantics and eight explicit arbitrary GPR high halves. No new ABI layout or intrinsic identity is introduced.",
    "driver": "Public source can resume a SYSEXIT return at an exported SYSENTER stub. Each transfer returns its existing status and consumes one step before target execution; normal compatibility instructions remain unavailable."
  },
  "qualification": {
    "native_original_instructions": 5760,
    "native_full_state_ram_comparisons": 23040,
    "native_matrix": "Both compatibility defaults; all valid CPL/DPL/conforming inputs, four selectors, four input flag patterns, three stack values, both C routes O0/O2, and four independent high-half choices.",
    "native_preservation": "All represented state, mapped RAM and live SYSENTER/kernel-GS MSRs are compared. The existing oracle also compares a seeded 4096-byte XSAVE image. Larger XSAVE2/AMX and arbitrary full-vector state are not independently sampled.",
    "portable_entry_context_cases": 2304,
    "portable_code_base_limit_cases": 1440,
    "public_sdk": "Both C routes at O0/O2 compare complete state through SYSENTER/SYSEXIT/SYSENTER and exact stop/budget behavior.",
    "compiler_bridge": {
      "profiles": [
        "high-neverc-O0",
