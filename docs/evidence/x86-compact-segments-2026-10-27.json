    },
    "regression": "126 compact/four-source literal cases per optimization level, executed with Clang ASan/UBSan and NeverC."
  },
  "boundaries": {
    "physical_avx512_execution_qualified": false,
    "descriptor_fault_execution_qualified": false,
    "neverc_frontend_architecture": "x64",
    "neverc_i386_execution_qualified": false,
    "source_transport_recorders": "Native calls alone are replaced by checked recorders; target attributes are removed. Host x64 runs validate operand values, widths, masks, zeroing, segment prefixes and ordinary DS object access, not i386 execution.",
