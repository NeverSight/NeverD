  "contract": {
    "llvm": [
      "i16 llvm.x86.fnstsw()",
      "void llvm.x86.fnstsw.mem(ptr)",
      "void llvm.x86.fnclex()",
      "void llvm.x86.fninit()",
      "void llvm.x86.fwait()"
    ],
    "neverc": [
      "unsigned short __builtin_ia32_fnstsw(void)",
      "void __builtin_ia32_fnstsw_mem(unsigned short *)",
      "void __builtin_ia32_fnclex(void)",
      "void __builtin_ia32_fninit(void)",
      "void __builtin_ia32_fwait(void)"
    ],
    "memory": "FNSTSW memory retains a single DD /7 two-byte alignment-one volatile access, not a register read plus a store.",
    "effects": "Conservative IR effects; native FPSW dependencies; FWAIT reads FPCW and may raise an FP exception. Status reads, FNCLEX and FNINIT are nonwaiting.",
    "reset_allocation": "FNINIT clobbers compiler FP, architectural ST and MMX register banks and is a scheduling boundary. This preserves live compiler values through spills/reloads, without asserting physical payload erasure.",
    "shared_ownership": "One X86 validator and private C renderer own seven control/status interfaces. The negative test covers 152 malformed cases before function filtering.",
    "projection": "Typed FNINIT/FNCLEX/FWAIT select registered native LLVM calls; C selects available NeverC builtins; r6 and other C compilers retain exact assembly fallbacks.",
    "owned_state": "Owned restore/step/save/host-restore remains one assembly unit. Typed X87ReadStatus consumes its sampled SSA status rather than ambient FNSTSW."
  },
