  "contract": {
    "profile": "X86LegacyFarTransferProfile::OrderedFrame",
    "oracle": "Original protected instructions under KVM, with independently initialized identical RAM/state. Native target/fault handlers stop through hardware execution breakpoints; they never execute the model.",
    "environments": [
      "16/32-bit protected code",
      "legacy paging and PAE",
      "CPL0..3",
      "GDT/LDT",
      "16/32-bit operand/address/gate/TSS/stack widths"
    ],
    "state": [
      "all eight GPRs",
      "EIP",
      "defined EFLAGS",
      "CR2",
      "usable segment caches",
      "selector/unusable for unusable caches",
      "descriptor bytes",
      "old/new stack and parameter bytes",
      "fault vector and frame"
    ],
    "ordering": [
      "pointer offset before selector, each field address-size wrapped",
      "code/stack accessed writes before later faults",
      "TSS stack offset before selector",
      "complete destination stack segment extent before frame writes",
      "old SS:SP before highest parameter",
      "descending interleaved parameter read/store",
      "old CS:return offset after parameters",
      "target limit after frame writes",
      "register/cache publication only on full completion"
    ],
    "software_checks": [
      "missing/invalid profile and malformed forms before fetch",
      "LOCK UD after authenticated fetch",
      "gate width independent of operand prefix",
      "RETF imm16 outer-stack parameter cleanup",
      "fault delivery backing stop/resume without replaying the accepted event",
      "original handler IRET and instruction retry",
      "retained partial call frame and highest-parameter CR2"
    ],
    "ordinary_lifting": "Unbound immediate or memory far branches refuse atomically in strict/permissive and fast/detailed routes. The removed near-call/branch lowering discarded architectural selector and gate state.",
    "exclusions": [
      "native LLVM/NeverC far-transfer intrinsics and general i386 source dispatcher",
      "task gates/TSS task switches",
      "real/VM86/IA-32e far execution",
      "reserved L-bit target caches",
      "CET/FRED and hardware debug producers",
      "REP/BND/duplicate prefixes",
      "concurrent CPUs, MMIO and external writers",
      "debugger RF and opaque unusable cache payload",
      "processor-dependent A/D on faulting walks",
      "other CPUs without a separately qualified binding"
    ]
  },
