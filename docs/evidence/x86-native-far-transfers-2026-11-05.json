  "contract": {
    "interfaces": 10,
    "returning_call": "No C arguments; AX/EAX/RAX result; platform C callee-saved banks and environment; exact CS/SS/SP restored by RETF; zero copied gate parameters; continuation offset fits actual return-frame width.",
    "terminal_jump": "Explicit ESP/RSP installed adjacent to the native far transfer; target base excludes SP; other registers compiler-selected.",
    "lowering": "Real call sequences and platform register masks, Win64 home space, no leaf red zone; terminal machine carriers survive until MC emission.",
    "oracle": "Independently encoded native far bytes execute at the same PC from a copied boundary state, including complete XSAVE import. Compare GPRs, segment/system state, FPU/XMM, events and all 2 MiB guest RAM. Returning entry then clobbers caller-saved banks and memory before the compiled continuation.",
    "formats_compile_only": [
      "ELF",
      "COFF",
      "Mach-O"
    ],
    "execution_platform": "Linux KVM, Intel Core i9-13900H, P core 2 and E core 12",
    "coverage": [
      "code16/code32/code64",
      "x32 pointer ABI",
      "LLVM IR, NeverC source and NeverC IR through full LLVM at O0/O2",
      "CPL0 and CPL3 direct transfers",
      "zero-parameter 16/32-bit call gates with independent opcode widths",
      "fixed and dynamic compiler frames",
      "packed targets copied into the compiler stack",
      "callee-saved restoration, integer and vector live values, memory effects",
      "native identity, mode/type/immediate diagnostics"
    ],
    "modes": "Code16 and x32 execute only full LLVM profiles. Linux i386 NeverC source uses its checked full-LLVM backend; x64 source uses the embedded backend.",
    "exclusions": [
      "arbitrary original-image context restoration",
      "nonzero native call-gate parameters",
      "task switching",
      "CET",
      "fault recovery",
      "asynchronous unwinding",
      "generic lifting of unbound far CALL/JMP"
    ]
  },
