  "reference": {
    "url": "https://cdrdv2-public.intel.com/874240/325462-090-sdm-vol-1-2abcd-3abcd-4.pdf",
    "document": "Intel SDM 325462-090, IRET/IRETD/IRETQ and RET; Volume 3A section 7.14.3",
    "artifact": "/mnt/data/neverd-uiret-20261030/intel-sdm-090.pdf",
