  "implementation": {
    "domain": "V6 and inheriting V7/V8 retain their 64-bit CPL0 entry, disabled CET/FRED, successful ordinary sequential RAM and no asynchronous event domain. Canonical CF/CB/CA imm16 with no prefix, 66 or 48 select dword, word or qword frame fields.",
    "lifter": "All IRET operand widths begun in 64-bit mode pop five frame fields, even at the same target CPL. The earlier narrow lift incorrectly named only three. Legacy i386 admission is unchanged.",
    "admission": "One frame-return reader binds exact bytes, field sizes, addresses and terminal intrinsic shape. It derives unsigned immediate cleanup once. Noncanonical prefix combinations remain native requests.",
    "state": "Narrow IP/SP fields zero-extend before target-mode stack rules. Word IRET preserves RF/AC/ID/VIF/VIP; wider IRET restores those bits from the frame. Existing target cache, segment invalidation, NMI, monitor and conditional high-half behavior is shared.",
    "memory": "The shared descriptor owner reads exactly the requested field width and forwards a pending accessed bit only when it lies within that field. Same-CPL RETF does not require absent saved SP/SS fields.",
    "public_export": "All three operand widths publish the same eight conditional compatibility choices, consume one driver step, stop before a selected target and refuse compatibility reentry without another budget charge.",
    "compiler": "Existing LLVM/NeverC native frame APIs need no source changes. NeverC still supports x86_64/aarch64 frontend targets; its deliberate i386 target refusal is separate from LLVM's i386 intrinsic backend."
  },
  "qualification": {
    "routes": [
      "high-c",
      "llvm-c"
    ],
    "optimizations": [
      "O0",
      "O2"
    ],
    "portable_sanitizers": [
      "address",
      "undefined"
    ],
    "exploratory_original_cases": 48,
    "native_original_instructions": 12296,
    "native_paired_state_and_ram_comparisons": 49184,
    "portable_guard_page_state_and_ram_cases": 1536,
    "public_export_success_and_reentry_pairs_all_widths": 24,
    "native_and_new_portable_paging_width": 48,
    "native_observations": "Independent KVM original instructions provide GPR, flags, IP, segment/cache, descriptor-table and event-state observations, plus all affected descriptor/frame RAM. Four independent high-half choices preserve every defined bit. This legacy oracle does not independently sample arbitrary full XSAVE/vector banks.",
    "matrix": "Both narrow widths; IRET and RETF plain/imm7/imm65535; target CPL0..3, 64-bit and both compatibility defaults, GDT/LDT, SS.B0/1, original-SP carries, saved-SP truncation, all 32 frame flag bits and narrow descriptor/frame aliases.",
    "guard_pages": "The last required frame byte borders PROT_NONE. The tests compare the full represented state and RAM and cover word flag preservation, same-CPL short frames and cleanup."
  },
