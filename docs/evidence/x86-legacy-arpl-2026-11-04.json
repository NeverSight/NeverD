{
  "schema_version": 1,
  "date": "2026-11-04",
  "scope": "Protected word ARPL register/memory completion, conditional access and original fault retry",
  "global_goal_complete": false,
  "reference": {
    "url": "https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html",
    "edition": "Intel SDM 093 Volume 2A, ARPL, pages 3-75 and 3-76",
    "qualified_host": "Intel Core i9-13900H, P core CPU 0 and E core CPU 12"
  },
  "contract": {
    "ownership": "Existing protected ordinary-RAM scalar grammar and executor; no new option or public state field. Exact raw bytes and mode precede fetch. The architectural RPL and ZF rules are implemented once.",
    "width": "ARPL always consumes a word, even with 66. Independent code/address sizes, segment prefixes and every register alias preserve unaffected bits.",
    "memory": "Read the original destination first. Only DEST.RPL < SRC.RPL requests a complete word store. False conditions can complete through read-only pages/segments. Read faults precede conditional write permission faults.",
    "publication": "Only successful completion changes destination RPL and ZF. Failed writes preserve old ZF and all original register state. Ordinary completion alone clears live RF. Fault frames retain original EIP and the original flags.",
    "restart": "Original guest handlers repair the PTE, discard the #PF error code and execute IRET before retry. Read and successful conditional-write A/D effects are compared independently of architectural state.",
    "native_interfaces": "The LLVM ARPL native interfaces already exist; this batch extends the protected original-state executor and adds no new compiler API or NeverC i386 frontend."
  },
