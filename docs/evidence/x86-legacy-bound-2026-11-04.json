{
  "schema_version": 1,
  "date": "2026-11-04",
  "scope": "Legacy BOUND native compiler interfaces, exact source projection, protected-state completion and full-width returned-value preservation",
  "global_goal_complete": false,
  "reference": {
    "url": "https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html",
    "edition": "Intel SDM 093, Volume 2A, BOUND",
    "qualified_host": "Intel Core i9-13900H; CPU 2 P core, CPU 12 E core, CPUID.1A core types 0x40/0x20",
    "interpretation": "The observed CPU compares signed inclusive lower <= index <= upper. It does not add the element size to the upper bound. The upper field is accessed only after the lower comparison succeeds."
  },
  "contract": {
    "protected": "Code16/code32, independently selected address16/address32, word/dword index and bounds, CPL0-3, segmented ordinary RAM under legacy paging/PAE. Each field offset wraps independently; bytes within a field do not wrap past its segment limit.",
    "faults": "Lower operand access precedes signed comparison; a lower failure raises #BR without touching the upper field. #BR/#GP/#SS/#PF/#AC and original fault EIP/RF follow the existing ordered executor. Original guest #BR/#PF handlers repair state and IRET before retry.",
    "mpx": "CPL and OSXSAVE are rebound from the current machine. Enabled #BR clears BNDSTATUS before attempted IDT delivery, even if delivery fails. Unknown enable state and explicitly active transactions refuse before fetch; an active transaction is refused even when MPX is disabled.",
    "compiler": "LLVM bound16/bound32 pointer and address32 interfaces plus four Clang builtins lower to native BOUND in code16/i386. Address controls and long-mode use are rejected. Calls have conservative memory effects and no result; repeated or unused checks remain observable.",
    "source": "Low/Med retain index, normalized eight-byte segment offset, constant address width and segment. HighC and LLVMC share a renderer requiring a concrete X86 target and the exact memory-effect contract. The pinned SDK retains one exact volatile GNU assembly alternative.",
    "returned_value": "A complete propagated parameter, temporary, constant or other-register value precedes later physical return-register read views. HighC and LLVM apply this to integer/pointer returns; declared source types do not authorize truncating a full returned value.",
    "decoder": "Capstone BOUND index and bounds memory operands are read-only, with no invented register or EFLAGS writes. Strict lifting checks raw bytes against the corrected operand details."
  },
