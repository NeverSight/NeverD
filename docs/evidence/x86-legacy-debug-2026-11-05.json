  "contract": {
    "binding": "InstructionStep with matching optional Debug state; DR7=0x400, DEBUGCTL=0, valid DR6 reserved bits, outside transactions. Enabled hardware controls refuse before fetch.",
    "tf": "Sample instruction-entry TF; POPF/IRET clearing TF still steps, setting TF starts with the next instruction; RF does not suppress instruction stepping.",
    "shadow": "MOV/POP SS suppresses its own TF cause when it establishes the window; no deferred BS. Consecutive SS load consumes the incoming window; LSS creates none. ICEBP after a real MOV SS keeps its own cause.",
    "dr6": "Clear inactive B0..B3; set RTM; preserve sticky status. TF sets BS; ICEBP does not. Software INT 1 and faults before completion do not generate a cause.",
    "continuation": "Publish completion and cause before IDT entry; retain them through failed gates/frames and backing stops. Resume accepted entry without replay. REP unfinished elements save original PC/RF; IRET keeps restored RF.",
    "native_oracle": "Original KVM instructions, guest debugging disabled, real IDT handlers, final HLT. Compare eight GPRs, six segment caches, EIP/EFLAGS/CR2, DR6/DR7, inhibition and complete 2 MiB RAM, including page tables and partial frames.",
    "round_trips": "Original #DB handler increments a RAM counter then IRET; original #PF handler repairs a PTE, drops error and IRET before retried load traps. No host-side intermediate repair.",
    "matrix": {
      "paging": [
        "legacy",
        "PAE"
      ],
      "code_bits": [
        16,
        32
      ],
      "stack_bits": [
        16,
        32
      ],
      "gate_bits": [
        16,
        32
      ],
      "cpl": [
        0,
        3
      ],
      "rf": [
        false,
        true
      ],
      "dr6": [
        "0xffff0ff0",
        "0xffffafff",
        "0xffffefff",
        "0xffffeff0"
      ],
      "instruction_scenarios": 42,
      "exception": "DebugStackFault requires CPL3"
    },
    "native_cpu": "Intel Core i9-13900H, P cores 2/4 and E core 12; Linux 7.0.0-42-generic",
    "historical_status_limit": "KVM CPUID exposes no RTM or bus-lock detection. Canonical native inputs have BLD=RTM=1. Incoming BLD=0/RTM=0 on a capable processor is software-only coverage; no native producer claimed."
  },
  "integration_note": "Ten existing dev commits were fast-forwarded from the source base before publication; the last two change only unrelated tests outside the qualified targets. All changed implementation/test files retained identical hashes. Rebuilt paging executables are compared with the exact tested binaries; x64 execution uses the integrated pipeline.",
