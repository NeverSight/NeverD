  "contract": {
    "source": "paged_memory and paged_debug with kernel-events-v6; separate debug step/validation bridges; instruction regions, optional IRQ/NMI scheduler; V6 wire layout unchanged",
    "state": "Explicit lifetime-bound external DR6/DR7/DEBUGCTL bank. DR7=0x400, DEBUGCTL=0, reserved/high DR6 bits checked before polling/fetch. Outside transactions. Enabled hardware breakpoints/GD/BTF refuse.",
    "cause": "Entry TF, RF-independent. Completed instruction or REP element publishes shared i386/x64 DR6 status before trap delivery. ICEBP does not add BS. Software INT1/INT3, instruction faults and external events do not fabricate status.",
    "flags": "Canonical PUSHFQ/POPFQ use existing lifter scalar flags and stack accesses, shared protected POPF mask with entry CPL/IOPL; setting TF starts with the next instruction; clearing TF still uses entry sampling. IRET retains restored RF.",
    "shadows": "Scheduler supplies current SS blocker. First MOV SS suppresses its own single-step trap; consecutive MOV SS consumes it; LSS creates none; ICEBP after MOV SS retains its own cause.",
    "continuation": "Completed instruction and cause survive failed debug entry. Accepted-event records retain the selected secondary exception, original fault PC, successful reads and writes. Resume skips completed writes and reuses read values, including descriptor/frame aliases; NMI acceptance survives its own blocker.",
    "oracle": "Independent original KVM bytes, guest debugging disabled, real IDT handlers ending HLT; compare DR6/DR7, 16 GPRs, usable segment caches, FS/GS bases, RFLAGS/RIP/CR2, NMI and scheduler shadows, complete 256 KiB RAM. Preseed page A/D to avoid extra handler-fetch effects.",
    "matrix": {
      "cpl": [
        0,
        1,
        2,
        3
      ],
      "rf": [
        0,
        1
      ],
      "dr6": [
        "0xffff0ff0",
        "0xffffafff",
        "0xffffefff",
        "0xffffeff0"
      ],
      "instruction_scenarios": 33,
      "source_routes": [
        "HighC",
        "LLVM-to-C"
      ],
      "compilers": [
        "Clang",
        "NeverC"
      ],
      "optimization": [
        "O0",
        "O2"
      ],
      "sdk": [
        "fork",
        "r6"
      ],
      "core_types": [
        "P",
        "E"
      ]
    },
    "round_trips": "Original handler increments RAM count and IRET; all REP elements step exactly once; original #PF handler repairs its PTE, drops error, IRET and retries before #DB. No host-side mid-program repair."
  },
