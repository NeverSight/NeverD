  "contracts": [
    "The runtime captures original near-transfer kind, instruction PC, committed PC/SP/RAX before post-instruction debug delivery. A distinct transfer_v1 symbol forces runtime linkage; progress_v1 is unchanged.",
    "A selected near RET consumes only the declared entry return cell. V2 contexts cache the real completion stop and pre-event RAX, including post-RET backing/work/shutdown stops; pre-RET faults retain the activation.",
    "Completed CALL starts its callee from the receipt before returning a debug/event stop. Pending noncompleted CALL retains original retry coordinates. Scheduled bridges require this invocation to charge an instruction before consuming a receipt.",
    "Scheduled RET uses actual SS inhibition and shared shadow expiry. Completed call resumes do not access state, runtime, budgets or producers.",
    "V2 function/call/site layouts are 32/48/64 bytes. V1 layouts remain 16/32/48 bytes, result_v1 and flat handler_context_v1 remain 24 bytes; new debug names prevent cross-layout writes.",
    "Selected pending handlers retry only after a successful privilege-return boundary to the original CALL PC/SP. A post-IRET debug event remains a handler boundary."
  ],
  "new_original_transfer_oracle": {
    "comparisons": 768,
    "per_run": 192,
    "runs": 4,
    "dimensions": [
      "near CALL, RET, RET imm16",
      "CPL0/CPL3",
      "TF and 8-byte read/write watchpoint",
      "HighC/LLVMC",
      "scheduled/unscheduled",
      "Clang/NeverC",
      "O0/O2",
      "native SDK/production r6",
      "P/E core"
    ],
    "observations": [
      "represented GPR,flags,segment,CR2,inhibition state",
      "DR6/DR7",
      "complete 262144-byte RAM including page tables",
      "saved debug-frame PC/SP and actual RAX versus completed-transfer receipt"
    ],
    "execution": "Original bytes in KVM with guest-debug interception disabled and backing pre-faulted; the handler stops at HLT. This is confined original-processor evidence, not a complete machine/environment proof."
  },
  "new_runtime_controller_coverage": [
    "Clang and NeverC, both C routes and scheduled/unscheduled execution; actual generated exports linked to X64PagedExecution.",
    "All 1/2/4/8-byte scalar results; independent real handler execution changes RAX without changing cached completion status/value.",
    "Pre-RET operand faults; nested return-cell ownership; successful and post-debug root return; completed-context idempotence.",
    "Completed CALL followed by backing failure, event-work exhaustion or shutdown; explicit event continuation and active-callee resume without replaying CALL.",
    "Pending CALL fault and producer-owned restoration; real handler IRET/budget exhaustion/retry; IRET data watchpoint and later quiescent privilege return.",
    "Actual scheduler SS inhibition; invalid bridge arguments clear stale receipts; invalid scheduler shadows, poll exhaustion and zero budget cannot reuse old CALL receipts.",
    "Software-only shutdown controller cases assert the stopping contract; they do not claim defined original post-shutdown state."
  ],
  "compatibility_regressions": "Full paged-execution, source and public export suites on both SDKs; debug/watchpoint suites also on E core. Existing V1 function/call/scheduler/handler compile-time and runtime checks remain separate from new processor comparisons.",
