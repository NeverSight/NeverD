    "mmx_post_reset_order": {
      "before_failed_objects": 6,
      "before_report_sha256": "73041e2fada3aa301c1d6ae7647eb2c66bc66ca7e3d2379aa44ec5d6161f957a",
      "mechanism": "Machine scheduling crossed EMMS/FEMMS physical clobbers while values still used virtual registers; the final reset became followed by MMX arithmetic or extraction. Both backends now recognize the reset as a scheduling boundary."
