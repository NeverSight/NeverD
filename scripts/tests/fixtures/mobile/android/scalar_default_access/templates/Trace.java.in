package fixture;
public final class Trace {
    public static long events;
    public static int failAt, rawCalls, overrideCalls;
    public static RuntimeException failure;
    public static Error error;
    public static Object receiver, sample, saved;
    public static @JAVA@ input, alternate;
    public static java.util.function.IntConsumer observer;
    public static void hit(int event) {
        events = events * 10 + event;
        if (observer != null) observer.accept(event);
        if (event == failAt) {
            if (error != null) throw error;
            throw failure;
        }
    }
}
