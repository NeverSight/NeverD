//===- arm64e_native_cpta.def - Native EL0 checked arithmetic control -----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//

#include <inttypes.h>
#include <signal.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

static void unsupported(int Signal) { _exit(128 + Signal); }

static uint64_t addChecked(uint64_t Base, uint64_t Offset) {
  register uint64_t Left __asm__("x1") = Base;
  register uint64_t Right __asm__("x2") = Offset;
  register uint64_t Result __asm__("x0");
  // ADDPT X0, X1, X2. Its encoding also builds with pre-CPA Apple assemblers.
  __asm__ volatile(".long 0x9a022020" : "=r"(Result) : "r"(Left), "r"(Right));
  return Result;
}

// The three other scalar forms must agree with ADDPT for these operands.
// Negate modulo 2^64 and multiply by one so the arithmetic result and
// pointer check have the same independent oracle for all four instructions.
static void checkOtherScalarForms(uint64_t Base, uint64_t Offset) {
  register uint64_t Address __asm__("x1") = Base;
  register uint64_t Operand __asm__("x2") = 0 - Offset;
  register uint64_t One __asm__("x3");
  register uint64_t Result __asm__("x0");
  __asm__ volatile(".long 0xda022020" // SUBPT X0, X1, X2
                   : "=r"(Result)
                   : "r"(Address), "r"(Operand));
  printf("%016" PRIx64 "\n", Result);
  Address = Base;
  Operand = Offset;
  One = 1;
  __asm__ volatile(".long 0x9b630440" // MADDPT X0, X2, X3, X1
                   : "=r"(Result)
                   : "r"(Address), "r"(Operand), "r"(One));
  printf("%016" PRIx64 "\n", Result);
  Address = Base;
  Operand = 0 - Offset;
  One = 1;
  __asm__ volatile(".long 0x9b638440" // MSUBPT X0, X2, X3, X1
                   : "=r"(Result)
                   : "r"(Address), "r"(Operand), "r"(One));
  printf("%016" PRIx64 "\n", Result);
}

// Access a genuine byte, then observe the architectural writeback without
// dereferencing the potentially poisoned result. Include an in-range offset
// and a top-byte carry for both a structure load and a structure store.
static int checkWriteback(void) {
  uint8_t Byte = 0xa7;
  const uint64_t Base = (uintptr_t)&Byte;
  const uint64_t Offsets[] = {1, UINT64_C(1) << 56};
  int Checked = 0;
  for (unsigned I = 0; I < sizeof(Offsets) / sizeof(Offsets[0]); ++I) {
    uint64_t Load = Base, Store = Base;
    unsigned Element;
    Byte = 0xa7;
    __asm__ volatile("ld1 {v0.b}[0], [%[base]], %[offset]\n"
                     "umov %w[element], v0.b[0]"
                     : [base] "+&r"(Load), [element] "=r"(Element)
                     : [offset] "r"(Offsets[I])
                     : "v0", "memory");
    __asm__ volatile("movi v0.8b, #0x5a\n"
                     "st1 {v0.b}[0], [%[base]], %[offset]"
                     : [base] "+&r"(Store)
                     : [offset] "r"(Offsets[I])
                     : "v0", "memory");
    if (Element != 0xa7 || Byte != 0x5a || Load != Store)
      return 1;
    const uint64_t Plain = Base + Offsets[I];
    const uint64_t Poison = UINT64_C(1) << 54;
    const uint64_t Expected =
        (Base & ~Poison) | ((Base >> 55 & 1) ? 0 : Poison);
    if (I == 0) {
      if (Load != Plain)
        return 1;
    } else {
      if (Load != Plain && Load != Expected)
        return 1;
      Checked = Load == Expected;
    }
  }
  puts(Checked ? "checked-writeback" : "unchecked-writeback");
  return 0;
}

int main(int Argc, char **Argv) {
  if (Argc == 2 && !strcmp(Argv[1], "writeback"))
    return checkWriteback();
  if (Argc < 3 || (Argc - 1) % 2)
    return 1;
  if (signal(SIGILL, unsupported) == SIG_ERR)
    return 1;
  puts("running-addpt");
  fflush(stdout);
  for (int I = 1; I < Argc; I += 2) {
    const uint64_t Base = strtoull(Argv[I], NULL, 16);
    const uint64_t Offset = strtoull(Argv[I + 1], NULL, 16);
    printf("%016" PRIx64 "\n", addChecked(Base, Offset));
    fflush(stdout);
    checkOtherScalarForms(Base, Offset);
  }
  return 0;
}
