//===- arm64e_native_cpta.def - Native EL0 checked arithmetic control -----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//

#include <inttypes.h>
#include <mach/arm/thread_status.h>
#include <signal.h>
#include <stdatomic.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ucontext.h>
#include <unistd.h>

// Use one Darwin process per instruction. The data symbol at its instruction
// address stays unsigned when the function pointer uses the arm64e ABI.
#define SCALAR_FORMS(X)                                                        \
  X(ADDPT, 0x9a012000, false)                                                  \
  X(SUBPT, 0xda012000, true)                                                   \
  X(MADDPT, 0x9b620020, false)                                                 \
  X(MSUBPT, 0x9b628020, true)

#define DEFINE_SCALAR(Name, Word, Subtract)                                    \
  extern uint64_t run##Name(uint64_t, uint64_t, uint64_t);                     \
  extern const uint32_t site##Name;                                            \
  __asm__(".text\n.p2align 2\n.globl _run" #Name "\n_run" #Name ":\n"          \
          ".globl _site" #Name "\n_site" #Name ": .inst " #Word "\nret\n");
SCALAR_FORMS(DEFINE_SCALAR)
#undef DEFINE_SCALAR

typedef struct {
  const char *Name;
  uint64_t (*Run)(uint64_t, uint64_t, uint64_t);
  const uint32_t *Site;
  bool Subtract;
} ScalarForm;

static const ScalarForm Forms[] = {
#define SCALAR_ROW(Name, Word, Subtract)                                       \
  {#Name, run##Name, &site##Name, Subtract},
    SCALAR_FORMS(SCALAR_ROW)
#undef SCALAR_ROW
};
#undef SCALAR_FORMS

static _Atomic(uintptr_t) ExpectedPC;

static void illegalInstruction(int Number, siginfo_t *Info, void *Context) {
  (void)Info;
  const mcontext_t MC = ((ucontext_t *)Context)->uc_mcontext;
  const uintptr_t PC = arm_thread_state64_get_pc(MC->__ss);
  _exit(Number == SIGILL &&
                PC == atomic_load_explicit(&ExpectedPC, memory_order_relaxed)
            ? 128 + SIGILL
            : EXIT_FAILURE);
}

// Access a genuine byte, then observe the architectural writeback without
// dereferencing the potentially poisoned result. Include an in-range offset
// and a top-byte carry for both a structure load and a structure store.
static int checkWriteback(void) {
  uint8_t Byte = 0xa7;
  const uint64_t Base = (uintptr_t)&Byte;
  const uint64_t Offsets[] = {1, UINT64_C(1) << 56};
  int Checked = 0;
  for (unsigned I = 0; I < sizeof(Offsets) / sizeof(Offsets[0]); ++I) {
    uint64_t Load = Base, Store = Base;
    unsigned Element;
    Byte = 0xa7;
    __asm__ volatile("ld1 {v0.b}[0], [%[base]], %[offset]\n"
                     "umov %w[element], v0.b[0]"
                     : [base] "+&r"(Load), [element] "=r"(Element)
                     : [offset] "r"(Offsets[I])
                     : "v0", "memory");
    __asm__ volatile("movi v0.8b, #0x5a\n"
                     "st1 {v0.b}[0], [%[base]], %[offset]"
                     : [base] "+&r"(Store)
                     : [offset] "r"(Offsets[I])
                     : "v0", "memory");
    if (Element != 0xa7 || Byte != 0x5a || Load != Store)
      return 1;
    const uint64_t Plain = Base + Offsets[I];
    const uint64_t Poison = UINT64_C(1) << 54;
    const uint64_t Expected =
        (Base & ~Poison) | ((Base >> 55 & 1) ? 0 : Poison);
    if (I == 0) {
      if (Load != Plain)
        return 1;
    } else {
      if (Load != Plain && Load != Expected)
        return 1;
      Checked = Load == Expected;
    }
  }
  puts(Checked ? "checked-writeback" : "unchecked-writeback");
  return 0;
}

int main(int Argc, char **Argv) {
  if (Argc == 2 && !strcmp(Argv[1], "writeback")) {
    puts("running-writeback");
    fflush(stdout);
    return checkWriteback();
  }
  if (Argc < 4 || Argc % 2)
    return EXIT_FAILURE;
  const ScalarForm *Form = NULL;
  for (size_t I = 0; I != sizeof(Forms) / sizeof(Forms[0]); ++I) {
    if (!strcmp(Argv[1], Forms[I].Name)) {
      Form = &Forms[I];
      break;
    }
  }
  if (!Form)
    return EXIT_FAILURE;
  atomic_store_explicit(&ExpectedPC, (uintptr_t)Form->Site,
                        memory_order_relaxed);
  struct sigaction Action = {0};
  Action.sa_sigaction = illegalInstruction;
  Action.sa_flags = SA_SIGINFO;
  sigemptyset(&Action.sa_mask);
  if (sigaction(SIGILL, &Action, NULL))
    return EXIT_FAILURE;
  puts(Form->Name);
  fflush(stdout);
  for (int I = 2; I < Argc; I += 2) {
    const uint64_t Base = strtoull(Argv[I], NULL, 16);
    const uint64_t Offset = strtoull(Argv[I + 1], NULL, 16);
    // All four forms compute Base + Offset. For the multiply forms, x0
    // is the accumulator, x1 the signed offset and x2 the factor one.
    printf("%016" PRIx64 "\n",
           Form->Run(Base, Form->Subtract ? 0 - Offset : Offset, 1));
    fflush(stdout);
  }
  return EXIT_SUCCESS;
}
