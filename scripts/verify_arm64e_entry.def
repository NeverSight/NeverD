{
  "output_argument": "--output",
  "binary_argument": "--test-binary",
  "compiler_argument": "--compiler",
  "probe_argument": "--probe-report",
  "offline_argument": "--compile-only",
  "export_environment": "NEVERD_ARM64E_ENTRY_FIXTURE_DIR",
  "export_filter": "--gtest_filter=AArch64EntryABI.ExportSignedNativeInputs",
  "export_case": "ExportSignedNativeInputs",
  "export_suite": "AArch64EntryABI",
  "export_xml_option": "--gtest_output=xml:",
  "export_xml": "export.xml",
  "export_label": "export",
  "export_sources": [
    "entry.ll",
    "entry-dwarf.ll",
    "caller.cpp"
  ],
  "loader_source": "loader.cpp",
  "loader_binary": "loader.out",
  "object_name": "entry-{optimization}-dwarf-{dwarf}.o",
  "library_name": "entry-{optimization}-key-{key}-dwarf-{dwarf}.dylib",
  "case_name": "{optimization}-key-{key}-dwarf-{dwarf}",
  "entry_source": "entry.ll",
  "caller_source": "caller.cpp",
  "version_args": [
    "--version"
  ],
  "version_label": "compiler",
  "compile_args": [
    "-arch",
    "arm64e",
    "-fno-omit-frame-pointer",
    "-fno-optimize-sibling-calls"
  ],
  "cxx_args": [
    "-std=c++20"
  ],
  "object_args": [
    "-c"
  ],
  "library_args": [
    "-dynamiclib"
  ],
  "dwarf_option": "-DNEVERD_ENTRY_DWARF",
  "key_option": "-DNEVERD_ENTRY_AUTH_KEY={key}",
  "output_option": "-o",
  "optimizations": [
    "-O0",
    "-O2"
  ],
  "keys": [
    0,
    1
  ],
  "dwarf_modes": [
    false,
    true
  ],
  "tool_timeout": 120,
  "export_timeout": 180,
  "execute_timeout": 30,
  "report_name": "report.json",
  "carrier_suffix": ".neverd.carriers",
  "function_pattern": "^([^\\s:]+):$",
  "signed_return_patterns": [
    "\\bpacibsp\\b",
    "\\b(retab|autibsp)\\b"
  ],
  "authenticated_call_pattern": "\\bblraa[z]?\\b",
  "key_call_patterns": {
    "0": "\\bblraa\\b",
    "1": "\\bblrab\\b"
  },
  "sections_command": [
    "/usr/bin/xcrun",
    "otool",
    "-l"
  ],
  "sections_suffix": "-sections",
  "section_pattern": "^\\s*sectname (\\S+)\\s*$",
  "dwarf_section": "__eh_frame",
  "compact_section": "__unwind_info",
  "classic_subtype": 2147483650,
  "source_files": [
    "scripts/verify_arm64e_entry.py",
    "scripts/verify_arm64e_entry.def",
    "unittests/lift/aarch64/AArch64EntryABITests.cpp",
    "unittests/lift/aarch64/AArch64EntryABIFixtures.def",
    "include/neverd/backend/llvm/AArch64/LLVMEntryABI.h",
    "include/neverd/backend/llvm/AArch64/LLVMEntryABI.def",
    "lib/backend/llvm/AArch64/LLVMEntryABI.cpp",
    "include/neverd/backend/llvm/LLVMSourceCallValue.h",
    "include/neverd/backend/llvm/LLVMSourceCallValue.def",
    "lib/ir/SourceABI.cpp",
    "lib/backend/llvm/emit/MedLLVMEmitter.cpp",
    "lib/backend/codegen/CodeGen.cpp",
    "lib/backend/codegen/SourcePatch.cpp",
    "lib/backend/codegen/MachO/MachOPatchObject.cpp",
    "lib/backend/codegen/MachO/MachOLayoutGrowth.cpp",
    "lib/backend/codegen/MachO/MachOCompactUnwindPatch.cpp",
    "lib/backend/codegen/MachO/MachOCompactUnwindLayout.def",
    "lib/backend/codegen/MachO/MachOPatch.cpp",
    "include/neverd/object/MachOLayout.h",
    "include/neverd/object/MachOLayout.def",
    "lib/backend/codegen/MachO/MachOHeaderGrowth.cpp",
    "lib/backend/codegen/MachO/MachOHeaderGrowth.def",
    "lib/backend/codegen/MachO/MachODependencyState.cpp",
    "lib/backend/codegen/MachO/MachODependencyState.h",
    "lib/backend/codegen/MachO/MachOExportLayout.cpp",
    "lib/backend/codegen/MachO/MachOCompactUnwindNative.def",
    "include/neverd/loader/MachO/MachOArm64e.h",
    "include/neverd/loader/MachO/MachOArm64e.def",
    "lib/loader/MachO/MachOArm64eFixups.cpp",
    "lib/backend/codegen/MachO/MachOExceptionPatch.cpp",
    "lib/backend/codegen/MachO/MachOLayoutGrowth.def",
    "lib/backend/codegen/MachO/MachOStrictLayout.h"
  ],
  "errors": {
    "arguments": "Native entry validation requires --probe-report; --compile-only does not accept one",
    "export": "Entry export must contain exactly the successful, unskipped owning test",
    "probe": "Native entry validation requires a successful same-source system PAC/unwind preflight",
    "signed_frames": "The reconstructed exception frame {function} must contain signed return sequences",
    "authenticated_call": "The independent caller must contain an authenticated indirect call",
    "unwind_mode": "The native image does not retain the requested compact or forced-DWARF unwind sections",
    "subtype": "The generated object or dylib does not declare the classic arm64e ABI",
    "matrix": "The complete native entry matrix did not execute successfully",
    "unwind_records": "The exception frame {function} must use the requested indexed unwind encoding",
    "producer": "Image publication requires the NeverD backend producer",
    "baseline": "The original entry must trap after entering the independent caller and before completing it",
    "receipt": "Publication must replace every declared public entry with a unique generated address and retain every exception frame",
    "execution": "The independent caller must enter and finish the complete entry matrix",
    "inspection": "The installed text range must be completely backed by the final published image",
    "image_base": "Expected one file-backed TEXT mapping for the Mach header",
    "zero_base": "The zero-base profile requires both input and installed Mach-O headers at zero",
    "prefix": "The requested nonzero-base image did not grow its TEXT prefix"
  },
  "dwarf_entry_source": "entry-dwarf.ll",
  "unwind_command": [
    "/usr/bin/xcrun",
    "llvm-objdump",
    "--macho",
    "--syms",
    "--unwind-info"
  ],
  "unwind_suffix": "-unwind",
  "symbol_pattern": "^([0-9a-fA-F]+)\\s+.*\\bF\\s+__TEXT,__text\\s+(\\S+)\\s*$",
  "unwind_pattern": "function offset=(0x[0-9a-fA-F]+), encoding(?:\\[\\d+\\])?=(0x[0-9a-fA-F]+)",
  "hex_radix": 16,
  "unwind_mode_mask": 251658240,
  "dwarf_unwind_modes": [
    50331648
  ],
  "compact_unwind_modes": [
    33554432,
    67108864
  ],
  "exception_entries": [
    "_entry_throwing",
    "_entry_wide_throwing",
    "_entry_large_throwing",
    "_entry_hva_throwing"
  ],
  "native_exception_functions": [
    "_entry_throw",
    "_main"
  ],
  "sdk_label": "sdk",
  "sdk_command": [
    "/usr/bin/xcrun",
    "--sdk",
    "macosx",
    "--show-sdk-path"
  ],
  "sysroot_option": "-isysroot",
  "producer_argument": "--producer",
  "producers": [
    "compiler",
    "neverd"
  ],
  "backend_producer": "neverd",
  "zero_base_original_optimization": "-O2",
  "zero_base_publication_layout": {
    "name": "zero preferred base, optimized original trapping entries and no reserved header padding",
    "header_args": ["-Wl,-headerpad,0", "-Wl,-install_name,@rpath/entry.dylib"]
  },
  "zero_base_argument": "--zero-base",
  "dense_argument": "--match-original-optimization",
  "dense_layout": "zero preferred base, caller and original entries at the same optimization, no reserved header padding",
  "dense_optimization": "-O0",
  "slide_field": "original_section_slide",
  "trampoline_field": "trampoline",
  "dense_error": "Dense O0 DWARF publication must move section entries and retain the zero preferred base",
  "bind_command": ["xcrun", "dyld_info", "-fixups"],
  "bind_suffix": "-dyld-binds",
  "bind_pattern": "^\\s*(__\\S+)\\s+(__\\S+)\\s+(0x[0-9a-fA-F]+)\\s+(auth-bind|bind)\\s+(.+?)\\s*$",
  "auth_bind_kind": "auth-bind",
  "bind_error": "Apple dyld_info could not reproduce an original bind at its installed slot",
  "bind_count_field": "original_dyld_binds_replayed",
  "publication_argument": "--publish",
  "backend_environment": "NEVERD_ARM64E_ENTRY_BACKEND",
  "backend_object": "entry-backend.o",
  "backend_dwarf_object": "entry-backend-dwarf.o",
  "original_ir": "entry-original.ll",
  "original_dwarf_ir": "entry-original-dwarf.ll",
  "publication_case": "PublishSignedNativeInputs",
  "publication_filter": "--gtest_filter=AArch64EntryABI.PublishSignedNativeInputs",
  "publication_input_environment": "NEVERD_ARM64E_ENTRY_ORIGINAL",
  "publication_output_environment": "NEVERD_ARM64E_ENTRY_INSTALLED",
  "publication_receipt_environment": "NEVERD_ARM64E_ENTRY_RECEIPT",
  "publication_dwarf_environment": "NEVERD_ARM64E_ENTRY_DWARF",
  "original_object_name": "original-dwarf-{dwarf}.o",
  "original_library_name": "original-{optimization}-key-{key}-dwarf-{dwarf}.dylib",
  "installed_library_name": "installed-{optimization}-key-{key}-dwarf-{dwarf}.dylib",
  "publication_suffix": "-publication",
  "baseline_suffix": "-original",
  "publication_xml_suffix": "-publication.xml",
  "receipt_suffix": "-receipt.json",
  "public_entry_count": 26,
  "baseline_returncodes": [
    -5
  ],
  "publication_disassembly_command": [
    "/usr/bin/xcrun",
    "llvm-objdump",
    "--disassemble-all",
    "--no-show-raw-insn"
  ],
  "addressed_instruction_pattern": "^\\s*([0-9a-fA-F]+):\\s+(.*)$",
  "enabled_environment_value": "1",
  "public_entries": [
    "_entry_scalar",
    "_entry_signed",
    "_entry_unsigned",
    "_entry_signed16",
    "_entry_unsigned16",
    "_entry_float",
    "_entry_double",
    "_entry_pointer",
    "_entry_vector64",
    "_entry_vector128",
    "_entry_vector_stack",
    "_entry_wide",
    "_entry_wide_stack",
    "_entry_pair",
    "_entry_hfa",
    "_entry_hfa_stack",
    "_entry_hva64",
    "_entry_hva128",
    "_entry_emitted_hva",
    "_entry_large",
    "_entry_stack",
    "_entry_packed",
    "_entry_throwing",
    "_entry_wide_throwing",
    "_entry_large_throwing",
    "_entry_hva_throwing"
  ],
  "optimization_scopes": {
    "compiler": "entry object and native caller",
    "neverd": "native caller; NeverD Codegen::compile uses CodeGenOptLevel::Less"
  },
  "caller_entry_marker": "neverd-entry-caller-entered\n",
  "caller_pass_marker": "neverd-entry-caller-passed\n",
  "publication_layout": "zero requested header padding, with a nonzero preferred base for unoptimized DWARF",
  "inspection_source_suffix": "-installed-text.s",
  "inspection_object_suffix": "-installed-text.o",
  "inspection_suffix": "-installed-text",
  "inspection_prefix": ".section __TEXT,__text,regular,pure_instructions\n",
  "inspection_row": ".byte {data}\n",
  "inspection_byte": "0x{byte:02x}",
  "inspection_row_bytes": 16,
  "occupied_library_name": "occupied-{optimization}-key-{key}-dwarf-{dwarf}.dylib",
  "occupied_suffix": "-occupied",
  "occupied_case": "RejectsOccupiedNativeInputs",
  "occupied_filter": "--gtest_filter=AArch64EntryABI.RejectsOccupiedNativeInputs",
  "occupied_header_args": [
    "-Wl,-headerpad,0"
  ],
  "tight_publication_layout": {
    "name": "zero header reservation; checked existing TEXT capacity",
    "header_args": [
      "-Wl,-headerpad,0"
    ]
  },
  "publication_layout_overrides": [
    {
      "dwarf": true,
      "optimization": "-O0",
      "layout": {
        "name": "zero header reservation with checked VM prefix",
        "header_args": [
          "-Wl,-headerpad,0",
          "-Wl,-segaddr,__TEXT,0x100000000"
        ],
        "require_prefix": true
      }
    }
  ],
  "text_base_pattern": "^\\s*cmd LC_SEGMENT_64\\s+cmdsize \\d+\\s+segname __TEXT\\s+vmaddr (0x[0-9a-fA-F]+)\\s+vmsize \\S+\\s+fileoff 0\\s*$"
}
