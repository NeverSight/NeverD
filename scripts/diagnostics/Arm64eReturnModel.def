// The FVP starts at EL1 with EL2 and EL3 absent.
#define RETURN_MODEL_STACK_EL1 0x80200000
#define RETURN_MODEL_STACK_EL0 0x80100000
#define RETURN_MODEL_VECTOR_SHIFT 11
#define RETURN_MODEL_VECTOR_COUNT 16
#define RETURN_MODEL_VECTOR_SLOT 128
#define RETURN_MODEL_INSN_BYTES 4
#define RETURN_MODEL_DAIF_EL0T 0x3c0
#define RETURN_MODEL_DAIF_EL1H 0x3c5
#define RETURN_MODEL_PSTATE_MODE_MASK 15
#define RETURN_MODEL_NIBBLE_MASK 15
#define RETURN_MODEL_NIBBLE_BITS 4
#define RETURN_MODEL_STACK_ALIGNMENT 16
#define RETURN_MODEL_SVC_ESR 0x56000000
#define RETURN_MODEL_SVC 0
#define RETURN_MODEL_SCTLR2 S3_0_C1_C0_3
#define RETURN_MODEL_ISAR3 S3_0_C0_C6_3
#define RETURN_MODEL_ISAR2 S3_0_C0_C6_2
// T0SZ=T1SZ=16 gives the two address ranges a defined 48-bit VA width.
#define RETURN_MODEL_TCR_48BIT 0x80100010
#define RETURN_MODEL_ENIA_IB 0xc0000000
#define RETURN_MODEL_FPEN 0x300000
#define RETURN_MODEL_KEY_A_LO 0x123456789abcdef0
#define RETURN_MODEL_KEY_A_HI 0x0fedcba987654321
#define RETURN_MODEL_KEY_B_LO 0xa5963c5af0e1872d
#define RETURN_MODEL_KEY_B_HI 0x1928374655aabbcc
#define RETURN_MODEL_ENPACM_SHIFT 7
#define RETURN_MODEL_ENPACM_MASK 3
#define RETURN_MODEL_APA_SHIFT 4
#define RETURN_MODEL_API_SHIFT 8
#define RETURN_MODEL_APA3_SHIFT 12
#define RETURN_MODEL_PACM_SHIFT 12
#define RETURN_MODEL_PAUTH_LR 6
#define RETURN_MODEL_PACM_FULL 2
#define RETURN_MODEL_SEMIHOST 0xf000
#define RETURN_MODEL_OPERATION_REGISTER "x0"
#define RETURN_MODEL_PARAMETER_REGISTER "x1"
#define RETURN_MODEL_WRITE0 4
#define RETURN_MODEL_EXIT 0x20
#define RETURN_MODEL_APP_EXIT 0x20026
#define RETURN_MODEL_STRING_IMPL(X) #X
#define RETURN_MODEL_STRING(X) RETURN_MODEL_STRING_IMPL(X)
#define RETURN_MODEL_TRAP "hlt #" RETURN_MODEL_STRING(RETURN_MODEL_SEMIHOST)
#define RETURN_MODEL_READ(Reg) "mrs %0, " RETURN_MODEL_STRING(Reg)
#define RETURN_MODEL_WRITE(Reg) "msr " RETURN_MODEL_STRING(Reg) ", %0\n\tisb"
#define RETURN_MODEL_FEATURE_ERROR "RETURN-MODEL feature mismatch\n"
#define RETURN_MODEL_CONTROL_ERROR "RETURN-MODEL control mismatch\n"
#define RETURN_MODEL_HEX "0123456789abcdef"
#define RETURN_MODEL_STATUS "oracle status="
#define RETURN_MODEL_TCR " TCR_EL1="
#define RETURN_MODEL_SCTLR " SCTLR_EL1="
#define RETURN_MODEL_MODE " EnPACM bits="
#define RETURN_MODEL_NEWLINE "\n"
#define RETURN_MODEL_EL1_ERROR "RETURN-MODEL EL1 comparison failed\n"
#define RETURN_MODEL_EL0_ERROR "RETURN-MODEL EL0 comparison failed\n"
#define RETURN_MODEL_EXCEPTION "RETURN-MODEL unexpected exception\n"
#define RETURN_MODEL_OBSERVATION "RETURN-MODEL compared EL1 and EL0 EnPACM/EnPACM0="
#define RETURN_MODEL_ZERO '0'
#define RETURN_MODEL_PASS "RETURN-MODEL passed EL1 and EL0 at all four EnPACM settings\n"
