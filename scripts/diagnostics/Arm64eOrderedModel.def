#define ORDERED_LRCPC_SHIFT 20
#define ORDERED_LRCPC_LEVEL 3
#define ORDERED_ALIGNMENT 2
#define ORDERED_NAA 0x40
#define ORDERED_SPAN 0x800000
#define ORDERED_EL0 0
#define ORDERED_EL1 1
#define ORDERED_MODE_COUNT 4
#define ORDERED_MODE_NAA 1
#define ORDERED_MODE_A 2
#define ORDERED_QUAD_BYTES 16
#define ORDERED_LANES 2
#define ORDERED_CASE_COUNT 115
#define ORDERED_LSE2_SHIFT 32
#define ORDERED_LSE2_LEVEL 1
#define ORDERED_GUARD_QUADS 3
#define ORDERED_SOURCE_COUNT 2
#define ORDERED_LAYOUT_ERROR "ordered abort record layout"
#define ORDERED_CASE_ERROR "ordered model inventory"
#define ORDERED_STORE_LOW 0xfedcba987654b381ULL
#define ORDERED_STORE_HIGH 0x91a2b3c4d5e6f708ULL
#define ORDERED_DATA_STEP 13
#define ORDERED_DATA_SEED 129

// Synchronous Data Abort from lower EL or the same EL, alignment fault.
#define ORDERED_EC_SHIFT 26
#define ORDERED_ABORT_EL0 0x24
#define ORDERED_ABORT_EL1 0x25
#define ORDERED_DFSC_MASK 0x3f
#define ORDERED_ALIGNMENT_FAULT 0x21
#define ORDERED_WRITE 0x40
#define ORDERED_FNV 0x400
#define ORDERED_ARMED_SLOT 0
#define ORDERED_ESR_SLOT 8
#define ORDERED_FAR_SLOT 16
#define ORDERED_WORD_SLOT 24
#define ORDERED_REGISTER_MASK 0x3ff
#define ORDERED_INSTRUCTION ".inst %c[encoding]"
#define ORDERED_BASE_REGISTER "x1"
#define ORDERED_DATA_REGISTER "x0"
#define ORDERED_VECTOR_REGISTER "v0"
#define ORDERED_REGISTER_FIELDS 0x20
#define ORDERED_REGISTER_ERROR "ordered fixture must use Rn=1 and Rt=0"
#define ORDERED_LSE2_ERROR "ORDERED-MODEL LSE2 unavailable\n"

#define ORDERED_FEATURE_ERROR "ORDERED-MODEL LRCPC3 unavailable\n"
#define ORDERED_CONTROL_ERROR "ORDERED-MODEL SCTLR alignment control mismatch\n"
#define ORDERED_00_PASS "ORDERED-MODEL compared EL1 and EL0 A=0 nAA=0\n"
#define ORDERED_01_PASS "ORDERED-MODEL compared EL1 and EL0 A=0 nAA=1\n"
#define ORDERED_10_PASS "ORDERED-MODEL compared EL1 and EL0 A=1 nAA=0\n"
#define ORDERED_11_PASS "ORDERED-MODEL compared EL1 and EL0 A=1 nAA=1\n"
#define ORDERED_PASS "ORDERED-MODEL passed GPR and SIMD comparisons\n"

#define ORDERED_NATIVE_LSE2 "hw.optional.arm.FEAT_LSE2"
#define ORDERED_NATIVE_LRCPC2 "hw.optional.arm.FEAT_LRCPC2"
#define ORDERED_NATIVE_X_LOAD 0xd9400020U
#define ORDERED_NATIVE_Q_STORE 0x1d800820U
#define ORDERED_NATIVE_Q_LOAD 0x1dc00820U
#define ORDERED_NATIVE_WORD_TEXT(Word) #Word
#define ORDERED_NATIVE_Q_ROUTINE(Name, Word)                                   \
  ".text\n.p2align 2\n.globl _" #Name "\n_" #Name ":\n"                         \
  ".globl _" #Name "Site\n_" #Name "Site:\n.inst " ORDERED_NATIVE_WORD_TEXT(Word) \
  "\nret\n"
#define ORDERED_NATIVE_Q_PASSED "ORDERED-NATIVE aligned Q store and both load lanes passed"
#define ORDERED_NATIVE_Q_UNAVAILABLE "ORDERED-NATIVE aligned Q store and load raised SIGILL"
#define ORDERED_NATIVE_SKIP 77
#define ORDERED_NATIVE_ATOMIC_ERROR "Darwin signal observations must be lock-free"
#define ORDERED_NATIVE_UNAVAILABLE "ORDERED-NATIVE LSE2 or LRCPC2 unavailable"
#define ORDERED_NATIVE_GPR "ORDERED-NATIVE GPR, aligned Q instructions unavailable"
#define ORDERED_NATIVE_GPR_SIMD "ORDERED-NATIVE GPR and SIMD"
#define ORDERED_NATIVE_NATURAL "ORDERED-NATIVE natural alignment"
#define ORDERED_NATIVE_GRANULE "ORDERED-NATIVE within one granule"
#define ORDERED_NATIVE_UNALIGNED "ORDERED-NATIVE unrestricted Normal-memory alignment"
#define ORDERED_NATIVE_MISMATCH "%s differs at comparison %d\n"
