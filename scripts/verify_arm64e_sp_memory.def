{
  "required_host": [
    "Darwin",
    "arm64"
  ],
  "compiler": "clang",
  "compile_timeout_seconds": 30,
  "execution_timeout_seconds": 5,
  "flags": [
    "--target=arm64-apple-macos",
    "-Wno-unused-parameter"
  ],
  "sdk_flag": "-isysroot",
  "input_files": [
    "high.c",
    "llvm.c",
    "llvm-macho.o",
    "harness.c"
  ],
  "harness_file": "harness.c",
  "main_token": "int main(void)",
  "fault_source": "diagnostics/Arm64eSPFault.c.inc",
  "fault_header": "diagnostics/Arm64eSPFault.def",
  "control_replacements": [
    [
      "&memory[256]",
      "&memory[264]"
    ],
    [
      "256 + item->offset",
      "264 + item->offset"
    ]
  ],
  "routes": [
    {
      "name": "high-O0",
      "file": "high.c",
      "compile_c": true,
      "optimization": "-O0"
    },
    {
      "name": "high-O2",
      "file": "high.c",
      "compile_c": true,
      "optimization": "-O2"
    },
    {
      "name": "llvm-c-O0",
      "file": "llvm.c",
      "compile_c": true,
      "optimization": "-O0"
    },
    {
      "name": "llvm-c-O2",
      "file": "llvm.c",
      "compile_c": true,
      "optimization": "-O2"
    },
    {
      "name": "llvm-object",
      "file": "llvm-macho.o",
      "compile_c": false
    }
  ],
  "test_reports": {
