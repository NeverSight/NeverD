        "AArch64StackAddressMemory.BothCProjectionsAndLLVMExecuteEveryRegisterFamily",
        "AArch64StackAddressMemory.NominalFootprintsKeepTheExactEntrySPBasis",
        "AArch64StackAddressMemory.UnknownOrExpiredInputsDoNotInventFrameAccesses",
        "AArch64StackAddressMemory.JoinsAndIndependentRootsKeepTheirOwnSPBasis",
        "AArch64StackAddressMemory.SourceBoundariesRequireAnExternalRawSPParameter",
        "AArch64StackAddressMemory.StackAssemblyRequiresTheLiteralSPAndClobber"
      ],
      "artifact_property": "cpta_stack_memory_artifacts"
    },
    "control": {
      "cases": [
