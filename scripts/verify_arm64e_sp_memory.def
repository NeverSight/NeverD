        "AArch64ImmediateMemory.BothCProjectionsAndLLVMExecuteEveryImmediateFamily",
        "AArch64ImmediateMemory.TracingUsesTheEncodedOffsetAndExactDataSlice",
        "AArch64ImmediateMemory.StackAndImageRequirementsCannotBeHiddenByFiltering",
        "AArch64ImmediateMemory.AssemblyCannotConsumeAPhantomRegisterIndex",
