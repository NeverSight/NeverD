{
  "manifest": "projections.json",
  "export": "export",
  "build": "build-r6",
  "check": "check",
  "tests": "--tests",
  "inputs": "--inputs",
  "output": "--output",
  "require_execution": "--require-execution",
  "require_native": "--require-native",
  "qualified_key": "native_generated_arm64e_x1_qualified",
  "control_receipt": "native_controls",
  "digest_pattern": "[0-9a-f]{64}",
  "r6": {
    "tag": "neverd-llvm-v23.0.0-r6",
    "sha256": "ffada4ba7a77b9394d02665dc1893f378a82f076af0ea057157d9cbfaab40fad",
    "target": "NeverDArm64eAnalysisTests",
    "bin_dir": "bin",
    "dependencies": ["git", "submodule", "update", "--init", "--depth", "1", "--", "third_party/capstone", "third_party/unicorn", "signatures"],
    "configure": ["cmake", "-S", ".", "-B", "{build}", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=ON", "-DNEVERD_BUILD_GUI=OFF", "-DNEVERD_BUILD_AGENT=OFF", "-DNEVERD_BUILD_WORKER=OFF", "-DNEVERD_ENABLE_WEB_ANALYSIS=OFF", "-DNEVERD_LLVM_PREBUILT=ON", "-DNEVERD_LLVM_PREBUILT_TAG={tag}", "-DNEVERD_LLVM_PREBUILT_SHA256={sha256}"],
    "compile": ["scripts/build.py", "{build}", "--target", "{target}", "--parallel", "3"]
  },
  "source_name": "projection.c",
  "driver": "diagnostics/Arm64eProjectionEntry.def",
  "compiler": "/usr/bin/clang",
  "c_flags": ["-std=gnu11", "-ffreestanding", "-Dmain=arm64eProjectionMain", "-I"],
  "entry_flags": ["-x", "c"],
  "compile": "compile-projection",
  "compile_entry": "compile-entry",
  "link": "link",
  "execute": "execute",
  "entry_object": "entry.o",
  "projected_object": "projection.o",
  "image": "projection.out",
  "entry_mode": "entry-only",
  "entered": "projection-entered",
  "compared": "projection-compared",
  "not_started": "did-not-start",
  "entry_only": "entry-only",
  "executed": "compared",
  "pairs": "unittests/lift/aarch64/AArch64PAuthNative.def",
  "pair_pattern": "^NEVERD_PAUTH_ORACLE_PAIR\\(\\w+,\\s*(?P<explicit>\\w+),\\s*\\w+,\\s*(?P<prefix>\\w+)\\)",
  "symbol_prefix": "_",
  "map_args": ["-Xlinker", "-map", "-Xlinker"],
  "map_name": "link.map",
  "map_input": "^\\[\\s*(\\d+)\\]\\s+(.+)$",
  "map_symbol": "^0x[\\da-fA-F]+\\s+0x[\\da-fA-F]+\\s+\\[\\s*(\\d+)\\]\\s+(\\S+)$",
  "map_live": "# Symbols:",
  "map_dead": "# Dead Stripped Symbols:",
  "capabilities": {"explicit": "explicit_key", "prefix": "pacm_pc_key"},
  "errors": {
    "inputs": "projection export differs from its source revision, fixture hashes or expected file inventory",
    "stage": "{label} failed for {directory}",
    "symbols": "the Apple link map does not attribute every IA/IB projection symbol to {owner}",
    "execution": "unexpected projection process status or entry/comparison records in {directory}",
    "capability": "the arm64e.x1 cursor controls failed before projection measurement"
  }
}
