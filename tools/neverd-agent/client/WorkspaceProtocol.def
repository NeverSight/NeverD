AGENT_PROPERTY(bool, lightTheme, settingsChanged)
AGENT_PROPERTY(bool, autoAddAnalysisObjects, settingsChanged)
AGENT_PROPERTY(QVariantList, analysisObjectApprovals, analysisObjectApprovalsChanged)
