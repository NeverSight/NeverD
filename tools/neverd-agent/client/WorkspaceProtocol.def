AGENT_PROPERTY(bool, queuePaused, conversationChanged)
AGENT_PROPERTY(QVariantMap, evidence, evidenceChanged)
AGENT_PROPERTY(bool, evidenceBusy, evidenceChanged)
AGENT_PROPERTY(bool, reviewBusy, reviewChanged)
AGENT_PROPERTY(QVariantList, changes, reviewChanged)
AGENT_PROPERTY(QVariantList, draftContext, conversationChanged)
AGENT_PROPERTY(QString, connectionStatus, connectionChanged)
