//===----------------------------------------------------------------------===//
// Define AGENT_PROPERTY(Type, Name, Signal), AGENT_STATE_SIGNAL(Name),
// AGENT_ACTION(Return, Name, Signature, Arguments), or
// AGENT_SIDE_PROPERTY(Type, Name, Signal) before inclusion.

#ifdef AGENT_PROPERTY
AGENT_PROPERTY(QVariantList, projects, workspaceChanged)
