NEVERD_MENU_SEPARATOR(OpenSubviews)
NEVERD_MENU_ITEM(OpenSubviews, ViewDisassembly)
NEVERD_MENU_ITEM(OpenSubviews, ViewPseudocode)
NEVERD_MENU_ITEM(OpenSubviews, ViewLLVMC)
NEVERD_MENU_ITEM(OpenSubviews, ViewHex)
NEVERD_MENU_SEPARATOR(OpenSubviews)
NEVERD_MENU_ITEM(OpenSubviews, ViewExports)
NEVERD_MENU_ITEM(OpenSubviews, ViewImports)
NEVERD_MENU_ITEM(OpenSubviews, ViewNames)
NEVERD_MENU_ITEM(OpenSubviews, ViewFunctions)
NEVERD_MENU_ITEM(OpenSubviews, ViewStrings)
NEVERD_MENU_ITEM(OpenSubviews, SearchStringReferences)
NEVERD_MENU_SEPARATOR(OpenSubviews)
NEVERD_MENU_ITEM(OpenSubviews, ViewSegments)
NEVERD_MENU_SEPARATOR(OpenSubviews)
NEVERD_MENU_ITEM(OpenSubviews, ViewCrossReferences)
NEVERD_MENU_ITEM(OpenSubviews, ViewBookmarks)
NEVERD_MENU_ITEM(OpenSubviews, ViewUndoHistory)
NEVERD_MENU_SEPARATOR(OpenSubviews)
NEVERD_MENU_ITEM(OpenSubviews, ViewConnections)
NEVERD_MENU_ITEM(OpenSubviews, ViewExtensions)
NEVERD_MENU(IntermediateRepresentations, View,
            QT_TRANSLATE_NOOP("Menus", "&Intermediate representations"))
NEVERD_MENU_ITEM(IntermediateRepresentations, ViewLowIR)
NEVERD_MENU_ITEM(IntermediateRepresentations, ViewMedIR)
NEVERD_MENU_ITEM(IntermediateRepresentations, ViewHighIR)
NEVERD_MENU_ITEM(IntermediateRepresentations, ViewLLVMIR)
NEVERD_MENU(Graphs, View, QT_TRANSLATE_NOOP("Menus", "&Graphs"))
NEVERD_MENU_ITEM(Graphs, ViewToggleGraph)
NEVERD_MENU_ITEM(Graphs, ViewGraphOverview)
NEVERD_MENU(Toolbars, View, QT_TRANSLATE_NOOP("Menus", "&Toolbars"))
NEVERD_MENU_PLACEHOLDER(Toolbars, ToolbarToggles)
NEVERD_MENU_SEPARATOR(View)
NEVERD_MENU_ITEM(View, ViewCalculator)
NEVERD_MENU_ITEM(View, ViewFullScreen)
NEVERD_MENU_ITEM(View, ViewOutput)
NEVERD_MENU_SEPARATOR(View)
NEVERD_MENU_ITEM(View, ViewZoomIn)
NEVERD_MENU_ITEM(View, ViewZoomOut)
NEVERD_MENU_ITEM(View, ViewZoomReset)

NEVERD_MENU(Options, None, QT_TRANSLATE_NOOP("Menus", "&Options"))
NEVERD_MENU_ITEM(Options, OptionsGeneral)
NEVERD_MENU_ITEM(Options, OptionsStrings)
NEVERD_MENU_ITEM(Options, OptionsColors)
NEVERD_MENU_ITEM(Options, OptionsFont)
NEVERD_MENU_ITEM(Options, OptionsShortcuts)
NEVERD_MENU_ITEM(Options, OptionsPalette)
