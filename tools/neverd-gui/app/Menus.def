NEVERD_MENU_ITEM(ProduceFile, FileExportListing)
NEVERD_MENU_ITEM(ProduceFile, FileExportPseudocode)
NEVERD_MENU_ITEM(ProduceFile, FileProducePatchedBinary)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_ITEM(File, FileSave)
NEVERD_MENU_ITEM(File, FilePackDatabase)
NEVERD_MENU_ITEM(File, FileClose)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_ITEM(File, FileQuickStart)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_PLACEHOLDER(File, RecentFiles)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_ITEM(File, FileExit)

