//===- Menus.def - Workbench menu structure ---------------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The menu bar, in the order of a classic interactive disassembler: File,
/// Edit, Jump, Search, View, Options, Windows and Help.  Commands come from
/// Actions.def; dynamic entries (recent files, languages, open windows) are
/// filled at placeholders.
///
//===----------------------------------------------------------------------===//

// NEVERD_MENU(Id, Parent, Text): a top-level menu (Parent is None) or submenu.
// NEVERD_MENU_ITEM(Menu, Action)
// NEVERD_MENU_SEPARATOR(Menu)
// NEVERD_MENU_PLACEHOLDER(Menu, Name): items supplied at run time.
// NEVERD_MENU_ICON(Menu, Icon): the icon (IconSet.def) a submenu shows in the
// menu that holds it.
#ifndef NEVERD_MENU
#define NEVERD_MENU(Id, Parent, Text)
#endif
#ifndef NEVERD_MENU_ITEM
#define NEVERD_MENU_ITEM(Menu, Action)
#endif
#ifndef NEVERD_MENU_SEPARATOR
#define NEVERD_MENU_SEPARATOR(Menu)
#endif
#ifndef NEVERD_MENU_PLACEHOLDER
#define NEVERD_MENU_PLACEHOLDER(Menu, Name)
#endif
#ifndef NEVERD_MENU_ICON
#define NEVERD_MENU_ICON(Menu, Icon)
#endif

NEVERD_MENU(File, None, QT_TRANSLATE_NOOP("Menus", "&File"))
NEVERD_MENU_ITEM(File, FileOpen)
NEVERD_MENU_ITEM(File, FilePackageReview)
NEVERD_MENU_ITEM(File, FileCompare)
NEVERD_MENU_ITEM(File, FileLineage)
