//===- Menus.def - Workbench menu structure ---------------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The menu bar, in the order of a classic interactive disassembler: File,
/// Edit, Jump, Search, View, Options, Windows and Help.  Commands come from
/// Actions.def; dynamic entries (recent files, languages, open windows) are
/// filled at placeholders.
///
//===----------------------------------------------------------------------===//

// NEVERD_MENU(Id, Parent, Text): a top-level menu (Parent is None) or submenu.
// NEVERD_MENU_ITEM(Menu, Action)
// NEVERD_MENU_SEPARATOR(Menu)
// NEVERD_MENU_PLACEHOLDER(Menu, Name): items supplied at run time.
#ifndef NEVERD_MENU
#define NEVERD_MENU(Id, Parent, Text)
#endif
#ifndef NEVERD_MENU_ITEM
#define NEVERD_MENU_ITEM(Menu, Action)
#endif
#ifndef NEVERD_MENU_SEPARATOR
#define NEVERD_MENU_SEPARATOR(Menu)
#endif
#ifndef NEVERD_MENU_PLACEHOLDER
#define NEVERD_MENU_PLACEHOLDER(Menu, Name)
#endif

NEVERD_MENU(File, None, QT_TRANSLATE_NOOP("Menus", "&File"))
NEVERD_MENU_ITEM(File, FileOpen)
NEVERD_MENU(LoadFile, File, QT_TRANSLATE_NOOP("Menus", "&Load file"))
NEVERD_MENU_ITEM(LoadFile, FileReload)
NEVERD_MENU_SEPARATOR(LoadFile)
NEVERD_MENU_ITEM(LoadFile, FileLoadSignatures)
NEVERD_MENU_ITEM(LoadFile, FileLoadSignatureTree)
NEVERD_MENU(ProduceFile, File, QT_TRANSLATE_NOOP("Menus", "&Produce file"))
NEVERD_MENU_ITEM(ProduceFile, FileExportListing)
NEVERD_MENU_ITEM(ProduceFile, FileExportPseudocode)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_ITEM(File, FileSave)
NEVERD_MENU_ITEM(File, FileClose)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_ITEM(File, FileQuickStart)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_PLACEHOLDER(File, RecentFiles)
NEVERD_MENU_SEPARATOR(File)
NEVERD_MENU_ITEM(File, FileExit)

NEVERD_MENU(Edit, None, QT_TRANSLATE_NOOP("Menus", "&Edit"))
NEVERD_MENU_ITEM(Edit, EditCopy)
NEVERD_MENU_ITEM(Edit, EditCopyAddress)
NEVERD_MENU_ITEM(Edit, EditUndo)
NEVERD_MENU_ITEM(Edit, EditRedo)
NEVERD_MENU_SEPARATOR(Edit)
NEVERD_MENU_ITEM(Edit, EditDefineData)
NEVERD_MENU_ITEM(Edit, EditDefineCode)
NEVERD_MENU_ITEM(Edit, EditDefineString)
NEVERD_MENU_ITEM(Edit, EditUndefine)
NEVERD_MENU(EditOperandType, Edit, QT_TRANSLATE_NOOP("Menus", "Operand &type"))
NEVERD_MENU_ITEM(EditOperandType, EditOperandNumber)
NEVERD_MENU_ITEM(EditOperandType, EditOperandHex)
NEVERD_MENU_ITEM(EditOperandType, EditOperandDecimal)
NEVERD_MENU_ITEM(EditOperandType, EditOperandBinary)
NEVERD_MENU_ITEM(EditOperandType, EditOperandChar)
NEVERD_MENU_ITEM(EditOperandType, EditOperandOffset)
NEVERD_MENU_SEPARATOR(EditOperandType)
NEVERD_MENU_ITEM(EditOperandType, EditOperandNegate)
NEVERD_MENU_ITEM(EditOperandType, EditOperandInvert)
NEVERD_MENU_ITEM(Edit, EditRename)
NEVERD_MENU(EditFunctions, Edit, QT_TRANSLATE_NOOP("Menus", "&Functions"))
NEVERD_MENU_ITEM(EditFunctions, EditCreateFunction)
NEVERD_MENU_ITEM(EditFunctions, EditDeleteFunction)
NEVERD_MENU(Comments, Edit, QT_TRANSLATE_NOOP("Menus", "Co&mments"))
NEVERD_MENU_ITEM(Comments, EditComment)
NEVERD_MENU_ITEM(Comments, EditRepeatableComment)
NEVERD_MENU_SEPARATOR(Edit)
NEVERD_MENU_ITEM(Edit, EditBookmark)

NEVERD_MENU(Jump, None, QT_TRANSLATE_NOOP("Menus", "&Jump"))
NEVERD_MENU_ITEM(Jump, JumpOperand)
NEVERD_MENU_ITEM(Jump, JumpNewWindow)
NEVERD_MENU_ITEM(Jump, JumpBack)
NEVERD_MENU_ITEM(Jump, JumpForward)
NEVERD_MENU_ITEM(Jump, JumpNextFunction)
NEVERD_MENU_ITEM(Jump, JumpPreviousFunction)
NEVERD_MENU_SEPARATOR(Jump)
NEVERD_MENU_ITEM(Jump, JumpPseudocode)
NEVERD_MENU_ITEM(Jump, JumpAnywhere)
NEVERD_MENU_ITEM(Jump, JumpByName)
NEVERD_MENU_ITEM(Jump, JumpFunction)
NEVERD_MENU_ITEM(Jump, JumpSegment)
NEVERD_MENU_ITEM(Jump, JumpXrefsTo)
NEVERD_MENU_ITEM(Jump, JumpXrefsFrom)
NEVERD_MENU_ITEM(Jump, JumpXrefOperand)
NEVERD_MENU_ITEM(Jump, JumpEntry)
NEVERD_MENU_SEPARATOR(Jump)
NEVERD_MENU_ITEM(Jump, JumpMark)

NEVERD_MENU(Search, None, QT_TRANSLATE_NOOP("Menus", "&Search"))
NEVERD_MENU_ITEM(Search, SearchText)
NEVERD_MENU_ITEM(Search, SearchNextText)
NEVERD_MENU_ITEM(Search, SearchBytes)
NEVERD_MENU_ITEM(Search, SearchNextBytes)
NEVERD_MENU_SEPARATOR(Search)
NEVERD_MENU_ITEM(Search, SearchStringReferences)
NEVERD_MENU_SEPARATOR(Search)
NEVERD_MENU_ITEM(Search, SearchHighlightUp)
NEVERD_MENU_ITEM(Search, SearchHighlightDown)
NEVERD_MENU_ITEM(Search, SearchInView)

NEVERD_MENU(View, None, QT_TRANSLATE_NOOP("Menus", "&View"))
NEVERD_MENU(OpenSubviews, View, QT_TRANSLATE_NOOP("Menus", "Open &subviews"))
