NEVERD_MENU_SEPARATOR(Windows)
NEVERD_MENU_PLACEHOLDER(Windows, OpenWindows)

NEVERD_MENU(Help, None, QT_TRANSLATE_NOOP("Menus", "&Help"))
NEVERD_MENU_ITEM(Help, HelpContents)
NEVERD_MENU_SEPARATOR(Help)
NEVERD_MENU_ITEM(Help, HelpAbout)

#undef NEVERD_MENU
#undef NEVERD_MENU_ITEM
#undef NEVERD_MENU_SEPARATOR
#undef NEVERD_MENU_PLACEHOLDER
