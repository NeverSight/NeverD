NEVERD_MENU(Windows, None, QT_TRANSLATE_NOOP("Menus", "&Windows"))
NEVERD_MENU_ITEM(Windows, WindowsSaveDesktop)
NEVERD_MENU_ITEM(Windows, WindowsLoadDesktop)
NEVERD_MENU_ITEM(Windows, WindowsResetDesktop)
