NEVERD_MENU(Analysis, Options, QT_TRANSLATE_NOOP("Menus", "&Analysis"))
NEVERD_MENU_ITEM(Analysis, OptionsAnalyze)
NEVERD_MENU_ITEM(Analysis, OptionsCancel)
