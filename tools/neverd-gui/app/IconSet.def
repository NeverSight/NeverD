//===- IconSet.def - The workbench's original icons -------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The record of every workbench icon (resources/icons/<name>.svg): the group
/// of commands it serves and what it shows, and the colors the set draws
/// with.  The icons are original artwork authored for NeverD and licensed
/// under the project's license; none is derived from another product's icon
/// set.  The workbench unit tests fail when an icon is missing from this
/// record or listed without its file, leaves the 16 px grid, draws in a color
/// not listed here, or embeds a raster image, text, an external reference, a
/// script or an editor's metadata.  scripts/check_gui_icons.py fails when a
/// straight stroke or an unstroked fill edge falls between two pixels at the
/// size the icon is drawn on, its viewBox, unless NEVERD_ICON_SOFT_LINE
/// allows the icon such a line.
///
//===----------------------------------------------------------------------===//

// NEVERD_ICON_COLOR(Hex, Use): a color the set draws with.
// NEVERD_ICON("Name", Group, Shows): an icon, the group whose accent it takes,
// and what it shows.  The Brand group keeps the logo's own colors.
#ifndef NEVERD_ICON_COLOR
#define NEVERD_ICON_COLOR(Hex, Use)
#endif
#ifndef NEVERD_ICON
#define NEVERD_ICON("Name", Group, Shows)
#endif
// NEVERD_ICON_SOFT_LINE("Name", Why): an icon allowed a straight line between
// two pixels, and why it cannot have it on whole pixels.
#ifndef NEVERD_ICON_SOFT_LINE
#define NEVERD_ICON_SOFT_LINE(Name, Why)
#endif

NEVERD_ICON_COLOR("#3B4250", "outline of every icon")
NEVERD_ICON_COLOR("#FFFFFF", "highlights")
NEVERD_ICON_COLOR("#D9902F", "file and transformation accent")
NEVERD_ICON_COLOR("#F2D8B6", "file and transformation tint")
