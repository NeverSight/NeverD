NEVERD_IDA_ACTION("SaveBase", "Ctrl-W", FileSave)
NEVERD_IDA_ACTION("CloseBase", "", FileClose)
NEVERD_IDA_ACTION("QuickStart", "", FileQuickStart)
NEVERD_IDA_ACTION("QuitIDA", "Alt-X", FileExit)
NEVERD_IDA_PLANNED("LoadFile", "", "File")
NEVERD_IDA_PLANNED("LoadPdbFile", "", "File")
NEVERD_IDA_PLANNED("LoadHeaderFile", "Ctrl-F9", "File")
NEVERD_IDA_PLANNED("ProduceAsm", "Alt-F10", "File")
NEVERD_IDA_PLANNED("ProduceMap", "", "File")
NEVERD_IDA_PLANNED("ProduceExe", "", "File")
