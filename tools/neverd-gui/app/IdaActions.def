//===- IdaActions.def - IDA commands and NeverD's ---------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// IDA's commands by action name, with the default shortcut of IDA's legacy
/// scheme (cfg/idagui.cfg), against the NeverD command that does the same.
/// The workbench unit tests hold every NeverD default to IDA's, and
/// scripts/compare_gui_with_ida.py reports the coverage, checked against an
/// IDA installation when one is given.
///
//===----------------------------------------------------------------------===//

// NEVERD_IDA_ACTION(IdaAction, Shortcut, NeverDAction): a command NeverD has;
// an empty shortcut where IDA has none either.
// NEVERD_IDA_PLANNED(IdaAction, Shortcut, Group): a command NeverD does not
// have yet, by the group of IDA's commands it belongs to.
#ifndef NEVERD_IDA_ACTION
#define NEVERD_IDA_ACTION(IdaAction, Shortcut, NeverDAction)
#endif
#ifndef NEVERD_IDA_PLANNED
#define NEVERD_IDA_PLANNED(IdaAction, Shortcut, Group)
#endif

// File.
NEVERD_IDA_ACTION("LoadNewFile", "", FileOpen)
NEVERD_IDA_ACTION("ReloadFile", "", FileReload)
NEVERD_IDA_ACTION("LoadSigFile", "", FileLoadSignatures)
NEVERD_IDA_ACTION("ProduceLst", "", FileExportListing)
