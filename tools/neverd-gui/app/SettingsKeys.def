//===- SettingsKeys.def - Settings more than one part reads -----*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The keys of the user settings that more than one part of the workbench
/// reads or writes, in one place.
///
//===----------------------------------------------------------------------===//

// NEVERD_SETTINGS_KEY(Name, Key)
#ifndef NEVERD_SETTINGS_KEY
#error "Define NEVERD_SETTINGS_KEY before including SettingsKeys.def"
#endif

// The files opened, newest first, and when each was last opened.
NEVERD_SETTINGS_KEY(RecentFiles, "files/recent")
NEVERD_SETTINGS_KEY(RecentOpened, "files/recentOpened")
// Whether the quick start dialog greets a workbench started without a file.
NEVERD_SETTINGS_KEY(QuickStart, "ui/quickStart")
// The user's preferred size of the resizable quick start dialog.
NEVERD_SETTINGS_KEY(QuickStartSize, "ui/quickStartSize")
// Whether windows keep the window manager's frame instead of drawing their
// own title bar; read as each window is created.
// Retired appearance preference, retained only for migration regressions.
NEVERD_SETTINGS_KEY(NativeTitleBar, "ui/nativeTitleBar")
// Whether every function's source opens simplified symbolically, as the
// code windows' Optimization menu and Options > General set it.
NEVERD_SETTINGS_KEY(SymbolicSimplification, "code/symbolicSimplification")
// Whether a workbench keeps other programs from finding it and opening links
// in it (InstanceServer), as IDA's DisableIpcServer does.
NEVERD_SETTINGS_KEY(InstancesDisabled, "instances/disabled")

NEVERD_SETTINGS_KEY(PatchAssemblerDialect, "patch/assemblerDialect")
NEVERD_SETTINGS_KEY(PatchFillNops, "patch/fillNops")
NEVERD_SETTINGS_KEY(PatchCompiler, "patch/compiler")
NEVERD_SETTINGS_KEY(PatchCompilerPaths, "patch/compilerPaths")

#undef NEVERD_SETTINGS_KEY
