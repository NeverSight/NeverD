//===- Actions.def - Workbench commands -------------------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Every workbench command: identifier, menu text, default shortcuts, icon and
/// status tip.  Shortcuts are IDA's defaults, so existing muscle memory
/// carries over: IdaActions.def pairs each command with IDA's.  Menus.def and
/// Toolbars.def place the commands; MainWindow implements them.
///
//===----------------------------------------------------------------------===//

// NEVERD_ACTION(Id, Text, Shortcut, Icon, Tip): shortcut active anywhere in
// the main window.
// NEVERD_VIEW_ACTION(Id, Text, Shortcut, Icon, Tip): shortcut active only while
// an analysis view has the keyboard focus, so single keys such as N or G keep
// typing into text fields.
// Multiple shortcuts use QKeySequence's list format, separated by "; ".
#ifndef NEVERD_ACTION
#error "Define NEVERD_ACTION before including Actions.def"
#endif
#ifndef NEVERD_VIEW_ACTION
#define NEVERD_VIEW_ACTION(Id, Text, Shortcut, Icon, Tip)                      \
  NEVERD_ACTION(Id, Text, Shortcut, Icon, Tip)
#endif

// Interactive patch commands. Second keys belong only to PatchMenu.def.
NEVERD_VIEW_ACTION(EditPatchMenu, QT_TRANSLATE_NOOP("Actions", "Patch"), "J",
                   "patch", QT_TRANSLATE_NOOP("Actions", "Open the patch menu"))
NEVERD_ACTION(EditPatchNop, QT_TRANSLATE_NOOP("Actions", "NOP instruction"), "",
              "patch_nop",
              QT_TRANSLATE_NOOP("Actions",
                                "Replace the current instruction with NOPs"))
NEVERD_ACTION(EditPatchAssemble, QT_TRANSLATE_NOOP("Actions", "Assemble…"), "",
              "patch_assemble",
              QT_TRANSLATE_NOOP("Actions",
                                "Edit an instruction with a live byte preview"))
NEVERD_ACTION(EditPatchBytes, QT_TRANSLATE_NOOP("Actions", "Change bytes…"), "",
              "patch",
              QT_TRANSLATE_NOOP("Actions",
                                "Edit the bytes at the current address"))
NEVERD_ACTION(EditPatchFillNops,
              QT_TRANSLATE_NOOP("Actions", "Fill selection with NOPs"), "",
              "patch_nop",
              QT_TRANSLATE_NOOP("Actions",
                                "Fill a whole instruction range with NOPs"))
NEVERD_ACTION(EditPatchAlwaysBranch,
              QT_TRANSLATE_NOOP("Actions", "Always branch"), "", "patch",
              QT_TRANSLATE_NOOP("Actions",
                                "Take the conditional branch unconditionally"))
NEVERD_ACTION(EditPatchNeverBranch,
              QT_TRANSLATE_NOOP("Actions", "Never branch"), "", "patch_nop",
              QT_TRANSLATE_NOOP("Actions",
                                "Replace the conditional branch with NOPs"))
NEVERD_ACTION(EditPatchInvertBranch,
              QT_TRANSLATE_NOOP("Actions", "Invert condition"), "", "patch",
              QT_TRANSLATE_NOOP("Actions", "Reverse the conditional branch"))
NEVERD_ACTION(EditPatchSkipCall, QT_TRANSLATE_NOOP("Actions", "Skip call"), "",
              "patch_nop",
              QT_TRANSLATE_NOOP("Actions", "Replace the call with NOPs"))
NEVERD_ACTION(
    EditPatchSkipCallValue,
    QT_TRANSLATE_NOOP("Actions", "Skip call and return value…"), "", "patch",
    QT_TRANSLATE_NOOP("Actions",
                      "Replace the call with a return-register assignment"))
NEVERD_ACTION(EditPatchConstant,
              QT_TRANSLATE_NOOP("Actions", "Change immediate…"), "", "patch",
              QT_TRANSLATE_NOOP("Actions",
                                "Change a uniquely encoded immediate operand"))
NEVERD_ACTION(
    EditPatchRewriteFunction,
    QT_TRANSLATE_NOOP("Actions", "Rewrite function in C…"), "",
    "patch_assemble",
    QT_TRANSLATE_NOOP("Actions",
