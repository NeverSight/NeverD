//===- Actions.def - Workbench commands -------------------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Every workbench command: identifier, menu text, default shortcut, icon and
/// status tip.  Shortcuts are IDA's defaults, so existing muscle memory
/// carries over: IdaActions.def pairs each command with IDA's.  Menus.def and
/// Toolbars.def place the commands; MainWindow implements them.
///
//===----------------------------------------------------------------------===//

// NEVERD_ACTION(Id, Text, Shortcut, Icon, Tip): shortcut active anywhere in
// the main window.
// NEVERD_VIEW_ACTION(Id, Text, Shortcut, Icon, Tip): shortcut active only while
// an analysis view has the keyboard focus, so single keys such as N or G keep
// typing into text fields.
#ifndef NEVERD_ACTION
#error "Define NEVERD_ACTION before including Actions.def"
#endif
#ifndef NEVERD_VIEW_ACTION
#define NEVERD_VIEW_ACTION(Id, Text, Shortcut, Icon, Tip)                      \
  NEVERD_ACTION(Id, Text, Shortcut, Icon, Tip)
#endif

// File.
NEVERD_ACTION(FileOpen, QT_TRANSLATE_NOOP("Actions", "&Open..."), "", "open",
              QT_TRANSLATE_NOOP("Actions", "Open a binary for analysis"))
NEVERD_ACTION(FileReload,
              QT_TRANSLATE_NOOP("Actions", "&Reload the input file"), "",
              "refresh",
              QT_TRANSLATE_NOOP("Actions",
                                "Read the input file again, with its saved "
                                "annotations"))
NEVERD_ACTION(
    FileLoadSignatures,
    QT_TRANSLATE_NOOP("Actions", "&FLIRT signature file..."), "", "signatures",
    QT_TRANSLATE_NOOP(
        "Actions",
        "Apply a byte signature (.pat) or library feature (.json) pack"))
NEVERD_ACTION(FileLoadSignatureTree,
              QT_TRANSLATE_NOOP("Actions", "Signature &directory..."), "",
              "signatures",
              QT_TRANSLATE_NOOP(
                  "Actions", "Apply every matching pack from a signature tree"))
NEVERD_ACTION(
    FileExportListing, QT_TRANSLATE_NOOP("Actions", "Create &LST file..."), "",
    "text_view",
    QT_TRANSLATE_NOOP("Actions",
                      "Write the current function's listing to a text file"))
NEVERD_ACTION(
    FileExportPseudocode, QT_TRANSLATE_NOOP("Actions", "Create &C file..."),
    "Ctrl+F5", "pseudocode",
    QT_TRANSLATE_NOOP("Actions",
                      "Write the current function's pseudocode to a C file"))
NEVERD_ACTION(FileSave, QT_TRANSLATE_NOOP("Actions", "&Save"), "Ctrl+W", "save",
              QT_TRANSLATE_NOOP("Actions",
                                "Save comments and history beside the binary"))
NEVERD_ACTION(FileClose, QT_TRANSLATE_NOOP("Actions", "&Close"), "", "close",
              QT_TRANSLATE_NOOP("Actions", "Close the current binary"))
NEVERD_ACTION(FileQuickStart, QT_TRANSLATE_NOOP("Actions", "&Quick start"), "",
              "jump_entry",
              QT_TRANSLATE_NOOP("Actions", "Show the quick start window"))
NEVERD_ACTION(FileExit, QT_TRANSLATE_NOOP("Actions", "E&xit"), "Alt+X", "exit",
              QT_TRANSLATE_NOOP("Actions", "Quit NeverD"))

