NEVERD_ACTION(EditPatchRevert,
              QT_TRANSLATE_NOOP("Actions", "Restore original bytes"), "",
              "patch_revert",
              QT_TRANSLATE_NOOP("Actions",
                                "Restore the input bytes for this patch"))
NEVERD_ACTION(EditPatchedBytes, QT_TRANSLATE_NOOP("Actions", "Patched bytes"),
              "Ctrl+Alt+P", "patched_bytes",
              QT_TRANSLATE_NOOP("Actions",
                                "Inspect and selectively revert byte patches"))
NEVERD_ACTION(FileProducePatchedBinary,
              QT_TRANSLATE_NOOP("Actions", "Patched binary…"), "", "patch",
              QT_TRANSLATE_NOOP("Actions",
                                "Replay all byte patches into a new binary"))

