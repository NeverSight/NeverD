//===- WindowsKernelLayout.def - Public x64 WDM layout --------------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Public x64 WDM record sizes and field offsets.
///
//===----------------------------------------------------------------------===//

NEVERD_WDM_VALUE(DriverObjectSize, 0x150)
// Matched 19041.6456 PsGetProcessImageFileName is LEA RAX,[RCX+5A8h]; RET.
NEVERD_WDM_VALUE(ProcessImageFileName19041Offset, 0x5a8)
// Matched 19041.6456 PsGetProcessSectionBaseAddress is MOV RAX,[RCX+520h]; RET.
NEVERD_WDM_VALUE(ProcessSectionBase19041Offset, 0x520)
// Matched 19041.6456 PsGetProcessPeb is MOV RAX,[RCX+550h]; RET.
NEVERD_WDM_VALUE(ProcessPeb19041Offset, 0x550)
// Matched 19041.6456 getter is MOV EAX,[RCX+7D4h]; RET.
NEVERD_WDM_VALUE(ProcessExitStatus19041Offset, 0x7d4)
// x64 wdm.h KeGetCurrentThread reads the current KTHREAD identity from GS.
NEVERD_WDM_VALUE(GSCurrentThreadOffset, 0x188)
// Windows 19041 x64 WDK SharedTickCount / KSYSTEM_TIME layout.
NEVERD_WDM_VALUE(SharedClockDataBase, 0xfffff78000000000ULL)
NEVERD_WDM_VALUE(SharedTickCountOffset, 0x320)
NEVERD_WDM_VALUE(SharedTickCountSize, 12)
NEVERD_WDM_VALUE(SharedTickLowOffset, 0)
NEVERD_WDM_VALUE(SharedTickHigh1Offset, 4)
NEVERD_WDM_VALUE(SharedTickHigh2Offset, 8)
// x64 ntifs.h KAPC_STATE: two LIST_ENTRYs, Process, and three UCHAR flags.
