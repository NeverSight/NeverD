NEVERD_WDM_VALUE(UnicodeRecordSize, 0x10)
NEVERD_WDM_VALUE(UnicodeBufferOffset, 0x08)
NEVERD_WDM_VALUE(UnicodeMaximumOffset, 0x02)
// CLIENT_ID{HANDLE UniqueProcess; HANDLE UniqueThread;}
NEVERD_WDM_VALUE(ClientIDSize, 0x10)
NEVERD_WDM_VALUE(ClientIDThreadOffset, 0x08)
// x64 ntdef.h LIST_ENTRY {Flink, Blink} and SINGLE_LIST_ENTRY {Next}.
NEVERD_WDM_VALUE(ListEntrySize, 0x10)
NEVERD_WDM_VALUE(ListEntryFlinkOffset, 0x00)
NEVERD_WDM_VALUE(ListEntryBlinkOffset, 0x08)
NEVERD_WDM_VALUE(SingleListEntrySize, 0x08)
// x64 wdm.h KLOCK_QUEUE_HANDLE {KSPIN_LOCK_QUEUE{Next, Lock}; KIRQL OldIrql}.
NEVERD_WDM_VALUE(LockQueueNextOffset, 0x00)
NEVERD_WDM_VALUE(LockQueueLockOffset, 0x08)
NEVERD_WDM_VALUE(LockQueueOldIrqlOffset, 0x10)
NEVERD_WDM_VALUE(LockQueueHandleSize, 0x18)
// x64 wdm.h SLIST_HEADER: Depth:16 and Sequence:48, then the first entry with
// four reserved low bits, since entries are 16-byte aligned.
NEVERD_WDM_VALUE(SListHeaderSize, 0x10)
NEVERD_WDM_VALUE(SListHeaderEntryOffset, 0x08)
NEVERD_WDM_VALUE(SListAlignment, 0x10)
NEVERD_WDM_VALUE(SListDepthMask, 0xffff)
NEVERD_WDM_VALUE(SListSequenceUnit, 0x10000)
NEVERD_WDM_VALUE(SListReservedMask, 0x0f)
// x64 wdm.h GENERAL_LOOKASIDE, common to paged and nonpaged lists. The
// 19041 initializers write through LastAllocateMisses; Future stays untouched.
NEVERD_WDM_VALUE(LookasideSize, 0x60)
NEVERD_WDM_VALUE(LookasideDepthOffset, 0x10)
NEVERD_WDM_VALUE(LookasideMaximumDepthOffset, 0x12)
NEVERD_WDM_VALUE(LookasideCountersOffset, 0x14)
NEVERD_WDM_VALUE(LookasideTypeOffset, 0x24)
NEVERD_WDM_VALUE(LookasideTagOffset, 0x28)
NEVERD_WDM_VALUE(LookasideEntrySizeOffset, 0x2c)
NEVERD_WDM_VALUE(LookasideAllocateOffset, 0x30)
NEVERD_WDM_VALUE(LookasideFreeOffset, 0x38)
NEVERD_WDM_VALUE(LookasideLinksOffset, 0x40)
NEVERD_WDM_VALUE(LookasideLastCountersOffset, 0x50)
NEVERD_WDM_VALUE(LookasideFutureOffset, 0x58)
// x64 FAST_MUTEX and Windows 8+ KGUARDED_MUTEX share this layout.
NEVERD_WDM_VALUE(FastMutexSize, 0x38)
NEVERD_WDM_VALUE(FastMutexOwnerOffset, 0x08)
NEVERD_WDM_VALUE(FastMutexContentionOffset, 0x10)
NEVERD_WDM_VALUE(FastMutexEventOffset, 0x18)
NEVERD_WDM_VALUE(FastMutexOldIrqlOffset, 0x30)
// The guarded-mutex initializer preserves the unwritten header byte at +3.
NEVERD_WDM_VALUE(EventHeaderSizeOffset, 2)
NEVERD_WDM_VALUE(EventSignalStateOffset, 4)
NEVERD_WDM_VALUE(EventWaitListOffset, 8)
NEVERD_WDM_VALUE(ObjectAttributesSize, 48)
NEVERD_WDM_VALUE(ObjectRootOffset, 8)
NEVERD_WDM_VALUE(ObjectNameOffset, 16)
NEVERD_WDM_VALUE(ObjectFlagsOffset, 24)
NEVERD_WDM_VALUE(ObjectSecurityOffset, 32)
NEVERD_WDM_VALUE(ObjectQualityOffset, 40)
NEVERD_WDM_VALUE(ObjectSizeOffset, 0x02)
NEVERD_WDM_VALUE(MDLSize, 0x30)
NEVERD_WDM_VALUE(MDLNextOffset, 0x00)
NEVERD_WDM_VALUE(MDLSizeOffset, 0x08)
NEVERD_WDM_VALUE(MDLFlagsOffset, 0x0a)
NEVERD_WDM_VALUE(MDLProcessOffset, 0x10)
NEVERD_WDM_VALUE(MDLMappedSystemVAOffset, 0x18)
NEVERD_WDM_VALUE(MDLStartVAOffset, 0x20)
NEVERD_WDM_VALUE(MDLByteCountOffset, 0x28)
NEVERD_WDM_VALUE(MDLByteOffsetOffset, 0x2c)

// Windows 10.0.19041.6456 legacy ERESOURCE and encoded OWNER_ENTRY count.
NEVERD_WDM_VALUE(ExecutiveResourceSize, 0x68)
NEVERD_WDM_VALUE(ExecutiveResourceTableOffset, 0x10)
NEVERD_WDM_VALUE(ExecutiveResourceActiveOffset, 0x18)
NEVERD_WDM_VALUE(ExecutiveResourceFlagsOffset, 0x1a)
NEVERD_WDM_VALUE(ExecutiveResourceOwnerOffset, 0x30)
NEVERD_WDM_VALUE(ExecutiveResourceActiveEntriesOffset, 0x40)
NEVERD_WDM_VALUE(ExecutiveResourceOwnerSize, 0x10)
NEVERD_WDM_VALUE(ExecutiveResourceExclusiveFlag, 0x80)
NEVERD_WDM_VALUE(ExecutiveResourceDisableBoostFlag, 0x8)
// Read-only provider RAM; independent of ECAM physical addresses in the table.
NEVERD_WDM_VALUE(FirmwareMcfgBase, 0xffffc20000000000ULL)
NEVERD_WDM_VALUE(FirmwareMcfgWindowSize, 0x2000)
