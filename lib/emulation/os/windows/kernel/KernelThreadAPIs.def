//===- KernelThreadAPIs.def - Thread scheduling API contracts -------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//

// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-kequeryprioritythread
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-kesetprioritythread
NEVERD_KERNEL_THREAD_API(KeQueryPriorityThread, 1, Passive,
                         queryThreadPriority(A[0]))
NEVERD_KERNEL_THREAD_API(KeSetPriorityThread, 2, Passive,
                         setThreadPriority(A[0], int32_t(uint32_t(A[1]))))
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntddk/nf-ntddk-kequeryactiveprocessors
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-kesetsystemaffinitythread
NEVERD_KERNEL_THREAD_API(KeQueryActiveProcessors, 0, Any,
                         uint64_t(profile::ActiveProcessorMask))
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntddk/nf-ntddk-kegetcurrentprocessornumberex
NEVERD_KERNEL_THREAD_API(KeGetCurrentProcessorNumberEx, 1, Any,
                         currentProcessorNumber(A[0]))
NEVERD_KERNEL_THREAD_API(KeSetSystemAffinityThread, 1, Dispatch,
                         setSystemAffinity(A[0]))
NEVERD_KERNEL_THREAD_API(KeRevertToUserAffinityThread, 0, Dispatch,
                         revertSystemAffinity())

// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntifs/nf-ntifs-pslookupthreadbythreadid
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntddk/nf-ntddk-psgetthreadid
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntddk/nf-ntddk-psgetcurrentthreadid
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntifs/nf-ntifs-psisthreadterminating
NEVERD_KERNEL_THREAD_API(PsGetThreadProcessId, 1, Dispatch,
                         threadProcessID(A[0]))
// The 19041 reference exports read the same per-thread Win32 association.
// Setting a nonzero value exchanges it; clearing compares the supplied old
// value. These scalar operations do not create or expose a win32k object.
NEVERD_KERNEL_THREAD_API(PsGetCurrentThreadWin32Thread, 0, Any,
                         currentThreadWin32Thread())
NEVERD_KERNEL_THREAD_API(PsGetThreadWin32Thread, 1, Any,
                         threadWin32Thread(A[0]))
NEVERD_KERNEL_THREAD_API(PsSetThreadWin32Thread, 3, Any,
                         setThreadWin32Thread(A[0], A[1], A[2]))
