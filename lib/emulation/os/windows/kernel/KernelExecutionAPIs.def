//===- KernelExecutionAPIs.def - IRQL and APC API contracts ---------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Argument counts, IRQL ceilings and typed operations for execution state.
/// The model owns direction, pairing and thread-local APC state checks.
///
//===----------------------------------------------------------------------===//

// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-keraiseirqltodpclevel
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-kelowerirql
NEVERD_KERNEL_EXECUTION_API(KfRaiseIrql, 1, Any, raiseIRQL(uint8_t(A[0])))
NEVERD_KERNEL_EXECUTION_API(KeRaiseIrqlToDpcLevel, 0, Dispatch,
                            raiseIRQL(scheduler::DispatchLevel))
NEVERD_KERNEL_EXECUTION_API(KeLowerIrql, 1, Any, lowerIRQL(uint8_t(A[0])))

// https://learn.microsoft.com/windows-hardware/drivers/kernel/disabling-apcs
NEVERD_KERNEL_EXECUTION_API(KeEnterCriticalRegion, 0, APC,
                            enterApcRegion(ApcRegionKind::Critical))
NEVERD_KERNEL_EXECUTION_API(KeLeaveCriticalRegion, 0, APC,
                            leaveApcRegion(ApcRegionKind::Critical))
NEVERD_KERNEL_EXECUTION_API(KeEnterGuardedRegion, 0, APC,
                            enterApcRegion(ApcRegionKind::Guarded))
NEVERD_KERNEL_EXECUTION_API(KeLeaveGuardedRegion, 0, APC,
                            leaveApcRegion(ApcRegionKind::Guarded))
NEVERD_KERNEL_EXECUTION_API(KeAreApcsDisabled, 0, Dispatch, apcsDisabled())
NEVERD_KERNEL_EXECUTION_API(KeAreAllApcsDisabled, 0, Dispatch,
                            allApcsDisabled())

// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-iogetinitialstack
// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-iogetstacklimits
// Stack extents come from the current live DriverSession execution, including
// its private callback stack. An execution identity alone supplies no extent.
NEVERD_KERNEL_EXECUTION_API(IoGetInitialStack, 0, APC, queryInitialStack())
NEVERD_KERNEL_EXECUTION_API(IoGetStackLimits, 2, Any,
                            queryStackLimits(A[0], A[1]))
NEVERD_KERNEL_EXECUTION_API(KeSetSystemGroupAffinityThread, 2, APC,
                            groupAffinity(A[0], A[1], false))
NEVERD_KERNEL_EXECUTION_API(KeRevertToUserGroupAffinityThread, 1, APC,
                            groupAffinity(A[0], 0, true))
