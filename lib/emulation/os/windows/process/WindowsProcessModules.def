#ifdef NEVERD_WINDOWS_PROCESS_VALUE
NEVERD_WINDOWS_PROCESS_VALUE(StartupReserved, 0x70003f00)
NEVERD_WINDOWS_PROCESS_VALUE(StatusDLLInitFailed, 0xc0000142)
NEVERD_WINDOWS_PROCESS_VALUE(ImportOrdinalFlag, UINT64_C(1) << 63)
NEVERD_WINDOWS_PROCESS_VALUE(ImportOrdinalMask, 0xffff)
NEVERD_WINDOWS_PROCESS_VALUE(ModuleStride, 0x120)
NEVERD_WINDOWS_PROCESS_VALUE(ModuleInitLink, 0x20)
NEVERD_WINDOWS_PROCESS_VALUE(ASCIIUpperBound, 127)
NEVERD_WINDOWS_PROCESS_VALUE(MaxForwarders, 64)
NEVERD_WINDOWS_PROCESS_VALUE(ForwarderOrdinalRadix, 10)
NEVERD_WINDOWS_PROCESS_VALUE(ErrorProcedureNotFound, 127)
NEVERD_WINDOWS_PROCESS_VALUE(ErrorInvalidOrdinal, 182)
#endif
#ifdef NEVERD_WINDOWS_PROCESS_TEXT
NEVERD_WINDOWS_PROCESS_TEXT(Lifetime, "invalid module lifetime continuation")
NEVERD_WINDOWS_PROCESS_TEXT(EntryThreadExit,
                            "PE entry returned with startup DLLs; loader "
                            "thread termination is not supported")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleName,
                            "invalid or duplicate guest module basename: ")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleMissing,
                            "startup module is not explicitly supplied: ")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleCycle, "cyclic startup module dependencies: ")
NEVERD_WINDOWS_PROCESS_TEXT(
    ModuleISA, "startup module architecture differs from the executable")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleBudget, "module work budget exceeded")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleTimeout, "module operation deadline exceeded")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleTLSBudget,
                            "aggregate static TLS capacity exceeded")
NEVERD_WINDOWS_PROCESS_TEXT(TLSZeroFill,
                            "nonzero TLS SizeOfZeroFill is not supported")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleForwarder,
                            "invalid or unsupported export forwarder")
NEVERD_WINDOWS_PROCESS_TEXT(ForwarderCycle, "cyclic export forwarding")
NEVERD_WINDOWS_PROCESS_TEXT(ForwarderDepth, "export forwarding depth exceeded")
NEVERD_WINDOWS_PROCESS_TEXT(ForwarderLoad,
                            "export query requires dynamic module loading: ")
NEVERD_WINDOWS_PROCESS_TEXT(ExportChanged,
                            "runtime export metadata was modified")
NEVERD_WINDOWS_PROCESS_TEXT(ExportBudget, "module metadata budget exceeded")
NEVERD_WINDOWS_PROCESS_TEXT(ForwarderSeparator, ".")
NEVERD_WINDOWS_PROCESS_TEXT(ForwarderOrdinal, "#")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleExport, "missing or unmapped guest export: ")
NEVERD_WINDOWS_PROCESS_TEXT(ModuleFixup,
                            "base relocation overlaps linker metadata")
NEVERD_WINDOWS_PROCESS_TEXT(DLLExtension, ".dll")
#endif

#ifdef NEVERD_WINDOWS_PROCESS_TEXT
NEVERD_WINDOWS_PROCESS_TEXT(ModuleLoadFailed, "guest module load failed: ")
NEVERD_WINDOWS_PROCESS_TEXT(
    LoaderChanged, "guest loader metadata was modified or inaccessible")
NEVERD_WINDOWS_PROCESS_TEXT(LoaderReentrant,
                            "unsupported reentrant module state transition")
#endif
#ifdef NEVERD_WINDOWS_PROCESS_VALUE
NEVERD_WINDOWS_PROCESS_VALUE(ErrorDLLInitFailed, 1114)
NEVERD_WINDOWS_PROCESS_VALUE(MaxLoaderDepth, 64)
#endif

