//===- DriverImage.def - Strict PE driver image declarations -------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifdef NEVERD_DRIVER_IMAGE_VALUE
NEVERD_DRIVER_IMAGE_VALUE(MaxImportNameLength, unsigned, 512)
NEVERD_DRIVER_IMAGE_VALUE(FirstImportCharacter, uint8_t, '!')
NEVERD_DRIVER_IMAGE_VALUE(LastImportCharacter, uint8_t, '~')
NEVERD_DRIVER_IMAGE_VALUE(MaxPESections, unsigned, 96)
// LLVM names the defined directories; PE32+ reserves the following slot.
NEVERD_DRIVER_IMAGE_VALUE(ReservedPEDirectory, unsigned,
                          llvm::COFF::NUM_DATA_DIRECTORIES)
NEVERD_DRIVER_IMAGE_VALUE(MaxPEDirectoryEntries, unsigned,
                          ReservedPEDirectory + 1)
NEVERD_DRIVER_IMAGE_VALUE(MinPEFileAlignment, uint64_t, 512)
NEVERD_DRIVER_IMAGE_VALUE(PEImageBaseAlignment, uint64_t, 64 * 1024)
NEVERD_DRIVER_IMAGE_VALUE(MaxPEFileAlignment, uint64_t, PEImageBaseAlignment)
NEVERD_DRIVER_IMAGE_VALUE(RelocationTypeShift, unsigned, 12)
NEVERD_DRIVER_IMAGE_VALUE(LoadConfigurationPrefixBytes, size_t, 12)
NEVERD_DRIVER_IMAGE_VALUE(RuntimeFunctionBytes, unsigned, 3 * sizeof(uint32_t))
#endif
