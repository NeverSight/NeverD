#ifdef NEVERD_ANDROID_PATH_STATUS
// LP64 pathname wrappers only adapt arguments. The Linux owner retains path
// lookup, explicit metadata, user-copy and unsupported-object decisions.
NEVERD_ANDROID_PATH_STATUS("stat", 0)
NEVERD_ANDROID_PATH_STATUS("stat64", 0)
NEVERD_ANDROID_PATH_STATUS("lstat", linux_model::AtSymlinkNoFollow)
NEVERD_ANDROID_PATH_STATUS("lstat64", linux_model::AtSymlinkNoFollow)
#endif
