//===- AndroidSymbols.def - Bionic symbol vocabulary -----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// One inventory owns symbol spellings and Bionic call bindings. Prefixes retain
// the existing diagnostics for unknown members of a modeled call family.
#ifndef NEVERD_ANDROID_SYMBOL
#define NEVERD_ANDROID_SYMBOL(Name, Text)
#define NEVERD_ANDROID_UNDEF_SYMBOL
#endif
#ifndef NEVERD_ANDROID_CALL
#define NEVERD_ANDROID_CALL(Name, Text, Handler)                               \
  NEVERD_ANDROID_SYMBOL(Name, Text)
#define NEVERD_ANDROID_UNDEF_CALL
#endif
#ifndef NEVERD_ANDROID_PREFIX
#define NEVERD_ANDROID_PREFIX(Name, Text, Handler)                             \
  NEVERD_ANDROID_SYMBOL(Name, Text)
#define NEVERD_ANDROID_UNDEF_PREFIX
#endif

