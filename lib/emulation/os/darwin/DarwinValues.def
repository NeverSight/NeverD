// Positive trap indices. ARM64 encodes their negative low-32-bit value;
// x64 uses the Mach syscall class. Fast ARM64 clocks have no x64 trap slot.
#ifdef NEVERD_DARWIN_MACH_SERVICE
NEVERD_DARWIN_MACH_SERVICE(ThreadSelfPort, 27, false)
NEVERD_DARWIN_MACH_SERVICE(TaskSelfPort, 28, false)
NEVERD_DARWIN_MACH_SERVICE(HostSelfPort, 29, false)
NEVERD_DARWIN_MACH_SERVICE(TimebaseInfo, 89, false)
NEVERD_DARWIN_MACH_SERVICE(AbsoluteTime, 3, true)
NEVERD_DARWIN_MACH_SERVICE(ContinuousTime, 4, true)
#endif

// Cancellation is outside this single-thread profile; both entry numbers
// share the exact same service owner and retain the original report number.
#ifdef NEVERD_DARWIN_SERVICE_ALIAS
