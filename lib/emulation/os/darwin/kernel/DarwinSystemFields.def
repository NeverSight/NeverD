//===- DarwinSystemFields.def - Supported system observation bindings ----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Member, wire field, native name, stable numeric MIB. The member type owns
// encoding width. Derived page32/page64 bindings are separate kernel policy.
#ifdef NEVERD_DARWIN_SYSTEM_FIELD
NEVERD_DARWIN_SYSTEM_FIELD(OSType, SystemOSType, "kern.ostype", 1, 1)
NEVERD_DARWIN_SYSTEM_FIELD(OSRelease, SystemOSRelease, "kern.osrelease", 1, 2)
NEVERD_DARWIN_SYSTEM_FIELD(OSRevision, SystemOSRevision, "kern.osrevision", 1,
                           3)
NEVERD_DARWIN_SYSTEM_FIELD(KernelVersion, SystemKernelVersion, "kern.version",
                           1, 4)
// Native kern.osversion permits privileged writes. Explicit root credentials
// stop unsupported for writes; non-root returns EPERM. Observation stays fixed.
NEVERD_DARWIN_SYSTEM_FIELD(OSVersion, SystemOSVersion, "kern.osversion", 1, 65)
NEVERD_DARWIN_SYSTEM_FIELD(Machine, SystemMachine, "hw.machine", 6, 1)
NEVERD_DARWIN_SYSTEM_FIELD(Model, SystemModel, "hw.model", 6, 2)
NEVERD_DARWIN_SYSTEM_FIELD(CPUCount, SystemCPUCount, "hw.ncpu", 6, 3)
NEVERD_DARWIN_SYSTEM_FIELD(MemorySize, SystemMemorySize, "hw.memsize", 6, 24)
// Writable natively for root; only its immutable read observation is modeled.
NEVERD_DARWIN_SYSTEM_FIELD(MaxFilesPerProcess, SystemMaxFilesPerProcess,
                           "kern.maxfilesperproc", 1, 29)
// Caller-visible observation only; root/mobile write authority is not inferred.
NEVERD_DARWIN_SYSTEM_FIELD(HostName, SystemHostName, "kern.hostname", 1, 10)
#endif

// Process observations have no sysctl names or numeric MIBs. The member type
// owns wire encoding; explicit policy selects admission in the system owner.
#ifdef NEVERD_DARWIN_PROCESS_FIELD
NEVERD_DARWIN_PROCESS_FIELD(ProcessGroupID, SystemProcessGroupID, Identity)
NEVERD_DARWIN_PROCESS_FIELD(SessionID, SystemSessionID, Identity)
NEVERD_DARWIN_PROCESS_FIELD(ProcessTainted, SystemProcessTainted, Raw)
NEVERD_DARWIN_PROCESS_FIELD(LoginNameBytes, SystemLoginNameHex, Login)
NEVERD_DARWIN_PROCESS_FIELD(ProcessNice, SystemProcessNice, Nice)
NEVERD_DARWIN_PROCESS_FIELD(ThreadID, ThreadID, Raw)
NEVERD_DARWIN_PROCESS_FIELD(ThreadSelfPort, SystemThreadSelfPort, Raw)
NEVERD_DARWIN_PROCESS_FIELD(TaskSelfPort, SystemTaskSelfPort, Raw)
NEVERD_DARWIN_PROCESS_FIELD(HostSelfPort, SystemHostSelfPort, Raw)
#endif
