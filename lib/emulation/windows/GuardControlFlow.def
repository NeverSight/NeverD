//===- GuardControlFlow.def - PE control-flow guard values ----------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Public PE metadata values and bounded execution-profile limits.
/// https://learn.microsoft.com/windows/win32/secbp/pe-metadata
/// https://learn.microsoft.com/windows/win32/api/winnt/ns-winnt-image_load_config_directory64
/// Define NEVERD_GUARD_VALUE(Name, Value) before including this file.
///
//===----------------------------------------------------------------------===//

NEVERD_GUARD_VALUE(Instrumented, 0x100)
NEVERD_GUARD_VALUE(FunctionTablePresent, 0x400)
NEVERD_GUARD_VALUE(SecurityCookieUnused, 0x800)
NEVERD_GUARD_VALUE(LongJumpTablePresent, 0x10000)
NEVERD_GUARD_VALUE(XfgInstrumented, 0x800000)
NEVERD_GUARD_VALUE(FunctionTableSizeMask, 0xf0000000)
NEVERD_GUARD_VALUE(FunctionTableSizeShift, 28)
NEVERD_GUARD_VALUE(FunctionTableOneExtraByte, 0x10000000)
NEVERD_GUARD_VALUE(FunctionTableTwoExtraBytes, 0x20000000)
NEVERD_GUARD_VALUE(FunctionSuppressed, 0x1)
NEVERD_GUARD_VALUE(GuardMemcpyPointerOffset, 0x138)
NEVERD_GUARD_VALUE(UmaPointersOffset, 0x140)
NEVERD_GUARD_VALUE(KnownLoadConfigurationSize, 0x148)
NEVERD_GUARD_VALUE(MaximumTargets, 1048576)
