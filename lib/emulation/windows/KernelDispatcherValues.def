///
/// \file
/// Public WDK wdm.h x64 object extents and enum values. Objects remain opaque;
/// the implementation does not depend on their private member layout.
/// https://learn.microsoft.com/windows-hardware/drivers/kernel/opaque-structures
/// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-keinitializeevent
/// https://learn.microsoft.com/windows-hardware/drivers/ddi/wdm/nf-wdm-keinitializetimerex
/// KMUTEX is the x64 WDK KMUTANT alias; its 56-byte extent is checked by the
/// genuine WDK fixture compile, while the guest contents remain opaque.
///
//===----------------------------------------------------------------------===//

NEVERD_KERNEL_DISPATCHER_VALUE(DpcSize, 64)
NEVERD_KERNEL_DISPATCHER_VALUE(TimerSize, 64)
NEVERD_KERNEL_DISPATCHER_VALUE(EventSize, 24)
NEVERD_KERNEL_DISPATCHER_VALUE(SemaphoreSize, 32)
NEVERD_KERNEL_DISPATCHER_VALUE(MutexSize, 56)
NEVERD_KERNEL_DISPATCHER_VALUE(ObjectAlignment, 8)
NEVERD_KERNEL_DISPATCHER_VALUE(NotificationObject, 0)
NEVERD_KERNEL_DISPATCHER_VALUE(SynchronizationObject, 1)
NEVERD_KERNEL_DISPATCHER_VALUE(DispatchLevel, 2)
NEVERD_KERNEL_DISPATCHER_VALUE(HighLevel, 15)
NEVERD_KERNEL_DISPATCHER_VALUE(MaxObjects, 1024)
NEVERD_KERNEL_DISPATCHER_VALUE(StatusSemaphoreLimitExceeded, 0xc0000047U)
NEVERD_KERNEL_DISPATCHER_VALUE(StatusMutantNotOwned, 0xc0000046U)
