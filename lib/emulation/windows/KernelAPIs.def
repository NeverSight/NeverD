NEVERD_KERNEL_API(memset, 3, Export)
NEVERD_KERNEL_API(memcmp, 3, Export)
NEVERD_KERNEL_API(RtlCopyMemory, 3, Export)
NEVERD_KERNEL_API(RtlMoveMemory, 3, Export)
NEVERD_KERNEL_API(RtlFillMemory, 3, Export)
NEVERD_KERNEL_API(RtlCompareMemory, 3, Export)
NEVERD_KERNEL_API(DbgPrintEx, 3, Export)
