NEVERD_KERNEL_API(IoCallDriver, 2, Helper)
NEVERD_KERNEL_API(PoCallDriver, 2, Export)
NEVERD_KERNEL_API(PoRequestPowerIrp, 6, Export)
NEVERD_KERNEL_API(PoSetPowerState, 3, Export)
NEVERD_KERNEL_API(PoStartNextPowerIrp, 1, Export)
