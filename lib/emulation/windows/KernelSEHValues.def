//===- KernelSEHValues.def - Bounded x64 SEH execution values -------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Architectural widths, supported unwind flags and execution bounds.
/// Define NEVERD_SEH_VALUE(Name, Value) before inclusion.
///
//===----------------------------------------------------------------------===//

NEVERD_SEH_VALUE(RegisterCount, 16)
NEVERD_SEH_VALUE(ReturnRegister, 0)
NEVERD_SEH_VALUE(StackRegister, 4)
NEVERD_SEH_VALUE(NonvolatileRegisterMask, 0xF0E8)
NEVERD_SEH_VALUE(PointerSize, 8)
NEVERD_SEH_VALUE(FrameOffsetScale, 16)
NEVERD_SEH_VALUE(MaxFrameOffset, 240)
NEVERD_SEH_VALUE(ExceptionHandlerFlag, 1)
NEVERD_SEH_VALUE(UnwindHandlerFlag, 2)
NEVERD_SEH_VALUE(ChainFlag, 4)
NEVERD_SEH_VALUE(MaxFrames, 128)
NEVERD_SEH_VALUE(MaxFunctions, 65536)
NEVERD_SEH_VALUE(MaxScopes, 4096)
NEVERD_SEH_VALUE(MaxUnwindSteps, MaxScopes + MaxFrames)
NEVERD_SEH_VALUE(SecurityCookieBits, 48)
NEVERD_SEH_VALUE(MaxUnwindOperations, 255)
NEVERD_SEH_VALUE(MaxSmallAllocation, 128)
NEVERD_SEH_VALUE(ContextSize, 1232)
NEVERD_SEH_VALUE(ContextFlagsOffset, 48)
NEVERD_SEH_VALUE(ContextCSOffset, 56)
NEVERD_SEH_VALUE(ContextSSOffset, 66)
NEVERD_SEH_VALUE(ContextEFlagsOffset, 68)
NEVERD_SEH_VALUE(ContextGPROffset, 120)
NEVERD_SEH_VALUE(ContextPCOffset, 248)
NEVERD_SEH_VALUE(ContextIntegerControl, 0x100003)
NEVERD_SEH_VALUE(MutableEFlags, 0xCD5)
NEVERD_SEH_VALUE(ExceptionRecordSize, 152)
NEVERD_SEH_VALUE(ExceptionFlagsOffset, 4)
NEVERD_SEH_VALUE(ExceptionLinkOffset, 8)
NEVERD_SEH_VALUE(MaxNestedExceptions, 16)
NEVERD_SEH_VALUE(ExceptionUnwindingFlag, 0x02)
NEVERD_SEH_VALUE(ExceptionNestedCallFlag, 0x10)
NEVERD_SEH_VALUE(ExceptionTargetUnwindFlag, 0x20)
NEVERD_SEH_VALUE(ExceptionAddressOffset, 16)
NEVERD_SEH_VALUE(ExceptionParameterCountOffset, 24)
NEVERD_SEH_VALUE(ExceptionParametersOffset, 32)
NEVERD_SEH_VALUE(MaxExceptionParameters, 15)
NEVERD_SEH_VALUE(RecordAlignment, 16)
NEVERD_SEH_VALUE(ExceptionPointersOffset, 160)
NEVERD_SEH_VALUE(ContextOffset, ExceptionPointersOffset + 2 * PointerSize)
NEVERD_SEH_VALUE(RecordsSize, ContextOffset + ContextSize)
NEVERD_SEH_VALUE(FirstNonvolatileXmm, 6)
NEVERD_SEH_VALUE(NonvolatileXmmCount, 10)
NEVERD_SEH_VALUE(XmmWordCount, 2)
NEVERD_SEH_VALUE(XmmSize, 16)

NEVERD_SEH_VALUE(MaxEpilogueBytes, 64)
NEVERD_SEH_VALUE(ModRMModeMask, 0xC0)
