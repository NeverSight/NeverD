NEVERD_WDM_VALUE(StatusSuccess, 0)
NEVERD_WDM_VALUE(StatusInsufficientResources, 0xc000009a)
NEVERD_WDM_VALUE(StatusObjectNameCollision, 0xc0000035)
NEVERD_WDM_VALUE(StatusObjectNameNotFound, 0xc0000034)
NEVERD_WDM_VALUE(InvalidDeviceRequest, 0xc0000010)
NEVERD_WDM_VALUE(StatusPending, 0x103)
NEVERD_WDM_VALUE(FileFlags, 0x802)
NEVERD_WDM_VALUE(FileCleanupComplete, 0x4000)
NEVERD_WDM_VALUE(IRPSynchronous, 0x04)
NEVERD_WDM_VALUE(IRPCreate, 0x80)
NEVERD_WDM_VALUE(IRPClose, 0x400)
NEVERD_WDM_VALUE(IRPBufferedAllocation, 0x30)
NEVERD_WDM_VALUE(IRPCopyOutput, 0x40)
NEVERD_WDM_VALUE(UserMode, 1)
NEVERD_WDM_VALUE(CreateOptions, 0x01000020)
NEVERD_WDM_VALUE(CreateDesiredAccess, 0x12019f)
NEVERD_WDM_VALUE(ShareReadWrite, 3)
NEVERD_WDM_VALUE(DriverType, 4)
NEVERD_WDM_VALUE(DeviceType, 3)
NEVERD_WDM_VALUE(FileType, 5)
NEVERD_WDM_VALUE(IRPType, 6)
NEVERD_WDM_VALUE(UnknownDeviceType, 0x22)
NEVERD_WDM_VALUE(SecureOpen, 0x100)
NEVERD_WDM_VALUE(DeviceInitializing, 0x80)
NEVERD_WDM_VALUE(DeviceExclusive, 0x08)
NEVERD_WDM_VALUE(DeviceAlignmentMask, 63)
NEVERD_WDM_VALUE(PoolAlignment, 16)
NEVERD_WDM_VALUE(PoolNX, 512)
NEVERD_WDM_VALUE(UninitializedPoolByte, 0xcd)
NEVERD_WDM_VALUE(FreedPoolByte, 0xdd)
NEVERD_WDM_VALUE(MaxUnicodeBytes, 65532)
NEVERD_WDM_VALUE(MaxDebugBytes, 512)
NEVERD_WDM_VALUE(MaxDebugFormatBytes, 1024)
NEVERD_WDM_VALUE(MaxCreateInformation, 5)
