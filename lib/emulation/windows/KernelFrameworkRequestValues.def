NEVERD_FRAMEWORK_VALUE(RequestParametersSize, 40)
NEVERD_FRAMEWORK_VALUE(RequestParametersType, 4)
NEVERD_FRAMEWORK_VALUE(RequestParametersLength, 8)
NEVERD_FRAMEWORK_VALUE(RequestParametersInputLength, 16)
NEVERD_FRAMEWORK_VALUE(RequestParametersOffset, 24)
NEVERD_FRAMEWORK_VALUE(RequestParametersControlCode, 24)
NEVERD_FRAMEWORK_VALUE(RequestBufferTooSmall, 0xc0000023)
NEVERD_FRAMEWORK_VALUE(RequestInvalidUserBuffer, 0xc00000e8)
NEVERD_FRAMEWORK_VALUE(RequestAccessViolation, 0xc0000005)
NEVERD_FRAMEWORK_VALUE(RequestCancelled, 0xc0000120)
NEVERD_FRAMEWORK_VALUE(RequestInternalError, 0xc00000e5)
NEVERD_FRAMEWORK_VALUE(RequestStopActionSuspend, 0x01)
NEVERD_FRAMEWORK_VALUE(RequestStopActionPurge, 0x02)
NEVERD_FRAMEWORK_VALUE(RequestStopRequestCancelable, 0x10000000)
