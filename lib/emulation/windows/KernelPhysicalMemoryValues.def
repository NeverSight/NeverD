NEVERD_KERNEL_PHYSICAL_VALUE(PhysicalSize, DriverDmaPhysicalSize)
NEVERD_KERNEL_PHYSICAL_VALUE(PageSize, DriverDmaPageSize)
NEVERD_KERNEL_PHYSICAL_VALUE(RegionLimit, 4096)
NEVERD_KERNEL_PHYSICAL_VALUE(PinLimit, 2048)
