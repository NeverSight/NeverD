NEVERD_KERNEL_MMIO_VALUE(NonCached, 0)
NEVERD_KERNEL_MMIO_VALUE(PageReadOnly, 0x02)
NEVERD_KERNEL_MMIO_VALUE(PageReadWrite, 0x04)
NEVERD_KERNEL_MMIO_VALUE(PageNoCache, 0x200)
NEVERD_KERNEL_MMIO_VALUE(MaxMappings, 64)
