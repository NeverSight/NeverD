// User MSR forms are deliberately unprivileged instructions, but still need
// feature, MSR bitmap and interception state absent from this environment.
NEVERD_DRIVER_UNSUPPORTED_X64(X86_INS_URDMSR)
NEVERD_DRIVER_UNSUPPORTED_X64(X86_INS_UWRMSR)
