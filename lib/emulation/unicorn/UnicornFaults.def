//===- UnicornFaults.def - CPU fault vocabulary --------------------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Stable fault names and the Unicorn memory-event classifications. A fault
/// describes an observed stop; it does not imply Windows exception dispatch.
///
//===----------------------------------------------------------------------===//

#ifdef NEVERD_UNICORN_FAULT_KIND
NEVERD_UNICORN_FAULT_KIND(UnmappedMemory, "unmapped_memory")
NEVERD_UNICORN_FAULT_KIND(Protection, "protection")
NEVERD_UNICORN_FAULT_KIND(InvalidMemoryRange, "invalid_memory_range")
NEVERD_UNICORN_FAULT_KIND(InvalidInstruction, "invalid_instruction")
NEVERD_UNICORN_FAULT_KIND(Interrupt, "interrupt")
NEVERD_UNICORN_FAULT_KIND(UnhandledException, "unhandled_exception")
#endif

#ifdef NEVERD_UNICORN_ACCESS_KIND
NEVERD_UNICORN_ACCESS_KIND(Read, "read")
NEVERD_UNICORN_ACCESS_KIND(Write, "write")
NEVERD_UNICORN_ACCESS_KIND(Execute, "execute")
#endif

#ifdef NEVERD_UNICORN_MEMORY_FAULT
NEVERD_UNICORN_MEMORY_FAULT(UC_MEM_READ_UNMAPPED, UnmappedMemory, Read)
NEVERD_UNICORN_MEMORY_FAULT(UC_MEM_WRITE_UNMAPPED, UnmappedMemory, Write)
NEVERD_UNICORN_MEMORY_FAULT(UC_MEM_FETCH_UNMAPPED, UnmappedMemory, Execute)
NEVERD_UNICORN_MEMORY_FAULT(UC_MEM_READ_PROT, Protection, Read)
NEVERD_UNICORN_MEMORY_FAULT(UC_MEM_WRITE_PROT, Protection, Write)
NEVERD_UNICORN_MEMORY_FAULT(UC_MEM_FETCH_PROT, Protection, Execute)
#endif
