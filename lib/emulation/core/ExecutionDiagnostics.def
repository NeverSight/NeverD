NEVERD_EXECUTION_DIAGNOSTIC(InvalidMapping, "invalid or overlapping guest mapping")
NEVERD_EXECUTION_DIAGNOSTIC(MemoryLimit, "guest mapping or backing budget exceeded")
NEVERD_EXECUTION_DIAGNOSTIC(Allocation, "cannot allocate guest backing")
NEVERD_EXECUTION_DIAGNOSTIC(PageTables, "guest page-table budget exceeded")
NEVERD_EXECUTION_DIAGNOSTIC(MemoryAccess, "guest memory access is unmapped or protected")
NEVERD_EXECUTION_DIAGNOSTIC(Faulted, "cannot execute or mutate a faulted CPU")
NEVERD_EXECUTION_DIAGNOSTIC(Running, "operation requires a stopped CPU")
NEVERD_EXECUTION_DIAGNOSTIC(ContextExpired, "CPU context owner has expired")
NEVERD_EXECUTION_DIAGNOSTIC(ContextOwner, "CPU context belongs to another backend instance")
NEVERD_EXECUTION_DIAGNOSTIC(Register, "invalid or unsupported x64 register state")
NEVERD_EXECUTION_DIAGNOSTIC(Decode, "cannot initialize checked x64 decoder")
NEVERD_EXECUTION_DIAGNOSTIC(Instruction, "instruction is outside the checked hardware execution contract")
NEVERD_EXECUTION_DIAGNOSTIC(Callback, "exception in execution observer")
NEVERD_EXECUTION_DIAGNOSTIC(Unavailable, "requested execution backend is unavailable on this host")
NEVERD_EXECUTION_DIAGNOSTIC(Contract, "hardware execution requires the explicit checked-x64-v1 contract")
NEVERD_EXECUTION_DIAGNOSTIC(SoftwareContract, "Unicorn currently supports only the driver-strict contract")
NEVERD_EXECUTION_DIAGNOSTIC(BackendName, "unknown execution backend")
NEVERD_EXECUTION_DIAGNOSTIC(ContractName, "unknown execution contract")
NEVERD_EXECUTION_DIAGNOSTIC(KvmOpen, "cannot open /dev/kvm")
NEVERD_EXECUTION_DIAGNOSTIC(KvmCapabilities, "KVM lacks the required API or debugging capability")
NEVERD_EXECUTION_DIAGNOSTIC(KvmCreate, "cannot create KVM VM or vCPU")
NEVERD_EXECUTION_DIAGNOSTIC(KvmMap, "cannot register KVM backing or map vCPU state")
NEVERD_EXECUTION_DIAGNOSTIC(KvmState, "KVM CPU state transfer failed")
NEVERD_EXECUTION_DIAGNOSTIC(KvmRun, "KVM single-step execution failed")
NEVERD_EXECUTION_DIAGNOSTIC(KvmExit, "unexpected KVM exit reason={0}, detail={1}, pc={2:x}, cr2={3:x}; CPU state is terminal")
NEVERD_EXECUTION_DIAGNOSTIC(WhpCapability, "Windows hypervisor is unavailable or lacks exception exits")
NEVERD_EXECUTION_DIAGNOSTIC(WhpCreate, "cannot create or configure WHP partition")
NEVERD_EXECUTION_DIAGNOSTIC(WhpMap, "cannot map WHP guest physical memory")
NEVERD_EXECUTION_DIAGNOSTIC(WhpState, "WHP CPU state transfer failed")
NEVERD_EXECUTION_DIAGNOSTIC(WhpRun, "WHP single-step execution failed")
NEVERD_EXECUTION_DIAGNOSTIC(WhpExit, "unexpected WHP exit; CPU state is terminal")
NEVERD_EXECUTION_DIAGNOSTIC(UnknownFault, "unknown backend fault kind")
NEVERD_EXECUTION_DIAGNOSTIC(UnknownAccess, "unknown backend access kind")
