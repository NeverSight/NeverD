//===- PowerPCIntegerOpcodes.def - Classic scalar opcode fields ----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// NEVERD_PPC_OPCODE(Name, Value) names a primary or extended opcode field
/// used by the scalar lifter. The primary opcode selects the extended field.
///
//===----------------------------------------------------------------------===//

// Primary opcodes.
NEVERD_PPC_OPCODE(MULLI, 7)
NEVERD_PPC_OPCODE(SUBFIC, 8)
NEVERD_PPC_OPCODE(CMPLI, 10)
NEVERD_PPC_OPCODE(CMPI, 11)
NEVERD_PPC_OPCODE(ADDIC, 12)
NEVERD_PPC_OPCODE(ADDICRecord, 13)
NEVERD_PPC_OPCODE(ADDI, 14)
NEVERD_PPC_OPCODE(ADDIS, 15)
NEVERD_PPC_OPCODE(BC, 16)
NEVERD_PPC_OPCODE(B, 18)
NEVERD_PPC_OPCODE(XL, 19)
NEVERD_PPC_OPCODE(RLWIMI, 20)
NEVERD_PPC_OPCODE(RLWINM, 21)
NEVERD_PPC_OPCODE(RLWNM, 23)
NEVERD_PPC_OPCODE(RotateDouble, 30)
NEVERD_PPC_OPCODE(X, 31)
NEVERD_PPC_OPCODE(LoadDS, 58)
NEVERD_PPC_OPCODE(StoreDS, 62)

// XL, MD and MDS extended opcodes.
NEVERD_PPC_OPCODE(MCRF, 0)
NEVERD_PPC_OPCODE(BCLR, 16)
NEVERD_PPC_OPCODE(BCCTR, 528)
NEVERD_PPC_OPCODE(RLDICL, 0)
NEVERD_PPC_OPCODE(RLDICR, 1)
NEVERD_PPC_OPCODE(RLDIC, 2)
NEVERD_PPC_OPCODE(RLDIMI, 3)
NEVERD_PPC_OPCODE(RLDCL, 8)
NEVERD_PPC_OPCODE(RLDCR, 9)

// X, XO, XS and A extended opcodes.
NEVERD_PPC_OPCODE(CMP, 0)
NEVERD_PPC_OPCODE(SUBFC, 8)
NEVERD_PPC_OPCODE(MULHDU, 9)
NEVERD_PPC_OPCODE(ADDC, 10)
NEVERD_PPC_OPCODE(MULHWU, 11)
NEVERD_PPC_OPCODE(ISEL, 15)
NEVERD_PPC_OPCODE(MFCR, 19)
NEVERD_PPC_OPCODE(SLW, 24)
NEVERD_PPC_OPCODE(CNTLZW, 26)
NEVERD_PPC_OPCODE(SLD, 27)
NEVERD_PPC_OPCODE(CMPL, 32)
NEVERD_PPC_OPCODE(SUBF, 40)
NEVERD_PPC_OPCODE(CNTLZD, 58)
NEVERD_PPC_OPCODE(MULHD, 73)
NEVERD_PPC_OPCODE(MULHW, 75)
NEVERD_PPC_OPCODE(NEG, 104)
NEVERD_PPC_OPCODE(MTCRF, 144)
NEVERD_PPC_OPCODE(MULLD, 233)
NEVERD_PPC_OPCODE(MULLW, 235)
NEVERD_PPC_OPCODE(OverflowEnable, 1u << 9)
NEVERD_PPC_OPCODE(ADD, 266)
NEVERD_PPC_OPCODE(MFSPR, 339)
NEVERD_PPC_OPCODE(MTSPR, 467)
NEVERD_PPC_OPCODE(SRW, 536)
NEVERD_PPC_OPCODE(SRD, 539)
NEVERD_PPC_OPCODE(SRAW, 792)
NEVERD_PPC_OPCODE(SRAD, 794)
NEVERD_PPC_OPCODE(SRAWI, 824)
NEVERD_PPC_OPCODE(SRADI, 826)
NEVERD_PPC_OPCODE(EXTSH, 922)
NEVERD_PPC_OPCODE(EXTSB, 954)
NEVERD_PPC_OPCODE(EXTSW, 986)

#undef NEVERD_PPC_OPCODE
