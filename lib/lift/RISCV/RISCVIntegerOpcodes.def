//===- RISCVIntegerOpcodes.def - RISC-V integer opcode fields -------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Major opcodes shared by compressed expansion, control-flow classification
/// and scalar lifting, followed by fixed fields of scalar register forms.
///
//===----------------------------------------------------------------------===//

NEVERD_RISCV_OPCODE(MajorMask, 0x7f)
NEVERD_RISCV_OPCODE(Load, 0x03)
NEVERD_RISCV_OPCODE(MiscMem, 0x0f)
NEVERD_RISCV_OPCODE(OpImm, 0x13)
NEVERD_RISCV_OPCODE(Auipc, 0x17)
NEVERD_RISCV_OPCODE(OpImm32, 0x1b)
NEVERD_RISCV_OPCODE(Store, 0x23)
NEVERD_RISCV_OPCODE(Atomic, 0x2f)
NEVERD_RISCV_OPCODE(Op, 0x33)
NEVERD_RISCV_OPCODE(Lui, 0x37)
NEVERD_RISCV_OPCODE(Op32, 0x3b)
NEVERD_RISCV_OPCODE(Branch, 0x63)
NEVERD_RISCV_OPCODE(Jalr, 0x67)
NEVERD_RISCV_OPCODE(Jal, 0x6f)
NEVERD_RISCV_OPCODE(System, 0x73)
NEVERD_RISCV_OPCODE(ExceptRdMask, 0xfffff07f)

// Zicond 1.0 register forms, excluding rd, rs1 and rs2.
NEVERD_RISCV_OPCODE(CzeroEqz, 0x0e005033)
NEVERD_RISCV_OPCODE(CzeroNez, 0x0e007033)

NEVERD_RISCV_OPCODE(LoadFP, 0x07)
NEVERD_RISCV_OPCODE(StoreFP, 0x27)
NEVERD_RISCV_OPCODE(FMAdd, 0x43)
NEVERD_RISCV_OPCODE(FMSub, 0x47)
NEVERD_RISCV_OPCODE(FNMSub, 0x4b)
NEVERD_RISCV_OPCODE(FNMAdd, 0x4f)
NEVERD_RISCV_OPCODE(OpFP, 0x53)

#undef NEVERD_RISCV_OPCODE
