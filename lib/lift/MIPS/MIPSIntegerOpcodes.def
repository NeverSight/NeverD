NEVERD_MIPS_SPECIAL_OPCODE(SRLV, 0x06)
NEVERD_MIPS_SPECIAL_OPCODE(SRAV, 0x07)
NEVERD_MIPS_SPECIAL_OPCODE(JR, 0x08)
NEVERD_MIPS_SPECIAL_OPCODE(JALR, 0x09)
NEVERD_MIPS_SPECIAL_OPCODE(MOVZ, 0x0a)
NEVERD_MIPS_SPECIAL_OPCODE(MOVN, 0x0b)
NEVERD_MIPS_SPECIAL_OPCODE(MFHI, 0x10)
NEVERD_MIPS_SPECIAL_OPCODE(MTHI, 0x11)
NEVERD_MIPS_SPECIAL_OPCODE(MFLO, 0x12)
NEVERD_MIPS_SPECIAL_OPCODE(MTLO, 0x13)
NEVERD_MIPS_SPECIAL_OPCODE(DSLLV, 0x14)
