NEVERD_MIPS_SPECIAL_OPCODE(DDIVU, 0x1f)
NEVERD_MIPS_SPECIAL_OPCODE(ADDU, 0x21)
NEVERD_MIPS_SPECIAL_OPCODE(SUBU, 0x23)
