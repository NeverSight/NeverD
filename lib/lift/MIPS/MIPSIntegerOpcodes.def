//===- MIPSIntegerOpcodes.def - Classic MIPS opcode fields
//-----------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Major opcodes and SPECIAL/SPECIAL2 function fields used by integer lifting.
/// Compressed instructions expand to these classic fields.
///
//===----------------------------------------------------------------------===//

#ifdef NEVERD_MIPS_MAJOR_OPCODE
NEVERD_MIPS_MAJOR_OPCODE(SPECIAL, 0x00)
NEVERD_MIPS_MAJOR_OPCODE(REGIMM, 0x01)
NEVERD_MIPS_MAJOR_OPCODE(J, 0x02)
NEVERD_MIPS_MAJOR_OPCODE(JAL, 0x03)
NEVERD_MIPS_MAJOR_OPCODE(BEQ, 0x04)
NEVERD_MIPS_MAJOR_OPCODE(BNE, 0x05)
NEVERD_MIPS_MAJOR_OPCODE(BGTZ, 0x07)
NEVERD_MIPS_MAJOR_OPCODE(ADDIU, 0x09)
NEVERD_MIPS_MAJOR_OPCODE(SLTI, 0x0a)
NEVERD_MIPS_MAJOR_OPCODE(SLTIU, 0x0b)
NEVERD_MIPS_MAJOR_OPCODE(ANDI, 0x0c)
NEVERD_MIPS_MAJOR_OPCODE(ORI, 0x0d)
NEVERD_MIPS_MAJOR_OPCODE(XORI, 0x0e)
NEVERD_MIPS_MAJOR_OPCODE(LUI, 0x0f)
NEVERD_MIPS_MAJOR_OPCODE(COP0, 0x10)
NEVERD_MIPS_MAJOR_OPCODE(COP1, 0x11)
NEVERD_MIPS_MAJOR_OPCODE(COP1X, 0x13)
NEVERD_MIPS_MAJOR_OPCODE(BEQL, 0x14)
NEVERD_MIPS_MAJOR_OPCODE(BGTZL, 0x17)
NEVERD_MIPS_MAJOR_OPCODE(DADDIU, 0x19)
NEVERD_MIPS_MAJOR_OPCODE(SPECIAL2, 0x1c)
NEVERD_MIPS_MAJOR_OPCODE(JALX, 0x1d)
NEVERD_MIPS_MAJOR_OPCODE(MSA, 0x1e)
NEVERD_MIPS_MAJOR_OPCODE(SPECIAL3, 0x1f)
NEVERD_MIPS_MAJOR_OPCODE(CACHE, 0x2f)
NEVERD_MIPS_MAJOR_OPCODE(LL, 0x30)
NEVERD_MIPS_MAJOR_OPCODE(PREF, 0x33)
NEVERD_MIPS_MAJOR_OPCODE(SC, 0x38)

#define NEVERD_MIPS_NAMED_INTEGER_MEMORY(Name, Op, Bytes, Store, Signed, Wide) \
  NEVERD_MIPS_MAJOR_OPCODE(Name, Op)
#include "neverd/ir/intrinsics/MIPS/MIPSIntegerMemory.def"
#undef NEVERD_MIPS_MAJOR_OPCODE
#endif

