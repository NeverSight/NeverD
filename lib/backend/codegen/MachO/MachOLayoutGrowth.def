#ifndef MACHO_LAYOUT_TEXT
#define MACHO_LAYOUT_TEXT(Name, Text)
#endif
#ifndef MACHO_LAYOUT_VALUE
#define MACHO_LAYOUT_VALUE(Type, Name, Value)
#endif

MACHO_LAYOUT_TEXT(kMetadataTextSegment, "__TEXT")
MACHO_LAYOUT_TEXT(kCompactSection, "__unwind_info")
MACHO_LAYOUT_VALUE(uint64_t, kMetadataCommandReserve, 512)
MACHO_LAYOUT_TEXT(kSectionOrderReferences,
                  "TEXT section ordering has unmodeled section references")

MACHO_LAYOUT_TEXT(
    kMetadataOwnership,
    "metadata placement has unknown load-command payload ownership")
MACHO_LAYOUT_TEXT(
    kMetadataCapacity,
    "new section needs authenticated header capacity and section identities")
MACHO_LAYOUT_TEXT(
    kRelroCapacity,
    "main executable needs unowned capacity in its existing read-only segment")

MACHO_LAYOUT_TEXT(kLostFrameSection, "header growth lost the DWARF section")

#undef MACHO_LAYOUT_TEXT
#undef MACHO_LAYOUT_VALUE
