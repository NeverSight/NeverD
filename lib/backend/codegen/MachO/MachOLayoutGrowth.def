#ifndef MACHO_LAYOUT_TEXT
#define MACHO_LAYOUT_TEXT(Name, Text)
#endif
#ifndef MACHO_LAYOUT_VALUE
#define MACHO_LAYOUT_VALUE(Type, Name, Value)
#endif

MACHO_LAYOUT_TEXT(kMetadataTextSegment, "__TEXT")
MACHO_LAYOUT_TEXT(kCompactSection, "__unwind_info")
