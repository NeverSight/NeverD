//===- MachOAuthenticatedFixups.def - Dyld installation contracts -*- C++
//-*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Encoding fields and diagnostics for authenticated chained installation.
//===----------------------------------------------------------------------===//

#ifndef MACHO_AUTH_FIXUP_VALUE
#define MACHO_AUTH_FIXUP_VALUE(Type, Name, Value)
#endif
#ifndef MACHO_AUTH_FIXUP_TEXT
#define MACHO_AUTH_FIXUP_TEXT(Name, Text)
#endif

MACHO_AUTH_FIXUP_VALUE(int64_t, kMinLibraryOrdinal, -3)
MACHO_AUTH_FIXUP_VALUE(int64_t, kMaxLibraryOrdinal, 0xfff0)
MACHO_AUTH_FIXUP_VALUE(unsigned, kImportWeakBit, 16)
MACHO_AUTH_FIXUP_VALUE(unsigned, kImportNameBit, 32)
MACHO_AUTH_FIXUP_VALUE(unsigned, kCodeSignatureAlignment, 16)
MACHO_AUTH_FIXUP_VALUE(uint16_t, kDefaultPointerFormat,
                       llvm::MachO::DYLD_CHAINED_PTR_ARM64E_USERLAND)
MACHO_AUTH_FIXUP_TEXT(kErrorPrefix, "Mach-O authenticated fixup: ")
MACHO_AUTH_FIXUP_TEXT(kImageABI, "requires a linked arm64e chained image")
MACHO_AUTH_FIXUP_TEXT(kPointerFormat, "unsupported authenticated chain format")
MACHO_AUTH_FIXUP_TEXT(kRecipe, "incomplete or contradictory signing recipe")
MACHO_AUTH_FIXUP_TEXT(kStorage, "storage is not aligned writable image data")
MACHO_AUTH_FIXUP_TEXT(kOverlap, "new storage overlaps an existing or new fixup")
MACHO_AUTH_FIXUP_TEXT(kTarget,
                      "local target is not representable image storage")
MACHO_AUTH_FIXUP_TEXT(kImport,
                      "import identity or ordinal cannot be represented")
MACHO_AUTH_FIXUP_TEXT(kExtent, "chain metadata exceeds its native field width")
MACHO_AUTH_FIXUP_TEXT(kReplay,
                      "installed signing recipe differs from its request")
MACHO_AUTH_FIXUP_TEXT(kSignature,
                      "code signature has no unique terminal LINKEDIT extent")

#undef MACHO_AUTH_FIXUP_VALUE
#undef MACHO_AUTH_FIXUP_TEXT
