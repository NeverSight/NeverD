//===- MachOLiftedLeaf.def - Darwin register-only leaf publication --*- C++
//-*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//

#ifndef MACHO_LEAF_TEXT
#define MACHO_LEAF_TEXT(Name, Text)
#endif
#ifndef MACHO_LEAF_VALUE
#define MACHO_LEAF_VALUE(Type, Name, Value)
#endif
#ifndef MACHO_LEAF_MEMORY
#define MACHO_LEAF_MEMORY(Name)
#endif
#ifndef MACHO_LEAF_INSTRUCTION
#define MACHO_LEAF_INSTRUCTION(Name)
#endif
#ifndef MACHO_LEAF_SEQUENCE
#define MACHO_LEAF_SEQUENCE(Name, ...)
#endif

MACHO_LEAF_TEXT(kLeafModule,
                "arm64e lifted image has no complete native leaf contract")
MACHO_LEAF_TEXT(
    kLeafCoverage,
    "arm64e lifted entries do not cover the original instruction section")
MACHO_LEAF_TEXT(kLeafCode, "arm64e generated instructions do not reproduce the "
                           "original position-independent leaf")
MACHO_LEAF_TEXT(kLeafFrame, "arm64e lifted leaf requires a matching native "
                            "frame record and unwind encoding")
MACHO_LEAF_TEXT(kBodyExtent,
                "arm64e entry {0} has {1} source bytes and {2} emitted bytes")
MACHO_LEAF_TEXT(kGeneratedCoverage,
                "arm64e object has {0} unwind ranges for {1} entries and {2} "
                "code bytes for {3} original bytes")
MACHO_LEAF_TEXT(kGeneratedSymbol,
                "arm64e object has no emitted address for {0}")
MACHO_LEAF_TEXT(
    kGeneratedRange,
    "arm64e object has no matching native range for {0} at [{1:x}, {2:x})")
MACHO_LEAF_TEXT(
    kSourceSection,
    "arm64e lifted image has unsupported instruction section {0},{1}")
MACHO_LEAF_TEXT(kSourceText,
                "arm64e lifted image requires file-backed TEXT with function "
                "starts and a single executable segment")
MACHO_LEAF_TEXT(kSourceEntry, "arm64e lifted function {0} has no complete "
                              "definition at an original entry")
MACHO_LEAF_TEXT(kDirectTarget,
                "arm64e direct transfer does not preserve its installed target")
MACHO_LEAF_TEXT(kErrorResultABI,
                "arm64e writable X21 across calls requires an error-result ABI")
MACHO_LEAF_TEXT(kLeafABIFlag, "ptrauth.abi-version")
MACHO_LEAF_TEXT(
    kDataPage,
    "arm64e lifted ADRP does not reproduce the original data page and register")
MACHO_LEAF_TEXT(kDataBinding,
                "arm64e lifted global needs an original image data address")
MACHO_LEAF_TEXT(kTailBranchAsm, "b ${0:c}")
MACHO_LEAF_TEXT(kTailBranchSymbol, "s")
MACHO_LEAF_TEXT(kFramePointerAttribute, "frame-pointer")
MACHO_LEAF_TEXT(kNonLeafFrame, "non-leaf")
// Standard FP/LR record at CFA-16. The second form also reserves a Swift
// error-result spill below the record.
MACHO_LEAF_SEQUENCE(kPushFrame, 0xa9bf7bfd, 0x910003fd)
MACHO_LEAF_SEQUENCE(kPopFrame, 0xa8c17bfd)
MACHO_LEAF_SEQUENCE(kAllocateFrame, 0xd10083ff, 0xa9017bfd, 0x910043fd)
MACHO_LEAF_SEQUENCE(kDeallocateFrame, 0xa9417bfd, 0x910083ff)
MACHO_LEAF_SEQUENCE(kPushLink, 0xf81f0ffe)
MACHO_LEAF_SEQUENCE(kPopLink, 0xf84107fe)
MACHO_LEAF_TEXT(kCompilerFrameAugmentation, "zR")
MACHO_LEAF_TEXT(kBKeyFrameAugmentation, "zRB")
MACHO_LEAF_VALUE(va_t, kInstructionPageBytes, 4096)
MACHO_LEAF_VALUE(uint32_t, kClassicABIVersion, 0)
MACHO_LEAF_VALUE(unsigned, kMemoryOperandCount, 2)
MACHO_LEAF_VALUE(unsigned, kArithmeticOperandCount, 3)
MACHO_LEAF_VALUE(uint32_t, kReturnToLR, 0xd65f03c0)
MACHO_LEAF_VALUE(uint32_t, kDestinationMask, 0x1f)
MACHO_LEAF_VALUE(uint32_t, kZeroOperationMask, 0x7fffffe0)
MACHO_LEAF_VALUE(uint32_t, kMoveWideZero, 0x52800000)
MACHO_LEAF_VALUE(uint32_t, kMoveFromZero, 0x2a1f03e0)

// Arithmetic and moves have no PC-relative operands. Plain memory accesses
// must pass additional base-register and addressing-mode checks.
MACHO_LEAF_INSTRUCTION(AARCH64_INS_ADD)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_SUB)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_AND)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_ORR)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_EOR)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_MOV)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_MOVZ)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_MOVN)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_MOVK)
// Register-only integer arithmetic has no PC-relative operand. The publisher
// compares the full instruction word, including the width and shift kind.
MACHO_LEAF_INSTRUCTION(AARCH64_INS_MUL)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_MADD)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_MSUB)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_LSL)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_LSR)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_ASR)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_ROR)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_FADD)
MACHO_LEAF_INSTRUCTION(AARCH64_INS_FSUB)

MACHO_LEAF_MEMORY(AARCH64_INS_LDR)
MACHO_LEAF_MEMORY(AARCH64_INS_STR)

#undef MACHO_LEAF_SEQUENCE
#undef MACHO_LEAF_MEMORY
#undef MACHO_LEAF_INSTRUCTION
#undef MACHO_LEAF_VALUE
#undef MACHO_LEAF_TEXT
