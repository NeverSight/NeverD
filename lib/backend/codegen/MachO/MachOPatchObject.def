//===- MachOPatchObject.def - Native authenticated objects -----*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//

#ifndef MACHO_OBJECT_VALUE
#define MACHO_OBJECT_VALUE(Type, Name, Value)
#endif

#ifndef MACHO_OBJECT_TEXT
#define MACHO_OBJECT_TEXT(Name, Text)
#endif

MACHO_OBJECT_TEXT(kClassicReturnCFI,
                  "classic arm64e requires implicit signed-return CFI; "
                  "use a compatible native object producer or fixed LLVM fork")

MACHO_OBJECT_TEXT(
    kSubtype,
    "native object pointer-authentication ABI does not match the image")
MACHO_OBJECT_TEXT(
    kAuthMetadata,
    "authenticated relocation lacks a native writable symbolic slot")
MACHO_OBJECT_TEXT(kAuthSymbol,
                  "authenticated relocation names an unavailable native symbol")
MACHO_OBJECT_TEXT(kAuthTarget, "authenticated relocation target overflows")
MACHO_OBJECT_TEXT(kDataSegment, "__DATA")
MACHO_OBJECT_TEXT(kAuthSegment, "__AUTH")
MACHO_OBJECT_TEXT(kDataConstSegment, "__DATA_CONST")
MACHO_OBJECT_TEXT(kAuthConstSegment, "__AUTH_CONST")
MACHO_OBJECT_TEXT(kConstSection, "__const")
MACHO_OBJECT_TEXT(kNativeImage, "native-object-image")
MACHO_OBJECT_TEXT(kNativeStorage,
                  "native authenticated object requires a linked arm64e image")
MACHO_OBJECT_TEXT(kNativePlacement,
                  "native authenticated object has no safe placement")

MACHO_OBJECT_VALUE(unsigned, kRelocationBits, 128)
// Native compact records contain three pointers and two 32-bit words.
MACHO_OBJECT_VALUE(unsigned, kCompactPointers, 3)
MACHO_OBJECT_VALUE(unsigned, kCompactFixedBytes, 2 * sizeof(uint32_t))
// Darwin arm64e unwind personality GOT signing schema.
MACHO_OBJECT_VALUE(uint8_t, kPersonalityKey, 0)
MACHO_OBJECT_VALUE(uint16_t, kPersonalityDiversity, 0)
MACHO_OBJECT_VALUE(bool, kPersonalityAddressDiversity, true)
MACHO_OBJECT_TEXT(kNativeGOT, "__nd_got")
MACHO_OBJECT_TEXT(kGOTRelocation,
                  "invalid native GOT or personality relocation")
MACHO_OBJECT_TEXT(kGOTRange, "native GOT displacement overflows")
MACHO_OBJECT_TEXT(kOrdinaryStorage,
                  "ordinary pointer lacks writable native pointer storage")
MACHO_OBJECT_TEXT(kOrdinarySymbol,
                  "ordinary pointer names an unavailable native symbol")
MACHO_OBJECT_TEXT(kOrdinaryTarget,
                  "ordinary pointer target overflows or lacks native storage")
MACHO_OBJECT_TEXT(kCompactLanguage,
                  "native compact language or range fields are inconsistent")

MACHO_OBJECT_TEXT(kLanguagePointer,
                  "native language pointer lacks an exact relocation contract")
MACHO_OBJECT_TEXT(kLanguageReplay,
                  "installed native language metadata failed semantic replay")

MACHO_OBJECT_TEXT(kMutableDataSection, "__data")
MACHO_OBJECT_TEXT(kObjCImageInfo, "__objc_imageinfo")
MACHO_OBJECT_VALUE(size_t, kObjCImageInfoBytes, 2 * sizeof(uint32_t))
MACHO_OBJECT_VALUE(uint32_t, kObjCImageInfoVersion, 0)
MACHO_OBJECT_TEXT(
    kObjCFlags,
    "native Objective-C image flags differ or lack an installed declaration")
MACHO_OBJECT_TEXT(kWeakDataAtom,
                  "weak data requires an independently owned regular data atom")
MACHO_OBJECT_TEXT(
    kWeakDataFallback,
    "weak data lacks an exported fallback and sealed coalescing GOT slot")
MACHO_OBJECT_TEXT(kWeakDataReference,
                  "weak data reference bypasses its coalescing GOT")
MACHO_OBJECT_TEXT(kPrivateWeak,
                  "native private weak data requires a coalescing contract")
MACHO_OBJECT_TEXT(kSharedCache,
                  "native publication requires an independent linked image")
MACHO_OBJECT_TEXT(kDependencyProfile,
                  "explicit native pointer providers require arm64e")
MACHO_OBJECT_TEXT(kPublishedPointer,
                  "published native pointer is not file-backed")

MACHO_OBJECT_TEXT(kPublishedCompact,
                  "final native compact table cannot be decoded completely")
MACHO_OBJECT_TEXT(kPublishedRange,
                  "final native compact encoding or range is not registered")

MACHO_OBJECT_TEXT(kNativeRelroSection, "__nd_const")
MACHO_OBJECT_TEXT(kMainRelro, "main executable has multiple read-only segments")

MACHO_OBJECT_TEXT(kMainRelroExtent,
                  "native read-only data extent exceeds placement limits")

#undef MACHO_OBJECT_VALUE
#undef MACHO_OBJECT_TEXT
