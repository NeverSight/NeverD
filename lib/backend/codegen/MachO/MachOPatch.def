//===- MachOPatch.def - Mach-O replacement placement contracts --*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Define MACHO_PATCH_TEXT(Name, Text) to consume placement names and errors.
//===----------------------------------------------------------------------===//

#ifndef MACHO_PATCH_TEXT
#define MACHO_PATCH_TEXT(Name, Text)
#endif

MACHO_PATCH_TEXT(kPatchDataSegment, "__ND_DATA")
MACHO_PATCH_TEXT(kPatchConstSegment, "__ND_CONST")
MACHO_PATCH_TEXT(kPlacementIdentity, "native Mach-O placement identity changed")
MACHO_PATCH_TEXT(kSegmentInstallation,
                 "native Mach-O segment installation failed")
MACHO_PATCH_TEXT(kNoAdjacentRXTail,
                 "macho_patch: cannot extend an adjacent RX segment for ")

MACHO_PATCH_TEXT(
    kExternalRelroStorage,
    "external read-only data requires reserved zero-filled section storage")

MACHO_PATCH_TEXT(kInitializerOffsets, "__init_offsets")
MACHO_PATCH_TEXT(kThreadVariables, "__thread_vars")
MACHO_PATCH_TEXT(kThreadTemplate, "__thread_data")

#undef MACHO_PATCH_TEXT
