#ifndef LLVMC_STACK_TEXT
#define LLVMC_STACK_TEXT(Name, Text)
#endif

LLVMC_STACK_TEXT(kLocalAddressName, "llvm_localaddress")
LLVMC_STACK_TEXT(kRetainStackFrame, "__attribute__((noinline)) ")
LLVMC_STACK_TEXT(kEntrySPName, "llvm_entry_sp")
LLVMC_STACK_TEXT(kStackIntrinsicDecl,
                 "extern void *{0}(void) __asm__(\"{1}\");\n")

#undef LLVMC_STACK_TEXT
