//===- ELFObjectRelocations.def - Relocations of ELF objects ----*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Relocations of a relocatable object whose meaning the loader models, per
/// architecture.  Types are llvm::ELF relocation enumerators.
///
//===----------------------------------------------------------------------===//

// NEVERD_ELF_GOT_REFERENCE(Arch, GotType, DirectType): a relocation that
// reaches its symbol through a GOT entry the linker creates.  The loader
// makes that entry, holding the symbol's address, and applies DirectType
// against the entry instead of the symbol.  i386 addresses its GOT from a
// base of zero (R_386_GOTPC), so its entries are GOTOFF fields.
#ifndef NEVERD_ELF_GOT_REFERENCE
#define NEVERD_ELF_GOT_REFERENCE(Arch, GotType, DirectType)
#endif
NEVERD_ELF_GOT_REFERENCE(X86, R_386_GOT32, R_386_GOTOFF)
NEVERD_ELF_GOT_REFERENCE(X86, R_386_GOT32X, R_386_GOTOFF)
NEVERD_ELF_GOT_REFERENCE(X64, R_X86_64_GOTPCREL, R_X86_64_PC32)
NEVERD_ELF_GOT_REFERENCE(X64, R_X86_64_GOTPCRELX, R_X86_64_PC32)
NEVERD_ELF_GOT_REFERENCE(X64, R_X86_64_REX_GOTPCRELX, R_X86_64_PC32)
NEVERD_ELF_GOT_REFERENCE(ARM, R_ARM_GOT_PREL, R_ARM_REL32)
NEVERD_ELF_GOT_REFERENCE(AArch64, R_AARCH64_ADR_GOT_PAGE,
                         R_AARCH64_ADR_PREL_PG_HI21)
NEVERD_ELF_GOT_REFERENCE(AArch64, R_AARCH64_LD64_GOT_LO12_NC,
                         R_AARCH64_LDST64_ABS_LO12_NC)
#undef NEVERD_ELF_GOT_REFERENCE

// NEVERD_ELF_BRANCH_REFERENCE(Arch, Type): the relocation of a call or branch
// instruction, so an undefined symbol it names is a function.  Only one in
// executable code counts: i386 has no PC-relative data addressing in code,
// but its data sections hold R_386_PC32 displacements.
#ifndef NEVERD_ELF_BRANCH_REFERENCE
#define NEVERD_ELF_BRANCH_REFERENCE(Arch, Type)
#endif
NEVERD_ELF_BRANCH_REFERENCE(X86, R_386_PC32)
NEVERD_ELF_BRANCH_REFERENCE(X86, R_386_PLT32)
NEVERD_ELF_BRANCH_REFERENCE(X64, R_X86_64_PLT32)
NEVERD_ELF_BRANCH_REFERENCE(ARM, R_ARM_CALL)
NEVERD_ELF_BRANCH_REFERENCE(ARM, R_ARM_JUMP24)
NEVERD_ELF_BRANCH_REFERENCE(ARM, R_ARM_PLT32)
NEVERD_ELF_BRANCH_REFERENCE(ARM, R_ARM_THM_CALL)
NEVERD_ELF_BRANCH_REFERENCE(ARM, R_ARM_THM_JUMP24)
NEVERD_ELF_BRANCH_REFERENCE(ARM, R_ARM_THM_JUMP19)
NEVERD_ELF_BRANCH_REFERENCE(AArch64, R_AARCH64_CALL26)
NEVERD_ELF_BRANCH_REFERENCE(AArch64, R_AARCH64_JUMP26)
NEVERD_ELF_BRANCH_REFERENCE(AArch64, R_AARCH64_CONDBR19)
NEVERD_ELF_BRANCH_REFERENCE(AArch64, R_AARCH64_TSTBR14)
#undef NEVERD_ELF_BRANCH_REFERENCE
