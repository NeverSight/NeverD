//===- ELFObjectRelocationWriters.def - Bytes ELF relocs write --*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The bytes each relocation type writes in a relocatable ELF object, per
/// architecture.  Types are llvm::ELF relocation enumerators.  A type missing
/// from its architecture's list withdraws the object's complete write
/// footprint, so an omission can suppress a proof but never manufacture one.
///
//===----------------------------------------------------------------------===//

// NEVERD_ELF_OBJECT_RELOCATION_WRITER(Arch, Type, OffsetBias, Width): the
// record writes [r_offset + OffsetBias, r_offset + OffsetBias + Width).
#ifndef NEVERD_ELF_OBJECT_RELOCATION_WRITER
#define NEVERD_ELF_OBJECT_RELOCATION_WRITER(Arch, Type, OffsetBias, Width)
#endif

NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_NONE, 0, 0)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_8, 0, 1)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_PC8, 0, 1)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_16, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_PC16, 0, 2)
// The record names the first word of the two-word TLS descriptor, but the
// linker's value write lands in the second word.
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_TLS_DESC, 4, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_PC32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_GOT32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_PLT32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_GLOB_DAT, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_JUMP_SLOT, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_RELATIVE, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_GOTOFF, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_GOTPC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_32PLT, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X86, R_386_GOT32X, 0, 4)

// x86-64 writes the field the record names.  The TLS forms a linker relaxes
// rewrite the instructions around them as well, so they are left out and
// withdraw the footprint.
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_NONE, 0, 0)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_8, 0, 1)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_PC8, 0, 1)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_16, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_PC16, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_32S, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_PC32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_PLT32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_GOT32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_GOTPCREL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_GOTPCRELX, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_REX_GOTPCRELX, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_GOTPC32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_SIZE32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_64, 0, 8)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_PC64, 0, 8)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_GOTOFF64, 0, 8)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(X64, R_X86_64_SIZE64, 0, 8)

NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_NONE, 0, 0)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_ABS64, 0, 8)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_PREL64, 0, 8)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_ABS16, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_PREL16, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_ABS32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_PREL32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_CALL26, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_JUMP26, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_ADR_PREL_PG_HI21, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_ADR_PREL_PG_HI21_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_ADR_GOT_PAGE, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_LD64_GOT_LO12_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_ADD_ABS_LO12_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_LDST64_ABS_LO12_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_LDST128_ABS_LO12_NC, 0,
                                    4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_LDST32_ABS_LO12_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_LDST16_ABS_LO12_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(AArch64, R_AARCH64_LDST8_ABS_LO12_NC, 0, 4)

// Thumb's 16-bit branches and the narrow data fields write less than a word;
// every A32 instruction, Thumb-2 instruction and data word writes four bytes.
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_NONE, 0, 0)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_ABS8, 0, 1)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_ABS16, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_JUMP11, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_JUMP8, 0, 2)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_PC24, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_ABS32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_REL32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_CALL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_GOTOFF32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_BASE_PREL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_GOT_BREL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_CALL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_JUMP24, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_JUMP24, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_TARGET1, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_V4BX, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_TARGET2, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_PREL31, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_MOVW_ABS_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_MOVT_ABS, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_MOVW_PREL_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_MOVT_PREL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_MOVW_ABS_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_MOVT_ABS, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_MOVW_PREL_NC, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_MOVT_PREL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_THM_JUMP19, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_GOT_PREL, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_TLS_GD32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_TLS_LDM32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_TLS_LDO32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_TLS_IE32, 0, 4)
NEVERD_ELF_OBJECT_RELOCATION_WRITER(ARM, R_ARM_TLS_LE32, 0, 4)

#undef NEVERD_ELF_OBJECT_RELOCATION_WRITER
