//===- ELFDynamicRelocations.def - Roles of ELF dynamic relocs --*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The dynamic relocations whose role the loader records, per architecture.
/// Types are llvm::ELF relocation enumerators.
///
//===----------------------------------------------------------------------===//

// NEVERD_ELF_IRELATIVE(Arch, Type): GNU indirect function relocations; the
// addend, or the slot under REL, names the resolver the dynamic linker calls.
#ifndef NEVERD_ELF_IRELATIVE
#define NEVERD_ELF_IRELATIVE(Arch, Type)
#endif
NEVERD_ELF_IRELATIVE(X86, R_386_IRELATIVE)
NEVERD_ELF_IRELATIVE(X64, R_X86_64_IRELATIVE)
NEVERD_ELF_IRELATIVE(ARM, R_ARM_IRELATIVE)
NEVERD_ELF_IRELATIVE(AArch64, R_AARCH64_IRELATIVE)
NEVERD_ELF_IRELATIVE(RISCV32, R_RISCV_IRELATIVE)
NEVERD_ELF_IRELATIVE(RISCV64, R_RISCV_IRELATIVE)
NEVERD_ELF_IRELATIVE(PPC32, R_PPC_IRELATIVE)
NEVERD_ELF_IRELATIVE(PPC32LE, R_PPC_IRELATIVE)
NEVERD_ELF_IRELATIVE(PPC64, R_PPC64_IRELATIVE)
NEVERD_ELF_IRELATIVE(PPC64LE, R_PPC64_IRELATIVE)
NEVERD_ELF_IRELATIVE(PPC64ELFv1, R_PPC64_IRELATIVE)
NEVERD_ELF_IRELATIVE(PPC64LEELFv1, R_PPC64_IRELATIVE)
#undef NEVERD_ELF_IRELATIVE

// NEVERD_ELF_SLOT_BINDING(Arch, Type): relocations that store a symbol's
// address in a GOT slot the dynamic linker binds.
#ifndef NEVERD_ELF_SLOT_BINDING
#define NEVERD_ELF_SLOT_BINDING(Arch, Type)
#endif
NEVERD_ELF_SLOT_BINDING(X86, R_386_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(X86, R_386_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(X64, R_X86_64_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(X64, R_X86_64_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(ARM, R_ARM_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(ARM, R_ARM_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(AArch64, R_AARCH64_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(AArch64, R_AARCH64_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS32, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS32EL, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS64, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS64EL, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS64N32, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS64N32EL, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS64O32, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS64O32EL, R_MIPS_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(MIPS32, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(MIPS32EL, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(MIPS64, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(MIPS64EL, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(MIPS64N32, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(MIPS64N32EL, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(MIPS64O32, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(MIPS64O32EL, R_MIPS_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(RISCV32, R_RISCV_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(RISCV64, R_RISCV_JUMP_SLOT)
NEVERD_ELF_SLOT_BINDING(PPC32, R_PPC_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(PPC32LE, R_PPC_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(PPC64, R_PPC64_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(PPC64LE, R_PPC64_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(PPC64ELFv1, R_PPC64_GLOB_DAT)
NEVERD_ELF_SLOT_BINDING(PPC64LEELFv1, R_PPC64_GLOB_DAT)
// ELFv2 jump slots hold code pointers. A classic PPC32 BSS-PLT slot can
// instead be rewritten as an instruction.
NEVERD_ELF_SLOT_BINDING(PPC64, R_PPC64_JMP_SLOT)
NEVERD_ELF_SLOT_BINDING(PPC64LE, R_PPC64_JMP_SLOT)
#undef NEVERD_ELF_SLOT_BINDING

// Halfword fields written by the PPC32 dynamic linker in either byte order.
#ifdef NEVERD_PPC32_HALFWORD_WRITE
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_ADDR16)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_ADDR16_LO)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_ADDR16_HI)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_ADDR16_HA)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_UADDR16)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_TPREL16)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_TPREL16_LO)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_TPREL16_HI)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_TPREL16_HA)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_DTPREL16)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_DTPREL16_LO)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_DTPREL16_HI)
NEVERD_PPC32_HALFWORD_WRITE(R_PPC_DTPREL16_HA)
#undef NEVERD_PPC32_HALFWORD_WRITE
#endif

// NEVERD_ELF_TLS_DESCRIPTOR(Arch, Type): TLS descriptor relocations; the
// dynamic linker writes the descriptor's first word with the resolver that
// code calls through it (`call *(%rax)`, `blr x1`).
#ifndef NEVERD_ELF_TLS_DESCRIPTOR
#define NEVERD_ELF_TLS_DESCRIPTOR(Arch, Type)
#endif
NEVERD_ELF_TLS_DESCRIPTOR(X86, R_386_TLS_DESC)
NEVERD_ELF_TLS_DESCRIPTOR(X64, R_X86_64_TLSDESC)
NEVERD_ELF_TLS_DESCRIPTOR(ARM, R_ARM_TLS_DESC)
NEVERD_ELF_TLS_DESCRIPTOR(AArch64, R_AARCH64_TLSDESC)
#undef NEVERD_ELF_TLS_DESCRIPTOR

// NEVERD_ELF_SYMBOL_VALUE(Arch, Type, Addend): relocations the dynamic linker
// resolves to their symbol's address, plus the addend when Addend is true.  A
// slot bound to a function or object the file defines holds that address,
// unless another module interposes a definition; a GNU indirect function's
// slot holds what its resolver returns.
#ifndef NEVERD_ELF_SYMBOL_VALUE
#define NEVERD_ELF_SYMBOL_VALUE(Arch, Type, Addend)
#endif
NEVERD_ELF_SYMBOL_VALUE(X86, R_386_GLOB_DAT, false)
NEVERD_ELF_SYMBOL_VALUE(X86, R_386_JUMP_SLOT, false)
NEVERD_ELF_SYMBOL_VALUE(X86, R_386_32, true)
NEVERD_ELF_SYMBOL_VALUE(X64, R_X86_64_GLOB_DAT, false)
NEVERD_ELF_SYMBOL_VALUE(X64, R_X86_64_JUMP_SLOT, false)
NEVERD_ELF_SYMBOL_VALUE(X64, R_X86_64_64, true)
NEVERD_ELF_SYMBOL_VALUE(ARM, R_ARM_GLOB_DAT, false)
NEVERD_ELF_SYMBOL_VALUE(ARM, R_ARM_JUMP_SLOT, false)
NEVERD_ELF_SYMBOL_VALUE(ARM, R_ARM_ABS32, true)
NEVERD_ELF_SYMBOL_VALUE(AArch64, R_AARCH64_GLOB_DAT, true)
NEVERD_ELF_SYMBOL_VALUE(AArch64, R_AARCH64_JUMP_SLOT, true)
NEVERD_ELF_SYMBOL_VALUE(AArch64, R_AARCH64_ABS64, true)
NEVERD_ELF_SYMBOL_VALUE(RISCV32, R_RISCV_JUMP_SLOT, false)
NEVERD_ELF_SYMBOL_VALUE(RISCV64, R_RISCV_JUMP_SLOT, false)
NEVERD_ELF_SYMBOL_VALUE(RISCV32, R_RISCV_32, true)
NEVERD_ELF_SYMBOL_VALUE(RISCV64, R_RISCV_64, true)
NEVERD_ELF_SYMBOL_VALUE(PPC32, R_PPC_ADDR32, true)
NEVERD_ELF_SYMBOL_VALUE(PPC32LE, R_PPC_ADDR32, true)
NEVERD_ELF_SYMBOL_VALUE(PPC64, R_PPC64_ADDR64, true)
NEVERD_ELF_SYMBOL_VALUE(PPC64LE, R_PPC64_ADDR64, true)
NEVERD_ELF_SYMBOL_VALUE(PPC64ELFv1, R_PPC64_ADDR64, true)
NEVERD_ELF_SYMBOL_VALUE(PPC64LEELFv1, R_PPC64_ADDR64, true)
#undef NEVERD_ELF_SYMBOL_VALUE

// NEVERD_ELF_ABSOLUTE_SYMBOL(Arch, Type): relocations that store a symbol's
// address plus the addend in an ordinary data word, such as the initializer of
// a pointer variable, which the program may later overwrite.
#ifndef NEVERD_ELF_ABSOLUTE_SYMBOL
#define NEVERD_ELF_ABSOLUTE_SYMBOL(Arch, Type)
#endif
NEVERD_ELF_ABSOLUTE_SYMBOL(X86, R_386_32)
NEVERD_ELF_ABSOLUTE_SYMBOL(X64, R_X86_64_64)
NEVERD_ELF_ABSOLUTE_SYMBOL(ARM, R_ARM_ABS32)
NEVERD_ELF_ABSOLUTE_SYMBOL(AArch64, R_AARCH64_ABS64)
NEVERD_ELF_ABSOLUTE_SYMBOL(RISCV32, R_RISCV_32)
NEVERD_ELF_ABSOLUTE_SYMBOL(RISCV64, R_RISCV_64)
NEVERD_ELF_ABSOLUTE_SYMBOL(PPC32, R_PPC_ADDR32)
NEVERD_ELF_ABSOLUTE_SYMBOL(PPC32LE, R_PPC_ADDR32)
NEVERD_ELF_ABSOLUTE_SYMBOL(PPC64, R_PPC64_ADDR64)
NEVERD_ELF_ABSOLUTE_SYMBOL(PPC64LE, R_PPC64_ADDR64)
NEVERD_ELF_ABSOLUTE_SYMBOL(PPC64ELFv1, R_PPC64_ADDR64)
NEVERD_ELF_ABSOLUTE_SYMBOL(PPC64LEELFv1, R_PPC64_ADDR64)
#undef NEVERD_ELF_ABSOLUTE_SYMBOL

// Ordinary symbol-address cells, distinct from PLT calls and TLS descriptors.
#ifndef NEVERD_ELF_DATA_SLOT
#define NEVERD_ELF_DATA_SLOT(Arch, Type)
#endif
NEVERD_ELF_DATA_SLOT(X86, R_386_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(X64, R_X86_64_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(ARM, R_ARM_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(AArch64, R_AARCH64_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(PPC32, R_PPC_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(PPC32LE, R_PPC_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(PPC64, R_PPC64_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(PPC64LE, R_PPC64_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(PPC64ELFv1, R_PPC64_GLOB_DAT)
NEVERD_ELF_DATA_SLOT(PPC64LEELFv1, R_PPC64_GLOB_DAT)
#undef NEVERD_ELF_DATA_SLOT

#ifndef NEVERD_ELF_COPY_OBJECT
#define NEVERD_ELF_COPY_OBJECT(Arch, Type)
#endif
NEVERD_ELF_COPY_OBJECT(MIPS32, R_MIPS_COPY)
NEVERD_ELF_COPY_OBJECT(MIPS32EL, R_MIPS_COPY)
NEVERD_ELF_COPY_OBJECT(MIPS64, R_MIPS_COPY)
NEVERD_ELF_COPY_OBJECT(MIPS64EL, R_MIPS_COPY)
NEVERD_ELF_COPY_OBJECT(MIPS64N32, R_MIPS_COPY)
NEVERD_ELF_COPY_OBJECT(MIPS64N32EL, R_MIPS_COPY)
NEVERD_ELF_COPY_OBJECT(MIPS64O32, R_MIPS_COPY)
NEVERD_ELF_COPY_OBJECT(MIPS64O32EL, R_MIPS_COPY)
#undef NEVERD_ELF_COPY_OBJECT
