//===- DyldCacheImage.def - Cache image analysis projection -------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Command classes and diagnostics for packing a cached image's referenced
/// file ranges. EMPTY retains commands with no file offsets; LINKEDIT names
/// linkedit_data_command payloads. LLVM owns the Mach-O structure layouts.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_CACHE_IMAGE_EMPTY
#define NEVERD_CACHE_IMAGE_EMPTY(Command)
#endif
#ifndef NEVERD_CACHE_IMAGE_LINKEDIT
#define NEVERD_CACHE_IMAGE_LINKEDIT(Command)
#endif
#ifndef NEVERD_CACHE_IMAGE_TEXT
#define NEVERD_CACHE_IMAGE_TEXT(Name, Text)
#endif

NEVERD_CACHE_IMAGE_EMPTY(LC_LOAD_DYLIB)
NEVERD_CACHE_IMAGE_EMPTY(LC_ID_DYLIB)
NEVERD_CACHE_IMAGE_EMPTY(LC_LOAD_WEAK_DYLIB)
NEVERD_CACHE_IMAGE_EMPTY(LC_REEXPORT_DYLIB)
NEVERD_CACHE_IMAGE_EMPTY(LC_LAZY_LOAD_DYLIB)
NEVERD_CACHE_IMAGE_EMPTY(LC_LOAD_UPWARD_DYLIB)
NEVERD_CACHE_IMAGE_EMPTY(LC_LOAD_DYLINKER)
NEVERD_CACHE_IMAGE_EMPTY(LC_ID_DYLINKER)
NEVERD_CACHE_IMAGE_EMPTY(LC_DYLD_ENVIRONMENT)
NEVERD_CACHE_IMAGE_EMPTY(LC_SUB_FRAMEWORK)
NEVERD_CACHE_IMAGE_EMPTY(LC_SUB_UMBRELLA)
NEVERD_CACHE_IMAGE_EMPTY(LC_SUB_CLIENT)
NEVERD_CACHE_IMAGE_EMPTY(LC_SUB_LIBRARY)
NEVERD_CACHE_IMAGE_EMPTY(LC_ROUTINES_64)
NEVERD_CACHE_IMAGE_EMPTY(LC_UUID)
NEVERD_CACHE_IMAGE_EMPTY(LC_RPATH)
NEVERD_CACHE_IMAGE_EMPTY(LC_VERSION_MIN_MACOSX)
NEVERD_CACHE_IMAGE_EMPTY(LC_VERSION_MIN_IPHONEOS)
NEVERD_CACHE_IMAGE_EMPTY(LC_VERSION_MIN_TVOS)
NEVERD_CACHE_IMAGE_EMPTY(LC_VERSION_MIN_WATCHOS)
NEVERD_CACHE_IMAGE_EMPTY(LC_BUILD_VERSION)
NEVERD_CACHE_IMAGE_EMPTY(LC_SOURCE_VERSION)
NEVERD_CACHE_IMAGE_EMPTY(LC_LINKER_OPTION)
NEVERD_CACHE_IMAGE_EMPTY(LC_THREAD)
NEVERD_CACHE_IMAGE_EMPTY(LC_UNIXTHREAD)

NEVERD_CACHE_IMAGE_LINKEDIT(LC_CODE_SIGNATURE)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_SEGMENT_SPLIT_INFO)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_FUNCTION_STARTS)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_DATA_IN_CODE)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_DYLIB_CODE_SIGN_DRS)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_LINKER_OPTIMIZATION_HINT)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_DYLD_EXPORTS_TRIE)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_DYLD_CHAINED_FIXUPS)
NEVERD_CACHE_IMAGE_LINKEDIT(LC_ATOM_INFO)

NEVERD_CACHE_IMAGE_TEXT(kProjectionMalformed,
                        "dyld cache: invalid image analysis projection")
NEVERD_CACHE_IMAGE_TEXT(
    kProjectionLimit,
    "dyld cache: image analysis projection exceeds its budget")
NEVERD_CACHE_IMAGE_TEXT(
    kProjectionCommand,
    "dyld cache: unsupported image command in analysis projection")
NEVERD_CACHE_IMAGE_TEXT(kProjectionEncrypted,
                        "dyld cache: encrypted image content is unavailable")

#undef NEVERD_CACHE_IMAGE_EMPTY
#undef NEVERD_CACHE_IMAGE_LINKEDIT
#undef NEVERD_CACHE_IMAGE_TEXT
