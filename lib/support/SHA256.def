//===- SHA256.def - SHA-256 constants ---------------------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The constants of SHA-256 (FIPS 180-4) and of the code that computes it
/// with the x86 and ARM64 SHA extensions. Define the macros a consumer reads
/// before including this file; the others expand to nothing.
///
///   NEVERD_SHA256_INITIAL_STATE(Value)       a word of the initial hash value
///   NEVERD_SHA256_ROUND_CONSTANT(Value)      a round constant, in round order
///   NEVERD_SHA256_SIZE(Name, Value)          a size in bytes
///   NEVERD_SHA256_BYTE(Name, Value)          a byte the padding writes
///   NEVERD_SHA256_LANES(Name, Value)         an SSE lane-selection immediate
///   NEVERD_SHA256_X86_FEATURE(Name, Leaf, Subleaf, Register, Bit)
///       an x86 compiler feature and its CPUID admission bit
///   NEVERD_SHA256_X86_FIRST_FEATURE(...)     first entry, for joining names;
///                                            defaults to X86_FEATURE
///   NEVERD_SHA256_ARM_FEATURES(Features, Target) LLVM features and compiler
///                                               target for ARM64 compression
///   NEVERD_SHA256_DARWIN_FEATURE(Name)          Darwin SHA-256 capability key
///   NEVERD_SHA256_LINUX_FEATURES(Features)       required Linux HWCAP flags
///   NEVERD_SHA256_WINDOWS_FEATURE(Feature)      Windows ARM64 capability
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_SHA256_INITIAL_STATE
#define NEVERD_SHA256_INITIAL_STATE(Value)
#endif
#ifndef NEVERD_SHA256_ROUND_CONSTANT
#define NEVERD_SHA256_ROUND_CONSTANT(Value)
#endif
#ifndef NEVERD_SHA256_SIZE
#define NEVERD_SHA256_SIZE(Name, Value)
#endif
#ifndef NEVERD_SHA256_BYTE
#define NEVERD_SHA256_BYTE(Name, Value)
#endif
#ifndef NEVERD_SHA256_LANES
#define NEVERD_SHA256_LANES(Name, Value)
#endif
#ifndef NEVERD_SHA256_X86_FEATURE
#define NEVERD_SHA256_X86_FEATURE(Name, Leaf, Subleaf, Register, Bit)
#endif
#ifndef NEVERD_SHA256_X86_FIRST_FEATURE
#define NEVERD_SHA256_X86_FIRST_FEATURE(Name, Leaf, Subleaf, Register, Bit)    \
  NEVERD_SHA256_X86_FEATURE(Name, Leaf, Subleaf, Register, Bit)
#endif
#ifndef NEVERD_SHA256_ARM_FEATURES
#define NEVERD_SHA256_ARM_FEATURES(Features, Target)
#endif
#ifndef NEVERD_SHA256_DARWIN_FEATURE
#define NEVERD_SHA256_DARWIN_FEATURE(Name)
#endif
#ifndef NEVERD_SHA256_LINUX_FEATURES
#define NEVERD_SHA256_LINUX_FEATURES(Features)
#endif
#ifndef NEVERD_SHA256_WINDOWS_FEATURE
#define NEVERD_SHA256_WINDOWS_FEATURE(Feature)
#endif

// FIPS 180-4, 5.3.3: the initial hash value H(0), words A to H.
NEVERD_SHA256_INITIAL_STATE(0x6A09E667)
NEVERD_SHA256_INITIAL_STATE(0xBB67AE85)
NEVERD_SHA256_INITIAL_STATE(0x3C6EF372)
NEVERD_SHA256_INITIAL_STATE(0xA54FF53A)
NEVERD_SHA256_INITIAL_STATE(0x510E527F)
NEVERD_SHA256_INITIAL_STATE(0x9B05688C)
NEVERD_SHA256_INITIAL_STATE(0x1F83D9AB)
NEVERD_SHA256_INITIAL_STATE(0x5BE0CD19)

// FIPS 180-4, 4.2.2: the round constants K, one per round.
NEVERD_SHA256_ROUND_CONSTANT(0x428A2F98)
NEVERD_SHA256_ROUND_CONSTANT(0x71374491)
NEVERD_SHA256_ROUND_CONSTANT(0xB5C0FBCF)
NEVERD_SHA256_ROUND_CONSTANT(0xE9B5DBA5)
NEVERD_SHA256_ROUND_CONSTANT(0x3956C25B)
NEVERD_SHA256_ROUND_CONSTANT(0x59F111F1)
NEVERD_SHA256_ROUND_CONSTANT(0x923F82A4)
NEVERD_SHA256_ROUND_CONSTANT(0xAB1C5ED5)
NEVERD_SHA256_ROUND_CONSTANT(0xD807AA98)
NEVERD_SHA256_ROUND_CONSTANT(0x12835B01)
NEVERD_SHA256_ROUND_CONSTANT(0x243185BE)
NEVERD_SHA256_ROUND_CONSTANT(0x550C7DC3)
NEVERD_SHA256_ROUND_CONSTANT(0x72BE5D74)
NEVERD_SHA256_ROUND_CONSTANT(0x80DEB1FE)
NEVERD_SHA256_ROUND_CONSTANT(0x9BDC06A7)
NEVERD_SHA256_ROUND_CONSTANT(0xC19BF174)
NEVERD_SHA256_ROUND_CONSTANT(0xE49B69C1)
NEVERD_SHA256_ROUND_CONSTANT(0xEFBE4786)
NEVERD_SHA256_ROUND_CONSTANT(0x0FC19DC6)
NEVERD_SHA256_ROUND_CONSTANT(0x240CA1CC)
NEVERD_SHA256_ROUND_CONSTANT(0x2DE92C6F)
NEVERD_SHA256_ROUND_CONSTANT(0x4A7484AA)
NEVERD_SHA256_ROUND_CONSTANT(0x5CB0A9DC)
NEVERD_SHA256_ROUND_CONSTANT(0x76F988DA)
NEVERD_SHA256_ROUND_CONSTANT(0x983E5152)
NEVERD_SHA256_ROUND_CONSTANT(0xA831C66D)
NEVERD_SHA256_ROUND_CONSTANT(0xB00327C8)
NEVERD_SHA256_ROUND_CONSTANT(0xBF597FC7)
NEVERD_SHA256_ROUND_CONSTANT(0xC6E00BF3)
NEVERD_SHA256_ROUND_CONSTANT(0xD5A79147)
NEVERD_SHA256_ROUND_CONSTANT(0x06CA6351)
NEVERD_SHA256_ROUND_CONSTANT(0x14292967)
NEVERD_SHA256_ROUND_CONSTANT(0x27B70A85)
NEVERD_SHA256_ROUND_CONSTANT(0x2E1B2138)
NEVERD_SHA256_ROUND_CONSTANT(0x4D2C6DFC)
NEVERD_SHA256_ROUND_CONSTANT(0x53380D13)
NEVERD_SHA256_ROUND_CONSTANT(0x650A7354)
NEVERD_SHA256_ROUND_CONSTANT(0x766A0ABB)
NEVERD_SHA256_ROUND_CONSTANT(0x81C2C92E)
NEVERD_SHA256_ROUND_CONSTANT(0x92722C85)
NEVERD_SHA256_ROUND_CONSTANT(0xA2BFE8A1)
NEVERD_SHA256_ROUND_CONSTANT(0xA81A664B)
NEVERD_SHA256_ROUND_CONSTANT(0xC24B8B70)
NEVERD_SHA256_ROUND_CONSTANT(0xC76C51A3)
NEVERD_SHA256_ROUND_CONSTANT(0xD192E819)
NEVERD_SHA256_ROUND_CONSTANT(0xD6990624)
NEVERD_SHA256_ROUND_CONSTANT(0xF40E3585)
NEVERD_SHA256_ROUND_CONSTANT(0x106AA070)
NEVERD_SHA256_ROUND_CONSTANT(0x19A4C116)
NEVERD_SHA256_ROUND_CONSTANT(0x1E376C08)
NEVERD_SHA256_ROUND_CONSTANT(0x2748774C)
NEVERD_SHA256_ROUND_CONSTANT(0x34B0BCB5)
NEVERD_SHA256_ROUND_CONSTANT(0x391C0CB3)
NEVERD_SHA256_ROUND_CONSTANT(0x4ED8AA4A)
NEVERD_SHA256_ROUND_CONSTANT(0x5B9CCA4F)
NEVERD_SHA256_ROUND_CONSTANT(0x682E6FF3)
NEVERD_SHA256_ROUND_CONSTANT(0x748F82EE)
NEVERD_SHA256_ROUND_CONSTANT(0x78A5636F)
NEVERD_SHA256_ROUND_CONSTANT(0x84C87814)
NEVERD_SHA256_ROUND_CONSTANT(0x8CC70208)
NEVERD_SHA256_ROUND_CONSTANT(0x90BEFFFA)
NEVERD_SHA256_ROUND_CONSTANT(0xA4506CEB)
NEVERD_SHA256_ROUND_CONSTANT(0xBEF9A3F7)
NEVERD_SHA256_ROUND_CONSTANT(0xC67178F2)

// FIPS 180-4, 5.1.1 and 5.2.1: the message is taken in 64-byte blocks, and
// padded to whole blocks by a one bit, zeros, and its length in bits as a
// 64-bit big-endian integer.
NEVERD_SHA256_SIZE(BlockBytes, 64)
NEVERD_SHA256_SIZE(RegisterBytes, 16)
NEVERD_SHA256_BYTE(MessageEnd, 0x80)

// The SHA extensions keep the state in two registers, as the words ABEF and
// CDGH (named from the high lane down); these immediates select the lanes
// that move the state between that and A to H.
NEVERD_SHA256_LANES(SwapWordPairs, _MM_SHUFFLE(2, 3, 0, 1)) // pshufd
NEVERD_SHA256_LANES(ReverseWords, _MM_SHUFFLE(0, 1, 2, 3))  // pshufd
NEVERD_SHA256_LANES(UpperWordsLow, _MM_SHUFFLE(0, 0, 3, 2)) // pshufd
NEVERD_SHA256_LANES(UpperHalf, 0xF0) // pblendw: 16-bit lanes 4 to 7

// The instructions compress() uses: the SHA extensions, pshufb (SSSE3), and
// pblendw (SSE4.1).  sha256() checks that the processor reports each one.
// CPUID.07H.00H:EBX[29], CPUID.01H:ECX[19,9]. The first entry also
// rejects CPUs without SHA before querying the older vector features.
NEVERD_SHA256_X86_FIRST_FEATURE("sha", 7, 0, EBX, 29)
NEVERD_SHA256_X86_FEATURE("sse4.1", 1, 0, ECX, 19)
NEVERD_SHA256_X86_FEATURE("ssse3", 1, 0, ECX, 9)

// SHA2 implies Advanced SIMD. Query the kernel's Linux HWCAP or Darwin sysctl
// capability or Windows's processor-feature query.
NEVERD_SHA256_ARM_FEATURES("sha2", "+sha2")
NEVERD_SHA256_DARWIN_FEATURE("hw.optional.arm.FEAT_SHA256")
NEVERD_SHA256_LINUX_FEATURES(HWCAP_ASIMD | HWCAP_SHA2)
NEVERD_SHA256_WINDOWS_FEATURE(PF_ARM_V8_CRYPTO_INSTRUCTIONS_AVAILABLE)

#undef NEVERD_SHA256_INITIAL_STATE
#undef NEVERD_SHA256_ROUND_CONSTANT
#undef NEVERD_SHA256_SIZE
#undef NEVERD_SHA256_BYTE
#undef NEVERD_SHA256_LANES
#undef NEVERD_SHA256_X86_FEATURE
#undef NEVERD_SHA256_X86_FIRST_FEATURE
#undef NEVERD_SHA256_ARM_FEATURES
#undef NEVERD_SHA256_DARWIN_FEATURE
#undef NEVERD_SHA256_LINUX_FEATURES
#undef NEVERD_SHA256_WINDOWS_FEATURE
