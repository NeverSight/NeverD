//===- MachOLayout.def - Reclaimable native command storage ---*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//

#ifndef MACHO_TOOL_ONLY_COMMAND
#define MACHO_TOOL_ONLY_COMMAND(Command)
#endif

// None participates in dyld execution. Reclaim only as many commands as the
// new segments and replacement signature need, preserving live loader tables.
MACHO_TOOL_ONLY_COMMAND(llvm::MachO::LC_SOURCE_VERSION)
MACHO_TOOL_ONLY_COMMAND(llvm::MachO::LC_DATA_IN_CODE)
MACHO_TOOL_ONLY_COMMAND(llvm::MachO::LC_FUNCTION_STARTS)

#undef MACHO_TOOL_ONLY_COMMAND
