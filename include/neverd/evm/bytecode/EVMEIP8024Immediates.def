//===- EVMEIP8024Immediates.def - EIP-8024 decode table -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard. Every possible immediate byte
// is classified exactly once for the single-depth and pair-depth encodings.
// The official fresh-fetch audit differentially executes go-ethereum's
// Amsterdam instruction handlers against these records.
//
//===----------------------------------------------------------------------===//

#ifndef EVM_EIP8024_SINGLE_VALID
#define EVM_EIP8024_SINGLE_VALID(ENCODED, DEPTH)
#endif
#ifndef EVM_EIP8024_SINGLE_INVALID
#define EVM_EIP8024_SINGLE_INVALID(ENCODED)
#endif
#ifndef EVM_EIP8024_PAIR_VALID
#define EVM_EIP8024_PAIR_VALID(ENCODED, FIRST, SECOND)
#endif
#ifndef EVM_EIP8024_PAIR_INVALID
#define EVM_EIP8024_PAIR_INVALID(ENCODED)
#endif

