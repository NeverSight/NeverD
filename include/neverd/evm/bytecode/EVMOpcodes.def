//===- EVMOpcodes.def - EVM opcode database -------------------*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard. It is the single source of
// truth for assigned legacy and named development-fork opcodes. Include it
// with EVM_OPCODE and optionally
// EVM_OPCODE_NAME_ALIAS defined to generate strongly typed declarations and
// metadata. Stack counts describe actual pop/push mutations; decoded
// instructions separately compute dynamic access requirements such as DUPN.
// PRIMARY_EFFECT, MEMORY_ACCESS, STATE_ACCESS, and CALL_VALUE_ACCESS are
// independent, strongly typed properties; keeping them on the same record makes
// omissions impossible when a new opcode is added.
//
// EVM_OPCODE(NAME, BYTE, STACK_POPS, STACK_PUSHES, IMMEDIATE_BYTES,
//            IMMEDIATE_KIND, CLASS, INTRODUCED, PRIMARY_EFFECT,
//            MEMORY_ACCESS, STATE_ACCESS, CALL_VALUE_ACCESS, TERMINATOR)
// EVM_OPCODE_NAME_ALIAS(OPCODE, ALIAS, FIRST_FORK, LAST_FORK_EXCLUSIVE)
//
//===----------------------------------------------------------------------===//

#ifndef EVM_OPCODE
#define EVM_OPCODE(NAME, BYTE, POPS, PUSHES, IMMEDIATE_BYTES, IMMEDIATE_KIND,  \
                   CLASS, INTRODUCED, EFFECT, MEMORY_ACCESS, STATE_ACCESS,     \
                   CALL_VALUE_ACCESS, TERMINATOR)
#endif

#ifndef EVM_OPCODE_NAME_ALIAS
#define EVM_OPCODE_NAME_ALIAS(OPCODE, ALIAS, FIRST_FORK, LAST_FORK_EXCLUSIVE)
#endif

