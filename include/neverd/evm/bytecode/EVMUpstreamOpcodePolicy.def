//===- EVMUpstreamOpcodePolicy.def - Upstream opcode policy ---*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard. It records naming differences
// and deliberately unsupported opcode constants found in go-ethereum. The
// drift audit fails on every upstream constant not covered here or by
// EVMOpcodes.def, forcing new protocol work through an explicit review.
//
//===----------------------------------------------------------------------===//

#ifndef EVM_UPSTREAM_OPCODE_ALIAS
#define EVM_UPSTREAM_OPCODE_ALIAS(NEVERD_NAME, UPSTREAM_NAME)
#endif

#ifndef EVM_UPSTREAM_OPCODE_EXCLUSION_KIND
#define EVM_UPSTREAM_OPCODE_EXCLUSION_KIND(ID, ALLOW_CANONICAL_BYTE,           \
                                           REQUIRE_INACTIVE, SUMMARY)
#endif

#ifndef EVM_UPSTREAM_OPCODE_IGNORE
#define EVM_UPSTREAM_OPCODE_IGNORE(NAME, BYTE, REASON)
#endif

EVM_UPSTREAM_OPCODE_EXCLUSION_KIND(
    HistoricalAlias, true, false,
    "an upstream compatibility spelling for a byte NeverD names canonically")
EVM_UPSTREAM_OPCODE_EXCLUSION_KIND(
    UnscheduledEOF, false, true,
    "an EOF proposal byte that must remain inactive in every audited table")

EVM_UPSTREAM_OPCODE_ALIAS(SHA3, KECCAK256)

// Historical spellings sharing PREVRANDAO's byte.
EVM_UPSTREAM_OPCODE_IGNORE(DIFFICULTY, 0x44, HistoricalAlias)
EVM_UPSTREAM_OPCODE_IGNORE(RANDOM, 0x44, HistoricalAlias)

// Unscheduled EOF proposal constants retained by go-ethereum. EOF is not part
// of any activated or selected development-fork instruction set.
EVM_UPSTREAM_OPCODE_IGNORE(DATALOAD, 0xd0, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(DATALOADN, 0xd1, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(DATASIZE, 0xd2, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(DATACOPY, 0xd3, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(RJUMP, 0xe0, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(RJUMPI, 0xe1, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(RJUMPV, 0xe2, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(CALLF, 0xe3, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(RETF, 0xe4, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(JUMPF, 0xe5, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(EOFCREATE, 0xec, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(RETURNCONTRACT, 0xee, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(RETURNDATALOAD, 0xf7, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(EXTCALL, 0xf8, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(EXTDELEGATECALL, 0xf9, UnscheduledEOF)
EVM_UPSTREAM_OPCODE_IGNORE(EXTSTATICCALL, 0xfb, UnscheduledEOF)

#undef EVM_UPSTREAM_OPCODE_IGNORE
#undef EVM_UPSTREAM_OPCODE_EXCLUSION_KIND
#undef EVM_UPSTREAM_OPCODE_ALIAS
