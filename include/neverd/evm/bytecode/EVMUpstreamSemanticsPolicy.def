//===- EVMUpstreamSemanticsPolicy.def - geth semantic policy -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard. It maps NeverD's canonical
// hardfork names to exported go-ethereum params.Rules fields and records the
// exceptional interpreter base stack prechecks that cannot be derived from
// EVM_OPCODE's mutation counts. Dynamic operation contracts live here; their
// exhaustive encoded-byte tables live in EVMEIP8024Immediates.def.
//
//===----------------------------------------------------------------------===//

#ifndef EVM_GETH_FORK_RULE
#define EVM_GETH_FORK_RULE(FORK, RULE)
#endif

#ifndef EVM_GETH_RULE_FIELD
#define EVM_GETH_RULE_FIELD(NAME, CATEGORY, EXPECTED_FORK)
#endif

#ifndef EVM_GETH_BASE_MIN_STACK
#define EVM_GETH_BASE_MIN_STACK(OPCODE, DEPTH)
#endif

#ifndef EVM_GETH_ACTIVE_WITHOUT_COST
#define EVM_GETH_ACTIVE_WITHOUT_COST(OPCODE, FORK)
#endif

#ifndef EVM_GETH_DYNAMIC_STACK_IMMEDIATE
#define EVM_GETH_DYNAMIC_STACK_IMMEDIATE(OPCODE, FAMILY, OPERATION_KIND,       \
                                         VALID_STACK_DELTA)
#endif

// Closed reflection inventory of params.Rules. A newly exported boolean can
// select a jump table even when upstream adds no opcode constant, so the live
// probe refuses any field not reviewed here.
EVM_GETH_RULE_FIELD(IsHomestead, MappedForkSelector, Homestead)
EVM_GETH_RULE_FIELD(IsEIP150, MappedForkSelector, TangerineWhistle)
EVM_GETH_RULE_FIELD(IsEIP155, NoOpcodeAllocation, Frontier)
EVM_GETH_RULE_FIELD(IsEIP158, MappedForkSelector, SpuriousDragon)
EVM_GETH_RULE_FIELD(IsEIP2929, NoOpcodeAllocation, Frontier)
EVM_GETH_RULE_FIELD(IsEIP4762, NoOpcodeAllocation, Frontier)
EVM_GETH_RULE_FIELD(IsByzantium, MappedForkSelector, Byzantium)
EVM_GETH_RULE_FIELD(IsConstantinople, MappedForkSelector, Constantinople)
EVM_GETH_RULE_FIELD(IsPetersburg, NoOpcodeAllocation, Frontier)
EVM_GETH_RULE_FIELD(IsIstanbul, MappedForkSelector, Istanbul)
EVM_GETH_RULE_FIELD(IsBerlin, MappedForkSelector, Berlin)
EVM_GETH_RULE_FIELD(IsLondon, MappedForkSelector, London)
EVM_GETH_RULE_FIELD(IsMerge, MappedForkSelector, Paris)
EVM_GETH_RULE_FIELD(IsShanghai, MappedForkSelector, Shanghai)
EVM_GETH_RULE_FIELD(IsCancun, MappedForkSelector, Cancun)
EVM_GETH_RULE_FIELD(IsPrague, MappedForkSelector, Pectra)
EVM_GETH_RULE_FIELD(IsOsaka, MappedForkSelector, Fusaka)
EVM_GETH_RULE_FIELD(IsAmsterdam, MappedForkSelector, Amsterdam)
EVM_GETH_RULE_FIELD(IsBogota, MappedForkSelector, Bogota)
EVM_GETH_RULE_FIELD(IsUBT, ExcludedSelectorExpectedError, Cancun)

EVM_GETH_FORK_RULE(Frontier, None)
EVM_GETH_FORK_RULE(Homestead, IsHomestead)
EVM_GETH_FORK_RULE(DaoFork, None)
EVM_GETH_FORK_RULE(TangerineWhistle, IsEIP150)
