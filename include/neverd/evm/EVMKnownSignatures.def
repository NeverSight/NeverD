                   "no specification declares these, but deployed contracts "
                   "spell them the same way often enough to be worth naming")

//===----------------------------------------------------------------------===//
// Solidity's own revert payloads
//===----------------------------------------------------------------------===//

EVM_LANGUAGE_REVERT(Message, "Error(string)")
EVM_LANGUAGE_REVERT(Panic, "Panic(uint256)")

// The argument of `Panic(uint256)`. A panic is the compiler reporting that one
// of the checks it inserted failed, so a recovered code says which check that
// was, and there is no other trace of it in the bytecode.
EVM_PANIC_CODE(Generic, 0x00, "generic",
               "a compiler-inserted check with no assigned code failed")
EVM_PANIC_CODE(Assert, 0x01, "assert", "an assert argument was false")
EVM_PANIC_CODE(ArithmeticOverflow, 0x11, "arithmetic-overflow",
               "an arithmetic result fell outside its type")
EVM_PANIC_CODE(DivideByZero, 0x12, "divide-by-zero",
               "a division or modulo had a zero divisor")
EVM_PANIC_CODE(EnumConversion, 0x21, "enum-conversion",
               "a value converted to an enumeration was out of range")
EVM_PANIC_CODE(StorageByteArrayEncoding, 0x22, "storage-byte-array-encoding",
               "a storage byte array was read with an invalid encoding")
EVM_PANIC_CODE(PopEmptyArray, 0x31, "pop-empty-array",
               "pop was called on an empty array")
EVM_PANIC_CODE(IndexOutOfBounds, 0x32, "index-out-of-bounds",
               "an array or fixed-size access was out of range")
EVM_PANIC_CODE(AllocationTooLarge, 0x41, "allocation-too-large",
               "too much memory was allocated, or an array grew too large")
EVM_PANIC_CODE(UninitializedFunctionPointer, 0x51,
               "uninitialized-function-pointer",
               "a zero-initialized internal function pointer was called")

