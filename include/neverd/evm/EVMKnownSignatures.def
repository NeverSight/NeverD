//===- EVMKnownSignatures.def - Well-known ABI signatures ------*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// EVM_SIGNATURE_KIND(ID, NAME, SUMMARY)
// EVM_KNOWN_STANDARD(ID, NAME, SUMMARY)
// EVM_KNOWN_FUNCTION(SIGNATURE, RETURNS, STANDARD)
// EVM_KNOWN_EVENT(SIGNATURE, STANDARD)
// EVM_KNOWN_ERROR(SIGNATURE, STANDARD)
// EVM_LANGUAGE_REVERT(ID, SIGNATURE)
// EVM_PANIC_CODE(ID, CODE, NAME, SUMMARY)
//
// The first names the three roles a signature can hold, which decide how much
// of its digest a program carries and where. The next four name the values a
// contract's ABI carries. The sixth names the two payloads the language
// reserves for itself, which are errors like any other except that recovery has
// to ask for them by role rather than by spelling; each therefore joins the
// error table from its own record. The last names the argument of the second of
// those two.
//
// SIGNATURE is the canonical ABI spelling, with no spaces and with every type
// in its full form. Selectors and topics are not written here: they are the
// Keccak-256 of the text, and Recovery derives them once on first use, the same
// way the Anchor dictionary derives its discriminators. A recovered selector
// that equals a derived one exhibits a preimage, so the match proves the
// signature rather than suggesting it. That is why only exact canonical
// spellings belong here; a typo produces a selector no contract will ever use,
// which EVMABITests detects by checking the published selectors of the entries
// most likely to be mistyped.
//
// RETURNS is the return list the owning standard declares, comma-separated and
// empty when it declares none. It is deliberately weaker evidence than the
// signature: an ABI selector covers the arguments only, so a contract may
// answer to a standard selector and return something else.
//
// Only a signature that is fixed by a specification, or that a widely deployed
// interface has made canonical, belongs here. This is a recognition aid, never
// an authority: a match names a selector, it never changes decoded semantics.
//
//===----------------------------------------------------------------------===//

#ifndef EVM_SIGNATURE_KIND
#define EVM_SIGNATURE_KIND(ID, NAME, SUMMARY)
#endif

#ifndef EVM_KNOWN_STANDARD
#define EVM_KNOWN_STANDARD(ID, NAME, SUMMARY)
#endif

#ifndef EVM_KNOWN_FUNCTION
#define EVM_KNOWN_FUNCTION(SIGNATURE, RETURNS, STANDARD)
#endif

#ifndef EVM_KNOWN_EVENT
#define EVM_KNOWN_EVENT(SIGNATURE, STANDARD)
#endif

#ifndef EVM_KNOWN_ERROR
#define EVM_KNOWN_ERROR(SIGNATURE, STANDARD)
#endif

#ifndef EVM_LANGUAGE_REVERT
#define EVM_LANGUAGE_REVERT(ID, SIGNATURE)
#endif

#ifndef EVM_PANIC_CODE
#define EVM_PANIC_CODE(ID, CODE, NAME, SUMMARY)
#endif

//===----------------------------------------------------------------------===//
// What role a signature holds
//
// The role decides how much of the digest a program carries: a call and a
// custom error carry the leading four bytes, and an event carries the whole
// thirty-two in its first topic.
//===----------------------------------------------------------------------===//

EVM_SIGNATURE_KIND(Function, "function",
                   "something a caller can invoke, selected by the leading "
                   "four bytes of its digest")
EVM_SIGNATURE_KIND(Event, "event",
                   "something the program logs, identified by the whole "
                   "digest in the log's first topic")
EVM_SIGNATURE_KIND(Error, "error",
                   "something a revert hands back, selected by the leading "
                   "four bytes of its digest")

