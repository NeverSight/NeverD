//===- EVMOpcodes.def - EVM legacy opcode database ------------*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard. It is the single source of
// truth for assigned legacy opcodes. Include it with EVM_OPCODE and optionally
// EVM_OPCODE_NAME_ALIAS defined to generate strongly typed declarations and
// metadata. Stack counts describe the complete stack contract of an opcode.
//
// EVM_OPCODE(NAME, BYTE, INPUTS, OUTPUTS, IMMEDIATE_BYTES, CLASS,
//            INTRODUCED, PRIMARY_EFFECT, TERMINATOR, VIEW, PURE)
// EVM_OPCODE_NAME_ALIAS(OPCODE, ALIAS, FIRST_FORK, LAST_FORK_EXCLUSIVE)
//
//===----------------------------------------------------------------------===//

#ifndef EVM_OPCODE
#define EVM_OPCODE(NAME, BYTE, INPUTS, OUTPUTS, IMMEDIATE_BYTES, CLASS,         \
                   INTRODUCED, EFFECT, TERMINATOR, VIEW, PURE)
#endif

#ifndef EVM_OPCODE_NAME_ALIAS
#define EVM_OPCODE_NAME_ALIAS(OPCODE, ALIAS, FIRST_FORK, LAST_FORK_EXCLUSIVE)
#endif

EVM_OPCODE(STOP, 0x00, 0, 0, 0, Control, Frontier, Halt, true, true, true)

