//===- ELFIntegerTargets.def - RISC-V and PowerPC ELF targets ---------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Native target identities, LLVM triple architectures and ELF spellings.
///
//===----------------------------------------------------------------------===//

NEVERD_ELF_INTEGER_TARGET(RISCV32, riscv32, "riscv32")
NEVERD_ELF_INTEGER_TARGET(RISCV64, riscv64, "riscv64")
NEVERD_ELF_INTEGER_TARGET(PPC32, ppc, "powerpc")
NEVERD_ELF_INTEGER_TARGET(PPC32LE, ppcle, "powerpcle")
NEVERD_ELF_INTEGER_TARGET(PPC64, ppc64, "powerpc64")
NEVERD_ELF_INTEGER_TARGET(PPC64LE, ppc64le, "powerpc64le")
// These ABI variants share their family's ELF machine and LLVM triple.
#ifndef NEVERD_ELF_INTEGER_ABI_TARGET
#define NEVERD_ELF_INTEGER_ABI_TARGET(Name, LLVMArch, Spelling, Suffix)        \
  NEVERD_ELF_INTEGER_TARGET(Name, LLVMArch, Spelling)
#endif
NEVERD_ELF_INTEGER_ABI_TARGET(PPC64ELFv1, ppc64, "powerpc64", "-elfv1")
NEVERD_ELF_INTEGER_ABI_TARGET(PPC64LEELFv1, ppc64le, "powerpc64le", "-elfv1")
NEVERD_ELF_INTEGER_ABI_TARGET(RISCV32D, riscv32, "riscv32", "-ilp32d")
NEVERD_ELF_INTEGER_ABI_TARGET(RISCV64D, riscv64, "riscv64", "-lp64d")
#undef NEVERD_ELF_INTEGER_ABI_TARGET
#undef NEVERD_ELF_INTEGER_TARGET
