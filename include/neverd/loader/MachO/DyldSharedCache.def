NEVERD_DYLD_CACHE_VALUE(uint32_t, kObjCLegacyV15, 15)
NEVERD_DYLD_CACHE_VALUE(uint32_t, kObjCLegacyV16, 16)
NEVERD_DYLD_CACHE_VALUE(size_t, kMappingBytes, 32)
NEVERD_DYLD_CACHE_VALUE(size_t, kLegacySlideMapping, 1)
NEVERD_DYLD_CACHE_VALUE(size_t, kSlideMappingBytes, 56)
NEVERD_DYLD_CACHE_VALUE(size_t, kMapAddress, 0)
NEVERD_DYLD_CACHE_VALUE(size_t, kMapSize, 8)
