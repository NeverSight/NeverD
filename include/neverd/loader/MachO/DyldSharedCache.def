NEVERD_DYLD_CACHE_VALUE(uint32_t, kSlideV2, 2)
NEVERD_DYLD_CACHE_VALUE(size_t, kV2HeaderBytes, 40)
NEVERD_DYLD_CACHE_VALUE(size_t, kV2StartsOffset, 8)
NEVERD_DYLD_CACHE_VALUE(size_t, kV2StartsCount, 12)
NEVERD_DYLD_CACHE_VALUE(size_t, kV2ExtrasOffset, 16)
NEVERD_DYLD_CACHE_VALUE(size_t, kV2ExtrasCount, 20)
NEVERD_DYLD_CACHE_VALUE(size_t, kV2DeltaMask, 24)
NEVERD_DYLD_CACHE_VALUE(size_t, kV2ValueAdd, 32)
NEVERD_DYLD_CACHE_VALUE(uint16_t, kV2NoRebase, 0x4000)
NEVERD_DYLD_CACHE_VALUE(uint16_t, kV2Extra, 0x8000)
NEVERD_DYLD_CACHE_VALUE(uint16_t, kV2End, 0x8000)
NEVERD_DYLD_CACHE_VALUE(uint16_t, kV2IndexMask, 0x3fff)
NEVERD_DYLD_CACHE_VALUE(unsigned, kV2Stride, 4)
NEVERD_DYLD_CACHE_VALUE(unsigned, kV2StrideLog2, 2)
