NEVERD_DYLD_CACHE_VALUE(unsigned, kChainStride, 8)
NEVERD_DYLD_CACHE_VALUE(unsigned, kDataKey, 2)
NEVERD_DYLD_CACHE_FIELD(kV3Unused, 62, 1)
NEVERD_DYLD_CACHE_FIELD(kV5Target, 0, 34)
NEVERD_DYLD_CACHE_FIELD(kV5High8, 34, 8)
NEVERD_DYLD_CACHE_FIELD(kV5Unused, 42, 10)
