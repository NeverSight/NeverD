NEVERD_DYLD_CACHE_FIELD(kV5Next, 52, 11)

NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxFiles, 256)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxMappings, 4096)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxImages, 65536)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxPathBytes, 4096)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxFixups, 1u << 24)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxSlidePages, 1u << 22)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxImageCommands, 65536)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxImageCommandBytes, 4u << 20)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxPreparedImageBytes, 512u << 20)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxImageSymbols, 1u << 24)
NEVERD_DYLD_CACHE_LIMIT(size_t, kMaxImageSymbolBytes, 1u << 20)
NEVERD_DYLD_CACHE_VALUE(unsigned, kMaxSectionAlignmentExponent, 31)

NEVERD_DYLD_CACHE_TEXT(kMalformedHeader, "dyld cache: malformed arm64e header")
NEVERD_DYLD_CACHE_TEXT(kMalformedMappings,
                       "dyld cache: invalid or overlapping mappings")
NEVERD_DYLD_CACHE_TEXT(kMalformedSubcaches,
                       "dyld cache: invalid subcache table, UUID or placement")
NEVERD_DYLD_CACHE_TEXT(kMalformedImages,
                       "dyld cache: invalid image address or path")
NEVERD_DYLD_CACHE_TEXT(kMalformedImageLayout,
                       "dyld cache: invalid cached Mach-O segment or section")
NEVERD_DYLD_CACHE_TEXT(
    kAmbiguousImageFileRange,
    "dyld cache: missing or ambiguous cached image file range")
NEVERD_DYLD_CACHE_TEXT(kMalformedSlides, "dyld cache: malformed slide chain")
NEVERD_DYLD_CACHE_TEXT(kUnsupportedSlides,
                       "dyld cache: unsupported arm64e slide version")
NEVERD_DYLD_CACHE_TEXT(kLimitExceeded,
                       "dyld cache: reader resource limit exceeded")
NEVERD_DYLD_CACHE_TEXT(kMissingFile, "dyld cache: cannot open ")
NEVERD_DYLD_CACHE_TEXT(kObjCLibraryPath, "/usr/lib/libobjc.A.dylib")
NEVERD_DYLD_CACHE_TEXT(kObjCLegacyOptSection, "__objc_opt_ro")
NEVERD_DYLD_CACHE_TEXT(
    kMalformedObjCOpts,
    "dyld cache: malformed Objective-C optimization metadata")
NEVERD_DYLD_CACHE_TEXT(
    kUnsupportedObjCOpts,
    "dyld cache: unsupported Objective-C optimization version")
NEVERD_DYLD_CACHE_TEXT(kLegacySuffix, ".{0}")
NEVERD_DYLD_CACHE_TEXT(kForbiddenSuffixBytes, "/\\")

#undef NEVERD_DYLD_CACHE_VALUE
#undef NEVERD_DYLD_CACHE_FIELD
#undef NEVERD_DYLD_CACHE_TEXT
#undef NEVERD_DYLD_CACHE_LIMIT
