//===- DyldSharedCache.def - Cache layout and reader contracts -*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// File offsets and field widths from Apple's dyld_cache_format.h and
/// fixup-chains.h. These describe serialized layouts, not host C structures.
/// VALUE defines typed constants, FIELD defines pointer bit fields, and TEXT
/// defines diagnostics. LIMIT owns this reader's resource ceilings.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_DYLD_CACHE_VALUE
#define NEVERD_DYLD_CACHE_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_DYLD_CACHE_FIELD
#define NEVERD_DYLD_CACHE_FIELD(Name, Low, Width)
#endif
#ifndef NEVERD_DYLD_CACHE_TEXT
#define NEVERD_DYLD_CACHE_TEXT(Name, Text)
#endif
#ifndef NEVERD_DYLD_CACHE_LIMIT
#define NEVERD_DYLD_CACHE_LIMIT(Type, Name, Value)
#endif

NEVERD_DYLD_CACHE_TEXT(kMagic, "dyld_v1  arm64e")
NEVERD_DYLD_CACHE_VALUE(size_t, kMagicBytes, 16)
NEVERD_DYLD_CACHE_VALUE(size_t, kUUIDBytes, 16)
NEVERD_DYLD_CACHE_VALUE(size_t, kMinimumHeaderBytes, 104)
NEVERD_DYLD_CACHE_VALUE(size_t, kMappingOffset, 16)
NEVERD_DYLD_CACHE_VALUE(size_t, kMappingCount, 20)
NEVERD_DYLD_CACHE_VALUE(size_t, kOldImagesOffset, 24)
NEVERD_DYLD_CACHE_VALUE(size_t, kOldImagesCount, 28)
NEVERD_DYLD_CACHE_VALUE(size_t, kOldSlideOffset, 56)
NEVERD_DYLD_CACHE_VALUE(size_t, kOldSlideSize, 64)
NEVERD_DYLD_CACHE_VALUE(size_t, kUUIDOffset, 88)
