NEVERD_DYLD_CACHE_VALUE(size_t, kMapSlideSize, 32)
NEVERD_DYLD_CACHE_VALUE(size_t, kMapFlags, 40)
NEVERD_DYLD_CACHE_VALUE(size_t, kSlideMapMaxProtection, 48)
NEVERD_DYLD_CACHE_VALUE(size_t, kSlideMapInitialProtection, 52)
NEVERD_DYLD_CACHE_VALUE(size_t, kOldSubcacheBytes, 24)
NEVERD_DYLD_CACHE_VALUE(size_t, kSubcacheBytes, 56)
NEVERD_DYLD_CACHE_VALUE(size_t, kSubcacheVMOffset, 16)
NEVERD_DYLD_CACHE_VALUE(size_t, kSubcacheSuffix, 24)
NEVERD_DYLD_CACHE_VALUE(size_t, kSubcacheSuffixBytes, 32)
