NEVERD_DYLD_CACHE_VALUE(size_t, kSubcacheCount, 396)
NEVERD_DYLD_CACHE_VALUE(size_t, kImagesOffset, 448)
NEVERD_DYLD_CACHE_VALUE(size_t, kImagesCount, 452)
NEVERD_DYLD_CACHE_VALUE(size_t, kCacheSubtype, 456)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCOptsOffset, 464)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCOptsSize, 472)
NEVERD_DYLD_CACHE_VALUE(uint32_t, kObjCOptsV1, 1)
NEVERD_DYLD_CACHE_VALUE(uint32_t, kObjCOptsV2, 2)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCOptsV1Bytes, 56)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCOptsV2Bytes, 72)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCSelectorBaseOffset, 48)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCHeaderInfoOffset, 8)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCLegacyHeaderInfoOffset, 12)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCHeaderInfoHeaderBytes, 8)
NEVERD_DYLD_CACHE_VALUE(size_t, kObjCHeaderInfoStrideOffset, 4)
