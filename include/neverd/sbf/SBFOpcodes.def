//===- SBFOpcodes.def - Versioned Solana SBF instruction set ----*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_OPCODE(NAME, ENCODING, MNEMONIC, OPERATION, OPERAND_FORM, WIDTH,
//            VERSION_MASK, EFFECT)
//
//===----------------------------------------------------------------------===//

#ifndef SBF_OPCODE
#define SBF_OPCODE(NAME, ENCODING, MNEMONIC, OPERATION, OPERAND_FORM, WIDTH,   \
                   VERSION_MASK, EFFECT)
#endif

// Immediate and legacy memory encodings (all versions except v2).
SBF_OPCODE(LDDW, 0x18, "lddw", LoadImm, LDDW, 64, NotV2, Pure)
SBF_OPCODE(LD_B_REG, 0x71, "ldxb", Load, Load, 8, NotV2, MemoryRead)
SBF_OPCODE(LD_H_REG, 0x69, "ldxh", Load, Load, 16, NotV2, MemoryRead)
SBF_OPCODE(LD_W_REG, 0x61, "ldxw", Load, Load, 32, NotV2, MemoryRead)
SBF_OPCODE(LD_DW_REG, 0x79, "ldxdw", Load, Load, 64, NotV2, MemoryRead)
SBF_OPCODE(ST_B_IMM, 0x72, "stb", Store, StoreImm, 8, NotV2, MemoryWrite)
SBF_OPCODE(ST_H_IMM, 0x6a, "sth", Store, StoreImm, 16, NotV2, MemoryWrite)
SBF_OPCODE(ST_W_IMM, 0x62, "stw", Store, StoreImm, 32, NotV2, MemoryWrite)
SBF_OPCODE(ST_DW_IMM, 0x7a, "stdw", Store, StoreImm, 64, NotV2, MemoryWrite)
SBF_OPCODE(ST_B_REG, 0x73, "stxb", Store, StoreReg, 8, NotV2, MemoryWrite)
SBF_OPCODE(ST_H_REG, 0x6b, "stxh", Store, StoreReg, 16, NotV2, MemoryWrite)
SBF_OPCODE(ST_W_REG, 0x63, "stxw", Store, StoreReg, 32, NotV2, MemoryWrite)
SBF_OPCODE(ST_DW_REG, 0x7b, "stxdw", Store, StoreReg, 64, NotV2, MemoryWrite)

// SIMD-0173 moved memory encodings (v2 exactly).
SBF_OPCODE(LD_1B_REG, 0x2c, "ldxb", Load, Load, 8, V2Only, MemoryRead)
SBF_OPCODE(LD_2B_REG, 0x3c, "ldxh", Load, Load, 16, V2Only, MemoryRead)
SBF_OPCODE(LD_4B_REG, 0x8c, "ldxw", Load, Load, 32, V2Only, MemoryRead)
SBF_OPCODE(LD_8B_REG, 0x9c, "ldxdw", Load, Load, 64, V2Only, MemoryRead)
SBF_OPCODE(ST_1B_IMM, 0x27, "stb", Store, StoreImm, 8, V2Only, MemoryWrite)
SBF_OPCODE(ST_2B_IMM, 0x37, "sth", Store, StoreImm, 16, V2Only, MemoryWrite)
SBF_OPCODE(ST_4B_IMM, 0x87, "stw", Store, StoreImm, 32, V2Only, MemoryWrite)
SBF_OPCODE(ST_8B_IMM, 0x97, "stdw", Store, StoreImm, 64, V2Only, MemoryWrite)
SBF_OPCODE(ST_1B_REG, 0x2f, "stxb", Store, StoreReg, 8, V2Only, MemoryWrite)
SBF_OPCODE(ST_2B_REG, 0x3f, "stxh", Store, StoreReg, 16, V2Only, MemoryWrite)
SBF_OPCODE(ST_4B_REG, 0x8f, "stxw", Store, StoreReg, 32, V2Only, MemoryWrite)
SBF_OPCODE(ST_8B_REG, 0x9f, "stxdw", Store, StoreReg, 64, V2Only, MemoryWrite)

// 32-bit ALU.
SBF_OPCODE(ADD32_IMM, 0x04, "add32", Add, DstImm, 32, All, Pure)
SBF_OPCODE(ADD32_REG, 0x0c, "add32", Add, DstSrc, 32, All, Pure)
SBF_OPCODE(SUB32_IMM, 0x14, "sub32", Sub, DstImm, 32, All, Pure)
SBF_OPCODE(SUB32_REG, 0x1c, "sub32", Sub, DstSrc, 32, All, Pure)
SBF_OPCODE(MUL32_IMM, 0x24, "mul32", Mul, DstImm, 32, NotV2, Pure)
SBF_OPCODE(MUL32_REG, 0x2c, "mul32", Mul, DstSrc, 32, NotV2, Pure)
SBF_OPCODE(DIV32_IMM, 0x34, "div32", UDiv, DstImm, 32, NotV2, MayFault)
SBF_OPCODE(DIV32_REG, 0x3c, "div32", UDiv, DstSrc, 32, NotV2, MayFault)
SBF_OPCODE(OR32_IMM, 0x44, "or32", Or, DstImm, 32, All, Pure)
SBF_OPCODE(OR32_REG, 0x4c, "or32", Or, DstSrc, 32, All, Pure)
SBF_OPCODE(AND32_IMM, 0x54, "and32", And, DstImm, 32, All, Pure)
SBF_OPCODE(AND32_REG, 0x5c, "and32", And, DstSrc, 32, All, Pure)
SBF_OPCODE(LSH32_IMM, 0x64, "lsh32", LSh, DstImm, 32, All, MayFault)
SBF_OPCODE(LSH32_REG, 0x6c, "lsh32", LSh, DstSrc, 32, All, Pure)
SBF_OPCODE(RSH32_IMM, 0x74, "rsh32", RSh, DstImm, 32, All, MayFault)
SBF_OPCODE(RSH32_REG, 0x7c, "rsh32", RSh, DstSrc, 32, All, Pure)
SBF_OPCODE(NEG32, 0x84, "neg32", Neg, Dst, 32, NotV2, Pure)
SBF_OPCODE(MOD32_IMM, 0x94, "mod32", URem, DstImm, 32, NotV2, MayFault)
SBF_OPCODE(MOD32_REG, 0x9c, "mod32", URem, DstSrc, 32, NotV2, MayFault)
SBF_OPCODE(XOR32_IMM, 0xa4, "xor32", Xor, DstImm, 32, All, Pure)
SBF_OPCODE(XOR32_REG, 0xac, "xor32", Xor, DstSrc, 32, All, Pure)
SBF_OPCODE(MOV32_IMM, 0xb4, "mov32", Mov, DstImm, 32, All, Pure)
SBF_OPCODE(MOV32_REG, 0xbc, "mov32", Mov, DstSrc, 32, All, Pure)
SBF_OPCODE(ARSH32_IMM, 0xc4, "arsh32", ARSh, DstImm, 32, All, MayFault)
SBF_OPCODE(ARSH32_REG, 0xcc, "arsh32", ARSh, DstSrc, 32, All, Pure)
SBF_OPCODE(LE, 0xd4, "le", EndianLE, Endian, 0, NotV2, Pure)
SBF_OPCODE(BE, 0xdc, "be", EndianBE, Endian, 0, All, Pure)

// 64-bit ALU.
SBF_OPCODE(ADD64_IMM, 0x07, "add64", Add, DstImm, 64, All, Pure)
SBF_OPCODE(ADD64_REG, 0x0f, "add64", Add, DstSrc, 64, All, Pure)
SBF_OPCODE(SUB64_IMM, 0x17, "sub64", Sub, DstImm, 64, All, Pure)
SBF_OPCODE(SUB64_REG, 0x1f, "sub64", Sub, DstSrc, 64, All, Pure)
SBF_OPCODE(MUL64_IMM, 0x27, "mul64", Mul, DstImm, 64, NotV2, Pure)
SBF_OPCODE(MUL64_REG, 0x2f, "mul64", Mul, DstSrc, 64, NotV2, Pure)
SBF_OPCODE(DIV64_IMM, 0x37, "div64", UDiv, DstImm, 64, NotV2, MayFault)
SBF_OPCODE(DIV64_REG, 0x3f, "div64", UDiv, DstSrc, 64, NotV2, MayFault)
SBF_OPCODE(OR64_IMM, 0x47, "or64", Or, DstImm, 64, All, Pure)
SBF_OPCODE(OR64_REG, 0x4f, "or64", Or, DstSrc, 64, All, Pure)
SBF_OPCODE(AND64_IMM, 0x57, "and64", And, DstImm, 64, All, Pure)
SBF_OPCODE(AND64_REG, 0x5f, "and64", And, DstSrc, 64, All, Pure)
SBF_OPCODE(LSH64_IMM, 0x67, "lsh64", LSh, DstImm, 64, All, MayFault)
SBF_OPCODE(LSH64_REG, 0x6f, "lsh64", LSh, DstSrc, 64, All, Pure)
SBF_OPCODE(RSH64_IMM, 0x77, "rsh64", RSh, DstImm, 64, All, MayFault)
SBF_OPCODE(RSH64_REG, 0x7f, "rsh64", RSh, DstSrc, 64, All, Pure)
SBF_OPCODE(NEG64, 0x87, "neg64", Neg, Dst, 64, NotV2, Pure)
SBF_OPCODE(MOD64_IMM, 0x97, "mod64", URem, DstImm, 64, NotV2, MayFault)
SBF_OPCODE(MOD64_REG, 0x9f, "mod64", URem, DstSrc, 64, NotV2, MayFault)
SBF_OPCODE(XOR64_IMM, 0xa7, "xor64", Xor, DstImm, 64, All, Pure)
SBF_OPCODE(XOR64_REG, 0xaf, "xor64", Xor, DstSrc, 64, All, Pure)
SBF_OPCODE(MOV64_IMM, 0xb7, "mov64", Mov, DstImm, 64, All, Pure)
SBF_OPCODE(MOV64_REG, 0xbf, "mov64", Mov, DstSrc, 64, All, Pure)
SBF_OPCODE(ARSH64_IMM, 0xc7, "arsh64", ARSh, DstImm, 64, All, MayFault)
SBF_OPCODE(ARSH64_REG, 0xcf, "arsh64", ARSh, DstSrc, 64, All, Pure)
SBF_OPCODE(HOR64_IMM, 0xf7, "hor64", HighOr, DstImm, 64, V2Only, Pure)

// SIMD-0174 product / quotient / remainder instructions (v2 exactly).
SBF_OPCODE(LMUL32_IMM, 0x86, "lmul32", Mul, DstImm, 32, V2Only, Pure)
SBF_OPCODE(LMUL32_REG, 0x8e, "lmul32", Mul, DstSrc, 32, V2Only, Pure)
SBF_OPCODE(LMUL64_IMM, 0x96, "lmul64", Mul, DstImm, 64, V2Only, Pure)
SBF_OPCODE(LMUL64_REG, 0x9e, "lmul64", Mul, DstSrc, 64, V2Only, Pure)
SBF_OPCODE(UHMUL64_IMM, 0x36, "uhmul64", UHighMul, DstImm, 64, V2Only, Pure)
SBF_OPCODE(UHMUL64_REG, 0x3e, "uhmul64", UHighMul, DstSrc, 64, V2Only, Pure)
SBF_OPCODE(SHMUL64_IMM, 0xb6, "shmul64", SHighMul, DstImm, 64, V2Only, Pure)
SBF_OPCODE(SHMUL64_REG, 0xbe, "shmul64", SHighMul, DstSrc, 64, V2Only, Pure)
SBF_OPCODE(UDIV32_IMM, 0x46, "udiv32", UDiv, DstImm, 32, V2Only, MayFault)
SBF_OPCODE(UDIV32_REG, 0x4e, "udiv32", UDiv, DstSrc, 32, V2Only, MayFault)
SBF_OPCODE(UDIV64_IMM, 0x56, "udiv64", UDiv, DstImm, 64, V2Only, MayFault)
SBF_OPCODE(UDIV64_REG, 0x5e, "udiv64", UDiv, DstSrc, 64, V2Only, MayFault)
SBF_OPCODE(UREM32_IMM, 0x66, "urem32", URem, DstImm, 32, V2Only, MayFault)
SBF_OPCODE(UREM32_REG, 0x6e, "urem32", URem, DstSrc, 32, V2Only, MayFault)
SBF_OPCODE(UREM64_IMM, 0x76, "urem64", URem, DstImm, 64, V2Only, MayFault)
SBF_OPCODE(UREM64_REG, 0x7e, "urem64", URem, DstSrc, 64, V2Only, MayFault)
SBF_OPCODE(SDIV32_IMM, 0xc6, "sdiv32", SDiv, DstImm, 32, V2Only, MayFault)
SBF_OPCODE(SDIV32_REG, 0xce, "sdiv32", SDiv, DstSrc, 32, V2Only, MayFault)
SBF_OPCODE(SDIV64_IMM, 0xd6, "sdiv64", SDiv, DstImm, 64, V2Only, MayFault)
SBF_OPCODE(SDIV64_REG, 0xde, "sdiv64", SDiv, DstSrc, 64, V2Only, MayFault)
SBF_OPCODE(SREM32_IMM, 0xe6, "srem32", SRem, DstImm, 32, V2Only, MayFault)
SBF_OPCODE(SREM32_REG, 0xee, "srem32", SRem, DstSrc, 32, V2Only, MayFault)
SBF_OPCODE(SREM64_IMM, 0xf6, "srem64", SRem, DstImm, 64, V2Only, MayFault)
SBF_OPCODE(SREM64_REG, 0xfe, "srem64", SRem, DstSrc, 64, V2Only, MayFault)

// SIMD-0377 32-bit conditional jumps (v3+).
SBF_OPCODE(JEQ32_IMM, 0x16, "jeq32", Eq, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JEQ32_REG, 0x1e, "jeq32", Eq, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JGT32_IMM, 0x26, "jgt32", UGt, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JGT32_REG, 0x2e, "jgt32", UGt, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JGE32_IMM, 0x36, "jge32", UGe, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JGE32_REG, 0x3e, "jge32", UGe, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JSET32_IMM, 0x46, "jset32", Set, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JSET32_REG, 0x4e, "jset32", Set, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JNE32_IMM, 0x56, "jne32", Ne, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JNE32_REG, 0x5e, "jne32", Ne, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JSGT32_IMM, 0x66, "jsgt32", SGt, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JSGT32_REG, 0x6e, "jsgt32", SGt, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JSGE32_IMM, 0x76, "jsge32", SGe, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JSGE32_REG, 0x7e, "jsge32", SGe, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JLT32_IMM, 0xa6, "jlt32", ULt, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JLT32_REG, 0xae, "jlt32", ULt, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JLE32_IMM, 0xb6, "jle32", ULe, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JLE32_REG, 0xbe, "jle32", ULe, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JSLT32_IMM, 0xc6, "jslt32", SLt, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JSLT32_REG, 0xce, "jslt32", SLt, BranchReg, 32, V3Plus, Branch)
SBF_OPCODE(JSLE32_IMM, 0xd6, "jsle32", SLe, BranchImm, 32, V3Plus, Branch)
SBF_OPCODE(JSLE32_REG, 0xde, "jsle32", SLe, BranchReg, 32, V3Plus, Branch)

// 64-bit control flow.
SBF_OPCODE(JA, 0x05, "ja", Jump, Branch, 64, All, Terminator)
SBF_OPCODE(JEQ64_IMM, 0x15, "jeq", Eq, BranchImm, 64, All, Branch)
SBF_OPCODE(JEQ64_REG, 0x1d, "jeq", Eq, BranchReg, 64, All, Branch)
SBF_OPCODE(JGT64_IMM, 0x25, "jgt", UGt, BranchImm, 64, All, Branch)
SBF_OPCODE(JGT64_REG, 0x2d, "jgt", UGt, BranchReg, 64, All, Branch)
SBF_OPCODE(JGE64_IMM, 0x35, "jge", UGe, BranchImm, 64, All, Branch)
SBF_OPCODE(JGE64_REG, 0x3d, "jge", UGe, BranchReg, 64, All, Branch)
SBF_OPCODE(JSET64_IMM, 0x45, "jset", Set, BranchImm, 64, All, Branch)
SBF_OPCODE(JSET64_REG, 0x4d, "jset", Set, BranchReg, 64, All, Branch)
SBF_OPCODE(JNE64_IMM, 0x55, "jne", Ne, BranchImm, 64, All, Branch)
SBF_OPCODE(JNE64_REG, 0x5d, "jne", Ne, BranchReg, 64, All, Branch)
SBF_OPCODE(JSGT64_IMM, 0x65, "jsgt", SGt, BranchImm, 64, All, Branch)
SBF_OPCODE(JSGT64_REG, 0x6d, "jsgt", SGt, BranchReg, 64, All, Branch)
SBF_OPCODE(JSGE64_IMM, 0x75, "jsge", SGe, BranchImm, 64, All, Branch)
SBF_OPCODE(JSGE64_REG, 0x7d, "jsge", SGe, BranchReg, 64, All, Branch)
SBF_OPCODE(JLT64_IMM, 0xa5, "jlt", ULt, BranchImm, 64, All, Branch)
SBF_OPCODE(JLT64_REG, 0xad, "jlt", ULt, BranchReg, 64, All, Branch)
SBF_OPCODE(JLE64_IMM, 0xb5, "jle", ULe, BranchImm, 64, All, Branch)
SBF_OPCODE(JLE64_REG, 0xbd, "jle", ULe, BranchReg, 64, All, Branch)
SBF_OPCODE(JSLT64_IMM, 0xc5, "jslt", SLt, BranchImm, 64, All, Branch)
SBF_OPCODE(JSLT64_REG, 0xcd, "jslt", SLt, BranchReg, 64, All, Branch)
SBF_OPCODE(JSLE64_IMM, 0xd5, "jsle", SLe, BranchImm, 64, All, Branch)
SBF_OPCODE(JSLE64_REG, 0xdd, "jsle", SLe, BranchReg, 64, All, Branch)
SBF_OPCODE(CALL_IMM, 0x85, "call", Call, CallImm, 64, All, Call)
SBF_OPCODE(CALL_REG, 0x8d, "callx", CallX, CallReg, 64, All, Call)
SBF_OPCODE(EXIT, 0x95, "exit", Exit, None, 64, All, Return)

#undef SBF_OPCODE
