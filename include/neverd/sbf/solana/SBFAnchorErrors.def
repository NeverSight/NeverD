//===- SBFAnchorErrors.def - Anchor framework error codes -------*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_ANCHOR_ERROR_RANGE(ID, NAME, FIRST, SUMMARY)
// SBF_ANCHOR_ERROR(ID, CODE, MESSAGE)
//
// An Anchor program returns a failure as a number, and that number is all a
// stripped binary carries: the message explaining it lives in the framework,
// not in the program. Naming a returned constant therefore turns an opaque
// immediate into the check that produced it, which is what a reader needs to
// follow a failure path.
//
// SBF_ANCHOR_ERROR_RANGE partitions the space. A code inside a range but not
// listed is still placed by its range, so a program built against a newer
// framework reports as "a constraint error" rather than as nothing at all.
// Codes at or above the custom range belong to the program's own enumeration
// and cannot be named without an IDL, so recovery reports the ordinal within
// that enumeration instead of guessing a name.
//
// An entry carries no display name of its own. The framework's variant name is
// what a developer reads in a program log, so consumers stringify ID rather
// than keep a second spelling that could drift from it.
//
// Provenance: anchor-lang `lang/src/error.rs`, read 2026-08-11. The ranges are
// the ones that file documents; the entries are its ErrorCode variants with
// their own numbering and their own messages.
//
//===----------------------------------------------------------------------===//

#ifndef SBF_ANCHOR_ERROR_RANGE
#define SBF_ANCHOR_ERROR_RANGE(ID, NAME, FIRST, SUMMARY)
#endif

#ifndef SBF_ANCHOR_ERROR
#define SBF_ANCHOR_ERROR(ID, CODE, MESSAGE)
#endif

SBF_ANCHOR_ERROR_RANGE(Instruction, "instruction", 100,
                       "the dispatcher could not route or decode the call")
// This band lists nothing: the framework retired its interface-description
// instructions in favour of program metadata. It stays so that a program built
// against a release that still had them is classified rather than dropped.
SBF_ANCHOR_ERROR_RANGE(Idl, "idl", 1000,
                       "an interface-description instruction failed")
SBF_ANCHOR_ERROR_RANGE(Event, "event", 1500,
                       "an event-emitting instruction failed")
SBF_ANCHOR_ERROR_RANGE(Constraint, "constraint", 2000,
                       "a declared account constraint did not hold")
SBF_ANCHOR_ERROR_RANGE(Require, "require", 2500,
                       "an explicit require assertion did not hold")
SBF_ANCHOR_ERROR_RANGE(Account, "account", 3000,
                       "an account failed validation or deserialization")
SBF_ANCHOR_ERROR_RANGE(Misc, "misc", 4100,
                       "the program and its declared identity disagree")
SBF_ANCHOR_ERROR_RANGE(Deprecated, "deprecated", 5000,
                       "a retired framework interface was used")
SBF_ANCHOR_ERROR_RANGE(Custom, "custom", 6000,
                       "the program's own enumeration, which only an IDL names")

SBF_ANCHOR_ERROR(InstructionMissing, 100,
                 "Instruction discriminator not provided")
SBF_ANCHOR_ERROR(InstructionFallbackNotFound, 101,
                 "Fallback functions are not supported")
SBF_ANCHOR_ERROR(InstructionDidNotDeserialize, 102,
                 "The program could not deserialize the given instruction")
SBF_ANCHOR_ERROR(InstructionDidNotSerialize, 103,
                 "The program could not serialize the given instruction")

SBF_ANCHOR_ERROR(EventInstructionStub, 1500,
