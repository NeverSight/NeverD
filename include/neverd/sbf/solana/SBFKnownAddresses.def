//===- SBFKnownAddresses.def - Well-known Solana addresses ------*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_KNOWN_ADDRESS(ID, NAME, ADDRESS, CATEGORY)
//
// ADDRESS is the canonical base58 spelling. Every entry must decode to exactly
// kPubkeyByteCount bytes; SBFSolanaModelTests enforces that, so a mistyped
// address cannot reach a report. Names use the spelling a Solana developer
// would write in source, because they appear directly in recovered output.
//
// Only addresses that are fixed by the protocol or by a widely deployed
// canonical program belong here. This is a recognition aid, never an authority:
// a match annotates a constant, it never changes decoded semantics.
//
//===----------------------------------------------------------------------===//

#ifndef SBF_KNOWN_ADDRESS
#define SBF_KNOWN_ADDRESS(ID, NAME, ADDRESS, CATEGORY)
#endif

