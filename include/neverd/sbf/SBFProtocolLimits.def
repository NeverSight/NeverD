//===- SBFProtocolLimits.def - SBF deployment limits --------*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_PROTOCOL_LIMIT(NAME, VALUE, SOURCE)
//
// Values are protocol evidence, not operational policy. Keep each entry
// paired with a fully pinned source in SBFUpstreamSources.def.
//
//===----------------------------------------------------------------------===//

#ifndef SBF_PROTOCOL_LIMIT
#define SBF_PROTOCOL_LIMIT(NAME, VALUE, SOURCE)
#endif

// anza-xyz/sbpf/src/ebpf.rs retains this historical constant, although the
// current loader and verifier do not enforce it.
SBF_PROTOCOL_LIMIT(LegacyProgramInstructionCount, 65'536, SBPFMain)

// anza-xyz/solana-sdk/system-interface/src/lib.rs defines the maximum account
// data length. A deployable ELF is necessarily smaller than its containing
// program-data account, so this is a conservative hostile-input ceiling.
SBF_PROTOCOL_LIMIT(MaxProgramAccountDataSize, 10'485'760, SolanaSDKMaster)

// anza-xyz/solana-sdk/pubkey/src/lib.rs bounds address derivation. The runtime
// rejects a call that exceeds either, so recovery reading a seed array stops
// there rather than following a count a program could never have used.
SBF_PROTOCOL_LIMIT(MaxSeeds, 16, SolanaSDKMaster)
SBF_PROTOCOL_LIMIT(MaxSeedLength, 32, SolanaSDKMaster)

// Digest widths of the hashing syscalls. anza-xyz/solana-sdk publishes one
// 32-byte digest type for sha256, keccak256, blake3, and poseidon; the sha512
// syscall proposed on agave master writes twice that.
SBF_PROTOCOL_LIMIT(Hash256ByteCount, 32, SolanaSDKMaster)
SBF_PROTOCOL_LIMIT(Hash512ByteCount, 64, AgaveMaster)

// anza-xyz/solana-sdk/secp256k1-recover: a signature is the r and s scalars
// concatenated, and the recovered key is the uncompressed point without the
// leading tag byte.
SBF_PROTOCOL_LIMIT(Secp256k1SignatureByteCount, 64, SolanaSDKMaster)
SBF_PROTOCOL_LIMIT(Secp256k1PublicKeyByteCount, 64, SolanaSDKMaster)

#undef SBF_PROTOCOL_LIMIT
