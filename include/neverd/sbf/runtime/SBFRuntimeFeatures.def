                    "enable_sbpf_v1_deployment_and_execution",
                    "JE86WkYvTrzW8HgNmrHY7dFYpCmSptUpKupbo2AdQ9cG", "",
                    ISAAvailability, HistoricalActivation,
                    "SBPF v1 deployment and execution are enabled")
