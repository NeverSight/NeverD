//===- SBFRuntimeFeatures.def - What the chain has turned on ----*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_CLUSTER(ID, NAME, ACTIVATES_EVERYTHING, SUMMARY)
// SBF_RUNTIME_PURPOSE(ID, NAME, SUMMARY)
// SBF_RUNTIME_FEATURE_DOMAIN(ID, NAME, SUMMARY)
// SBF_RUNTIME_FEATURE_DISPOSITION(ID, NAME, SUMMARY)
// SBF_RUNTIME_FEATURE(ID, NAME, GATE, ADDRESS, SIMD, DOMAIN, DISPOSITION,
//                     SUMMARY)
// SBF_RUNTIME_FEATURE_ACTIVATION(ID, CLUSTER, SLOT)
// SBF_RUNTIME_VERSION(VERSION, ENABLE_FEATURE)
//
//   Three questions get confused with each other constantly, and each has its
//   own answer:
//
//     which instructions the program is allowed to contain   -> SBFVersions.def
//     which loader serialized its input                      -> SBFLoaders.def
//     which runtime behaviours the chain has switched on     -> here
//
//   Collapsing them produces claims like "v4 programs get r2", which is false
//   in both directions: a v0 program running on today's mainnet gets r2, and a
//   v4 program running on a validator that has not activated the gate does
//   not. The version is a property of the file, the feature is a property of
//   the chain at a slot, and neither implies the other.
//
//   A feature is not a boolean either. The same gate is on for one cluster and
//   off for another, which is the entire reason a program that works on devnet
//   fails on mainnet, and it turns on at a slot, which is why the answer for a
//   historical transaction differs from the answer for the next one. So an
//   activation is recorded per cluster with the slot it happened at, and a
//   feature with no record on a cluster has not been activated there.
//
//   GATE is the identifier Agave gives the switch and ADDRESS is the feature
//   account whose state records the activation slot. A pending account may
//   already exist without activating the gate, so the state rather than mere
//   existence is what makes an activation checkable against a live node. SIMD
//   is the proposal that specified the behaviour, empty for the switches that
//   predate the process.
//
//   DOMAIN classifies the upstream subsystem whose behaviour changes.
//   DISPOSITION records whether the pinned revision still branches on the
//   field, has folded the active side into unconditional code, or only retains
//   the activation account as historical chain-ISA provenance.  These are
//   typed table columns so consumers never infer semantics from gate strings.
//
//   ACTIVATES_EVERYTHING marks a cluster that starts from a fresh genesis and
//   therefore turns on every gate its validator knows. Recording that as a
//   property of the cluster keeps a developer's local validator from needing
//   an activation row per feature, and keeps those rows from being mistaken
//   for observations of a real chain.
//
//   Feature row order assigns RuntimeFeature's public bit identities. Existing
//   rows are therefore append-only even when grouping a new row beside an old
//   one would look tidier.
//
//   SBF_RUNTIME_VERSION records the monotonically activated chain ISA range.
//   V0 uses RuntimeFeature::None because it predates feature activation; a
//   version absent from this list is known to the pinned upstream toolchain but
//   is not yet admitted by the pinned Agave runtime.
//
//===----------------------------------------------------------------------===//

#ifndef SBF_CLUSTER
#define SBF_CLUSTER(ID, NAME, ACTIVATES_EVERYTHING, SUMMARY)
#endif

#ifndef SBF_RUNTIME_PURPOSE
#define SBF_RUNTIME_PURPOSE(ID, NAME, SUMMARY)
#endif

#ifndef SBF_RUNTIME_FEATURE_DOMAIN
#define SBF_RUNTIME_FEATURE_DOMAIN(ID, NAME, SUMMARY)
#endif

#ifndef SBF_RUNTIME_FEATURE_DISPOSITION
#define SBF_RUNTIME_FEATURE_DISPOSITION(ID, NAME, SUMMARY)
#endif

#ifndef SBF_RUNTIME_FEATURE
#define SBF_RUNTIME_FEATURE(ID, NAME, GATE, ADDRESS, SIMD, DOMAIN,             \
                            DISPOSITION, SUMMARY)
#endif

#ifndef SBF_RUNTIME_FEATURE_ACTIVATION
#define SBF_RUNTIME_FEATURE_ACTIVATION(ID, CLUSTER, SLOT)
#endif

#ifndef SBF_RUNTIME_VERSION
#define SBF_RUNTIME_VERSION(VERSION, ENABLE_FEATURE)
#endif

//===----------------------------------------------------------------------===//
// The chains
//===----------------------------------------------------------------------===//

SBF_CLUSTER(MainnetBeta, "mainnet-beta", false,
            "the chain that holds value, and the one a gate reaches last")
SBF_CLUSTER(Testnet, "testnet", false,
            "where a release is exercised before it reaches mainnet")
SBF_CLUSTER(Devnet, "devnet", false,
            "where a program is exercised before it reaches mainnet")
SBF_CLUSTER(Localnet, "localnet", true,
            "a validator started from a fresh genesis, which activates every "
            "gate it knows and therefore answers differently from every real "
            "chain")

//===----------------------------------------------------------------------===//
// What the answer is being asked for
//
// The runtime builds two different syscall registries, and which one applies
// is not a property of the chain or the program but of the question. A program
// already on chain runs against the execution registry no matter what the
// deployment registry would have refused; asking whether the same program
// could be deployed today is a separate question with a different answer.
//===----------------------------------------------------------------------===//

SBF_RUNTIME_PURPOSE(Execution, "execution",
                    "running a program that is already deployed, which is "
                    "what a recovered program is a description of")
SBF_RUNTIME_PURPOSE(Deployment, "deployment",
                    "getting a program accepted onto the chain, which refuses "
                    "things it will happily keep running")

//===----------------------------------------------------------------------===//
// Typed feature classifications
//===----------------------------------------------------------------------===//

SBF_RUNTIME_FEATURE_DOMAIN(EntrypointABI, "entrypoint-abi",
                           "register and input arguments visible at entry")
SBF_RUNTIME_FEATURE_DOMAIN(InputMemory, "input-memory",
                           "serialized input and VM memory-region topology")
SBF_RUNTIME_FEATURE_DOMAIN(SyscallRegistration, "syscall-registration",
                           "whether a syscall symbol resolves")
SBF_RUNTIME_FEATURE_DOMAIN(SyscallSemantics, "syscall-semantics",
                           "results, errors, byte order, and argument checks")
SBF_RUNTIME_FEATURE_DOMAIN(CPIExecution, "cpi-execution",
                           "cross-program invocation limits and validation")
SBF_RUNTIME_FEATURE_DOMAIN(VMFaultPolicy, "vm-fault-policy",
                           "observable VM failure and compute-unit policy")
SBF_RUNTIME_FEATURE_DOMAIN(LoaderManagement, "loader-management",
                           "loader instructions and program-account mutation")
SBF_RUNTIME_FEATURE_DOMAIN(ProgramAdmission, "program-admission",
                           "deployment and execution admission policy")
SBF_RUNTIME_FEATURE_DOMAIN(
    ISAAvailability, "isa-availability",
    "which SBPF instruction-set versions the chain admits")

SBF_RUNTIME_FEATURE_DISPOSITION(
    RuntimeBranch, "runtime-branch",
    "the pinned Agave revision directly consults this FeatureSnapshot field")
SBF_RUNTIME_FEATURE_DISPOSITION(
    FoldedBranch, "folded-branch",
    "the snapshot retains provenance but the pinned revision has folded the "
    "active behaviour into unconditional code")
SBF_RUNTIME_FEATURE_DISPOSITION(
    HistoricalActivation, "historical-activation",
    "the activation account is required for a slot-qualified historical "
    "answer although the pinned revision no longer branches on it")

//===----------------------------------------------------------------------===//
// The gates
//
// Only gates that change a current or slot-qualified SBF answer are tabulated.
// The disposition column distinguishes current runtime branches from active
// behaviour folded into the pin and from historical chain-ISA activations.
//===----------------------------------------------------------------------===//

SBF_RUNTIME_FEATURE(InstructionDataPointer, "instruction-data-pointer",
                    "provide_instruction_data_offset_in_vm_r2",
                    "5xXZc66h4UdB6Yq7FzdBxBiRAFMMScMLwHxk2QZDaNZL", "simd-0321",
                    EntrypointABI, RuntimeBranch,
                    "the entrypoint receives the address of the instruction "
                    "data in r2, so a program no longer has to walk the "
                    "serialized accounts to find it")
SBF_RUNTIME_FEATURE_ACTIVATION(InstructionDataPointer, MainnetBeta, 410400000)
SBF_RUNTIME_FEATURE_ACTIVATION(InstructionDataPointer, Testnet, 388028256)
SBF_RUNTIME_FEATURE_ACTIVATION(InstructionDataPointer, Devnet, 446688000)

