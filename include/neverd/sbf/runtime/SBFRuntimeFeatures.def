// These execution-topology gates were added after the original public feature
// identities and therefore stay here to preserve the append-only bit ABI. They
// are independent of the loader-selected account serialization: one changes
// which VM addresses syscalls accept, while the other changes the backing
// regions for account data without changing the logical ABIv0/ABIv1 fields.
SBF_RUNTIME_FEATURE(SyscallParameterAddressRestrictions,
                    "syscall-parameter-address-restrictions",
                    "syscall_parameter_address_restrictions",
                    "EDGMC5kxFxGk4ixsNkGt8bW7QL5hDMXnbwaZvYMwNfzF", "simd-0459",
                    SyscallSemantics, RuntimeBranch,
                    "syscall and CPI parameters must satisfy the runtime's "
                    "VM-address and alignment restrictions")
SBF_RUNTIME_FEATURE_ACTIVATION(SyscallParameterAddressRestrictions, MainnetBeta,
                               429840000)
SBF_RUNTIME_FEATURE_ACTIVATION(SyscallParameterAddressRestrictions, Testnet,
                               407468256)
SBF_RUNTIME_FEATURE_ACTIVATION(SyscallParameterAddressRestrictions, Devnet,
                               462240000)

