SBF_RUNTIME_FEATURE_ACTIVATION(AccountDataDirectMapping, Devnet, 463968000)

// Observable loader, VM, CPI and syscall semantics retained by the pinned
// FeatureSnapshot. RuntimeBranch rows still have an upstream use site.
// FoldedBranch rows describe the pre-activation side for historical analysis;
// the pin retains their typed field but implements the active side
// unconditionally. Rows remain in upstream snapshot order where practical and
// are appended here to preserve every earlier public bit identity.
SBF_RUNTIME_FEATURE(
    EnableLoaderSetAuthorityChecked, "loader-set-authority-checked",
    "enable_bpf_loader_set_authority_checked_ix",
    "5x3825XS7M2A3Ekbn5VGGkvFoAg5qrRWkTrY4bARP1GL", "", LoaderManagement,
    RuntimeBranch,
    "the loader accepts the checked set-authority instruction and requires the "
    "new authority to sign")
SBF_RUNTIME_FEATURE_ACTIVATION(EnableLoaderSetAuthorityChecked, MainnetBeta,
                               251424000)
SBF_RUNTIME_FEATURE_ACTIVATION(EnableLoaderSetAuthorityChecked, Testnet,
                               247628260)
SBF_RUNTIME_FEATURE_ACTIVATION(EnableLoaderSetAuthorityChecked, Devnet,
                               255744000)

