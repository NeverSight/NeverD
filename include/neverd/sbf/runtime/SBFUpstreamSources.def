//===- SBFUpstreamSources.def - SBF ABI provenance database -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_UPSTREAM_SOURCE(ID, NAME, REVISION)
// SBF_UPSTREAM_TOOLCHAIN(ID, NAME, VERSION)
//
// An empty revision denotes a moving published specification rather than a
// repository snapshot. Repository sources always carry the full audited
// object ID; shortened hashes are presentation details, never identities.
//
//===----------------------------------------------------------------------===//

#ifndef SBF_UPSTREAM_SOURCE
#define SBF_UPSTREAM_SOURCE(ID, NAME, REVISION)
#endif

#ifndef SBF_UPSTREAM_TOOLCHAIN
#define SBF_UPSTREAM_TOOLCHAIN(ID, NAME, VERSION)
#endif

SBF_UPSTREAM_SOURCE(SolanaReference, "solana-syscall-reference", "")
SBF_UPSTREAM_SOURCE(AgaveMaster, "agave-master",
                    "ef210d67f2fabeee1730498188fa78854260c679")
SBF_UPSTREAM_SOURCE(SBPFMain, "anza-sbpf-main",
                    "2510663bb8d894e8e3094be351e4bb4b604f1f84")
SBF_UPSTREAM_SOURCE(SolanaSDKMaster, "anza-solana-sdk-master",
                    "122f32e571ce39face4beffaccea733e37c207fd")
SBF_UPSTREAM_SOURCE(FiredancerTestVectors, "firedancer-test-vectors",
                    "68bb4af40235562e8852fa23d5727e49c2a0b862")
SBF_UPSTREAM_SOURCE(Legacy, "legacy-loader-api", "")

SBF_UPSTREAM_TOOLCHAIN(OfficialOracleRust, "rust", "1.97.1")

#undef SBF_UPSTREAM_TOOLCHAIN
#undef SBF_UPSTREAM_SOURCE
