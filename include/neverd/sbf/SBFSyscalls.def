//===- SBFSyscalls.def - Solana program runtime syscall database -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SBF_SYSCALL(ID, NAME, ARGUMENT_COUNT, CATEGORY, EFFECTS)
//
//===----------------------------------------------------------------------===//

#ifndef SBF_SYSCALL
#define SBF_SYSCALL(ID, NAME, ARGUMENT_COUNT, CATEGORY, EFFECTS)
#endif

SBF_SYSCALL(Abort, "abort", 0, Terminal, Terminal)
SBF_SYSCALL(Panic, "sol_panic_", 3, Terminal, ReadsMemory | Terminal)

SBF_SYSCALL(Log, "sol_log_", 2, Logging, ReadsMemory)
SBF_SYSCALL(Log64, "sol_log_64_", 5, Logging, None)
SBF_SYSCALL(LogComputeUnits, "sol_log_compute_units_", 0, Logging, None)
SBF_SYSCALL(LogPubkey, "sol_log_pubkey", 1, Logging, ReadsMemory)
SBF_SYSCALL(LogData, "sol_log_data", 2, Logging, ReadsMemory)

SBF_SYSCALL(Memcpy, "sol_memcpy_", 3, Memory, ReadsMemory | WritesMemory)
SBF_SYSCALL(Memmove, "sol_memmove_", 3, Memory, ReadsMemory | WritesMemory)
SBF_SYSCALL(Memcmp, "sol_memcmp_", 4, Memory, ReadsMemory | WritesMemory)
SBF_SYSCALL(Memset, "sol_memset_", 3, Memory, WritesMemory)

SBF_SYSCALL(CreateProgramAddress, "sol_create_program_address", 4, PDA,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(TryFindProgramAddress, "sol_try_find_program_address", 5, PDA,
            ReadsMemory | WritesMemory)

SBF_SYSCALL(Sha256, "sol_sha256", 3, Crypto, ReadsMemory | WritesMemory)
SBF_SYSCALL(Keccak256, "sol_keccak256", 3, Crypto,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(Blake3, "sol_blake3", 3, Crypto, ReadsMemory | WritesMemory)
SBF_SYSCALL(Poseidon, "sol_poseidon", 4, Crypto, ReadsMemory | WritesMemory)
SBF_SYSCALL(Secp256k1Recover, "sol_secp256k1_recover", 4, Crypto,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(CurveValidatePoint, "sol_curve_validate_point", 3, Crypto,
            ReadsMemory)
SBF_SYSCALL(CurveGroupOp, "sol_curve_group_op", 4, Crypto,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(CurveMultiscalarMul, "sol_curve_multiscalar_mul", 5, Crypto,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(AltBn128GroupOp, "sol_alt_bn128_group_op", 4, Crypto,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(AltBn128Compression, "sol_alt_bn128_compression", 3, Crypto,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(BigModExp, "sol_big_mod_exp", 3, Crypto,
            ReadsMemory | WritesMemory)

SBF_SYSCALL(InvokeSignedRust, "sol_invoke_signed_rust", 5, CPI,
            ReadsMemory | WritesMemory | CPI)
SBF_SYSCALL(InvokeSignedC, "sol_invoke_signed_c", 5, CPI,
            ReadsMemory | WritesMemory | CPI)

SBF_SYSCALL(GetClockSysvar, "sol_get_clock_sysvar", 1, Sysvar, WritesMemory)
SBF_SYSCALL(GetEpochScheduleSysvar, "sol_get_epoch_schedule_sysvar", 1,
            Sysvar, WritesMemory)
SBF_SYSCALL(GetRentSysvar, "sol_get_rent_sysvar", 1, Sysvar, WritesMemory)
SBF_SYSCALL(GetEpochRewardsSysvar, "sol_get_epoch_rewards_sysvar", 1, Sysvar,
            WritesMemory)
SBF_SYSCALL(GetLastRestartSlot, "sol_get_last_restart_slot", 1, Sysvar,
            WritesMemory)
SBF_SYSCALL(GetFeesSysvar, "sol_get_fees_sysvar", 1, Sysvar, WritesMemory)
SBF_SYSCALL(GetSysvar, "sol_get_sysvar", 4, Sysvar,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(GetEpochStake, "sol_get_epoch_stake", 1, Sysvar, ReadsMemory)

SBF_SYSCALL(SetReturnData, "sol_set_return_data", 2, Runtime, ReadsMemory)
SBF_SYSCALL(GetReturnData, "sol_get_return_data", 3, Runtime, WritesMemory)
SBF_SYSCALL(GetProcessedSiblingInstruction,
            "sol_get_processed_sibling_instruction", 3, Runtime,
            ReadsMemory | WritesMemory)
SBF_SYSCALL(GetStackHeight, "sol_get_stack_height", 0, Runtime, None)
SBF_SYSCALL(RemainingComputeUnits, "sol_remaining_compute_units", 0, Runtime,
            None)

SBF_SYSCALL(AllocFree, "sol_alloc_free_", 2, Deprecated, WritesMemory)

#undef SBF_SYSCALL
