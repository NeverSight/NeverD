//===- SBFRelocations.def - Solana SBF ELF relocations ----------*- C++ -*-===//
//
// NeverD Decompiler
//
// SBF_RELOCATION(ID, VALUE, NAME, WIDTH_BITS, PURPOSE)
//
//===----------------------------------------------------------------------===//

#ifndef SBF_RELOCATION
#define SBF_RELOCATION(ID, VALUE, NAME, WIDTH_BITS, PURPOSE)
#endif

SBF_RELOCATION(Abs64, 1, "R_BPF_64_64", 64, Absolute)
SBF_RELOCATION(Relative64, 8, "R_BPF_64_RELATIVE", 64, Relative)
SBF_RELOCATION(Call32, 10, "R_BPF_64_32", 32, Call)

#undef SBF_RELOCATION
