//===- HeaderLibraries.def - Type libraries of system headers ---*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The type libraries NeverD ships, each the types and prototypes a
/// system's headers declare.  HeaderLibraryImages.def says which images each
/// describes.
///
/// NEVERD_HEADER_LIBRARY(Id, Name, File, Model, ABI, Spelling)
///   Id         The HeaderLibrary enumerator.
///   Name       Its name in JSON.
///   File       Its source, lib/types/headers/<File>.h, generated by the
///              script its first lines name; the build embeds it, and
///              lib/types/CMakeLists.txt lists it.
///   Model      The data model it is laid out for.
///   ABI        The RecordABI its records are laid out by, which a program
///              joining it follows too: a 32-bit Linux program's i386
///              System V ABI, which its data model alone does not say.
///   Spelling   The BuiltinSpelling a declaration of it is shown in, which
///              says every builtin's width whatever system reads it:
///              Windows' ULONG, which Windows fixes at 32 bits on every
///              architecture, or exact widths (Portable), where the
///              headers' long is 32 or 64 bits by their data model.
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_HEADER_LIBRARY
#define NEVERD_HEADER_LIBRARY(Id, Name, File, Model, ABI, Spelling)
#endif

NEVERD_HEADER_LIBRARY(WindowsKernelX64, "windows-kernel-x64", WindowsKernelX64,
                      LLP64, Microsoft, Windows)
NEVERD_HEADER_LIBRARY(WindowsUserX64, "windows-user-x64", WindowsUserX64, LLP64,
                      Microsoft, Windows)
NEVERD_HEADER_LIBRARY(WindowsKernelX86, "windows-kernel-x86", WindowsKernelX86,
                      ILP32, Microsoft, Windows)
NEVERD_HEADER_LIBRARY(WindowsUserX86, "windows-user-x86", WindowsUserX86, ILP32,
                      Microsoft, Windows)
NEVERD_HEADER_LIBRARY(WindowsUserARM64, "windows-user-arm64", WindowsUserARM64,
                      LLP64, Microsoft, Windows)
NEVERD_HEADER_LIBRARY(WindowsKernelARM64, "windows-kernel-arm64",
                      WindowsKernelARM64, LLP64, Microsoft, Windows)

NEVERD_HEADER_LIBRARY(LinuxX64, "linux-x64", LinuxX64, LP64, Itanium, Portable)
NEVERD_HEADER_LIBRARY(LinuxX86, "linux-x86", LinuxX86, ILP32, I386SystemV,
                      Portable)
NEVERD_HEADER_LIBRARY(LinuxARM64, "linux-arm64", LinuxARM64, LP64, Itanium,
                      Portable)
NEVERD_HEADER_LIBRARY(LinuxARM, "linux-arm", LinuxARM, ILP32, AAPCS32, Portable)

NEVERD_HEADER_LIBRARY(AndroidX64, "android-x64", AndroidX64, LP64, Itanium,
                      Portable)
NEVERD_HEADER_LIBRARY(AndroidX86, "android-x86", AndroidX86, ILP32, AndroidI386,
                      Portable)
NEVERD_HEADER_LIBRARY(AndroidARM64, "android-arm64", AndroidARM64, LP64,
                      Itanium, Portable)
NEVERD_HEADER_LIBRARY(AndroidARM, "android-arm", AndroidARM, ILP32, AAPCS32,
                      Portable)

NEVERD_HEADER_LIBRARY(MuslX64, "musl-x64", MuslX64, LP64, Itanium, Portable)
NEVERD_HEADER_LIBRARY(MuslX86, "musl-x86", MuslX86, ILP32, I386SystemV,
                      Portable)
NEVERD_HEADER_LIBRARY(MuslARM64, "musl-arm64", MuslARM64, LP64, Itanium,
                      Portable)
NEVERD_HEADER_LIBRARY(MuslARM, "musl-arm", MuslARM, ILP32, AAPCS32, Portable)

NEVERD_HEADER_LIBRARY(MacOSX64, "macos-x64", MacOSX64, LP64, Itanium, Portable)
NEVERD_HEADER_LIBRARY(MacOSARM64, "macos-arm64", MacOSARM64, LP64, AppleARM64,
                      Portable)
NEVERD_HEADER_LIBRARY(IOSARM64, "ios-arm64", IOSARM64, LP64, AppleARM64,
                      Portable)

NEVERD_HEADER_LIBRARY(FreeBSDX64, "freebsd-x64", FreeBSDX64, LP64, Itanium,
                      Portable)
NEVERD_HEADER_LIBRARY(FreeBSDX86, "freebsd-x86", FreeBSDX86, ILP32, I386SystemV,
                      Portable)
NEVERD_HEADER_LIBRARY(FreeBSDARM64, "freebsd-arm64", FreeBSDARM64, LP64,
                      Itanium, Portable)
NEVERD_HEADER_LIBRARY(FreeBSDARM, "freebsd-arm", FreeBSDARM, ILP32, AAPCS32,
                      Portable)

NEVERD_HEADER_LIBRARY(UefiX64, "uefi-x64", UefiX64, LLP64, Microsoft, Portable)
NEVERD_HEADER_LIBRARY(UefiX86, "uefi-x86", UefiX86, ILP32, Microsoft, Portable)
NEVERD_HEADER_LIBRARY(UefiARM64, "uefi-arm64", UefiARM64, LLP64, Microsoft,
                      Portable)

#undef NEVERD_HEADER_LIBRARY
