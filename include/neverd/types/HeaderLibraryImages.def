//===- HeaderLibraryImages.def - What header libraries describe -*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The images the header libraries (HeaderLibraries.def) describe: the kinds
/// of image, how an image's headers tell its kind, and the libraries an
/// image of each kind and architecture joins, in order.  The first library
/// to declare a name gives it.
///
/// NEVERD_HEADER_IMAGE_KIND(Kind)
///   A kind of image whose code calls a system's API one set of headers
///   declares.
///
/// NEVERD_HEADER_PE_SUBSYSTEM(Subsystem, Kind)
///   A PE image of the subsystem (IMAGE_SUBSYSTEM_*) is of the kind.
///
/// NEVERD_HEADER_LINUX_LIBC(LibC, Kind)
///   An ELF image under Linux that runs on the C library (LinuxLibC,
///   ELFOperatingSystem.h) is of the kind.
///
/// NEVERD_HEADER_DARWIN_PLATFORM(Platform, Kind)
///   A Mach-O image built for the platform (DarwinPlatform,
///   DarwinOperatingSystem.h) is of the kind.
///
/// NEVERD_HEADER_ELF_SYSTEM(System, Kind)
///   An ELF image that runs under the system other than Linux (ELFSystem,
///   ELFOperatingSystem.h) is of the kind.
///
/// NEVERD_HEADER_PE_ENTRY_TYPE(Subsystem, Type)
///   The entry point of a PE image of the subsystem has the function type
///   the joined libraries' pointer type Type points to.
///
/// NEVERD_HEADER_LIBRARY_IMAGE(Kind, Arch, Library)
///   An image of the kind and architecture joins the library, after the
///   rows above for the same image, where the library's data model is the
///   image's.
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_HEADER_IMAGE_KIND
#define NEVERD_HEADER_IMAGE_KIND(Kind)
#endif
#ifndef NEVERD_HEADER_PE_SUBSYSTEM
#define NEVERD_HEADER_PE_SUBSYSTEM(Subsystem, Kind)
#endif
#ifndef NEVERD_HEADER_LINUX_LIBC
#define NEVERD_HEADER_LINUX_LIBC(LibC, Kind)
#endif
#ifndef NEVERD_HEADER_DARWIN_PLATFORM
#define NEVERD_HEADER_DARWIN_PLATFORM(Platform, Kind)
#endif
#ifndef NEVERD_HEADER_ELF_SYSTEM
#define NEVERD_HEADER_ELF_SYSTEM(System, Kind)
#endif
#ifndef NEVERD_HEADER_PE_ENTRY_TYPE
#define NEVERD_HEADER_PE_ENTRY_TYPE(Subsystem, Type)
#endif
#ifndef NEVERD_HEADER_LIBRARY_IMAGE
#define NEVERD_HEADER_LIBRARY_IMAGE(Kind, Arch, Library)
#endif

// The Windows kernel, its drivers and the native programs ntdll starts.
NEVERD_HEADER_IMAGE_KIND(WindowsKernel)
// Windows programs and the libraries they load.
NEVERD_HEADER_IMAGE_KIND(WindowsUser)
// Linux programs and libraries on the GNU C Library.
NEVERD_HEADER_IMAGE_KIND(GNULinux)
// Android programs and the native libraries apps load, on bionic.
NEVERD_HEADER_IMAGE_KIND(Android)
// Linux programs and libraries on musl.
NEVERD_HEADER_IMAGE_KIND(MuslLinux)
// macOS programs and the libraries they load, on libSystem.
NEVERD_HEADER_IMAGE_KIND(MacOS)
// iOS apps and the frameworks they load, on libSystem, the simulator's too.
NEVERD_HEADER_IMAGE_KIND(IOS)
// UEFI applications, drivers and the other modules of a platform's
// firmware, which EDK II's MdePkg declares.
NEVERD_HEADER_IMAGE_KIND(UEFI)
NEVERD_HEADER_IMAGE_KIND(FreeBSD)

NEVERD_HEADER_PE_SUBSYSTEM(1, WindowsKernel) // IMAGE_SUBSYSTEM_NATIVE
NEVERD_HEADER_PE_SUBSYSTEM(2, WindowsUser)   // IMAGE_SUBSYSTEM_WINDOWS_GUI
NEVERD_HEADER_PE_SUBSYSTEM(3, WindowsUser)   // IMAGE_SUBSYSTEM_WINDOWS_CUI
NEVERD_HEADER_PE_SUBSYSTEM(10, UEFI)         // IMAGE_SUBSYSTEM_EFI_APPLICATION
NEVERD_HEADER_PE_SUBSYSTEM(11, UEFI) // IMAGE_SUBSYSTEM_EFI_BOOT_SERVICE_DRIVER
NEVERD_HEADER_PE_SUBSYSTEM(12, UEFI) // IMAGE_SUBSYSTEM_EFI_RUNTIME_DRIVER
NEVERD_HEADER_PE_SUBSYSTEM(13, UEFI) // IMAGE_SUBSYSTEM_EFI_ROM

// An application's entry and a runtime driver's are the UEFI
// specification's EFI_IMAGE_ENTRY_POINT.  A boot service driver's need not
// be: EDK II builds PEIMs, the PEI and DXE cores and standalone MM drivers
// as boot service drivers too, whose entries take other parameters.
NEVERD_HEADER_PE_ENTRY_TYPE(10, "EFI_IMAGE_ENTRY_POINT")
NEVERD_HEADER_PE_ENTRY_TYPE(12, "EFI_IMAGE_ENTRY_POINT")

// Neither bionic nor musl lays records out as glibc does on 32-bit targets.
NEVERD_HEADER_LINUX_LIBC(GNU, GNULinux)
NEVERD_HEADER_LINUX_LIBC(Bionic, Android)
NEVERD_HEADER_LINUX_LIBC(Musl, MuslLinux)

NEVERD_HEADER_DARWIN_PLATFORM(MacOS, MacOS)
NEVERD_HEADER_DARWIN_PLATFORM(IOS, IOS)

NEVERD_HEADER_ELF_SYSTEM(FreeBSD, FreeBSD)

NEVERD_HEADER_LIBRARY_IMAGE(WindowsKernel, X64, WindowsKernelX64)
NEVERD_HEADER_LIBRARY_IMAGE(WindowsUser, X64, WindowsUserX64)
// The few routines ntdll exports that the kernel's headers declare and
// phnt's native API, in the user mode library, does not.
NEVERD_HEADER_LIBRARY_IMAGE(WindowsUser, X64, WindowsKernelX64)
NEVERD_HEADER_LIBRARY_IMAGE(WindowsKernel, X86, WindowsKernelX86)
NEVERD_HEADER_LIBRARY_IMAGE(WindowsUser, X86, WindowsUserX86)
NEVERD_HEADER_LIBRARY_IMAGE(WindowsUser, X86, WindowsKernelX86)
NEVERD_HEADER_LIBRARY_IMAGE(WindowsKernel, AArch64, WindowsKernelARM64)
NEVERD_HEADER_LIBRARY_IMAGE(WindowsUser, AArch64, WindowsUserARM64)
NEVERD_HEADER_LIBRARY_IMAGE(WindowsUser, AArch64, WindowsKernelARM64)
NEVERD_HEADER_LIBRARY_IMAGE(GNULinux, X64, LinuxX64)
NEVERD_HEADER_LIBRARY_IMAGE(GNULinux, X86, LinuxX86)
NEVERD_HEADER_LIBRARY_IMAGE(GNULinux, AArch64, LinuxARM64)
NEVERD_HEADER_LIBRARY_IMAGE(GNULinux, ARM, LinuxARM)
NEVERD_HEADER_LIBRARY_IMAGE(Android, X64, AndroidX64)
NEVERD_HEADER_LIBRARY_IMAGE(Android, X86, AndroidX86)
NEVERD_HEADER_LIBRARY_IMAGE(Android, AArch64, AndroidARM64)
NEVERD_HEADER_LIBRARY_IMAGE(Android, ARM, AndroidARM)
NEVERD_HEADER_LIBRARY_IMAGE(MuslLinux, X64, MuslX64)
NEVERD_HEADER_LIBRARY_IMAGE(MuslLinux, X86, MuslX86)
NEVERD_HEADER_LIBRARY_IMAGE(MuslLinux, AArch64, MuslARM64)
NEVERD_HEADER_LIBRARY_IMAGE(MuslLinux, ARM, MuslARM)
NEVERD_HEADER_LIBRARY_IMAGE(MacOS, X64, MacOSX64)
NEVERD_HEADER_LIBRARY_IMAGE(MacOS, AArch64, MacOSARM64)
// No library describes the simulator's x64 iOS: Apple silicon Macs run the
// ARM64 simulator, whose apps join iOS's.
NEVERD_HEADER_LIBRARY_IMAGE(IOS, AArch64, IOSARM64)
NEVERD_HEADER_LIBRARY_IMAGE(UEFI, X64, UefiX64)
NEVERD_HEADER_LIBRARY_IMAGE(UEFI, X86, UefiX86)
NEVERD_HEADER_LIBRARY_IMAGE(UEFI, AArch64, UefiARM64)
NEVERD_HEADER_LIBRARY_IMAGE(FreeBSD, X64, FreeBSDX64)
NEVERD_HEADER_LIBRARY_IMAGE(FreeBSD, X86, FreeBSDX86)
NEVERD_HEADER_LIBRARY_IMAGE(FreeBSD, AArch64, FreeBSDARM64)
NEVERD_HEADER_LIBRARY_IMAGE(FreeBSD, ARM, FreeBSDARM)

#undef NEVERD_HEADER_IMAGE_KIND
#undef NEVERD_HEADER_PE_SUBSYSTEM
#undef NEVERD_HEADER_LINUX_LIBC
#undef NEVERD_HEADER_DARWIN_PLATFORM
#undef NEVERD_HEADER_ELF_SYSTEM
#undef NEVERD_HEADER_PE_ENTRY_TYPE
#undef NEVERD_HEADER_LIBRARY_IMAGE
