//===- BranchEncoding.def - Encodings of direct branches --------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The encodings of the ARM and A64 direct branches, and of the linker thunks
/// such a branch may enter: what decodeDirectBranch reads, what signature
/// matching follows through a thunk, and the A64 conditional branches function
/// discovery reads.  x86's rel32 call and jump are in
/// neverd/support/ISAEncoding.def.  Define the macros a consumer reads before
/// including this file; the others expand to nothing.
///
///   NEVERD_BRANCH_FORM(Name, Mask, Match)  an instruction word, or Thumb
///                                          halfword, whose bits under Mask
///                                          are Match
///   NEVERD_BRANCH_FIELD(Name, Low, Width)  a field of such a word or halfword
///   NEVERD_BRANCH_VALUE(Name, Value)       another constant of an encoding
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_BRANCH_FORM
#define NEVERD_BRANCH_FORM(Name, Mask, Match)
#endif
#ifndef NEVERD_BRANCH_FIELD
#define NEVERD_BRANCH_FIELD(Name, Low, Width)
#endif
#ifndef NEVERD_BRANCH_VALUE
#define NEVERD_BRANCH_VALUE(Name, Value)
#endif

// An x86 instruction may start at any byte.
NEVERD_BRANCH_VALUE(X86InstructionAlignment, 1)

// A32 and T32 instructions are words and halfwords; the program counter reads
// eight bytes past an A32 instruction and four past a T32 one.  A 32-bit ARM
// code address with its low bit set is entered in Thumb state.
NEVERD_BRANCH_VALUE(ArmInstructionBytes, 4)
NEVERD_BRANCH_VALUE(ThumbHalfwordBytes, 2)
NEVERD_BRANCH_VALUE(ThumbWideInstructionBytes, 4)
NEVERD_BRANCH_VALUE(ArmPCOffset, 8)
NEVERD_BRANCH_VALUE(ThumbPCOffset, 4)
NEVERD_BRANCH_VALUE(ThumbStateBit, 1)

// A32 B, BL and BLX (immediate): the condition, 101, BL's link bit or BLX's
// halfword bit, and the offset in words.  BLX has the condition field of the
// unconditional instruction space.
NEVERD_BRANCH_FORM(ArmBranch, 0x0E000000, 0x0A000000)
NEVERD_BRANCH_FIELD(ArmCondition, 28, 4)
NEVERD_BRANCH_FIELD(ArmLinkOrHalfword, 24, 1)
NEVERD_BRANCH_FIELD(ArmBranchOffset, 0, 24)
NEVERD_BRANCH_VALUE(ArmConditionAlways, 0xE)
NEVERD_BRANCH_VALUE(ArmConditionUnconditional, 0xF)

// The A32 long branches of linker thunks: `ldr pc, [pc, #-4]` followed by
// the target, and `movw ip, #imm16`, `movt ip, #imm16`, `add ip, ip, pc` and
// `bx ip`.  MOVW and MOVT hold imm4:imm12.
NEVERD_BRANCH_FORM(ArmLoadPCFromNextWord, 0xFFFFFFFF, 0xE51FF004)
NEVERD_BRANCH_FORM(ArmMoveWideToIP, 0xFFF0F000, 0xE300C000)
NEVERD_BRANCH_FORM(ArmMoveTopToIP, 0xFFF0F000, 0xE340C000)
NEVERD_BRANCH_FIELD(ArmMoveImm4, 16, 4)
NEVERD_BRANCH_FIELD(ArmMoveImm12, 0, 12)
NEVERD_BRANCH_FORM(ArmAddIPIPPC, 0xFFFFFFFF, 0xE08CC00F)
NEVERD_BRANCH_FORM(ArmBranchExchangeIP, 0xFFFFFFFF, 0xE12FFF1C)

// The A32 PLT entry an ELF linker writes: `add ip, pc, #imm`, an optional
// `add ip, ip, #imm`, and `ldr pc, [ip, #imm12]!`.  An ADD's immediate is a
// modified immediate: imm8 rotated right by twice the rotation field.
NEVERD_BRANCH_FORM(ArmAddIPPCImmediate, 0xFFFFF000, 0xE28FC000)
NEVERD_BRANCH_FORM(ArmAddIPIPImmediate, 0xFFFFF000, 0xE28CC000)
NEVERD_BRANCH_FORM(ArmLoadPCFromIPPreIndexed, 0xFFFFF000, 0xE5BCF000)
NEVERD_BRANCH_FIELD(ArmModifiedImm8, 0, 8)
NEVERD_BRANCH_FIELD(ArmModifiedRotation, 8, 4)
NEVERD_BRANCH_FIELD(ArmLoadImm12, 0, 12)

// T32 B.W (T4), BL and BLX (immediate): a first halfword 11110:S:imm10, and a
// second 1:J1:x:J2:imm11 whose bits 14 and 12 tell the three apart.  The
// offset S:I1:I2:imm10:imm11 is in halfwords, with I1 = NOT(J1 XOR S) and
// I2 = NOT(J2 XOR S).  BLX's imm11 is imm10L:H, and a BLX with H set is
// UNDEFINED.
NEVERD_BRANCH_FORM(ThumbWideBranchHigh, 0xF800, 0xF000)
NEVERD_BRANCH_FORM(ThumbJumpLow, 0xD000, 0x9000)
NEVERD_BRANCH_FORM(ThumbLinkLow, 0xD000, 0xD000)
NEVERD_BRANCH_FORM(ThumbLinkExchangeLow, 0xD001, 0xC000)
NEVERD_BRANCH_FIELD(ThumbBranchSign, 10, 1)
NEVERD_BRANCH_FIELD(ThumbBranchHigh, 0, 10)
NEVERD_BRANCH_FIELD(ThumbBranchJ1, 13, 1)
NEVERD_BRANCH_FIELD(ThumbBranchJ2, 11, 1)
NEVERD_BRANCH_FIELD(ThumbBranchLow, 0, 11)

// The T32 long branches of linker thunks: `movw ip, #imm16` and
// `movt ip, #imm16` (T3; imm4:i of the first halfword, imm3:imm8 of the
// second), `add ip, pc` and `bx ip`.
NEVERD_BRANCH_FORM(ThumbMoveWideToIPHigh, 0xFBF0, 0xF240)
NEVERD_BRANCH_FORM(ThumbMoveTopToIPHigh, 0xFBF0, 0xF2C0)
NEVERD_BRANCH_FORM(ThumbMoveToIPLow, 0x8F00, 0x0C00)
NEVERD_BRANCH_FIELD(ThumbMoveImm4, 0, 4)
NEVERD_BRANCH_FIELD(ThumbMoveI, 10, 1)
NEVERD_BRANCH_FIELD(ThumbMoveImm3, 12, 3)
NEVERD_BRANCH_FIELD(ThumbMoveImm8, 0, 8)
NEVERD_BRANCH_FORM(ThumbAddIPPC, 0xFFFF, 0x44FC)
NEVERD_BRANCH_FORM(ThumbBranchExchangeIP, 0xFFFF, 0x4760)

// A64 B and BL, and B or BL alone: the offset is in instructions.
NEVERD_BRANCH_VALUE(A64InstructionBytes, 4)
NEVERD_BRANCH_FORM(A64BranchOrLink, 0x7C000000, 0x14000000)
NEVERD_BRANCH_FORM(A64Branch, 0xFC000000, 0x14000000)
NEVERD_BRANCH_FORM(A64BranchLink, 0xFC000000, 0x94000000)
NEVERD_BRANCH_FIELD(A64BranchOffset, 0, 26)

// The A64 conditional branches: B.cond and BC.cond, CBZ and CBNZ, which share
// B.cond's offset field, and TBZ and TBNZ.  The offsets are in instructions.
NEVERD_BRANCH_FORM(A64ConditionalBranch, 0xFF000000, 0x54000000)
NEVERD_BRANCH_FORM(A64CompareBranch, 0x7E000000, 0x34000000)
NEVERD_BRANCH_FORM(A64TestBranch, 0x7E000000, 0x36000000)
NEVERD_BRANCH_FIELD(A64ConditionalBranchOffset, 5, 19)
NEVERD_BRANCH_FIELD(A64TestBranchOffset, 5, 14)

// The A64 range thunks: `adrp x16, page; add x16, x16, #lo12; br x16`, and
// `ldr x16, #8; br x16` with the target in the doubleword after them.
// ADRP's page offset is immhi:immlo, in pages; LDR's literal offset is in
// words.
NEVERD_BRANCH_VALUE(A64PageBytes, 4096)
NEVERD_BRANCH_FORM(A64PageAddressX16, 0x9F00001F, 0x90000010)
NEVERD_BRANCH_FIELD(A64PageImmLo, 29, 2)
NEVERD_BRANCH_FIELD(A64PageImmHi, 5, 19)
NEVERD_BRANCH_FORM(A64AddX16X16, 0xFFC003FF, 0x91000210)
NEVERD_BRANCH_FIELD(A64AddImm12, 10, 12)
NEVERD_BRANCH_FORM(A64LoadX16FromThunkEnd, 0xFFFFFFFF, 0x58000050)
NEVERD_BRANCH_FIELD(A64LoadLiteralOffset, 5, 19)
NEVERD_BRANCH_FORM(A64BranchRegisterX16, 0xFFFFFFFF, 0xD61F0200)

#undef NEVERD_BRANCH_FORM
#undef NEVERD_BRANCH_FIELD
#undef NEVERD_BRANCH_VALUE
