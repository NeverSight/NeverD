//===- LLVMCodegenTargets.def - Linked LLVM backends ------------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// LLVM backends linked by NeverD and registered for code generation.
/// CMake consumes the same entries for source and prebuilt LLVM builds.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_LLVM_CODEGEN_TARGET
#define NEVERD_LLVM_CODEGEN_TARGET(Name)
#endif

NEVERD_LLVM_CODEGEN_TARGET(X86)
NEVERD_LLVM_CODEGEN_TARGET(ARM)
NEVERD_LLVM_CODEGEN_TARGET(AArch64)

#undef NEVERD_LLVM_CODEGEN_TARGET
