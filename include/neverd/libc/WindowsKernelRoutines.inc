// Windows kernel routines with fixed, documented call contracts.
//
// ND_WINDOWS_DISPATCH_THUNK(Name)
//   An indirect-call dispatcher (MSVC Control Flow Guard): it jumps to the
//   target in RAX with the caller's argument registers unchanged.  A call to
//   it is an indirect call; its arguments are the registers the caller set.
//
// ND_WINDOWS_PROTO(Name, Widths...)
//   A routine whose WDK prototype (wdm.h, ntddk.h, ntifs.h) fixes its
//   parameters.  Each width is the bytes the Win64 ABI passes for that
//   parameter: 8 for a pointer, handle, SIZE_T, ULONG64 or LARGE_INTEGER; 4 for
//   ULONG, LONG, NTSTATUS, ACCESS_MASK or an enum; 2 for USHORT or WCHAR; 1 for
//   BOOLEAN, KIRQL, KPROCESSOR_MODE or UCHAR.  Variadic routines are absent.
//
// Names are matched after leading underscores are stripped.

ND_WINDOWS_DISPATCH_THUNK("guard_dispatch_icall")
ND_WINDOWS_DISPATCH_THUNK("guard_dispatch_icall_nop")
ND_WINDOWS_DISPATCH_THUNK("guard_xfg_dispatch_icall")
