NEVERD_MIPS_MSA(SetBitVector, 0xff80003f, 0x7a00000d)
NEVERD_MIPS_MSA(NegateBitVector, 0xff80003f, 0x7a80000d)
NEVERD_MIPS_MSA(MultiplyVector, 0xff80003f, 0x78000012)
NEVERD_MIPS_MSA(MultiplyAddVector, 0xff80003f, 0x78800012)
NEVERD_MIPS_MSA(MultiplySubVector, 0xff80003f, 0x79000012)
NEVERD_MIPS_MSA(AbsoluteMaximumVector, 0xff80003f, 0x7b00000e)
NEVERD_MIPS_MSA(AbsoluteMinimumVector, 0xff80003f, 0x7b80000e)

NEVERD_MIPS_MSA(AddAbsoluteVector, 0xff80003f, 0x78000010)
NEVERD_MIPS_MSA(AddSaturatedAbsoluteVector, 0xff80003f, 0x78800010)
NEVERD_MIPS_MSA(AddSaturatedSignedVector, 0xff80003f, 0x79000010)
NEVERD_MIPS_MSA(AddSaturatedUnsignedVector, 0xff80003f, 0x79800010)
NEVERD_MIPS_MSA(SubSaturatedSignedVector, 0xff80003f, 0x78000011)
NEVERD_MIPS_MSA(SubSaturatedUnsignedVector, 0xff80003f, 0x78800011)
NEVERD_MIPS_MSA(AverageSignedVector, 0xff80003f, 0x7a000010)
NEVERD_MIPS_MSA(AverageUnsignedVector, 0xff80003f, 0x7a800010)
NEVERD_MIPS_MSA(RoundAverageSignedVector, 0xff80003f, 0x7b000010)
NEVERD_MIPS_MSA(RoundAverageUnsignedVector, 0xff80003f, 0x7b800010)

NEVERD_MIPS_MSA(AndImmediate, 0xff00003f, 0x78000000)
NEVERD_MIPS_MSA(OrImmediate, 0xff00003f, 0x79000000)
NEVERD_MIPS_MSA(NorImmediate, 0xff00003f, 0x7a000000)
NEVERD_MIPS_MSA(XorImmediate, 0xff00003f, 0x7b000000)
NEVERD_MIPS_MSA(MergeNonzeroVector, 0xffe0003f, 0x7880001e)
NEVERD_MIPS_MSA(MergeZeroVector, 0xffe0003f, 0x78a0001e)
NEVERD_MIPS_MSA(SelectVector, 0xffe0003f, 0x78c0001e)
NEVERD_MIPS_MSA(PopulationCount, 0xfffc003f, 0x7b04001e)
NEVERD_MIPS_MSA(LeadingOneCount, 0xfffc003f, 0x7b08001e)
NEVERD_MIPS_MSA(LeadingZeroCount, 0xfffc003f, 0x7b0c001e)
// BIT uses a prefix-coded lane width and count in bits22..16. The lifter
// rejects the reserved 1111xxx prefix before emitting any operations.
NEVERD_MIPS_MSA(ShiftLeftImmediate, 0xff80003f, 0x78000009)
NEVERD_MIPS_MSA(ShiftRightSignedImmediate, 0xff80003f, 0x78800009)
NEVERD_MIPS_MSA(ShiftRightImmediate, 0xff80003f, 0x79000009)
