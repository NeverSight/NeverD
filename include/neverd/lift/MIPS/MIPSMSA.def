//===- MIPSMSA.def - Admitted MSA integer encodings ----------------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Include with NEVERD_MIPS_MSA(Name, Mask, Value). Register and lane fields
/// are excluded from the masks; reserved/data-format bits remain checked.
//===----------------------------------------------------------------------===//

NEVERD_MIPS_MSA(FillWord, 0xffff003f, 0x7b02001e)
NEVERD_MIPS_MSA(InsertWord, 0xfffc003f, 0x79300019)
NEVERD_MIPS_MSA(CopyWord, 0xfffc003f, 0x78b00019)
NEVERD_MIPS_MSA(AddVector, 0xff80003f, 0x7800000e)
NEVERD_MIPS_MSA(SubVector, 0xff80003f, 0x7880000e)
NEVERD_MIPS_MSA(EqualVector, 0xff80003f, 0x7800000f)
NEVERD_MIPS_MSA(SignedLessVector, 0xff80003f, 0x7900000f)
NEVERD_MIPS_MSA(UnsignedLessVector, 0xff80003f, 0x7980000f)
NEVERD_MIPS_MSA(SignedLessEqualVector, 0xff80003f, 0x7a00000f)
NEVERD_MIPS_MSA(UnsignedLessEqualVector, 0xff80003f, 0x7a80000f)
NEVERD_MIPS_MSA(SignedMaximumVector, 0xff80003f, 0x7900000e)
NEVERD_MIPS_MSA(UnsignedMaximumVector, 0xff80003f, 0x7980000e)
NEVERD_MIPS_MSA(SignedMinimumVector, 0xff80003f, 0x7a00000e)
NEVERD_MIPS_MSA(UnsignedMinimumVector, 0xff80003f, 0x7a80000e)
NEVERD_MIPS_MSA(AndVector, 0xffe0003f, 0x7800001e)
NEVERD_MIPS_MSA(OrVector, 0xffe0003f, 0x7820001e)
NEVERD_MIPS_MSA(NorVector, 0xffe0003f, 0x7840001e)
NEVERD_MIPS_MSA(XorVector, 0xffe0003f, 0x7860001e)

NEVERD_MIPS_MSA(ShiftLeftVector, 0xff80003f, 0x7800000d)
NEVERD_MIPS_MSA(ShiftRightSignedVector, 0xff80003f, 0x7880000d)
NEVERD_MIPS_MSA(ShiftRightVector, 0xff80003f, 0x7900000d)
