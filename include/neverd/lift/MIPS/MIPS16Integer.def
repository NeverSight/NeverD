//===- MIPS16Integer.def - MIPS16e32 scalar encoding forms ---------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// MIPS16 major opcode, classic scalar form, destination, source, signed imm8.
// Extended immediates retain their full 16 bits; the scalar form owns
// extension.
#ifdef NEVERD_MIPS16_IMMEDIATE
NEVERD_MIPS16_IMMEDIATE(0x09, 9, RX, RX, true)   // ADDIU
NEVERD_MIPS16_IMMEDIATE(0x0a, 10, 24, RX, false) // SLTI
NEVERD_MIPS16_IMMEDIATE(0x0b, 11, 24, RX, false) // SLTIU
NEVERD_MIPS16_IMMEDIATE(0x0d, 13, RX, 0, false)  // LI
NEVERD_MIPS16_IMMEDIATE(0x0e, 14, 24, RX, false) // CMPI
#undef NEVERD_MIPS16_IMMEDIATE
#endif

// MIPS16 base+imm5 memory forms. EXTEND supplies an unscaled signed imm16.
#ifdef NEVERD_MIPS16_MEMORY
NEVERD_MIPS16_MEMORY(0x10, 32, 0) // LB
NEVERD_MIPS16_MEMORY(0x11, 33, 1) // LH
NEVERD_MIPS16_MEMORY(0x13, 35, 2) // LW
NEVERD_MIPS16_MEMORY(0x14, 36, 0) // LBU
NEVERD_MIPS16_MEMORY(0x15, 37, 1) // LHU
NEVERD_MIPS16_MEMORY(0x18, 40, 0) // SB
NEVERD_MIPS16_MEMORY(0x19, 41, 1) // SH
NEVERD_MIPS16_MEMORY(0x1b, 43, 2) // SW
#undef NEVERD_MIPS16_MEMORY
#endif

// MIPS16 SHFT function, classic function; the immediate owner handles widths.
#ifdef NEVERD_MIPS16_SHIFT
NEVERD_MIPS16_SHIFT(0, 0) // SLL
NEVERD_MIPS16_SHIFT(2, 2) // SRL
NEVERD_MIPS16_SHIFT(3, 3) // SRA
#undef NEVERD_MIPS16_SHIFT
#endif

// MIPS16 RR function, classic function, destination, left, right.
#ifdef NEVERD_MIPS16_REGISTER
NEVERD_MIPS16_REGISTER(0x02, 42, 24, RX, RY) // SLT
NEVERD_MIPS16_REGISTER(0x03, 43, 24, RX, RY) // SLTU
NEVERD_MIPS16_REGISTER(0x04, 4, RY, RX, RY)  // SLLV
NEVERD_MIPS16_REGISTER(0x06, 6, RY, RX, RY)  // SRLV
NEVERD_MIPS16_REGISTER(0x07, 7, RY, RX, RY)  // SRAV
NEVERD_MIPS16_REGISTER(0x0a, 38, 24, RX, RY) // CMP
NEVERD_MIPS16_REGISTER(0x0b, 35, RX, 0, RY)  // NEG
NEVERD_MIPS16_REGISTER(0x0c, 36, RX, RX, RY) // AND
NEVERD_MIPS16_REGISTER(0x0d, 37, RX, RX, RY) // OR
NEVERD_MIPS16_REGISTER(0x0e, 38, RX, RX, RY) // XOR
NEVERD_MIPS16_REGISTER(0x18, 24, 0, RX, RY)  // MULT
NEVERD_MIPS16_REGISTER(0x19, 25, 0, RX, RY)  // MULTU
NEVERD_MIPS16_REGISTER(0x1a, 26, 0, RX, RY)  // DIV
NEVERD_MIPS16_REGISTER(0x1b, 27, 0, RX, RY)  // DIVU
#undef NEVERD_MIPS16_REGISTER
#endif
