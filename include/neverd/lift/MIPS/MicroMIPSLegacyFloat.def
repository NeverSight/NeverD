//===- MicroMIPSLegacyFloat.def - Pre-R6 microMIPS floating forms --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Physical minor and canonical COP1/COP1X bits. Shared scalar forms live in
// MicroMIPSFloat.def. Register roles are determined by the operand group.

#ifdef NEVERD_MICRO_LEGACY_FP_BINARY
NEVERD_MICRO_LEGACY_FP_BINARY(0x0230, 0x46c00000u) // add.ps
NEVERD_MICRO_LEGACY_FP_BINARY(0x0270, 0x46c00001u) // sub.ps
NEVERD_MICRO_LEGACY_FP_BINARY(0x02b0, 0x46c00002u) // mul.ps
NEVERD_MICRO_LEGACY_FP_BINARY(0x0080, 0x46c0002cu) // pll.ps
NEVERD_MICRO_LEGACY_FP_BINARY(0x00c0, 0x46c0002du) // plu.ps
NEVERD_MICRO_LEGACY_FP_BINARY(0x0100, 0x46c0002eu) // pul.ps
NEVERD_MICRO_LEGACY_FP_BINARY(0x0140, 0x46c0002fu) // puu.ps
NEVERD_MICRO_LEGACY_FP_BINARY(0x0180, 0x46000026u) // cvt.ps.s
#undef NEVERD_MICRO_LEGACY_FP_BINARY
#endif

#ifdef NEVERD_MICRO_LEGACY_FP_UNARY
NEVERD_MICRO_LEGACY_FP_UNARY(0x437b, 0x46c00005u) // abs.ps
NEVERD_MICRO_LEGACY_FP_UNARY(0x407b, 0x46c00006u) // mov.ps
NEVERD_MICRO_LEGACY_FP_UNARY(0x4b7b, 0x46c00007u) // neg.ps
NEVERD_MICRO_LEGACY_FP_UNARY(0x213b, 0x46c00028u) // cvt.s.pl
NEVERD_MICRO_LEGACY_FP_UNARY(0x293b, 0x46c00020u) // cvt.s.pu
#undef NEVERD_MICRO_LEGACY_FP_UNARY
#endif

#ifdef NEVERD_MICRO_LEGACY_FP_TERNARY
NEVERD_MICRO_LEGACY_FP_TERNARY(0x01, 0x4c000020u) // madd.s
NEVERD_MICRO_LEGACY_FP_TERNARY(0x09, 0x4c000021u) // madd.d
NEVERD_MICRO_LEGACY_FP_TERNARY(0x11, 0x4c000026u) // madd.ps
NEVERD_MICRO_LEGACY_FP_TERNARY(0x21, 0x4c000028u) // msub.s
NEVERD_MICRO_LEGACY_FP_TERNARY(0x29, 0x4c000029u) // msub.d
NEVERD_MICRO_LEGACY_FP_TERNARY(0x31, 0x4c00002eu) // msub.ps
NEVERD_MICRO_LEGACY_FP_TERNARY(0x02, 0x4c000030u) // nmadd.s
NEVERD_MICRO_LEGACY_FP_TERNARY(0x0a, 0x4c000031u) // nmadd.d
NEVERD_MICRO_LEGACY_FP_TERNARY(0x12, 0x4c000036u) // nmadd.ps
NEVERD_MICRO_LEGACY_FP_TERNARY(0x22, 0x4c000038u) // nmsub.s
NEVERD_MICRO_LEGACY_FP_TERNARY(0x2a, 0x4c000039u) // nmsub.d
NEVERD_MICRO_LEGACY_FP_TERNARY(0x32, 0x4c00003eu) // nmsub.ps
NEVERD_MICRO_LEGACY_FP_TERNARY(0x19, 0x4c00001eu) // alnv.ps (GPR selector)
#undef NEVERD_MICRO_LEGACY_FP_TERNARY
#endif
