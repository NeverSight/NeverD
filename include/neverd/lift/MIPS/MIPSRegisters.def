//===- MIPSRegisters.def - Integer register identities and ABI names -----===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// Shared storage slots and o32/n64 spellings. Include with
/// NEVERD_MIPS_REGISTER(Name, Index, O32, N64),
/// NEVERD_MIPS_GPR(Name, Index, O32, N64, CapstoneRegister), or
/// NEVERD_MIPS_REGISTER_TEXT(Name, Text) defined.
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_MIPS_REGISTER
#define NEVERD_MIPS_REGISTER(Name, Index, O32, N64)
#endif
#ifndef NEVERD_MIPS_GPR
#define NEVERD_MIPS_GPR(Name, Index, O32, N64, Reg)                            \
  NEVERD_MIPS_REGISTER(Name, Index, O32, N64)
#endif
#ifndef NEVERD_MIPS_REGISTER_TEXT
#define NEVERD_MIPS_REGISTER_TEXT(Name, Text)
#endif

NEVERD_MIPS_GPR(Zero, 0, "zero", "zero", MIPS_REG_ZERO)
NEVERD_MIPS_GPR(AT, 1, "at", "at", MIPS_REG_AT)
NEVERD_MIPS_GPR(V0, 2, "v0", "v0", MIPS_REG_V0)
NEVERD_MIPS_GPR(V1, 3, "v1", "v1", MIPS_REG_V1)
NEVERD_MIPS_GPR(A0, 4, "a0", "a0", MIPS_REG_A0)
NEVERD_MIPS_GPR(A1, 5, "a1", "a1", MIPS_REG_A1)
NEVERD_MIPS_GPR(A2, 6, "a2", "a2", MIPS_REG_A2)
NEVERD_MIPS_GPR(A3, 7, "a3", "a3", MIPS_REG_A3)
NEVERD_MIPS_GPR(R8, 8, "t0", "a4", MIPS_REG_T0)
NEVERD_MIPS_GPR(R9, 9, "t1", "a5", MIPS_REG_T1)
NEVERD_MIPS_GPR(R10, 10, "t2", "a6", MIPS_REG_T2)
NEVERD_MIPS_GPR(R11, 11, "t3", "a7", MIPS_REG_T3)
NEVERD_MIPS_GPR(R12, 12, "t4", "t0", MIPS_REG_T4)
NEVERD_MIPS_GPR(R13, 13, "t5", "t1", MIPS_REG_T5)
NEVERD_MIPS_GPR(R14, 14, "t6", "t2", MIPS_REG_T6)
NEVERD_MIPS_GPR(R15, 15, "t7", "t3", MIPS_REG_T7)
NEVERD_MIPS_GPR(S0, 16, "s0", "s0", MIPS_REG_S0)
NEVERD_MIPS_GPR(S1, 17, "s1", "s1", MIPS_REG_S1)
NEVERD_MIPS_GPR(S2, 18, "s2", "s2", MIPS_REG_S2)
NEVERD_MIPS_GPR(S3, 19, "s3", "s3", MIPS_REG_S3)
NEVERD_MIPS_GPR(S4, 20, "s4", "s4", MIPS_REG_S4)
NEVERD_MIPS_GPR(S5, 21, "s5", "s5", MIPS_REG_S5)
NEVERD_MIPS_GPR(S6, 22, "s6", "s6", MIPS_REG_S6)
NEVERD_MIPS_GPR(S7, 23, "s7", "s7", MIPS_REG_S7)
NEVERD_MIPS_GPR(T8, 24, "t8", "t8", MIPS_REG_T8)
NEVERD_MIPS_GPR(T9, 25, "t9", "t9", MIPS_REG_T9)
NEVERD_MIPS_GPR(K0, 26, "k0", "k0", MIPS_REG_K0)
NEVERD_MIPS_GPR(K1, 27, "k1", "k1", MIPS_REG_K1)
NEVERD_MIPS_GPR(GP, 28, "gp", "gp", MIPS_REG_GP)
NEVERD_MIPS_GPR(SP, 29, "sp", "sp", MIPS_REG_SP)
NEVERD_MIPS_GPR(FP, 30, "fp", "fp", MIPS_REG_FP)
NEVERD_MIPS_GPR(RA, 31, "ra", "ra", MIPS_REG_RA)
NEVERD_MIPS_REGISTER(HI, 32, "hi", "hi")
NEVERD_MIPS_REGISTER(LO, 33, "lo", "lo")
NEVERD_MIPS_REGISTER(PC, 34, "pc", "pc")
NEVERD_MIPS_REGISTER(DSPControl, 35, "dspcontrol", "dspcontrol")

NEVERD_MIPS_REGISTER(AC1HI, 36, "ac1_hi", "ac1_hi")
NEVERD_MIPS_REGISTER(AC1LO, 37, "ac1_lo", "ac1_lo")
NEVERD_MIPS_REGISTER(AC2HI, 38, "ac2_hi", "ac2_hi")
NEVERD_MIPS_REGISTER(AC2LO, 39, "ac2_lo", "ac2_lo")
NEVERD_MIPS_REGISTER(AC3HI, 40, "ac3_hi", "ac3_hi")
NEVERD_MIPS_REGISTER(AC3LO, 41, "ac3_lo", "ac3_lo")
NEVERD_MIPS_REGISTER(AC0Pending, 42, "ac0_pending", "ac0_pending")

NEVERD_MIPS_REGISTER_TEXT(UnknownRegister, "unknown_mips_register")

#undef NEVERD_MIPS_REGISTER
#undef NEVERD_MIPS_REGISTER_TEXT
#undef NEVERD_MIPS_GPR
