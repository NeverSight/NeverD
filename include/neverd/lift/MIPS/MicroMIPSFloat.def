//===- MicroMIPSFloat.def - microMIPS Release 6 POOL32F forms -------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Physical minor, equivalent COP1 bits. Argument order is encoded by the group.

#ifdef NEVERD_MICRO_FP_BINARY
NEVERD_MICRO_FP_BINARY(0x0030, 0x46000000u) // add.s
NEVERD_MICRO_FP_BINARY(0x0070, 0x46000001u) // sub.s
NEVERD_MICRO_FP_BINARY(0x00b0, 0x46000002u) // mul.s
NEVERD_MICRO_FP_BINARY(0x00f0, 0x46000003u) // div.s
NEVERD_MICRO_FP_BINARY(0x01b8, 0x46000018u) // maddf.s
NEVERD_MICRO_FP_BINARY(0x01f8, 0x46000019u) // msubf.s
NEVERD_MICRO_FP_BINARY(0x0003, 0x4600001cu) // min.s
NEVERD_MICRO_FP_BINARY(0x0023, 0x4600001du) // mina.s
NEVERD_MICRO_FP_BINARY(0x000b, 0x4600001eu) // max.s
NEVERD_MICRO_FP_BINARY(0x002b, 0x4600001fu) // maxa.s
NEVERD_MICRO_FP_BINARY(0x0130, 0x46200000u) // add.d
NEVERD_MICRO_FP_BINARY(0x0170, 0x46200001u) // sub.d
NEVERD_MICRO_FP_BINARY(0x01b0, 0x46200002u) // mul.d
NEVERD_MICRO_FP_BINARY(0x01f0, 0x46200003u) // div.d
NEVERD_MICRO_FP_BINARY(0x03b8, 0x46200018u) // maddf.d
NEVERD_MICRO_FP_BINARY(0x03f8, 0x46200019u) // msubf.d
NEVERD_MICRO_FP_BINARY(0x0203, 0x4620001cu) // min.d
NEVERD_MICRO_FP_BINARY(0x0223, 0x4620001du) // mina.d
NEVERD_MICRO_FP_BINARY(0x020b, 0x4620001eu) // max.d
NEVERD_MICRO_FP_BINARY(0x022b, 0x4620001fu) // maxa.d
NEVERD_MICRO_FP_BINARY(0x00b8, 0x46000010u) // sel.s
NEVERD_MICRO_FP_BINARY(0x0038, 0x46000014u) // seleqz.s
NEVERD_MICRO_FP_BINARY(0x0078, 0x46000017u) // selnez.s
NEVERD_MICRO_FP_BINARY(0x02b8, 0x46200010u) // sel.d
NEVERD_MICRO_FP_BINARY(0x0238, 0x46200014u) // seleqz.d
NEVERD_MICRO_FP_BINARY(0x0278, 0x46200017u) // selnez.d
#undef NEVERD_MICRO_FP_BINARY
#endif

#ifdef NEVERD_MICRO_FP_UNARY
NEVERD_MICRO_FP_UNARY(0x0a3b, 0x46000004u) // sqrt.s
NEVERD_MICRO_FP_UNARY(0x333b, 0x46000008u) // round.l.s
NEVERD_MICRO_FP_UNARY(0x233b, 0x46000009u) // trunc.l.s
NEVERD_MICRO_FP_UNARY(0x133b, 0x4600000au) // ceil.l.s
NEVERD_MICRO_FP_UNARY(0x033b, 0x4600000bu) // floor.l.s
NEVERD_MICRO_FP_UNARY(0x3b3b, 0x4600000cu) // round.w.s
NEVERD_MICRO_FP_UNARY(0x2b3b, 0x4600000du) // trunc.w.s
NEVERD_MICRO_FP_UNARY(0x1b3b, 0x4600000eu) // ceil.w.s
NEVERD_MICRO_FP_UNARY(0x0b3b, 0x4600000fu) // floor.w.s
NEVERD_MICRO_FP_UNARY(0x123b, 0x46000015u) // recip.s
NEVERD_MICRO_FP_UNARY(0x023b, 0x46000016u) // rsqrt.s
NEVERD_MICRO_FP_UNARY(0x137b, 0x46000021u) // cvt.d.s
NEVERD_MICRO_FP_UNARY(0x093b, 0x46000024u) // cvt.w.s
NEVERD_MICRO_FP_UNARY(0x013b, 0x46000025u) // cvt.l.s
NEVERD_MICRO_FP_UNARY(0x4a3b, 0x46200004u) // sqrt.d
NEVERD_MICRO_FP_UNARY(0x733b, 0x46200008u) // round.l.d
NEVERD_MICRO_FP_UNARY(0x633b, 0x46200009u) // trunc.l.d
NEVERD_MICRO_FP_UNARY(0x533b, 0x4620000au) // ceil.l.d
NEVERD_MICRO_FP_UNARY(0x433b, 0x4620000bu) // floor.l.d
NEVERD_MICRO_FP_UNARY(0x7b3b, 0x4620000cu) // round.w.d
NEVERD_MICRO_FP_UNARY(0x6b3b, 0x4620000du) // trunc.w.d
NEVERD_MICRO_FP_UNARY(0x5b3b, 0x4620000eu) // ceil.w.d
NEVERD_MICRO_FP_UNARY(0x4b3b, 0x4620000fu) // floor.w.d
NEVERD_MICRO_FP_UNARY(0x523b, 0x46200015u) // recip.d
NEVERD_MICRO_FP_UNARY(0x423b, 0x46200016u) // rsqrt.d
NEVERD_MICRO_FP_UNARY(0x1b7b, 0x46200020u) // cvt.s.d
NEVERD_MICRO_FP_UNARY(0x493b, 0x46200024u) // cvt.w.d
NEVERD_MICRO_FP_UNARY(0x413b, 0x46200025u) // cvt.l.d
NEVERD_MICRO_FP_UNARY(0x3b7b, 0x46800020u) // cvt.s.w
NEVERD_MICRO_FP_UNARY(0x337b, 0x46800021u) // cvt.d.w
NEVERD_MICRO_FP_UNARY(0x5b7b, 0x46a00020u) // cvt.s.l
NEVERD_MICRO_FP_UNARY(0x537b, 0x46a00021u) // cvt.d.l
NEVERD_MICRO_FP_UNARY(0x037b, 0x46000005u) // abs.s
NEVERD_MICRO_FP_UNARY(0x007b, 0x46000006u) // mov.s
NEVERD_MICRO_FP_UNARY(0x0b7b, 0x46000007u) // neg.s
NEVERD_MICRO_FP_UNARY(0x237b, 0x46200005u) // abs.d
NEVERD_MICRO_FP_UNARY(0x207b, 0x46200006u) // mov.d
NEVERD_MICRO_FP_UNARY(0x2b7b, 0x46200007u) // neg.d
#undef NEVERD_MICRO_FP_UNARY
#endif

#ifdef NEVERD_MICRO_FP_REVERSED
NEVERD_MICRO_FP_REVERSED(0x0020, 0x4600001au) // rint.s
NEVERD_MICRO_FP_REVERSED(0x0220, 0x4620001au) // rint.d
NEVERD_MICRO_FP_REVERSED(0x0060, 0x4600001bu) // class.s
NEVERD_MICRO_FP_REVERSED(0x0260, 0x4620001bu) // class.d
#undef NEVERD_MICRO_FP_REVERSED
#endif
