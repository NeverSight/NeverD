//===- MicroMIPS64.def - Doubleword scalar field mappings ----------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Physical POOL32S function, corresponding classic SPECIAL3 function.
#ifdef NEVERD_MICRO64_BITFIELD
NEVERD_MICRO64_BITFIELD(0x2c, 3) // DEXT
NEVERD_MICRO64_BITFIELD(0x24, 1) // DEXTM
NEVERD_MICRO64_BITFIELD(0x14, 2) // DEXTU
NEVERD_MICRO64_BITFIELD(0x0c, 7) // DINS
NEVERD_MICRO64_BITFIELD(0x04, 5) // DINSM
NEVERD_MICRO64_BITFIELD(0x34, 6) // DINSU
#undef NEVERD_MICRO64_BITFIELD
#endif

// Physical function, classic SPECIAL function, rotate selector.
#ifdef NEVERD_MICRO64_SHIFT
NEVERD_MICRO64_SHIFT(0x000, 56, 0) // DSLL
NEVERD_MICRO64_SHIFT(0x040, 58, 0) // DSRL
NEVERD_MICRO64_SHIFT(0x080, 59, 0) // DSRA
NEVERD_MICRO64_SHIFT(0x0c0, 58, 1) // DROTR
NEVERD_MICRO64_SHIFT(0x008, 60, 0) // DSLL32
NEVERD_MICRO64_SHIFT(0x048, 62, 0) // DSRL32
NEVERD_MICRO64_SHIFT(0x088, 63, 0) // DSRA32
NEVERD_MICRO64_SHIFT(0x0c8, 62, 1) // DROTR32
#undef NEVERD_MICRO64_SHIFT
#endif
#ifdef NEVERD_MICRO64_VARIABLE_SHIFT
NEVERD_MICRO64_VARIABLE_SHIFT(0x010, 20, 0) // DSLLV
NEVERD_MICRO64_VARIABLE_SHIFT(0x050, 22, 0) // DSRLV
NEVERD_MICRO64_VARIABLE_SHIFT(0x090, 23, 0) // DSRAV
NEVERD_MICRO64_VARIABLE_SHIFT(0x0d0, 22, 1) // DROTRV
#undef NEVERD_MICRO64_VARIABLE_SHIFT
#endif
