//===- PowerPCVMXRegisters.def - VMX register file and ELF ABI ------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Internal vector storage follows the integer and CR slots without aliases.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_PPC_VMX_VALUE
#define NEVERD_PPC_VMX_VALUE(Name, Value)
#endif
#ifndef NEVERD_PPC_VMX_REGISTER
#define NEVERD_PPC_VMX_REGISTER(Index)
#endif

#ifdef NEVERD_PPC_VMX_FEATURE
NEVERD_PPC_VMX_FEATURE("+altivec")
#undef NEVERD_PPC_VMX_FEATURE
#endif

NEVERD_PPC_VMX_VALUE(VectorBase, 0x200)
NEVERD_PPC_VMX_VALUE(VectorBytes, 16)
NEVERD_PPC_VMX_VALUE(VectorCount, 32)
NEVERD_PPC_VMX_VALUE(FirstVectorArgument, 2)
NEVERD_PPC_VMX_VALUE(VectorArgumentCount, 12)
NEVERD_PPC_VMX_VALUE(FirstSavedVector, 20)
NEVERD_PPC_VMX_VALUE(VXFormMask, 0xfc0007ff)

NEVERD_PPC_VMX_REGISTER(0)
NEVERD_PPC_VMX_REGISTER(1)
NEVERD_PPC_VMX_REGISTER(2)
NEVERD_PPC_VMX_REGISTER(3)
NEVERD_PPC_VMX_REGISTER(4)
NEVERD_PPC_VMX_REGISTER(5)
NEVERD_PPC_VMX_REGISTER(6)
NEVERD_PPC_VMX_REGISTER(7)
NEVERD_PPC_VMX_REGISTER(8)
NEVERD_PPC_VMX_REGISTER(9)
NEVERD_PPC_VMX_REGISTER(10)
NEVERD_PPC_VMX_REGISTER(11)
NEVERD_PPC_VMX_REGISTER(12)
NEVERD_PPC_VMX_REGISTER(13)
NEVERD_PPC_VMX_REGISTER(14)
NEVERD_PPC_VMX_REGISTER(15)
NEVERD_PPC_VMX_REGISTER(16)
NEVERD_PPC_VMX_REGISTER(17)
NEVERD_PPC_VMX_REGISTER(18)
NEVERD_PPC_VMX_REGISTER(19)
NEVERD_PPC_VMX_REGISTER(20)
NEVERD_PPC_VMX_REGISTER(21)
NEVERD_PPC_VMX_REGISTER(22)
NEVERD_PPC_VMX_REGISTER(23)
NEVERD_PPC_VMX_REGISTER(24)
NEVERD_PPC_VMX_REGISTER(25)
NEVERD_PPC_VMX_REGISTER(26)
NEVERD_PPC_VMX_REGISTER(27)
NEVERD_PPC_VMX_REGISTER(28)
NEVERD_PPC_VMX_REGISTER(29)
NEVERD_PPC_VMX_REGISTER(30)
NEVERD_PPC_VMX_REGISTER(31)

#undef NEVERD_PPC_VMX_REGISTER
#undef NEVERD_PPC_VMX_VALUE
