#ifdef NEVERD_UNPACK_TEXT
NEVERD_UNPACK_TEXT(HeapImageStorage, "image")
NEVERD_UNPACK_TEXT(HeapTLSStorage, "thread_local")
NEVERD_UNPACK_TEXT(Prefix, "unpack: ")
NEVERD_UNPACK_TEXT(EmptyOptions, "{}")
NEVERD_UNPACK_TEXT(TooLarge, "unpack options JSON exceeds 64 KiB")
NEVERD_UNPACK_TEXT(ObjectRequired, "unpack options must be a JSON object")
