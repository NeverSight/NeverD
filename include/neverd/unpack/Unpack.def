//===- Unpack.def - Unpacking vocabulary, limits and report fields --------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Container formats whose images can be unpacked. Each one has a module that
// validates its files and writes observed memory back as a file. An input in
// any other container is an error; no format is guessed.
#ifdef NEVERD_UNPACK_FORMAT
NEVERD_UNPACK_FORMAT(PE64, "pe64")
#endif

// Legacy report vocabulary retained for source compatibility. Generic
// recovery always reports Unidentified and supplies no brand evidence.
#ifdef NEVERD_UNPACK_PACKER
NEVERD_UNPACK_PACKER(Unidentified, "unidentified")
NEVERD_UNPACK_PACKER(UPX, "upx")
#endif

#ifdef NEVERD_UNPACK_EVIDENCE
NEVERD_UNPACK_EVIDENCE(UPXSectionNames, "upx_section_names")
NEVERD_UNPACK_EVIDENCE(UPXPackHeader, "upx_pack_header")
NEVERD_UNPACK_EVIDENCE(UPXEntryStub, "upx_entry_stub")
#endif

// Unpacked: a transfer into generated code was accepted as the entry and the
// image at that boundary was rebuilt. NoEntry: the bounded run ended first;
// the transfers it did observe and the process stop reason say why.
// UnsupportedState: the accepted image has runtime dependencies whose
// reconstruction is unsupported. Snapshot: the caller explicitly requested
// image bytes only. Restored: supported owned runtime resources are embedded
// under an explicit fixed-address/native-environment contract.
#ifdef NEVERD_UNPACK_OUTCOME
NEVERD_UNPACK_OUTCOME(Unpacked, "unpacked")
NEVERD_UNPACK_OUTCOME(NoEntry, "no_entry")
NEVERD_UNPACK_OUTCOME(UnsupportedState, "unsupported_state")
NEVERD_UNPACK_OUTCOME(Snapshot, "snapshot")
NEVERD_UNPACK_OUTCOME(Restored, "restored")
#endif

// Transfer is the observed transfer that was accepted. Stub is retained for
// old report consumers; recovery never predicts an entry from stub bytes.
#ifdef NEVERD_UNPACK_ENTRY_SOURCE
NEVERD_UNPACK_ENTRY_SOURCE(Transfer, "transfer")
NEVERD_UNPACK_ENTRY_SOURCE(Stub, "stub")
#endif

// Static: bound by the guest loader from the input's own import directory.
// Runtime: stored by guest code after the image was mapped.
#ifdef NEVERD_UNPACK_IMPORT_ORIGIN
NEVERD_UNPACK_IMPORT_ORIGIN(Static, "static")
NEVERD_UNPACK_IMPORT_ORIGIN(Runtime, "runtime")
#endif

#ifdef NEVERD_UNPACK_LIMIT
NEVERD_UNPACK_LIMIT(Instructions, 100000000)
NEVERD_UNPACK_LIMIT(Events, 1000000)
NEVERD_UNPACK_LIMIT(TimeoutMicroseconds, 600000000)
NEVERD_UNPACK_LIMIT(Memory, 512ull * 1024 * 1024)
NEVERD_UNPACK_LIMIT(Quantum, 65536)
NEVERD_UNPACK_LIMIT(MaxTransfers, 64)
NEVERD_UNPACK_LIMIT(InputBytes, 1024ull * 1024 * 1024)
NEVERD_UNPACK_LIMIT(Imports, 1 << 20)
#endif

#ifdef NEVERD_UNPACK_REPORT_LIMIT
NEVERD_UNPACK_REPORT_LIMIT(SchemaVersion, NEVERD_UNPACK_SCHEMA_VERSION, 1)
NEVERD_UNPACK_REPORT_LIMIT(JSONLimit, NEVERD_UNPACK_OPTIONS_JSON_LIMIT, 65536)
#endif

// Guest process options whose unpacking default differs from a plain guest
// run, for every profile.
#ifdef NEVERD_UNPACK_PROCESS_DEFAULT
NEVERD_UNPACK_PROCESS_DEFAULT("instruction_limit", Limits.Instructions,
                              Instructions)
NEVERD_UNPACK_PROCESS_DEFAULT("event_limit", Limits.Events, Events)
NEVERD_UNPACK_PROCESS_DEFAULT("timeout_microseconds",
                              Limits.TimeoutMicroseconds, TimeoutMicroseconds)
NEVERD_UNPACK_PROCESS_DEFAULT("memory_limit", MemoryLimit, Memory)
NEVERD_UNPACK_PROCESS_DEFAULT("instruction_quantum", InstructionQuantum,
                              Quantum)
#endif

// Options of one guest OS model that unpacking needs. Only a stub runs, and
// it resolves the whole import table of the program it carries; its lookups
// must not depend on which exports the OS model implements.
// Option group member, option member, JSON group, JSON field, value.
#ifdef NEVERD_UNPACK_PROFILE_DEFAULT
NEVERD_UNPACK_PROFILE_DEFAULT(Windows, DeferUnmodeled, "windows",
                              "defer_unmodeled", true)
#endif

