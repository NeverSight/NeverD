NEVERD_UNPACK_TEXT(FieldType, "invalid unpack option type or value: ")
NEVERD_UNPACK_TEXT(PathRequired, "unpacking requires a nonempty input path")
NEVERD_UNPACK_TEXT(OutputRequired, "unpacking requires a nonempty output path")
NEVERD_UNPACK_TEXT(SamePath, "the unpacked output must not replace its input")
NEVERD_UNPACK_TEXT(Disabled, "unpacking by execution is disabled; rebuild "
                             "with -DNEVERD_ENABLE_CPU_EMULATION=ON")
NEVERD_UNPACK_TEXT(AllocationFailed, "could not allocate unpack report")
NEVERD_UNPACK_TEXT(RunFailed, "unpacking failed: ")
NEVERD_UNPACK_TEXT(UnexpectedException,
                   "unpacking failed with an unexpected exception")
NEVERD_UNPACK_TEXT(SessionFailed, "could not create unpack session")
NEVERD_UNPACK_TEXT(InvalidReport, "invalid unpack report")
NEVERD_UNPACK_TEXT(WriteFailed, "cannot write unpacked image: ")
#endif

#ifdef NEVERD_UNPACK_CLI_STRING
NEVERD_UNPACK_CLI_STRING(Command, "unpack")
NEVERD_UNPACK_CLI_STRING(
    Help, "Recover the image a packed executable builds at run time and emit "
          "a JSON report")
NEVERD_UNPACK_CLI_STRING(Input, "packed executable")
NEVERD_UNPACK_CLI_STRING(OutputOption, "o")
NEVERD_UNPACK_CLI_STRING(OutputHelp, "Path of the rebuilt image (required)")
NEVERD_UNPACK_CLI_STRING(OutputValue, "path")
NEVERD_UNPACK_CLI_STRING(OptionsOption, "options")
NEVERD_UNPACK_CLI_STRING(OptionsHelp,
                         "Options JSON: backend, resource limits, transfer, "
                         "snapshot_only, restore_runtime, "
                         "arguments/environment and Windows module inputs")
NEVERD_UNPACK_CLI_STRING(OptionsValue, "json")
#endif

#ifdef NEVERD_UNPACK_CLI_STATUS
NEVERD_UNPACK_CLI_STATUS(Success, 0)
NEVERD_UNPACK_CLI_STATUS(Error, 1)
NEVERD_UNPACK_CLI_STATUS(Incomplete, 3)
#endif
