//===- MIPSDSP.def - DSP selectors and admitted encodings ----------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// MIPS32 DSP control fields and the initial classic r2 instruction subset.
//===----------------------------------------------------------------------===//
#ifndef NEVERD_MIPS_DSP_FIELD
#define NEVERD_MIPS_DSP_FIELD(Name, Selector, Bits)
#endif
#ifndef NEVERD_MIPS_DSP_INSTRUCTION
#define NEVERD_MIPS_DSP_INSTRUCTION(Name, Mask, Value)
#endif

#ifndef NEVERD_MIPS_DSP_SHIFT
#define NEVERD_MIPS_DSP_SHIFT(Name, Mask, Value, Bytes, Variable, Rounded)     \
  NEVERD_MIPS_DSP_INSTRUCTION(Name, Mask, Value)
#endif

#ifndef NEVERD_MIPS_DSP_LEFT
#define NEVERD_MIPS_DSP_LEFT(Name, Mask, Value, Bytes, Variable, Saturated)    \
  NEVERD_MIPS_DSP_INSTRUCTION(Name, Mask, Value)
#endif

#ifndef NEVERD_MIPS_DSP_EXPAND
#define NEVERD_MIPS_DSP_EXPAND(Name, Value, Bytes, First, Step, Shift,         \
                               OutBytes)                                       \
  NEVERD_MIPS_DSP_INSTRUCTION(Name, 0xffe007ff, Value)
#endif

NEVERD_MIPS_DSP_FIELD(Position, 0x01, 0x0000003f)
NEVERD_MIPS_DSP_FIELD(ShiftCount, 0x02, 0x00001f80)
NEVERD_MIPS_DSP_FIELD(Carry, 0x04, 0x00002000)
NEVERD_MIPS_DSP_FIELD(Overflow, 0x08, 0x00ff0000)
NEVERD_MIPS_DSP_FIELD(Condition, 0x10, 0x0f000000)
NEVERD_MIPS_DSP_FIELD(ExtractFailure, 0x20, 0x00004000)

// The ten-bit RDDSP/WRDSP selector ignores its upper four bits.
NEVERD_MIPS_DSP_INSTRUCTION(ReadControl, 0xfc0007ff, 0x7c0004b8)
NEVERD_MIPS_DSP_INSTRUCTION(WriteControl, 0xfc0007ff, 0x7c0004f8)
NEVERD_MIPS_DSP_INSTRUCTION(AddUnsignedBytes, 0xfc0007ff, 0x7c000010)
NEVERD_MIPS_DSP_INSTRUCTION(AddSaturatedUnsignedBytes, 0xfc0007ff, 0x7c000110)
NEVERD_MIPS_DSP_INSTRUCTION(SubUnsignedBytes, 0xfc0007ff, 0x7c000050)
NEVERD_MIPS_DSP_INSTRUCTION(SubSaturatedUnsignedBytes, 0xfc0007ff, 0x7c000150)

NEVERD_MIPS_DSP_INSTRUCTION(AddSignedHalfwords, 0xfc0007ff, 0x7c000290)
NEVERD_MIPS_DSP_INSTRUCTION(AddSaturatedSignedHalfwords, 0xfc0007ff, 0x7c000390)
NEVERD_MIPS_DSP_INSTRUCTION(SubSignedHalfwords, 0xfc0007ff, 0x7c0002d0)
NEVERD_MIPS_DSP_INSTRUCTION(SubSaturatedSignedHalfwords, 0xfc0007ff, 0x7c0003d0)
NEVERD_MIPS_DSP_INSTRUCTION(MultiplyLeftBytes, 0xfc0007ff, 0x7c000190)
NEVERD_MIPS_DSP_INSTRUCTION(MultiplyRightBytes, 0xfc0007ff, 0x7c0001d0)
NEVERD_MIPS_DSP_INSTRUCTION(MultiplyRoundedHalfwords, 0xfc0007ff, 0x7c0007d0)

// Right shifts leave DSPControl unchanged. Reserved immediate bits are masked.
NEVERD_MIPS_DSP_SHIFT(ShiftRightBytes, 0xff0007ff, 0x7c000053, 1, false, false)
NEVERD_MIPS_DSP_SHIFT(ShiftRightVariableBytes, 0xfc0007ff, 0x7c0000d3, 1, true,
                      false)
NEVERD_MIPS_DSP_SHIFT(ShiftRightHalfwords, 0xfe0007ff, 0x7c000253, 2, false,
                      false)
NEVERD_MIPS_DSP_SHIFT(ShiftRightVariableHalfwords, 0xfc0007ff, 0x7c0002d3, 2,
                      true, false)
NEVERD_MIPS_DSP_SHIFT(RoundRightHalfwords, 0xfe0007ff, 0x7c000353, 2, false,
                      true)
NEVERD_MIPS_DSP_SHIFT(RoundRightVariableHalfwords, 0xfc0007ff, 0x7c0003d3, 2,
                      true, true)
NEVERD_MIPS_DSP_SHIFT(RoundRightWord, 0xfc0007ff, 0x7c000553, 4, false, true)
NEVERD_MIPS_DSP_SHIFT(RoundRightVariableWord, 0xfc0007ff, 0x7c0005d3, 4, true,
                      true)
NEVERD_MIPS_DSP_INSTRUCTION(PackHalfwords, 0xfc0007ff, 0x7c000511)
NEVERD_MIPS_DSP_INSTRUCTION(PackBytes, 0xfc0007ff, 0x7c000311)

NEVERD_MIPS_DSP_EXPAND(ExpandLeftHalfword, 0x7c000312, 2, 2, 0, 16, 4)
NEVERD_MIPS_DSP_EXPAND(ExpandRightHalfword, 0x7c000352, 2, 0, 0, 16, 4)
NEVERD_MIPS_DSP_EXPAND(ExpandFractionalLeftBytes, 0x7c000112, 1, 2, 1, 7, 2)
NEVERD_MIPS_DSP_EXPAND(ExpandFractionalRightBytes, 0x7c000152, 1, 0, 1, 7, 2)
NEVERD_MIPS_DSP_EXPAND(ExpandFractionalLeftAlternateBytes, 0x7c000192, 1, 1, 2,
                       7, 2)
NEVERD_MIPS_DSP_EXPAND(ExpandFractionalRightAlternateBytes, 0x7c0001d2, 1, 0, 2,
                       7, 2)
NEVERD_MIPS_DSP_EXPAND(ExpandLeftBytes, 0x7c000712, 1, 2, 1, 0, 2)
NEVERD_MIPS_DSP_EXPAND(ExpandRightBytes, 0x7c000752, 1, 0, 1, 0, 2)
NEVERD_MIPS_DSP_EXPAND(ExpandLeftAlternateBytes, 0x7c000792, 1, 1, 2, 0, 2)
NEVERD_MIPS_DSP_EXPAND(ExpandRightAlternateBytes, 0x7c0007d2, 1, 0, 2, 0, 2)
NEVERD_MIPS_DSP_INSTRUCTION(ReverseHalfwordBits, 0xffe007ff, 0x7c0006d2)
NEVERD_MIPS_DSP_INSTRUCTION(ReduceAddBytes, 0xfc1f07ff, 0x7c000510)
NEVERD_MIPS_DSP_INSTRUCTION(ReplicateBytes, 0xff0007ff, 0x7c000092)
NEVERD_MIPS_DSP_INSTRUCTION(ReplicateHalfwords, 0xfc0007ff, 0x7c000292)
NEVERD_MIPS_DSP_INSTRUCTION(ReplicateVariableBytes, 0xffe007ff, 0x7c0000d2)
NEVERD_MIPS_DSP_INSTRUCTION(ReplicateVariableHalfwords, 0xffe007ff, 0x7c0002d2)

NEVERD_MIPS_DSP_INSTRUCTION(AddSaturatedSignedWord, 0xfc0007ff, 0x7c000590)
NEVERD_MIPS_DSP_INSTRUCTION(SubSaturatedSignedWord, 0xfc0007ff, 0x7c0005d0)
NEVERD_MIPS_DSP_INSTRUCTION(AddSetCarry, 0xfc0007ff, 0x7c000410)
NEVERD_MIPS_DSP_INSTRUCTION(AddWithCarry, 0xfc0007ff, 0x7c000450)
NEVERD_MIPS_DSP_INSTRUCTION(ModularSubtract, 0xfc0007ff, 0x7c000490)
NEVERD_MIPS_DSP_INSTRUCTION(CompareEqualBytes, 0xfc00ffff, 0x7c000011)
NEVERD_MIPS_DSP_INSTRUCTION(CompareLessBytes, 0xfc00ffff, 0x7c000051)
NEVERD_MIPS_DSP_INSTRUCTION(CompareLessEqualBytes, 0xfc00ffff, 0x7c000091)
NEVERD_MIPS_DSP_INSTRUCTION(PickBytes, 0xfc0007ff, 0x7c0000d1)
NEVERD_MIPS_DSP_INSTRUCTION(PickHalfwords, 0xfc0007ff, 0x7c0002d1)

NEVERD_MIPS_DSP_INSTRUCTION(AbsoluteSaturatedHalfwords, 0xffe007ff, 0x7c000252)
NEVERD_MIPS_DSP_INSTRUCTION(AbsoluteSaturatedWord, 0xffe007ff, 0x7c000452)
NEVERD_MIPS_DSP_INSTRUCTION(CompareGPRBytesEqual, 0xfc0007ff, 0x7c000111)
NEVERD_MIPS_DSP_INSTRUCTION(CompareGPRBytesLess, 0xfc0007ff, 0x7c000151)
NEVERD_MIPS_DSP_INSTRUCTION(CompareGPRBytesLessEqual, 0xfc0007ff, 0x7c000191)
NEVERD_MIPS_DSP_LEFT(ShiftLeftBytes, 0xff0007ff, 0x7c000013, 1, false, false)
NEVERD_MIPS_DSP_LEFT(ShiftLeftVariableBytes, 0xfc0007ff, 0x7c000093, 1, true,
                     false)
NEVERD_MIPS_DSP_LEFT(ShiftLeftHalfwords, 0xfe0007ff, 0x7c000213, 2, false,
                     false)
NEVERD_MIPS_DSP_LEFT(ShiftLeftVariableHalfwords, 0xfc0007ff, 0x7c000293, 2,
                     true, false)
NEVERD_MIPS_DSP_LEFT(ShiftLeftSaturatedHalfwords, 0xfe0007ff, 0x7c000313, 2,
                     false, true)
NEVERD_MIPS_DSP_LEFT(ShiftLeftSaturatedVariableHalfwords, 0xfc0007ff,
                     0x7c000393, 2, true, true)
NEVERD_MIPS_DSP_LEFT(ShiftLeftSaturatedWord, 0xfc0007ff, 0x7c000513, 4, false,
                     true)
NEVERD_MIPS_DSP_LEFT(ShiftLeftSaturatedVariableWord, 0xfc0007ff, 0x7c000593, 4,
                     true, true)

NEVERD_MIPS_DSP_INSTRUCTION(MultiplyExpandedLeftHalfword, 0xfc0007ff,
                            0x7c000710)
NEVERD_MIPS_DSP_INSTRUCTION(MultiplyExpandedRightHalfword, 0xfc0007ff,
                            0x7c000750)
NEVERD_MIPS_DSP_INSTRUCTION(PackRoundedSaturatedHalfwords, 0xfc0007ff,
                            0x7c000551)
NEVERD_MIPS_DSP_INSTRUCTION(PackSaturatedUnsignedBytes, 0xfc0007ff, 0x7c0003d1)

NEVERD_MIPS_DSP_INSTRUCTION(DotAddLeftBytes, 0xfc00e7ff, 0x7c0000f0)
NEVERD_MIPS_DSP_INSTRUCTION(DotAddRightBytes, 0xfc00e7ff, 0x7c0001f0)
NEVERD_MIPS_DSP_INSTRUCTION(DotSubLeftBytes, 0xfc00e7ff, 0x7c0002f0)
NEVERD_MIPS_DSP_INSTRUCTION(DotSubRightBytes, 0xfc00e7ff, 0x7c0003f0)
NEVERD_MIPS_DSP_INSTRUCTION(DotAddFractionalHalfwords, 0xfc00e7ff, 0x7c000130)
NEVERD_MIPS_DSP_INSTRUCTION(DotSubFractionalHalfwords, 0xfc00e7ff, 0x7c000170)
NEVERD_MIPS_DSP_INSTRUCTION(MultiplySubtractFractionalHalfwords, 0xfc00e7ff,
                            0x7c0001b0)

#undef NEVERD_MIPS_DSP_LEFT
#undef NEVERD_MIPS_DSP_EXPAND
#undef NEVERD_MIPS_DSP_SHIFT
#undef NEVERD_MIPS_DSP_FIELD
#undef NEVERD_MIPS_DSP_INSTRUCTION
