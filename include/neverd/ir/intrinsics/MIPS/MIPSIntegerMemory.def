// Major opcode, access bytes, store, signed load, and 64-bit GPR requirement.
#ifndef NEVERD_MIPS_NAMED_INTEGER_MEMORY
#define NEVERD_MIPS_NAMED_INTEGER_MEMORY(Name, Op, Bytes, Store, Signed, Wide) \
  NEVERD_MIPS_INTEGER_MEMORY(Op, Bytes, Store, Signed, Wide)
#endif

NEVERD_MIPS_NAMED_INTEGER_MEMORY(LB, 32, 1, false, true, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(LH, 33, 2, false, true, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(LW, 35, 4, false, true, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(LBU, 36, 1, false, false, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(LHU, 37, 2, false, false, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(LWU, 39, 4, false, false, true)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(SB, 40, 1, true, false, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(SH, 41, 2, true, false, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(SW, 43, 4, true, false, false)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(LD, 55, 8, false, true, true)
NEVERD_MIPS_NAMED_INTEGER_MEMORY(SD, 63, 8, true, false, true)

#undef NEVERD_MIPS_NAMED_INTEGER_MEMORY
#undef NEVERD_MIPS_INTEGER_MEMORY
