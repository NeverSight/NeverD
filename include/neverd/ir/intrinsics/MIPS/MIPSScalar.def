//===- MIPSScalar.def - MIPS scalar intrinsic contracts ------------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Define the desired table macro before including this file. Published IDs
// and instruction encodings are stable; byte widths are architectural values.

#ifndef NEVERD_MIPS_MERGE_LOAD
#define NEVERD_MIPS_MERGE_LOAD(Id, Value, Opcode, Bytes, Left, CName)
#endif
#ifndef NEVERD_MIPS_SCALAR_INTRINSIC
#define NEVERD_MIPS_SCALAR_INTRINSIC(Id, Value, CName)
#endif
#ifndef NEVERD_MIPS_SCALAR_TEXT
#define NEVERD_MIPS_SCALAR_TEXT(Name, Text)
#endif
#ifndef NEVERD_MIPS_MERGE_STORE
#define NEVERD_MIPS_MERGE_STORE(Id, Value, Opcode, Bytes, Left, CName)         \
  NEVERD_MIPS_SCALAR_INTRINSIC(Id, Value, CName)
#endif

NEVERD_MIPS_MERGE_LOAD(MIPSLwl, 16000, 0x22, 4, true, "neverd_mips_lwl")
NEVERD_MIPS_MERGE_LOAD(MIPSLwr, 16001, 0x26, 4, false, "neverd_mips_lwr")
NEVERD_MIPS_MERGE_LOAD(MIPSLdl, 16002, 0x1a, 8, true, "neverd_mips_ldl")
NEVERD_MIPS_MERGE_LOAD(MIPSLdr, 16003, 0x1b, 8, false, "neverd_mips_ldr")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSUnpredictable, 16004,
                             "neverd_mips_unpredictable")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSRequireWord, 16005, "neverd_mips_require_word")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSLwrUpper, 16006, "neverd_mips_lwr_upper")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSReadDSPControl, 16007,
                             "neverd_mips_read_dspcontrol")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSWriteDSPControl, 16008,
                             "neverd_mips_write_dspcontrol")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSDivWord, 16009, "neverd_mips_div_word")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSDivUnsignedWord, 16010,
                             "neverd_mips_div_unsigned_word")
NEVERD_MIPS_MERGE_STORE(MIPSSwl, 16011, 0x2a, 4, true, "neverd_mips_swl")
NEVERD_MIPS_MERGE_STORE(MIPSSwr, 16012, 0x2e, 4, false, "neverd_mips_swr")

NEVERD_MIPS_SCALAR_INTRINSIC(MIPSExecutionHazardBarrier, 16013,
                             "neverd_mips_ehb")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSSync, 16014, "neverd_mips_sync")

NEVERD_MIPS_SCALAR_INTRINSIC(MIPSLoadLinkedWord, 16015, "neverd_mips_ll")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSStoreConditionalWord, 16016, "neverd_mips_sc")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSReadHardwareRegister, 16017,
                             "neverd_mips_rdhwr")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSDisableInterrupts, 16018, "neverd_mips_di")
NEVERD_MIPS_SCALAR_INTRINSIC(MIPSEnableInterrupts, 16019, "neverd_mips_ei")
NEVERD_MIPS_SCALAR_TEXT(
    kStatefulSourceUnsupported,
    "MIPS system/reservation state requires an authenticated execution "
    "context; native source lowering is not supported")

NEVERD_MIPS_SCALAR_TEXT(kMalformedScalar,
                        "invalid MIPS scalar intrinsic operand/output contract")
NEVERD_MIPS_SCALAR_TEXT(
    kUnpredictableResult,
    "MIPS source output observes an architecturally unpredictable value")
NEVERD_MIPS_SCALAR_TEXT(kPartialLwrRequiresWord,
                        "partial MIPS64 LWR requires a sign-extended word or "
                        "an explicit CPU policy")

#undef NEVERD_MIPS_MERGE_LOAD
#undef NEVERD_MIPS_MERGE_STORE
#undef NEVERD_MIPS_SCALAR_INTRINSIC
#undef NEVERD_MIPS_SCALAR_TEXT
