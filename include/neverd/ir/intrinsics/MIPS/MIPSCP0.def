//===- MIPSCP0.def - Admitted MIPS32 CP0 word views ----------------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Register, selector, software-visible word, locally writable.
// The stable key is (selector << 5) | register. EPC preserves the ISA-mode bit.
NEVERD_MIPS_CP0(12, 0, Status, false)
NEVERD_MIPS_CP0(14, 0, EPC, true)
NEVERD_MIPS_CP0(30, 0, ErrorEPC, true)
NEVERD_MIPS_CP0(0, 1, MVPControl, false)
NEVERD_MIPS_CP0(1, 1, VPEControl, false)
NEVERD_MIPS_CP0(1, 2, VPEConf0, false)
#undef NEVERD_MIPS_CP0
