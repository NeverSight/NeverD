//===- RISCVFloating.def - Scalar F/D value and control effects ---------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// Result and input machine values. N ends the argument list. The final field
// distinguishes rounding operands from funct3 selectors such as FMIN/FMAX.
RISCV_FP_FORM(AddS, Add, "fadd.s", S, S, S, N, true)
RISCV_FP_FORM(AddD, Add, "fadd.d", D, D, D, N, true)
RISCV_FP_FORM(SubS, Sub, "fsub.s", S, S, S, N, true)
RISCV_FP_FORM(SubD, Sub, "fsub.d", D, D, D, N, true)
RISCV_FP_FORM(MulS, Mul, "fmul.s", S, S, S, N, true)
RISCV_FP_FORM(MulD, Mul, "fmul.d", D, D, D, N, true)
RISCV_FP_FORM(DivS, Div, "fdiv.s", S, S, S, N, true)
RISCV_FP_FORM(DivD, Div, "fdiv.d", D, D, D, N, true)
RISCV_FP_FORM(SqrtS, Sqrt, "fsqrt.s", S, S, N, N, true)
RISCV_FP_FORM(SqrtD, Sqrt, "fsqrt.d", D, D, N, N, true)
RISCV_FP_FORM(MAddS, MAdd, "fmadd.s", S, S, S, S, true)
RISCV_FP_FORM(MAddD, MAdd, "fmadd.d", D, D, D, D, true)
RISCV_FP_FORM(MSubS, MSub, "fmsub.s", S, S, S, S, true)
RISCV_FP_FORM(MSubD, MSub, "fmsub.d", D, D, D, D, true)
RISCV_FP_FORM(NMSubS, NMSub, "fnmsub.s", S, S, S, S, true)
RISCV_FP_FORM(NMSubD, NMSub, "fnmsub.d", D, D, D, D, true)
RISCV_FP_FORM(NMAddS, NMAdd, "fnmadd.s", S, S, S, S, true)
RISCV_FP_FORM(NMAddD, NMAdd, "fnmadd.d", D, D, D, D, true)
RISCV_FP_FORM(MinS, Min, "fmin.s", S, S, S, N, false)
RISCV_FP_FORM(MinD, Min, "fmin.d", D, D, D, N, false)
RISCV_FP_FORM(MaxS, Max, "fmax.s", S, S, S, N, false)
RISCV_FP_FORM(MaxD, Max, "fmax.d", D, D, D, N, false)
RISCV_FP_FORM(EqS, Eq, "feq.s", X, S, S, N, false)
RISCV_FP_FORM(EqD, Eq, "feq.d", X, D, D, N, false)
RISCV_FP_FORM(LtS, Lt, "flt.s", X, S, S, N, false)
RISCV_FP_FORM(LtD, Lt, "flt.d", X, D, D, N, false)
RISCV_FP_FORM(LeS, Le, "fle.s", X, S, S, N, false)
RISCV_FP_FORM(LeD, Le, "fle.d", X, D, D, N, false)
RISCV_FP_FORM(ClassS, Class, "fclass.s", X, S, N, N, false)
RISCV_FP_FORM(ClassD, Class, "fclass.d", X, D, N, N, false)
RISCV_FP_FORM(ToWS, ToW, "fcvt.w.s", W, S, N, N, true)
RISCV_FP_FORM(ToWD, ToW, "fcvt.w.d", W, D, N, N, true)
RISCV_FP_FORM(ToWUS, ToWU, "fcvt.wu.s", WU, S, N, N, true)
RISCV_FP_FORM(ToWUD, ToWU, "fcvt.wu.d", WU, D, N, N, true)
RISCV_FP_FORM(ToLS, ToL, "fcvt.l.s", L, S, N, N, true)
RISCV_FP_FORM(ToLD, ToL, "fcvt.l.d", L, D, N, N, true)
RISCV_FP_FORM(ToLUS, ToLU, "fcvt.lu.s", LU, S, N, N, true)
RISCV_FP_FORM(ToLUD, ToLU, "fcvt.lu.d", LU, D, N, N, true)
RISCV_FP_FORM(FromWS, FromW, "fcvt.s.w", S, W, N, N, true)
RISCV_FP_FORM(FromWD, FromW, "fcvt.d.w", D, W, N, N, true)
RISCV_FP_FORM(FromWUS, FromWU, "fcvt.s.wu", S, WU, N, N, true)
RISCV_FP_FORM(FromWUD, FromWU, "fcvt.d.wu", D, WU, N, N, true)
RISCV_FP_FORM(FromLS, FromL, "fcvt.s.l", S, L, N, N, true)
RISCV_FP_FORM(FromLD, FromL, "fcvt.d.l", D, L, N, N, true)
RISCV_FP_FORM(FromLUS, FromLU, "fcvt.s.lu", S, LU, N, N, true)
RISCV_FP_FORM(FromLUD, FromLU, "fcvt.d.lu", D, LU, N, N, true)
RISCV_FP_FORM(ToS, Convert, "fcvt.s.d", S, D, N, N, true)
RISCV_FP_FORM(ToD, Convert, "fcvt.d.s", D, S, N, N, true)
#undef RISCV_FP_FORM
