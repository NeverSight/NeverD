//===- RISCVCycle.def - Zicntr cycle CSR reads ---------------------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// CSRRS with rs1=x0 reads the indicated CSR without writing it. The word
/// excludes rd. The high half is available only when XLEN is 32.
///
/// NEVERD_RISCV_CYCLE(Id, Value, Word, HighHalf, Mnemonic)
//===----------------------------------------------------------------------===//

NEVERD_RISCV_CYCLE(RISCVRdcycle, 18016, 0xc0002073, false, "rdcycle")
NEVERD_RISCV_CYCLE(RISCVRdcycleh, 18017, 0xc8002073, true, "rdcycleh")

#undef NEVERD_RISCV_CYCLE
