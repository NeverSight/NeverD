                               "malformed AArch64 original memory operation")
NEVERD_A64_ADDRESS_MEMORY_TEXT(
    kAddressMemorySPUnsupported,
    "SP-origin memory projection requires an "
    "explicit raw-SP parameter without an image; "
    "reconstructed stack environments are unqualified")
NEVERD_A64_ADDRESS_MEMORY_TEXT(
    kAddressMemoryImmediateImageUnsupported,
    "immediate original memory requires a runtime GPR value or a complete "
    "occurrence-bound image span")

