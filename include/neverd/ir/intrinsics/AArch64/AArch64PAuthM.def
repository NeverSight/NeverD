//===- AArch64PAuthM.def - PACM instruction prefix contracts ---*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// PACM affects the next executed instruction only (DDI0487 M.d D8.10.4).
/// The mode operand records whether that path executed the prefix; hardware
/// still supplies feature/enable controls. These implicit recipes must remain
/// distinct from explicit PAuth_LR recipes when FEAT_PACIMP is present.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_A64_PAUTH_M_MARKER
#define NEVERD_A64_PAUTH_M_MARKER(Id, Name)
#endif
#ifndef NEVERD_A64_PAUTH_M_OPERATION
#define NEVERD_A64_PAUTH_M_OPERATION(Id, Mnemonic, Key, Auth, Return, Asm)
#endif
#ifndef NEVERD_A64_PAUTH_M_CONSUMER
#define NEVERD_A64_PAUTH_M_CONSUMER(Word, Id, Mod2)
#endif
#ifndef NEVERD_A64_PAUTH_M_VALUE
#define NEVERD_A64_PAUTH_M_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_A64_PAUTH_M_TEXT
#define NEVERD_A64_PAUTH_M_TEXT(Name, Text)
#endif

NEVERD_A64_PAUTH_M_MARKER(A64_PACMPending, "__neverd_pending_pacm")

NEVERD_A64_PAUTH_M_OPERATION(A64_PaciaM, "pacm_pacia", IA, false, false,
                             ".inst 0xd503211f")
NEVERD_A64_PAUTH_M_OPERATION(A64_PacibM, "pacm_pacib", IB, false, false,
                             ".inst 0xd503215f")
NEVERD_A64_PAUTH_M_OPERATION(A64_AutiaM, "pacm_autia", IA, true, false,
                             ".inst 0xd503219f")
NEVERD_A64_PAUTH_M_OPERATION(A64_AutibM, "pacm_autib", IB, true, false,
                             ".inst 0xd50321df")
NEVERD_A64_PAUTH_M_OPERATION(A64_AuthReturnIAM, "pacm_retaa", IA, true, true,
                             ".inst 0xd503219f")
NEVERD_A64_PAUTH_M_OPERATION(A64_AuthReturnIBM, "pacm_retab", IB, true, true,
                             ".inst 0xd50321df")

NEVERD_A64_PAUTH_M_CONSUMER(0xd503233f, A64_PaciaM, PC)
NEVERD_A64_PAUTH_M_CONSUMER(0xd503237f, A64_PacibM, PC)
NEVERD_A64_PAUTH_M_CONSUMER(0xd50323bf, A64_AutiaM, X16)
NEVERD_A64_PAUTH_M_CONSUMER(0xd50323ff, A64_AutibM, X16)
NEVERD_A64_PAUTH_M_CONSUMER(0xd65f0bff, A64_AuthReturnIAM, X16)
NEVERD_A64_PAUTH_M_CONSUMER(0xd65f0fff, A64_AuthReturnIBM, X16)
NEVERD_A64_PAUTH_M_CONSUMER(0xd503211f, A64_PaciaM, X15)
NEVERD_A64_PAUTH_M_CONSUMER(0xd503215f, A64_PacibM, X15)
NEVERD_A64_PAUTH_M_CONSUMER(0xd503219f, A64_AutiaM, X15)
NEVERD_A64_PAUTH_M_CONSUMER(0xd50321df, A64_AutibM, X15)

NEVERD_A64_PAUTH_M_VALUE(uint32_t, kAArch64PACMEncoding, 0xd50324ff)
NEVERD_A64_PAUTH_M_VALUE(unsigned, kAArch64PACMOperandCount, 4)
// All operand materialization precedes this indivisible instruction pair.
NEVERD_A64_PAUTH_M_TEXT(kAArch64PACMPrefixLLVM,
                        "cbz $4, 2f\n.inst 0xd50324ff\n2:\n")
NEVERD_A64_PAUTH_M_TEXT(kAArch64PACMPrefixC,
                        "cbz %4, 2f\n.inst 0xd50324ff\n2:\n")
NEVERD_A64_PAUTH_M_TEXT(kAArch64PACMConstraints, "={x17},0,{x16},{x15},r")
NEVERD_A64_PAUTH_M_TEXT(kAArch64PACMReturnConstraints,
                        "={x17},0,{x16},{x15},r,~{x14},~{cc}")

#undef NEVERD_A64_PAUTH_M_MARKER
#undef NEVERD_A64_PAUTH_M_OPERATION
#undef NEVERD_A64_PAUTH_M_CONSUMER
#undef NEVERD_A64_PAUTH_M_VALUE
#undef NEVERD_A64_PAUTH_M_TEXT
