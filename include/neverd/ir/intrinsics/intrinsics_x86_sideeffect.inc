SIDEEFFECT(Intrinsic::Int1);
SIDEEFFECT(Intrinsic::IntN);
SIDEEFFECT(Intrinsic::Into);
SIDEEFFECT(Intrinsic::Ud2);
SIDEEFFECT(Intrinsic::Hlt);
