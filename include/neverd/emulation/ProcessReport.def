#ifdef NEVERD_PROCESS_REPORT_LIMIT
NEVERD_PROCESS_REPORT_LIMIT(SchemaVersion, NEVERD_PROCESS_SCHEMA_VERSION, 1)
// 1 MiB of explicit DEX bytes uses 2 MiB of hexadecimal text. Other request
// text retains its separate 64 KiB ceiling, including JSON escape overhead.
NEVERD_PROCESS_REPORT_LIMIT(JSONLimit, NEVERD_PROCESS_OPTIONS_JSON_LIMIT,
                            2162688)
NEVERD_PROCESS_REPORT_LIMIT(JSONMetadataLimit,
                            NEVERD_PROCESS_OPTIONS_JSON_METADATA_LIMIT, 65536)
#endif
