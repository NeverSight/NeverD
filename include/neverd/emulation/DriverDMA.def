NEVERD_DRIVER_DMA_LIMIT(DriverDmaAlignmentLimit, 4096)
NEVERD_DRIVER_DMA_LIMIT(DriverDmaPageSize, 4096)
NEVERD_DRIVER_DMA_LIMIT(DriverDmaLogicalLengthLimit, 1073741824)
NEVERD_DRIVER_DMA_LIMIT(DriverScenarioDmaEventsPerRequestLimit, 64)
NEVERD_DRIVER_DMA_LIMIT(DriverScenarioDmaEventLimit, 1024)
NEVERD_DRIVER_DMA_LIMIT(DriverScenarioDmaBytesLimit, 16777216)
#endif

#ifdef NEVERD_DRIVER_DMA_ADDRESS
NEVERD_DRIVER_DMA_ADDRESS(DriverDmaPhysicalBase, 0x1000000000ULL)
NEVERD_DRIVER_DMA_ADDRESS(DriverDmaPhysicalSize, 0x100000ULL)
#endif

