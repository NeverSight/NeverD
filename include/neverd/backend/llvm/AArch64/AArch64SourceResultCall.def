/// \file
/// RESULT_CALL_VALUE and RESULT_CALL_TEXT own the packet layout, AArch64
/// instruction templates and C spelling. RESULT_CALL_CLOBBER lists registers
/// overwritten by the bridge or the callee. x18 is Darwin's reserved register.
//===----------------------------------------------------------------------===//
#ifndef RESULT_CALL_VALUE
#define RESULT_CALL_VALUE(Name, Value)
#endif
#ifndef RESULT_CALL_TEXT
#define RESULT_CALL_TEXT(Name, Text)
#endif
#ifndef RESULT_CALL_INPUTS
#define RESULT_CALL_INPUTS(Text)
#endif
#ifndef VALUE_CALL_INPUTS
#define VALUE_CALL_INPUTS(Text)
#endif
#ifndef RESULT_CALL_CLOBBER
#define RESULT_CALL_CLOBBER(Name)
#endif

RESULT_CALL_INPUTS("r,r")
VALUE_CALL_INPUTS("r,r,r")
RESULT_CALL_VALUE(kResultCallWordBytes, 8)
RESULT_CALL_VALUE(kResultCallFloatBytes, 4)
RESULT_CALL_VALUE(kResultCallHalfBytes, 2)
RESULT_CALL_VALUE(kResultCallByteBytes, 1)
RESULT_CALL_VALUE(kResultCallScratchRegister, 9)
RESULT_CALL_VALUE(kResultCallHeaderWords, 4)
RESULT_CALL_VALUE(kValueCallHeaderWords, 2)
RESULT_CALL_VALUE(kResultCallInputCount, 2)
RESULT_CALL_VALUE(kValueCallInputCount, 3)
RESULT_CALL_VALUE(kResultCallRedZoneBytes, 128)
RESULT_CALL_VALUE(kResultCallStackAlignment, 16)
RESULT_CALL_TEXT(kResultCallMarker, "// neverd.aarch64.result-storage.v1\n")
RESULT_CALL_TEXT(
    kResultCallPrefix,
    "mov x19, $0\nmov x20, sp\nldr x9, [x19, #24]\nsub sp, sp, x9\n")
RESULT_CALL_TEXT(kValueCallPrefix, "mov x19, $0\nmov x20, sp\nsub sp, sp, $2\n")
RESULT_CALL_TEXT(
    kResultCallSuffix,
    "ldr x16, [x19]\nldr x17, [x19, #8]\nldr x8, [x19, #16]\n{0}\nmov sp, x20")
RESULT_CALL_TEXT(kValueCallSuffix,
                 "ldr x16, [x19]\nldr x17, [x19, #8]\n{0}\nmov sp, x20")
RESULT_CALL_TEXT(kResultCallRaw, "blr x16")
RESULT_CALL_TEXT(kResultCallIA, "blraa x16, x17")
RESULT_CALL_TEXT(kResultCallIB, "blrab x16, x17")
RESULT_CALL_TEXT(kResultCallLoad, "{0} {1}{2}, [x19, #{3}]\n")
RESULT_CALL_TEXT(kResultCallStore, "{0} {1}9, [sp, #{2}]\n")
RESULT_CALL_TEXT(kResultCallResultStore, "\n{0} {1}{2}, [x19, #{3}]")
RESULT_CALL_TEXT(kResultCallLoadByte, "ldrb")
RESULT_CALL_TEXT(kResultCallLoadSignedByte, "ldrsb")
RESULT_CALL_TEXT(kResultCallLoadHalf, "ldrh")
RESULT_CALL_TEXT(kResultCallLoadSignedHalf, "ldrsh")
RESULT_CALL_TEXT(kResultCallLoadWord, "ldr")
RESULT_CALL_TEXT(kResultCallStoreByte, "strb")
RESULT_CALL_TEXT(kResultCallStoreHalf, "strh")
RESULT_CALL_TEXT(kResultCallStoreWord, "str")
RESULT_CALL_TEXT(kResultCallW, "w")
RESULT_CALL_TEXT(kResultCallX, "x")
RESULT_CALL_TEXT(kResultCallS, "s")
RESULT_CALL_TEXT(kResultCallD, "d")
RESULT_CALL_TEXT(kResultCallQ, "q")
RESULT_CALL_TEXT(kResultCallAlignmentC, "__attribute__((aligned({0}))) ")
RESULT_CALL_TEXT(kResultCallPacket, "__neverd_result_call")
RESULT_CALL_TEXT(kResultCallValue, "__neverd_result_argument")
RESULT_CALL_TEXT(
    kResultCallPacketC,
    "({{ {6}uint64_t {0}[{1}] = {{(uint64_t)({2}), (uint64_t)({3}), "
    "(uint64_t)({4}), {5}}; ")
RESULT_CALL_TEXT(kValueCallPacketC,
                 "({{ {6}uint64_t {0}[{1}]; {0}[0] = (uint64_t)({2}); "
                 "{0}[1] = (uint64_t)({3}); ")
RESULT_CALL_TEXT(kResultCallArgumentC,
                 "{{ {0} = {1}; __builtin_memcpy(&{2}[{3}], &{4}, {5}); } ")
RESULT_CALL_TEXT(kResultCallLogicalArgumentC, "{{ {0} = {1}; ")
RESULT_CALL_TEXT(kResultCallArgumentPieceC,
                 "__builtin_memcpy(&{0}[{1}], (unsigned char *)&{2} + {3}, "
                 "{4}); ")
RESULT_CALL_TEXT(kResultCallArgumentEndC, "} ")
RESULT_CALL_TEXT(
    kResultCallAsmC,
    "__asm__ volatile(\"{0}\" : : \"r\"({1}), \"r\"({2}) : {3}\"unwind\");")
RESULT_CALL_TEXT(kValueCallAsmC,
                 "__asm__ volatile(\"{0}\" : : \"r\"({1}), \"r\"({2}), "
                 "\"r\"((uint64_t)({4})) : {3}\"unwind\");")
RESULT_CALL_TEXT(kResultCallEndC, " (void)0; })")
RESULT_CALL_TEXT(kResultCallResultDeclarationC, "{0}; ")
RESULT_CALL_TEXT(kResultCallResultCopyC,
                 "__builtin_memcpy((unsigned char *)&{0} + {1}, &{2}[{3}], "
                 "{4}); ")
RESULT_CALL_TEXT(kResultCallValueEndC, " {0}; })")
RESULT_CALL_TEXT(kResultCallFrameC, "__builtin_frame_address(0)")
RESULT_CALL_TEXT(kResultCallDirectC, "__neverd_aarch64_code_address({0})")
RESULT_CALL_TEXT(kResultCallError,
                 "The AArch64 source call has incomplete carriers")
RESULT_CALL_TEXT(kResultCallFrameAttribute, "frame-pointer")
RESULT_CALL_TEXT(kResultCallFrameAll, "all")
RESULT_CALL_TEXT(kResultCallCompilerContract,
                 "\n#if !defined(__aarch64__) || !defined(__clang__) || "
                 "!defined(__EXCEPTIONS)\n#error \"AArch64 machine ABI "
                 "calls require AArch64 Clang and -fexceptions\"\n#endif\n")
