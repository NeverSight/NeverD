//===- LLVMX86X87StateAsm.def - x87 state inline-asm contracts -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// X86_X87_STATE_ASM(EFFECT, CONSTRAINTS, C_CLOBBERS)
//
// x87 instructions that change register tags, TOP or status use side-effecting
// inline asm when a native intrinsic is unavailable. CONSTRAINTS tell LLVM
// what each one destroys: emptying registers or moving TOP clobbers every
// stack register, so the x87 stackifier keeps no value in the register file
// across the instruction, and FNINIT also resets the control word.
// C_CLOBBERS carry the same contract into the LLVM-to-C rendering, spelled as
// GCC and Clang both accept them.
//
//===----------------------------------------------------------------------===//

#ifndef X86_X87_STATE_ASM
#error "Define X86_X87_STATE_ASM before including LLVMX86X87StateAsm.def"
#endif

// FWAIT, FNCLEX: exception state only.
X86_X87_STATE_ASM(Status, "~{memory},~{dirflag},~{fpsr},~{flags}", "\"memory\"")

// Environment saves mask exceptions after writing the original control word.
X86_X87_STATE_ASM(Control, "~{memory},~{dirflag},~{fpsr},~{fpcr},~{flags}",
                  "\"memory\"")

// FFREE/FFREEP, FINCSTP/FDECSTP: register tags or TOP.
X86_X87_STATE_ASM(Stack,
                  "~{memory},~{dirflag},~{fpsr},~{flags},~{st},~{st(1)},"
                  "~{st(2)},~{st(3)},~{st(4)},~{st(5)},~{st(6)},~{st(7)}",
                  "\"memory\", \"st\", \"st(1)\", \"st(2)\", \"st(3)\", "
                  "\"st(4)\", \"st(5)\", \"st(6)\", \"st(7)\"")

// FNINIT: the whole FPU state, including the MMX aliases and control word.
X86_X87_STATE_ASM(
    Reset,
    "~{memory},~{dirflag},~{fpsr},~{fpcr},~{flags},~{st},"
    "~{st(1)},~{st(2)},~{st(3)},~{st(4)},~{st(5)},~{st(6)},"
    "~{st(7)},~{mm0},~{mm1},~{mm2},~{mm3},~{mm4},~{mm5},"
    "~{mm6},~{mm7}",
    "\"memory\", \"st\", \"st(1)\", \"st(2)\", \"st(3)\", "
    "\"st(4)\", \"st(5)\", \"st(6)\", \"st(7)\", \"mm0\", "
    "\"mm1\", \"mm2\", \"mm3\", \"mm4\", \"mm5\", \"mm6\", \"mm7\"")

#undef X86_X87_STATE_ASM
