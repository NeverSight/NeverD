//===- CHeaderNames.def - What emitted C takes from its headers -*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The names emitted C uses without declaring them: types and macros of the
/// headers it includes, and the compiler builtins and intrinsics it calls.  A
/// reader of the text needs their types; a name not listed here and not
/// declared in the text is refused, or read as an intrinsic whose signature
/// the text leaves to its header.
///
///   NEVERD_C_HEADER_INTEGER(Name, Bits, Signed)
///     An integer typedef; Bits 0 is the pointer width.
///   NEVERD_C_HEADER_NAMED_TYPE(Name, Bits)
///     A type the reader keeps by name; Bits 0 when its size does not matter.
///   NEVERD_C_HEADER_CONSTANT(Name, Value)
///     An `int` macro.
///   NEVERD_C_HEADER_FUNCTION(Prototype)
///     A function or builtin, declared as C.
///   NEVERD_C_HEADER_GENERIC(Name, Result)
///     A builtin whose types follow its arguments: Result is Bool, Void,
///     Int, or Pointee (the type its first argument points to).
///
//===----------------------------------------------------------------------===//

#ifndef NEVERD_C_HEADER_INTEGER
#define NEVERD_C_HEADER_INTEGER(Name, Bits, Signed)
#endif
#ifndef NEVERD_C_HEADER_NAMED_TYPE
#define NEVERD_C_HEADER_NAMED_TYPE(Name, Bits)
#endif
#ifndef NEVERD_C_HEADER_CONSTANT
#define NEVERD_C_HEADER_CONSTANT(Name, Value)
#endif
#ifndef NEVERD_C_HEADER_FUNCTION
#define NEVERD_C_HEADER_FUNCTION(Prototype)
#endif
#ifndef NEVERD_C_HEADER_GENERIC
#define NEVERD_C_HEADER_GENERIC(Name, Result)
#endif

// <stdint.h>, <stddef.h>, <unistd.h>
NEVERD_C_HEADER_INTEGER("int8_t", 8, true)
NEVERD_C_HEADER_INTEGER("int16_t", 16, true)
NEVERD_C_HEADER_INTEGER("int32_t", 32, true)
NEVERD_C_HEADER_INTEGER("int64_t", 64, true)
NEVERD_C_HEADER_INTEGER("uint8_t", 8, false)
NEVERD_C_HEADER_INTEGER("uint16_t", 16, false)
NEVERD_C_HEADER_INTEGER("uint32_t", 32, false)
NEVERD_C_HEADER_INTEGER("uint64_t", 64, false)
NEVERD_C_HEADER_INTEGER("intptr_t", 0, true)
NEVERD_C_HEADER_INTEGER("uintptr_t", 0, false)
NEVERD_C_HEADER_INTEGER("size_t", 0, false)
NEVERD_C_HEADER_INTEGER("ssize_t", 0, true)
NEVERD_C_HEADER_INTEGER("ptrdiff_t", 0, true)
// The data model sizes it.
NEVERD_C_HEADER_INTEGER("wchar_t", 32, true)

// <stdio.h>, <setjmp.h>, <link.h>, intrinsic vectors.
NEVERD_C_HEADER_NAMED_TYPE("FILE", 0)
NEVERD_C_HEADER_NAMED_TYPE("jmp_buf", 0)
NEVERD_C_HEADER_NAMED_TYPE("va_list", 0)
NEVERD_C_HEADER_NAMED_TYPE("__m64", 64)
NEVERD_C_HEADER_NAMED_TYPE("__m128", 128)
NEVERD_C_HEADER_NAMED_TYPE("__m128d", 128)
NEVERD_C_HEADER_NAMED_TYPE("__m128i", 128)
NEVERD_C_HEADER_NAMED_TYPE("__m256", 256)
NEVERD_C_HEADER_NAMED_TYPE("__m256d", 256)
NEVERD_C_HEADER_NAMED_TYPE("__m256i", 256)
NEVERD_C_HEADER_NAMED_TYPE("__m512", 512)
NEVERD_C_HEADER_NAMED_TYPE("__m512d", 512)
NEVERD_C_HEADER_NAMED_TYPE("__m512i", 512)
NEVERD_C_HEADER_NAMED_TYPE("__mmask8", 8)
NEVERD_C_HEADER_NAMED_TYPE("__mmask16", 16)
NEVERD_C_HEADER_NAMED_TYPE("__mmask32", 32)
NEVERD_C_HEADER_NAMED_TYPE("__mmask64", 64)

// <excpt.h> and the atomic memory orders.
NEVERD_C_HEADER_CONSTANT("EXCEPTION_EXECUTE_HANDLER", 1)
NEVERD_C_HEADER_CONSTANT("EXCEPTION_CONTINUE_SEARCH", 0)
NEVERD_C_HEADER_CONSTANT("EXCEPTION_CONTINUE_EXECUTION", -1)
NEVERD_C_HEADER_CONSTANT("__ATOMIC_RELAXED", 0)
NEVERD_C_HEADER_CONSTANT("__ATOMIC_CONSUME", 1)
NEVERD_C_HEADER_CONSTANT("__ATOMIC_ACQUIRE", 2)
NEVERD_C_HEADER_CONSTANT("__ATOMIC_RELEASE", 3)
NEVERD_C_HEADER_CONSTANT("__ATOMIC_ACQ_REL", 4)
NEVERD_C_HEADER_CONSTANT("__ATOMIC_SEQ_CST", 5)

