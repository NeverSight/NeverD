//===- AArch64SVEVectorC.def - SVE vector C representation ----*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// ACLE spellings follow LLVM llvmorg-22.1.6 arm_sve.td. svuint8_t carries
/// the entire active register; reinterpretation does not convert lane values.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_A64_SVE_VECTOR_C_TYPE
#define NEVERD_A64_SVE_VECTOR_C_TYPE(Name, Text)
#endif
#ifndef NEVERD_A64_SVE_VECTOR_C_TEXT
#define NEVERD_A64_SVE_VECTOR_C_TEXT(Name, Text)
#endif
#ifndef NEVERD_A64_SVE_VECTOR_C_WIDTH
#define NEVERD_A64_SVE_VECTOR_C_WIDTH(Bytes, Scalar, Dup, Index, Last, To, From)
#endif
#ifndef NEVERD_A64_SVE_VECTOR_C_STORE
#define NEVERD_A64_SVE_VECTOR_C_STORE(Lane, Bytes, Normal, NonTemporal)
#endif

NEVERD_A64_SVE_VECTOR_C_TYPE(kVectorDeclaration, "svuint8_t {0}")
NEVERD_A64_SVE_VECTOR_C_TEXT(kVectorCall, "{0}({1})")
NEVERD_A64_SVE_VECTOR_C_TEXT(kVectorScalarBits, "({0})({1})")
NEVERD_A64_SVE_VECTOR_C_TEXT(kVectorDup, "{0}(({1})({2}))")
NEVERD_A64_SVE_VECTOR_C_TEXT(kVectorIndex, "{0}(({1})({2}), ({1})({3}))")
NEVERD_A64_SVE_VECTOR_C_TEXT(kVectorLast, "{0}({1}, {2})")
NEVERD_A64_SVE_VECTOR_C_TEXT(kVectorStore,
                             "{0}({1}, ({2} *)(uintptr_t)({3}), {4})")
NEVERD_A64_SVE_VECTOR_C_WIDTH(1, "uint8_t", "svdup_n_u8", "svindex_u8",
                              "svlastb_u8", "svreinterpret_u8_u8",
                              "svreinterpret_u8_u8")
NEVERD_A64_SVE_VECTOR_C_WIDTH(2, "uint16_t", "svdup_n_u16", "svindex_u16",
                              "svlastb_u16", "svreinterpret_u8_u16",
                              "svreinterpret_u16_u8")
NEVERD_A64_SVE_VECTOR_C_WIDTH(4, "uint32_t", "svdup_n_u32", "svindex_u32",
                              "svlastb_u32", "svreinterpret_u8_u32",
                              "svreinterpret_u32_u8")
NEVERD_A64_SVE_VECTOR_C_WIDTH(8, "uint64_t", "svdup_n_u64", "svindex_u64",
                              "svlastb_u64", "svreinterpret_u8_u64",
                              "svreinterpret_u64_u8")
NEVERD_A64_SVE_VECTOR_C_STORE(1, 1, "svst1_u8", "svstnt1_u8")
NEVERD_A64_SVE_VECTOR_C_STORE(2, 1, "svst1b_u16", nullptr)
NEVERD_A64_SVE_VECTOR_C_STORE(2, 2, "svst1_u16", "svstnt1_u16")
NEVERD_A64_SVE_VECTOR_C_STORE(4, 1, "svst1b_u32", nullptr)
NEVERD_A64_SVE_VECTOR_C_STORE(4, 2, "svst1h_u32", nullptr)
NEVERD_A64_SVE_VECTOR_C_STORE(4, 4, "svst1_u32", "svstnt1_u32")
NEVERD_A64_SVE_VECTOR_C_STORE(8, 1, "svst1b_u64", nullptr)
NEVERD_A64_SVE_VECTOR_C_STORE(8, 2, "svst1h_u64", nullptr)
NEVERD_A64_SVE_VECTOR_C_STORE(8, 4, "svst1w_u64", nullptr)
NEVERD_A64_SVE_VECTOR_C_STORE(8, 8, "svst1_u64", "svstnt1_u64")

#undef NEVERD_A64_SVE_VECTOR_C_TYPE
#undef NEVERD_A64_SVE_VECTOR_C_TEXT
#undef NEVERD_A64_SVE_VECTOR_C_WIDTH
#undef NEVERD_A64_SVE_VECTOR_C_STORE
