//===- CRotateBuiltins.def - Fixed-width C rotate builtins ----------------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
// GCC lacks Clang's fixed-width rotate builtins. Predefined unsigned types
// let their compatibility definitions precede a caller-supplied C header.

#ifndef NEVERD_C_ROTATE_BUILTIN
#define NEVERD_C_ROTATE_BUILTIN(Bytes, Bits, Mask, Type)
#endif

NEVERD_C_ROTATE_BUILTIN(1, 8, 7, "__UINT8_TYPE__")
NEVERD_C_ROTATE_BUILTIN(2, 16, 15, "__UINT16_TYPE__")
NEVERD_C_ROTATE_BUILTIN(4, 32, 31, "__UINT32_TYPE__")
NEVERD_C_ROTATE_BUILTIN(8, 64, 63, "__UINT64_TYPE__")

#undef NEVERD_C_ROTATE_BUILTIN
