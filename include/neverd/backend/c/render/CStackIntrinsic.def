#ifndef C_STACK_TEXT
#define C_STACK_TEXT(Name, Text)
#endif

C_STACK_TEXT(kLocalAddressName, "llvm_localaddress")
C_STACK_TEXT(kRetainStackFrame, "__attribute__((noinline)) ")
C_STACK_TEXT(kEntrySPName, "llvm_entry_sp")
C_STACK_TEXT(kStackIntrinsicDecl,
                 "extern void *{0}(void) __asm__(\"{1}\");\n")

C_STACK_TEXT(kNativeEntrySPName, "__neverd_entry_sp")
C_STACK_TEXT(kNativeEntryValue, "((uintptr_t){0}())")

#undef C_STACK_TEXT
