//===- X86WidenedIntrinsics.def - Wide SSE intrinsic forms ------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The C intrinsics Clang spells the VEX.256 and EVEX.512 forms of an SSE
/// operation with, where the name is not the SSE one's under the wider
/// prefix, and the target features its header declares each with.  An SSE
/// name ending in _si128 names its whole register; these forms work on each
/// 128-bit lane of theirs, which their names spell _epi128.
///
//===----------------------------------------------------------------------===//

// NEVERD_X86_WIDENED_INTRINSIC(Intrinsic, Bytes, Name, Features)
#ifndef NEVERD_X86_WIDENED_INTRINSIC
#define NEVERD_X86_WIDENED_INTRINSIC(Intrinsic, Bytes, Name, Features)
#endif

// VPCLMULQDQ
NEVERD_X86_WIDENED_INTRINSIC(Pclmulqdq, 32, "_mm256_clmulepi64_epi128",
                             "vpclmulqdq,avx")
NEVERD_X86_WIDENED_INTRINSIC(Pclmulqdq, 64, "_mm512_clmulepi64_epi128",
                             "vpclmulqdq,avx512f")

// VAES
NEVERD_X86_WIDENED_INTRINSIC(AesEnc, 32, "_mm256_aesenc_epi128", "vaes")
NEVERD_X86_WIDENED_INTRINSIC(AesEnc, 64, "_mm512_aesenc_epi128", "vaes,avx512f")
NEVERD_X86_WIDENED_INTRINSIC(AesEncLast, 32, "_mm256_aesenclast_epi128", "vaes")
NEVERD_X86_WIDENED_INTRINSIC(AesEncLast, 64, "_mm512_aesenclast_epi128",
                             "vaes,avx512f")
NEVERD_X86_WIDENED_INTRINSIC(AesDec, 32, "_mm256_aesdec_epi128", "vaes")
NEVERD_X86_WIDENED_INTRINSIC(AesDec, 64, "_mm512_aesdec_epi128", "vaes,avx512f")
NEVERD_X86_WIDENED_INTRINSIC(AesDecLast, 32, "_mm256_aesdeclast_epi128", "vaes")
NEVERD_X86_WIDENED_INTRINSIC(AesDecLast, 64, "_mm512_aesdeclast_epi128",
                             "vaes,avx512f")

#undef NEVERD_X86_WIDENED_INTRINSIC
