//===- X86IntrinsicOperandOrder.def - x86 C operand order -------*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The x86 operations whose C intrinsic takes the lifted operands in another
/// order.  The lifter keeps Intel's operand order, which for VPERMD and
/// VPERMPS names the indices before the data; _mm256_permutevar8x32_epi32
/// takes the data first.  Each entry names the lifted operand the C
/// intrinsic's first and second arguments are.
///
//===----------------------------------------------------------------------===//

// NEVERD_X86_C_OPERAND_ORDER(Intrinsic, First, Second)
#ifndef NEVERD_X86_C_OPERAND_ORDER
#define NEVERD_X86_C_OPERAND_ORDER(Intrinsic, First, Second)
#endif

NEVERD_X86_C_OPERAND_ORDER(Permd, 1, 0)

#undef NEVERD_X86_C_OPERAND_ORDER
