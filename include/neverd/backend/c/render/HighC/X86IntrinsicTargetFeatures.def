//===- X86IntrinsicTargetFeatures.def - x86 intrinsic features --*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
///
/// \file
/// The target feature a function needs to call the C intrinsic HighC spells
/// an x86 operation with: the function takes `__attribute__((target(...)))`
/// naming it, as the compiler's intrinsic headers require, so the C builds
/// with no -m option for an instruction past the target's baseline (i386 has
/// no SSE at all).  Each entry is the feature Clang's header declares the
/// intrinsic with; one the x86-64 baseline already has costs nothing there.
///
//===----------------------------------------------------------------------===//

// NEVERD_X86_TARGET_FEATURE(Intrinsic, Feature)
#ifndef NEVERD_X86_TARGET_FEATURE
#define NEVERD_X86_TARGET_FEATURE(Intrinsic, Feature)
#endif

// SSE
NEVERD_X86_TARGET_FEATURE(Shufps, "sse")
NEVERD_X86_TARGET_FEATURE(Unpckhps, "sse")
NEVERD_X86_TARGET_FEATURE(Unpcklps, "sse")
NEVERD_X86_TARGET_FEATURE(Sfence, "sse")

