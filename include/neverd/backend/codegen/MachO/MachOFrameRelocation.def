//===- MachOFrameRelocation.def - Metadata relocation contract -*- C++ -*-===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
/// \file
/// Framing spellings, diagnostics and bounded static RA comparison work.
/// Define NEVERD_MACHO_FRAME_VALUE(Type, Name, Value),
/// NEVERD_MACHO_FRAME_TEXT(Name, Text), or
/// NEVERD_MACHO_FRAME_LIMIT(Type, Name, Value) before inclusion.
//===----------------------------------------------------------------------===//

#ifndef NEVERD_MACHO_FRAME_VALUE
#define NEVERD_MACHO_FRAME_VALUE(Type, Name, Value)
#endif
#ifndef NEVERD_MACHO_FRAME_TEXT
#define NEVERD_MACHO_FRAME_TEXT(Name, Text)
#endif
#ifndef NEVERD_MACHO_FRAME_LIMIT
#define NEVERD_MACHO_FRAME_LIMIT(Type, Name, Value)
#endif

NEVERD_MACHO_FRAME_VALUE(char, kAugmentationLength, 'z')
NEVERD_MACHO_FRAME_VALUE(char, kAugmentationEncoding, 'R')
NEVERD_MACHO_FRAME_VALUE(char, kAugmentationPersonality, 'P')
NEVERD_MACHO_FRAME_VALUE(char, kAugmentationLSDA, 'L')
NEVERD_MACHO_FRAME_VALUE(char, kAugmentationSignal, 'S')
NEVERD_MACHO_FRAME_VALUE(unsigned, kFramePointerArithmeticBits, 65)
NEVERD_MACHO_FRAME_VALUE(unsigned, kFrameMissingStatus, 255)
NEVERD_MACHO_FRAME_TEXT(kFrameMissingCIE, "absent")
NEVERD_MACHO_FRAME_TEXT(kFramePointerContext,
                        "{0}: VA={1}, CIE={2}, encoding={3}, status={4}")
NEVERD_MACHO_FRAME_TEXT(kBasicAugmentation, "zR")
// Each old/new query has a preflight and state replay. One extra unit charges
// an empty program, so the total bounds both instruction work and query count.
NEVERD_MACHO_FRAME_VALUE(uint64_t, kRAComparisonPasses, 4)
NEVERD_MACHO_FRAME_LIMIT(uint64_t, kMachOFrameRAComparisonWork, 1u << 20)
NEVERD_MACHO_FRAME_TEXT(
    kFrameIdentityChanged,
    "relocated DWARF frame identity or normalized CFI changed")
NEVERD_MACHO_FRAME_TEXT(
    kFrameStateUnavailable,
    "relocated DWARF return-address state is not statically known")
NEVERD_MACHO_FRAME_TEXT(kFrameStateChanged,
                        "relocated DWARF return-address signing recipe changed")
NEVERD_MACHO_FRAME_TEXT(
    kFramePointerContract,
    "EH growth needs an address-stable DWARF pointer contract")
NEVERD_MACHO_FRAME_TEXT(kFramePointerReach,
                        "relocated DWARF pointer exceeds its encoded reach")
NEVERD_MACHO_FRAME_TEXT(kFrameLanguageChanged,
                        "relocated DWARF personality or LSDA identity changed")
NEVERD_MACHO_FRAME_TEXT(
    kFrameStateBudget,
    "DWARF return-address relocation exceeds its comparison budget")

#undef NEVERD_MACHO_FRAME_VALUE
#undef NEVERD_MACHO_FRAME_TEXT
#undef NEVERD_MACHO_FRAME_LIMIT
