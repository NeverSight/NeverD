//===- MIPSDSPSource.def - Original-machine DSP state transfers ----------===//
//
// NeverD Decompiler
//
//===----------------------------------------------------------------------===//
#ifndef NEVERD_MIPS_DSP_SOURCE_TEXT
#define NEVERD_MIPS_DSP_SOURCE_TEXT(Name, Text)
#endif

NEVERD_MIPS_DSP_SOURCE_TEXT(DSPReadAsm,
                            ".set push\n.set dsp\nrddsp $0, 63\n.set pop")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPWriteAsm,
                            ".set push\n.set dsp\nwrdsp $0, 63\n.set pop")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPReadConstraints, "=r,~{memory}")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPWriteConstraints, "r,~{memory}")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPSourceCAttribute, "NEVERD_MIPS_NO_DSP ")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPSourceMarker, "neverd.mips.dspcontrol")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPSourceFeatures, "-dsp,-dspr2")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPFeatureAttribute, "target-features")
NEVERD_MIPS_DSP_SOURCE_TEXT(
    DSPSourceCBegin,
    "#if defined(__clang__)\n"
    "#define NEVERD_MIPS_NO_DSP __attribute__((target(\"no-dsp,no-dspr2\")))\n"
    "#pragma clang attribute push "
    "(NEVERD_MIPS_NO_DSP, apply_to=function)\n"
    "#elif defined(__GNUC__) && defined(__mips__) && !defined(__mips_dsp)\n"
    "#define NEVERD_MIPS_NO_DSP\n"
    "#else\n"
    "#error \"Preserving DSPControl requires Clang or MIPS GCC with -mno-dsp -mno-dspr2\"\n"
    "#endif\n\n")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPSourceCEnd,
                            "\n#if defined(__clang__)\n#pragma clang attribute pop\n#endif\n"
                            "#undef NEVERD_MIPS_NO_DSP\n")
NEVERD_MIPS_DSP_SOURCE_TEXT(
    DSPReadCAsm, "\".set push\\n.set dsp\\nrddsp %0, 63\\n.set pop\"")
NEVERD_MIPS_DSP_SOURCE_TEXT(
    DSPWriteCAsm, "\".set push\\n.set dsp\\nwrdsp %0, 63\\n.set pop\"")
NEVERD_MIPS_DSP_SOURCE_TEXT(
    MalformedDSPSource,
    "invalid original-machine MIPS DSPControl source transfer")

// AC3 has no partial HI/LO producer hazard. Save its halves around the
// POS-only MTHLIP so native source observes the issuing CPU's undefined POS.
NEVERD_MIPS_DSP_SOURCE_TEXT(
    DSPPositionAsm,
    ".set push\n.set dsp\nmfhi $$8,$$ac3\nmflo $$9,$$ac3\nmthlip "
    "$$zero,$$ac3\nmthi $$8,$$ac3\nmtlo $$9,$$ac3\n.set pop")
NEVERD_MIPS_DSP_SOURCE_TEXT(
    DSPPositionCAsm,
    "\".set push\\n.set dsp\\nmfhi $8,$ac3\\nmflo $9,$ac3\\nmthlip "
    "$zero,$ac3\\nmthi $8,$ac3\\nmtlo $9,$ac3\\n.set pop\"")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPPositionConstraints, "~{$8},~{$9},~{memory}")
NEVERD_MIPS_DSP_SOURCE_TEXT(DSPCompareConstraints, "r,r,~{memory}")
#undef NEVERD_MIPS_DSP_SOURCE_TEXT
