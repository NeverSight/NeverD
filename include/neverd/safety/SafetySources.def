//===- SafetySources.def - Default input-source catalog ------*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SAFETY_SOURCE(NAME, OUT)
// SAFETY_SOURCE_RETURN(NAME, OUT)
// SAFETY_SOURCE_NO_RETURN(NAME, OUT)
//
//   OUT is the argument index that receives tainted bytes, or -1 when there is
//   no output-buffer argument.  The RETURN variants explicitly state whether
//   the scalar/pointer return also carries attacker-controlled input.
//
//===----------------------------------------------------------------------===//

#ifndef SAFETY_SOURCE
#define SAFETY_SOURCE(NAME, OUT)
#endif
#ifndef SAFETY_SOURCE_RETURN
#define SAFETY_SOURCE_RETURN(NAME, OUT) SAFETY_SOURCE(NAME, OUT)
#endif
#ifndef SAFETY_SOURCE_NO_RETURN
#define SAFETY_SOURCE_NO_RETURN(NAME, OUT) SAFETY_SOURCE(NAME, OUT)
#endif

// POSIX providers.
SAFETY_SOURCE_RETURN(getenv, -1)
SAFETY_SOURCE_RETURN(secure_getenv, -1)
SAFETY_SOURCE_RETURN(read, 1)
SAFETY_SOURCE_RETURN(pread, 1)
SAFETY_SOURCE_RETURN(read_chk, 1)
SAFETY_SOURCE_RETURN(pread_chk, 1)
SAFETY_SOURCE_RETURN(recv, 1)
SAFETY_SOURCE_RETURN(recvfrom, 1)
SAFETY_SOURCE_RETURN(recv_chk, 1)
SAFETY_SOURCE_RETURN(recvfrom_chk, 1)
SAFETY_SOURCE_RETURN(fgets, 0)
SAFETY_SOURCE_RETURN(fread, 0)
SAFETY_SOURCE_RETURN(fgets_unlocked, 0)
SAFETY_SOURCE_RETURN(fread_unlocked, 0)
SAFETY_SOURCE_RETURN(fgets_chk, 0)
SAFETY_SOURCE_RETURN(fread_chk, 0)
SAFETY_SOURCE_RETURN(fgets_unlocked_chk, 0)
SAFETY_SOURCE_RETURN(fread_unlocked_chk, 0)
SAFETY_SOURCE_RETURN(gets, 0)
SAFETY_SOURCE_NO_RETURN(scanf, -1)
SAFETY_SOURCE_NO_RETURN(fscanf, -1)
SAFETY_SOURCE_NO_RETURN(sscanf, -1)
SAFETY_SOURCE_NO_RETURN(isoc99_scanf, -1)
SAFETY_SOURCE_NO_RETURN(isoc99_fscanf, -1)
SAFETY_SOURCE_NO_RETURN(isoc99_sscanf, -1)
SAFETY_SOURCE_NO_RETURN(isoc23_scanf, -1)
SAFETY_SOURCE_NO_RETURN(isoc23_fscanf, -1)
SAFETY_SOURCE_NO_RETURN(isoc23_sscanf, -1)

// Win32 providers, so a PE hunt is not restricted to POSIX inputs.
SAFETY_SOURCE_RETURN(GetCommandLineA, -1)
SAFETY_SOURCE_RETURN(GetCommandLineW, -1)
SAFETY_SOURCE_NO_RETURN(ReadFile, 1)
SAFETY_SOURCE_RETURN(GetEnvironmentVariableA, 1)
SAFETY_SOURCE_RETURN(GetEnvironmentVariableW, 1)
SAFETY_SOURCE_RETURN(argv, -1)

#undef SAFETY_SOURCE_NO_RETURN
#undef SAFETY_SOURCE_RETURN
#undef SAFETY_SOURCE
