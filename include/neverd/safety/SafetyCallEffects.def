SAFETY_STANDARD_FORMATTED_INPUT("isoc23_fscanf", 2)
SAFETY_FORMATTED_INPUT("isoc23_sscanf", 2)
SAFETY_INPUT_RETURN("argv", 0, 0)

#undef SAFETY_STANDARD_FORMATTED_INPUT
#undef SAFETY_FORMATTED_INPUT
#undef SAFETY_STANDARD_INPUT_BUFFER
#undef SAFETY_REPLAYABLE_DESCRIPTOR_INPUT_BUFFER
#undef SAFETY_DESCRIPTOR_INPUT_BUFFER
#undef SAFETY_ENVIRONMENT_RETURN
#undef SAFETY_INPUT_RETURN

#define SAFETY_WINDOWS_INPUT(NAME, CAPS, ARITY)                               \
  SAFETY_CALL_EFFECT(NAME, Input, CAPS, CallEffectFormat::COFF,               \
                     CallEffectABI::Microsoft, ARITY, ARITY)

SAFETY_WINDOWS_INPUT("GetCommandLineA",
                     CallEffectCapability::Return |
                         CallEffectCapability::Taint |
                         CallEffectCapability::Capture,
                     0)
SAFETY_WINDOWS_INPUT("GetCommandLineW",
                     CallEffectCapability::Return |
