//===- SafetyCallEffects.def - Exact external-call summaries -*- C++ -*-===//
//
// NeverD Decompiler
//
// This file intentionally has no include guard.
//
// SAFETY_CALL_EFFECT(NAME, FAMILY, CAPABILITIES, FORMATS, ABIS, MIN, MAX)
//
// NAME is a string literal in SinkCatalog-normalized form. MAX may be
// CallEffectDescriptor::VariadicArity. Unconstrained format/ABI fields mean
// that the property is platform-independent. A configured discovery entry
// absent from this table has NoEffect.
//
//===----------------------------------------------------------------------===//

#ifndef SAFETY_CALL_EFFECT
#define SAFETY_CALL_EFFECT(NAME, FAMILY, CAPABILITIES, FORMATS, ABIS, MIN, MAX)
#endif

#define SAFETY_STRING_EFFECT(NAME, FAMILY, ARITY)                              \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, FAMILY,                                                           \
      CallEffectCapability::Return | CallEffectCapability::ModRef |           \
          CallEffectCapability::StringExtent | CallEffectCapability::Capture, \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, ARITY,   \
      ARITY)

SAFETY_STRING_EFFECT("strlen", StringLength, 1)
SAFETY_STRING_EFFECT("wcslen", StringLength, 1)
SAFETY_STRING_EFFECT("strnlen", BoundedStringLength, 2)
SAFETY_STRING_EFFECT("strnlen_s", BoundedStringLength, 2)
SAFETY_STRING_EFFECT("wcsnlen", BoundedStringLength, 2)

#undef SAFETY_STRING_EFFECT

#define SAFETY_INPUT_RETURN(NAME, MIN, MAX)                                    \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, Input,                                                            \
      CallEffectCapability::Return | CallEffectCapability::Taint |            \
          CallEffectCapability::Capture,                                      \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN, MAX)
#define SAFETY_ENVIRONMENT_RETURN(NAME, MIN, MAX)                              \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, Input,                                                            \
      CallEffectCapability::Return | CallEffectCapability::Taint |            \
          CallEffectCapability::Capture |                                     \
          CallEffectCapability::LiteralEnvironmentReplay,                     \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN, MAX)
#define SAFETY_DESCRIPTOR_INPUT_BUFFER(NAME, MIN, MAX)                         \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, Input,                                                            \
      CallEffectCapability::Return | CallEffectCapability::ModRef |           \
          CallEffectCapability::Taint | CallEffectCapability::Capture |       \
          CallEffectCapability::MayConsumeStandardInput |                     \
          CallEffectCapability::DescriptorZeroIsStandardInput,                \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN, MAX)
#define SAFETY_REPLAYABLE_DESCRIPTOR_INPUT_BUFFER(NAME, MIN, MAX)              \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, Input,                                                            \
      CallEffectCapability::Return | CallEffectCapability::ModRef |           \
          CallEffectCapability::Taint | CallEffectCapability::Capture |       \
          CallEffectCapability::MayConsumeStandardInput |                     \
          CallEffectCapability::DescriptorZeroIsStandardInput |               \
          CallEffectCapability::ExactStandardInputReplay,                     \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN, MAX)
#define SAFETY_STANDARD_INPUT_BUFFER(NAME, MIN, MAX)                           \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, Input,                                                            \
      CallEffectCapability::Return | CallEffectCapability::ModRef |           \
          CallEffectCapability::Taint | CallEffectCapability::Capture |       \
          CallEffectCapability::MayConsumeStandardInput,                      \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN, MAX)
#define SAFETY_FORMATTED_INPUT(NAME, MIN)                                      \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, FormattedInput,                                                   \
      CallEffectCapability::Return | CallEffectCapability::ModRef |           \
          CallEffectCapability::Taint | CallEffectCapability::Capture,        \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN,     \
      CallEffectDescriptor::VariadicArity)
#define SAFETY_STANDARD_FORMATTED_INPUT(NAME, MIN)                             \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, FormattedInput,                                                   \
      CallEffectCapability::Return | CallEffectCapability::ModRef |           \
          CallEffectCapability::Taint | CallEffectCapability::Capture |       \
          CallEffectCapability::MayConsumeStandardInput,                      \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN,     \
      CallEffectDescriptor::VariadicArity)

SAFETY_ENVIRONMENT_RETURN("getenv", 1, 1)
SAFETY_ENVIRONMENT_RETURN("secure_getenv", 1, 1)
SAFETY_REPLAYABLE_DESCRIPTOR_INPUT_BUFFER("read", 3, 3)
SAFETY_DESCRIPTOR_INPUT_BUFFER("pread", 4, 4)
