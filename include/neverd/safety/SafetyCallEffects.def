      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN, MAX)
#define SAFETY_RELEASE_EFFECT(NAME, MIN, MAX)                                  \
  SAFETY_CALL_EFFECT(                                                         \
      NAME, Release,                                                          \
      CallEffectCapability::ModRef | CallEffectCapability::Release |          \
          CallEffectCapability::Capture,                                      \
      CallEffectFormat::Unconstrained, CallEffectABI::Unconstrained, MIN, MAX)

